# ==============================================================================
# CẤU HÌNH CỔNG THANH TOÁN VNPAY (SANDBOX TEST) - PET SHOP MIO (MẪU CẤU HÌNH EXAMPLE)
# ==============================================================================
# Hướng dẫn:
# 1. Sao chép file này thành 'config/vnpay.properties' hoặc 'config/vnpay.local.properties'
# 2. Cung cấp mã Merchant Terminal Code và Secret Key do cổng VNPay Sandbox cấp.
# Ngoài ra có thể cấu hình qua biến môi trường: VNPAY_TMN_CODE, VNPAY_HASH_SECRET
# ==============================================================================

# Mã định danh website (Merchant Terminal Code) do VNPay cấp
vnpay.tmnCode=YOUR_VNPAY_TMN_CODE_HERE

# Chuỗi bí mật tạo chữ ký số kiểm tra toàn vẹn dữ liệu (Secret Key)
vnpay.hashSecret=YOUR_VNPAY_HASH_SECRET_HERE

# URL cổng thanh toán VNPay Sandbox
vnpay.payUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# URL tra cứu trạng thái giao dịch
vnpay.apiUrl=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Cổng local nhận callback (Local Loopback Server)
vnpay.returnPort=8888
vnpay.returnPath=/vnpay_return
