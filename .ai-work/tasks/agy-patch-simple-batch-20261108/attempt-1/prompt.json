ATE()), 0, 335000, N'Chuyển khoản QR', N'Đã thanh toán');\r\nINSERT INTO ChiTietHoaDon (maChiTiet, maHoaDon, loaiChiTiet, maSanPham, maDichVu, soLuong, donGiaLucBan, thanhTien) VALUES\r\n('HD261102-01_CT1', 'HD261102-01', 'SAN_PHAM', 'SP005', NULL,    1, 85000, 85000),\r\n('HD261102-01_CT2', 'HD261102-01', 'DICH_VU',  NULL,    'DV006', 1, 250000, 250000);\r\nINSERT INTO ChiTietXuatLo (maChiTiet, soLo, maQuyDoi, soLuongXuatCoSo) VALUES\r\n('HD261102-01_CT1', 'LO_BC_2026_01', 'QD008', 1);\r\nINSERT INTO ChiTietDichVu (maChiTiet, maDichVu, maThuCung, maKtvThucHien, tienHoaHong) VALUES\r\n('HD261102-01_CT2', 'DV006', 'TC003', 'NV005', 25000);\r\n-- Hóa đơn 4: Cách đây 3 ngày, hóa đơn mua cát và đồ chơi phụ kiện\r\nINSERT INTO HoaDon (maHoaDon, maKhachHang, maNhanVien, ngayLap, thoiGianThanhToan, giamGia, thanhTien, phuongThucThanhToan, trangThaiHoaDon)\r\nVALUES ('HD261031-01', 'KH004', 'NV003', DATEADD(day, -3, GETDATE()), DATEADD(day, -3, GETDATE()), 0, 110000, N'Tiền mặt', N'Đã thanh toán');\r\nINSERT INTO ChiTietHoaDon (maChiTiet, maHoaDon, loaiChiTiet, maSanPham, maDichVu, soLuong, donGiaLucBan, thanhTien) VALUES\r\n('HD261031-01_CT1', 'HD261031-01', 'SAN_PHAM', 'SP006', NULL, 1, 65000, 65000),\r\n('HD261031-01_CT2', 'HD261031-01', 'SAN_PHAM', 'SP004', NULL, 1, 45000, 45000);\r\nINSERT INTO ChiTietXuatLo (maChiTiet, soLo, maQuyDoi, soLuongXuatCoSo) VALUES\r\n('HD261031-01_CT1', 'LO_CAT_2026_01', 'QD009', 1),\r\n('HD261031-01_CT2', 'LO_PK_2026_01',  'QD007', 1);\r\nGO\r\n\r\n-- 14. Phiếu đổi trả hàng mẫu (Khách đổi trả 1 lon pate bị móp vỏ, hoàn kho lại nguyên vẹn)\r\nINSERT INTO PhieuDoiTra (maPhieuDoiTra, maHoaDonGoc, maNhanVienTiepNhan, ngayDoiTra, tongTienHoan, lyDoDoiTra)\r\nVALUES ('DT001', 'HD261103-01', 'NV003', DATEADD(minute, -30, GETDATE()), 20000, N'Khách mua nhầm vị cá thu, đổi sang pate cá hồi');\r\nINSERT INTO ChiTietDoiTra (maChiTietDoiTra, maPhieuDoiTra, maSanPham, soLuongDoiTra, tienHoanLai, soLuong, donGiaHoan, lyDoChiTiet)\r\nVALUES ('CTDT001', 'DT001', 'SP002', 1, 20000, 1, 20000, N'Hàng nguyên vẹn, còn nguyên tem hạn sử dụng');\r\nGO\r\n\r\n-- 15. Khách sạn lưu trú thú cưng (Pet Hotel - 12 Phòng đủ 3 phân hạng và 3 trạng thái kiểm thử)\r\nINSERT INTO PhongLuuTru (maPhong, loaiPhong, donGiaNgay, trangThai, tenThuCung, giongLoai, tenChu, sdtChu, thoiGianCheckIn, duKienCheckOut, ghiChuChamSoc, daChoAnSang, daChoAnToi, daDiDaoVeSinh, phiDichVuPhatSinh) VALUES\r\n-- Phân hạng 1: Phòng Tiêu chuẩn (150.000đ/ngày)\r\n('P101', N'Phòng Tiêu chuẩn', 150000, N'ĐANG CÓ KHÁCH', N'Bim Bim', N'Corgi Chân Ngắn (9.5kg)', N'Nguyễn Văn An', '0988111222', \r\n DATEADD(day, -2, GETDATE()), DATEADD(day, 1, GETDATE()), N'Ăn hạt Royal Canin ngâm mềm, dắt đi dạo 2 lần/ngày', 1, 1, 1, 0),\r\n('P102', N'Phòng Tiêu chuẩn', 150000, N'TRỐNG', '', '', '', '', NULL, NULL, '', 0, 0, 0, 0),\r\n('P103', N'Phòng Tiêu chuẩn', 150000, N'ĐANG CÓ KHÁCH', N'Bơ', N'Poodle Nâu Đỏ (3.5kg)', N'Trần Thị Mai', '0977333444', \r\n DATEADD(day, -1, GETDATE()), DATEADD(day, 2, GETDATE()), N'Ăn kèm pate gà, chải lông mỗi chiều, có phụ thu nhỏ gáy ve', 1, 0, 1, 75000),\r\n('P104', N'Phòng Tiêu chuẩn', 150000, N'ĐANG DỌN DẸP', '', '', '', '', NULL, NULL, '', 0, 0, 0, 0),\r\n-- Phân hạng 2: Phòng VIP Suite (250.000đ/ngày)\r\n('V201', N'Phòng VIP Suite', 250000, N'ĐANG CÓ KHÁCH', N'Golden Sam', N'Golden Retriever (28kg)', N'Đặng Quốc Bảo', '0933555777', \r\n DATEADD(day, -3, GETDATE()), DATEADD(day, 1, GETDATE()), N'Camera VIP bật 24/7 cho chủ xem, ăn 3 bữa thịt bò tươi', 1, 1, 1, 100000),\r\n('V202', N'Phòng VIP Suite', 250000, N'TRỐNG', '', '', '', '', NULL, NULL, '', 0, 0, 0, 0),\r\n('V203', N'Phòng VIP Suite', 250000, N'TRỐNG', '', '', '', '', NULL, NULL, '', 0, 0, 0, 0),\r\n('V204', N'Phòng VIP Suite', 250000, N'ĐANG CÓ KHÁCH', N'Lu Lu', N'Poodle Tiny (5.8kg)', N'Trần Thị Mai', '0977333444', \r\n DATEADD(hour, -10, GETDATE()), DATEADD(day, 3, GETDATE()), N'Bật điều hòa 24 độ C liên tục, sấy ấm đệm ngủ', 1, 0, 1, 0),\r\n-- Phân hạng 3: Condo cho Mèo (200.000đ/ngày)\r\n('C301', N'Condo cho Mèo', 200000, N'ĐANG CÓ KHÁCH', N'Miu Miu', N'Mèo Anh Lông Ngắn (4.2kg)', N'Lê Hoàng Yến', '0912345678', \r\n DATEADD(day, -1, GETDATE()), DATEADD(day, 2, GETDATE()), N'Ăn hạt Orijen + súp thưởng Ciao lúc 15h chiều', 1, 0, 1, 30000),\r\n('C302', N'Condo cho Mèo', 200000, N'TRỐNG', '', '', '', '', NULL, NULL, '', 0, 0, 0, 0),\r\n('C303', N'Condo cho Mèo', 200000, N'TRỐNG', '', '', '', '', NULL, NULL, '', 0, 0, 0, 0),\r\n('C304', N'Condo cho Mèo', 200000, N'TRỐNG', '', '', '', '', NULL, NULL, '', 0, 0, 0, 0);\r\nGO\r\n\r\n-- 26. Thẻ Spa Pass mẫu kiểm thử quầy POS\r\nINSERT INTO TheSpaPass (maThe, sdtKhachHang, tenKhachHang, tenGoi, tongSoBuoi, soBuoiDaDung, donGiaGoi, ngayKichHoat, ngayHetHan, trangThai) VALUES\r\n('PASS_0988111222_01', '0988111222', N'Nguyễn Văn An', N'Gói Spa Chăm Sóc Thư Giãn (5 Buổi)', 5, 2, 900000, DATEADD(day, -20, CAST(GETDATE() AS DATE)), DATEADD(day, 70, CAST(GETDATE() AS DATE)), N'ĐANG HOẠT ĐỘNG'),\r\n('PASS_0977333444_01', '0977333444', N'Trần Thị Mai', N'Gói Spa Toàn Diện & Cắt Tỉa (10 Buổi)', 10, 8, 1600000, DATEADD(day, -45, CAST(GETDATE() AS DATE)), DATEADD(day, 45, CAST(GETDATE() AS DATE)), N'ĐANG HOẠT ĐỘNG');\r\nGO\r\n\r\n-- ======================================================================================\r\n-- KIỂM TRA TÍNH TOÀN VẸN VÀ THỐNG KÊ DỮ LIỆU ĐÃ NẠP\r\n-- ======================================================================================\r\nPRINT N'==================================================================';\r\nPRINT N'    HỆ THỐNG CƠ SỞ DỮ LIỆU QUẢN LÝ CỬA HÀNG THÚ CƯNG MIO (IUH)    ';\r\nPRINT N'       KHỞI TẠO VÀ NẠP DỮ LIỆU MẪU MỌI KỊCH BẢN THÀNH CÔNG!       ';\r\nPRINT N'==================================================================';\r\nSELECT 'TaiKhoan' AS TenBang, COUNT(*) AS SoLuongBanGhi FROM TaiKhoan\r\nUNION ALL\r\nSELECT 'NhanVien', COUNT(*) FROM NhanVien\r\nUNION ALL\r\nSELECT 'CaLamViec', COUNT(*) FROM CaLamViec\r\nUNION ALL\r\nSELECT 'BangPhanCong', COUNT(*) FROM BangPhanCong\r\nUNION ALL\r\nSELECT 'BangGiaoCa', COUNT(*) FROM BangGiaoCa\r\nUNION ALL\r\nSELECT 'KhachHang', COUNT(*) FROM KhachHang\r\nUNION ALL\r\nSELECT 'ThuCung', COUNT(*) FROM ThuCung\r\nUNION ALL\r\nSELECT 'HoSoThuCung', COUNT(*) FROM HoSoThuCung\r\nUNION ALL\r\nSELECT 'HoSoSucKhoe', COUNT(*) FROM HoSoSucKhoe\r\nUNION ALL\r\nSELECT 'DichVu', COUNT(*) FROM DichVu\r\nUNION ALL\r\nSELECT 'LichHen', COUNT(*) FROM LichHen\r\nUNION ALL\r\nSELECT 'ChiTietLichHen', COUNT(*) FROM ChiTietLichHen\r\nUNION ALL\r\nSELECT 'DanhMucHang', COUNT(*) FROM DanhMucHang\r\nUNION ALL\r\nSELECT 'SanPham', COUNT(*) FROM SanPham\r\nUNION ALL\r\nSELECT 'DonViTinh', COUNT(*) FROM DonViTinh\r\nUNION ALL\r\nSELECT 'QuyDoiDonVi', COUNT(*) FROM QuyDoiDonVi\r\nUNION ALL\r\nSELECT 'NhaCungCap', COUNT(*) FROM NhaCungCap\r\nUNION ALL\r\nSELECT 'LoHang', COUNT(*) FROM LoHang\r\nUNION ALL\r\nSELECT 'HoaDon', COUNT(*) FROM HoaDon\r\nUNION ALL\r\nSELECT 'ChiTietHoaDon', COUNT(*) FROM ChiTietHoaDon\r\nUNION ALL\r\nSELECT 'ChiTietXuatLo', COUNT(*) FROM ChiTietXuatLo\r\nUNION ALL\r\nSELECT 'ChiTietDichVu', COUNT(*) FROM ChiTietDichVu\r\nUNION ALL\r\nSELECT 'PhieuDoiTra', COUNT(*) FROM PhieuDoiTra\r\nUNION ALL\r\nSELECT 'ChiTietDoiTra', COUNT(*) FROM ChiTietDoiTra\r\nUNION ALL\r\nSELECT 'PhongLuuTru', COUNT(*) FROM PhongLuuTru\r\nUNION ALL\r\nSELECT 'TheSpaPass', COUNT(*) FROM TheSpaPass\r\nUNION ALL\r\nSELECT 'LichSuLuuTru', COUNT(*) FROM LichSuLuuTru;\r\nGO\r\n\r\n"},{"path":"src/dao/LoHangDAO.java","sha256":"598638308a6a14ad3480ef9710a23ee2ed59c0c2944151877e743dcd8ab8b722","content":"package dao;\r\n\r\nimport entity.LoHang;\r\nimport entity.NhaCungCap;\r\nimport entity.SanPham;\r\nimport utils.DBConnection;\r\n\r\nimport java.sql.*;\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\n/**\r\n * Data Access Object cho Lô Hàng & Nhà Cung Cấp.\r\n * Cung cấp đầy đủ các thao tác CRUD và thuật toán FEFO (First Expired, First Out).\r\n */\r\npublic class LoHangDAO {\r\n\r\n    /**\r\n     * Lấy toàn bộ danh sách lô hàng trong kho\r\n     */\r\n    public List<LoHang> getAllLoHang() throws SQLException {\r\n        List<LoHang> list = new ArrayList<>();\r\n        String sql = \"SELECT l.*, s.tenSanPham, n.tenNhaCungCap \" +\r\n                \"FROM LoHang l \" +\r\n                \"JOIN SanPham s ON l.maSanPham = s.maSanPham \" +\r\n                \"JOIN NhaCungCap n ON l.maNhaCungCap = n.maNhaCungCap \" +\r\n                \"ORDER BY l.hanSuDung ASC\";\r\n\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql);\r\n             ResultSet rs = ps.executeQuery()) {\r\n            while (rs.next()) {\r\n                list.add(mapResultSetToLoHang(rs));\r\n            }\r\n        }\r\n        return list;\r\n    }\r\n\r\n    /**\r\n     * Tìm lô hàng theo số lô\r\n     */\r\n    public LoHang getLoHangBySoLo(String soLo) throws SQLException {\r\n        String sql = \"SELECT l.*, s.tenSanPham, n.tenNhaCungCap \" +\r\n                \"FROM LoHang l \" +\r\n                \"JOIN SanPham s ON l.maSanPham = s.maSanPham \" +\r\n                \"JOIN NhaCungCap n ON l.maNhaCungCap = n.maNhaCungCap \" +\r\n                \"WHERE l.soLo = ?\";\r\n\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setString(1, soLo);\r\n            try (ResultSet rs = ps.executeQuery()) {\r\n                if (rs.next()) {\r\n                    return mapResultSetToLoHang(rs);\r\n                }\r\n            }\r\n        }\r\n        return null;\r\n    }\r\n\r\n    /**\r\n     * Lấy lô hàng khả dụng theo quy tắc FEFO (Hạn sử dụng gần nhất, còn tồn kho)\r\n     */\r\n    public LoHang getLoHangFEFOBySanPham(String maSanPham) throws SQLException {\r\n        String sql = \"SELECT TOP 1 l.*, s.tenSanPham, n.tenNhaCungCap \" +\r\n                \"FROM LoHang l \" +\r\n                \"JOIN SanPham s ON l.maSanPham = s.maSanPham \" +\r\n                \"JOIN NhaCungCap n ON l.maNhaCungCap = n.maNhaCungCap \" +\r\n                \"WHERE l.maSanPham = ? AND l.soLuongTon > 0 \" +\r\n                \"ORDER BY l.hanSuDung ASC\";\r\n\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setString(1, maSanPham);\r\n            try (ResultSet rs = ps.executeQuery()) {\r\n                if (rs.next()) {\r\n                    return mapResultSetToLoHang(rs);\r\n                }\r\n            }\r\n        }\r\n\r\n        // Nếu hết hàng hoặc chưa có lô, thử lấy lô bất kỳ của sản phẩm\r\n        String sqlFallback = \"SELECT TOP 1 l.*, s.tenSanPham, n.tenNhaCungCap \" +\r\n                \"FROM LoHang l \" +\r\n                \"JOIN SanPham s ON l.maSanPham = s.maSanPham \" +\r\n                \"JOIN NhaCungCap n ON l.maNhaCungCap = n.maNhaCungCap \" +\r\n                \"WHERE l.maSanPham = ? \" +\r\n                \"ORDER BY l.hanSuDung DESC\";\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sqlFallback)) {\r\n            ps.setString(1, maSanPham);\r\n            try (ResultSet rs = ps.executeQuery()) {\r\n                if (rs.next()) {\r\n                    return mapResultSetToLoHang(rs);\r\n                }\r\n            }\r\n        }\r\n        return null;\r\n    }\r\n\r\n    /**\r\n     * Thêm lô hàng mới nhập kho\r\n     */\r\n    public boolean insertLoHang(LoHang lh) throws SQLException {\r\n        String sql = \"INSERT INTO LoHang (soLo, maSanPham, maNhaCungCap, ngaySanXuat, hanSuDung, donGiaNhapCoSo, soLuongNhap, soLuongTon) \" +\r\n                \"VALUES (?, ?, ?, ?, ?, ?, ?, ?)\";\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setString(1, lh.getSoLo());\r\n            ps.setString(2, lh.getSanPham() != null ? lh.getSanPham().getMaSanPham() : null);\r\n            ps.setString(3, lh.getNhaCungCap() != null ? lh.getNhaCungCap().getMaNhaCungCap() : null);\r\n            ps.setDate(4, lh.getNgaySanXuat() != null ? Date.valueOf(lh.getNgaySanXuat()) : null);\r\n            ps.setDate(5, Date.valueOf(lh.getHanSuDung()));\r\n            ps.setBigDecimal(6, lh.getDonGiaNhapCoSo());\r\n            ps.setInt(7, lh.getSoLuongNhap());\r\n            ps.setInt(8, lh.getSoLuongTon());\r\n            return ps.executeUpdate() > 0;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Cập nhật thông tin lô hàng\r\n     */\r\n    public boolean updateLoHang(LoHang lh) throws SQLException {\r\n        String sql = \"UPDATE LoHang SET maSanPham = ?, maNhaCungCap = ?, ngaySanXuat = ?, hanSuDung = ?, \" +\r\n                \"donGiaNhapCoSo = ?, soLuongNhap = ?, soLuongTon = ? WHERE soLo = ?\";\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setString(1, lh.getSanPham() != null ? lh.getSanPham().getMaSanPham() : null);\r\n            ps.setString(2, lh.getNhaCungCap() != null ? lh.getNhaCungCap().getMaNhaCungCap() : null);\r\n            ps.setDate(3, lh.getNgaySanXuat() != null ? Date.valueOf(lh.getNgaySanXuat()) : null);\r\n            ps.setDate(4, Date.valueOf(lh.getHanSuDung()));\r\n            ps.setBigDecimal(5, lh.getDonGiaNhapCoSo());\r\n            ps.setInt(6, lh.getSoLuongNhap());\r\n            ps.setInt(7, lh.getSoLuongTon());\r\n            ps.setString(8, lh.getSoLo());\r\n            return ps.executeUpdate() > 0;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Xóa lô hàng theo số lô\r\n     */\r\n    public boolean deleteLoHang(String soLo) throws SQLException {\r\n        String sql = \"DELETE FROM LoHang WHERE soLo = ?\";\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setString(1, soLo);\r\n            return ps.executeUpdate() > 0;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Trừ tồn kho của một lô hàng cụ thể\r\n     */\r\n    public boolean truTonKho(String soLo, int soLuongXuat) throws SQLException {\r\n        String sql = \"UPDATE LoHang SET soLuongTon = soLuongTon - ? WHERE soLo = ? AND soLuongTon >= ?\";\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setInt(1, soLuongXuat);\r\n            ps.setString(2, soLo);\r\n            ps.setInt(3, soLuongXuat);\r\n            return ps.executeUpdate() > 0;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Cộng hoàn trả tồn kho cho một lô hàng cụ thể (khi đổi trả hàng nguyên tem)\r\n     */\r\n    public boolean congTonKho(String soLo, int soLuongCong) throws SQLException {\r\n        String sql = \"UPDATE LoHang SET soLuongTon = soLuongTon + ? WHERE soLo = ?\";\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setInt(1, soLuongCong);\r\n            ps.setString(2, soLo);\r\n            return ps.executeUpdate() > 0;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Cập nhật số lượng tồn kho thực tế sau kiểm kê\r\n     */\r\n    public boolean capNhatSoLuongTon(String soLo, int soLuongMoi) throws SQLException {\r\n        String sql = \"UPDATE LoHang SET soLuongTon = ? WHERE soLo = ?\";\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setInt(1, Math.max(0, soLuongMoi));\r\n            ps.setString(2, soLo);\r\n            return ps.executeUpdate() > 0;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Lấy danh sách các lô hàng cận hạn sử dụng (trong vòng N ngày tới)\r\n     */\r\n    public List<LoHang> layDanhSachCanDate(int soNgayCanhBao) throws SQLException {\r\n        List<LoHang> list = new ArrayList<>();\r\n        String sql = \"SELECT l.*, s.tenSanPham, n.tenNhaCungCap \" +\r\n                \"FROM LoHang l \" +\r\n                \"JOIN SanPham s ON l.maSanPham = s.maSanPham \" +\r\n                \"JOIN NhaCungCap n ON l.maNhaCungCap = n.maNhaCungCap \" +\r\n                \"WHERE DATEDIFF(day, CAST(GETDATE() AS DATE), l.hanSuDung) <= ? AND l.soLuongTon > 0 \" +\r\n                \"ORDER BY l.hanSuDung ASC\";\r\n\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setInt(1, soNgayCanhBao);\r\n            try (ResultSet rs = ps.executeQuery()) {\r\n                while (rs.next()) {\r\n                    list.add(mapResultSetToLoHang(rs));\r\n                }\r\n            }\r\n        }\r\n        return list;\r\n    }\r\n\r\n    /**\r\n     * Lấy danh sách các lô hàng còn tồn kho khả dụng của một sản phẩm,\r\n     * sắp xếp ưu tiên theo hạn sử dụng tăng dần (FEFO).\r\n     */\r\n    public List<LoHang> getAvailableLotsFEFO(String maSanPham) throws SQLException {\r\n        List<LoHang> list = new ArrayList<>();\r\n        String sql = \"SELECT l.*, s.tenSanPham, n.tenNhaCungCap \" +\r\n                \"FROM LoHang l \" +\r\n                \"JOIN SanPham s ON l.maSanPham = s.maSanPham \" +\r\n                \"JOIN NhaCungCap n ON l.maNhaCungCap = n.maNhaCungCap \" +\r\n                \"WHERE l.maSanPham = ? AND l.soLuongTon > 0 AND l.hanSuDung >= CAST(GETDATE() AS DATE) \" +\r\n                \"ORDER BY l.hanSuDung ASC\";\r\n\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setString(1, maSanPham);\r\n            try (ResultSet rs = ps.executeQuery()) {\r\n                while (rs.next()) {\r\n                    list.add(mapResultSetToLoHang(rs));\r\n                }\r\n            }\r\n        }\r\n        return list;\r\n    }\r\n\r\n    /**\r\n     * Lấy tổng tồn kho khả dụng của một sản phẩm từ tất cả các lô còn hạn.\r\n     */\r\n    public int getTongTonKhaDung(String maSanPham) throws SQLException {\r\n        String sql = \"SELECT SUM(soLuongTon) AS tongTon \" +\r\n                \"FROM LoHang \" +\r\n                \"WHERE maSanPham = ? AND soLuongTon > 0 AND hanSuDung >= CAST(GETDATE() AS DATE)\";\r\n\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setString(1, maSanPham);\r\n            try (ResultSet rs = ps.executeQuery()) {\r\n                if (rs.next()) {\r\n                    return rs.getInt(\"tongTon\");\r\n                }\r\n            }\r\n        }\r\n        return 0;\r\n    }\r\n\r\n    /**\r\n     * Lấy toàn bộ danh sách nhà cung cấp\r\n     */\r\n    public List<NhaCungCap> getAllNhaCungCap() throws SQLException {\r\n        List<NhaCungCap> list = new ArrayList<>();\r\n        String sql = \"SELECT * FROM NhaCungCap ORDER BY tenNhaCungCap ASC\";\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql);\r\n             ResultSet rs = ps.executeQuery()) {\r\n            while (rs.next()) {\r\n                list.add(new NhaCungCap(\r\n                        rs.getString(\"maNhaCungCap\"),\r\n                        rs.getString(\"tenNhaCungCap\"),\r\n                        rs.getString(\"diaChi\"),\r\n                        rs.getString(\"soDienThoai\")\r\n                ));\r\n            }\r\n        }\r\n        return list;\r\n    }\r\n\r\n    /**\r\n     * Thêm nhà cung cấp mới\r\n     */\r\n    public boolean insertNhaCungCap(NhaCungCap ncc) throws SQLException {\r\n        String sql = \"INSERT INTO NhaCungCap (maNhaCungCap, tenNhaCungCap, diaChi, soDienThoai) VALUES (?, ?, ?, ?)\";\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setString(1, ncc.getMaNhaCungCap());\r\n            ps.setString(2, ncc.getTenNhaCungCap());\r\n            ps.setString(3, ncc.getDiaChi());\r\n            ps.setString(4, ncc.getSoDienThoai());\r\n            return ps.executeUpdate() > 0;\r\n        }\r\n    }\r\n    /**\r\n     * Tự động phát sinh số lô tiếp theo trong năm \r\n     */\r\n    public String phatSinhSoLoTuDong() {\r\n        int maxNum = 0;\r\n        int namHienTai = java.time.LocalDate.now().getYear();\r\n        String prefix = \"LO_\" + namHienTai + \"_\";\r\n        String sql = \"SELECT soLo FROM LoHang WHERE soLo LIKE ?\";\r\n        \r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setString(1, prefix + \"%\");\r\n            try (ResultSet rs = ps.executeQuery()) {\r\n                while (rs.next()) {\r\n                    String soLo = rs.getString(\"soLo\");\r\n                    if (soLo != null && soLo.length() > prefix.length()) {\r\n                        try {\r\n                            String sttPart = soLo.substring(prefix.length()).replaceAll(\"[^0-9]\", \"\");\r\n                            int stt = Integer.parseInt(sttPart);\r\n                            if (stt > maxNum) {\r\n                                maxNum = stt;\r\n                            }\r\n                        } catch (Exception ignored) {}\r\n                    }\r\n                }\r\n            }\r\n        } catch (Exception e) {\r\n            System.err.println(\"[LoHangDAO] Lỗi phát sinh số lô: \" + e.getMessage());\r\n        }\r\n        // Trả về mã kế tiếp\r\n        return String.format(\"%s%03d\", prefix, maxNum + 1);\r\n    }\r\n\r\n    private LoHang mapResultSetToLoHang(ResultSet rs) throws SQLException {\r\n        LoHang lo = new LoHang();\r\n        lo.setSoLo(rs.getString(\"soLo\"));\r\n\r\n        SanPham sp = new SanPham();\r\n        sp.setMaSanPham(rs.getString(\"maSanPham\"));\r\n        sp.setTenSanPham(rs.getString(\"tenSanPham\"));\r\n        lo.setSanPham(sp);\r\n\r\n        NhaCungCap ncc = new NhaCungCap();\r\n        ncc.setMaNhaCungCap(rs.getString(\"maNhaCungCap\"));\r\n        ncc.setTenNhaCungCap(rs.getString(\"tenNhaCungCap\"));\r\n        lo.setNhaCungCap(ncc);\r\n\r\n        Date nsx = rs.getDate(\"ngaySanXuat\");\r\n        if (nsx != null) lo.setNgaySanXuat(nsx.toLocalDate());\r\n        lo.setHanSuDung(rs.getDate(\"hanSuDung\").toLocalDate());\r\n        lo.setDonGiaNhapCoSo(rs.getBigDecimal(\"donGiaNhapCoSo\"));\r\n        lo.setSoLuongNhap(rs.getInt(\"soLuongNhap\"));\r\n        lo.setSoLuongTon(rs.getInt(\"soLuongTon\"));\r\n\r\n        return lo;\r\n    }\r\n}\r\n"},{"path":"src/gui/ThietLapQuyDoiDialog.java","sha256":"1327210197f804f1cf6e1b2338021ddae42e34f222012c6c5453b76def0d0151","content":"package gui;\r\n\r\nimport utils.IconHelper;\r\nimport utils.ThemeColors;\r\n\r\nimport javax.swing.*;\r\nimport javax.swing.border.CompoundBorder;\r\nimport javax.swing.border.EmptyBorder;\r\nimport javax.swing.border.LineBorder;\r\nimport javax.swing.table.DefaultTableCellRenderer;\r\nimport javax.swing.table.DefaultTableModel;\r\nimport java.awt.*;\r\nimport java.text.DecimalFormat;\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\n/**\r\n * Hộp thoại Thiết lập Đơn vị tính Quy đổi & Bảng giá đa quy cách đóng gói.\r\n * Hỗ trợ bán hàng đa đơn vị tính: Lon -> Khay/Thùng, Gói -> Thùng, Kg -> Bao...\r\n */\r\npublic class ThietLapQuyDoiDialog extends JDialog {\r\n\r\n    private final DecimalFormat df = new DecimalFormat(\"#,### đ\");\r\n\r\n    public interface OnQuyDoiUpdatedListener {\r\n        void onQuyDoiAdded(String maSP, String tenSP, String donViMoi, int tyLe, long giaBan);\r\n    }\r\n\r\n    private final OnQuyDoiUpdatedListener listener;\r\n\r\n    private JComboBox<String> cboSanPham;\r\n    private JLabel lblDvtGoc;\r\n    private JLabel lblGiaGoc;\r\n    private DefaultTableModel modelQuyDoi;\r\n    private JTable tblQuyDoi;\r\n\r\n    private JTextField txtDonViMoi;\r\n    private JSpinner spnTyLe;\r\n    private JTextField txtGiaBanMoi;\r\n\r\n    public static class QuyDoiItem {\r\n        String maSP;\r\n        String tenSP;\r\n        String donVi;\r\n        int tyLe;\r\n        boolean laCoSo;\r\n        long giaBan;\r\n\r\n        public QuyDoiItem(String maSP, String tenSP, String donVi, int tyLe, boolean laCoSo, long giaBan) {\r\n            this.maSP = maSP;\r\n            this.tenSP = tenSP;\r\n            this.donVi = donVi;\r\n            this.tyLe = tyLe;\r\n            this.laCoSo = laCoSo;\r\n            this.giaBan = giaBan;\r\n        }\r\n    }\r\n\r\n    private final List<QuyDoiItem> dsQuyDoi = new ArrayList<>();\r\n\r\n    public ThietLapQuyDoiDialog(Frame parent, OnQuyDoiUpdatedListener listener) {\r\n        super(parent, \"THIẾT LẬP ĐƠN VỊ TÍNH QUY ĐỔI (UNIT CONVERSION)\", true);\r\n        this.listener = listener;\r\n\r\n        setSize(780, 560);\r\n        setLocationRelativeTo(parent);\r\n        setResizable(false);\r\n        setLayout(new BorderLayout());\r\n        getContentPane().setBackground(ThemeColors.SURFACE);\r\n\r\n        dongBoDuLieuQuyDoiTuDatabase();\r\n        initUI();\r\n        capNhatBangTheoSanPham();\r\n        tinhToanGiaTuDong();\r\n    }\r\n\r\n    private void dongBoDuLieuQuyDoiTuDatabase() {\r\n        dsQuyDoi.clear();\r\n        try {\r\n            bus.KhoLoHangBus khoBus = new bus.KhoLoHangBus();\r\n            List<entity.SanPham> dsSP = khoBus.layDanhSachSanPham();\r\n            if (dsSP != null && !dsSP.isEmpty()) {\r\n                for (entity.SanPham sp : dsSP) {\r\n                    List<entity.QuyDoiDonVi> listQd = khoBus.layQuyDoiBySanPham(sp.getMaSanPham());\r\n                    for (entity.QuyDoiDonVi qd : listQd) {\r\n                        dsQuyDoi.add(new QuyDoiItem(\r\n                                sp.getMaSanPham(),\r\n                                sp.getTenSanPham(),\r\n                                qd.getDonViTinh() != null ? qd.getDonViTinh().getTenDonVi() : \"Đơn vị\",\r\n                                qd.getTyLeQuyDoi(),\r\n                                qd.isLaDonViCoSo(),\r\n                                qd.getGiaBan() != null ? qd.getGiaBan().longValue() : 0L\r\n                        ));\r\n                    }\r\n                }\r\n            }\r\n        } catch (Exception e) {\r\n            System.err.println(\"[ThietLapQuyDoiDialog] Lỗi nạp quy đổi từ CSDL: \" + e.getMessage());\r\n        }\r\n    }\r\n\r\n    private void initUI() {\r\n        // 1. Header\r\n        JPanel pnlHeader = new JPanel(new BorderLayout());\r\n        pnlHeader.setBackground(ThemeColors.PRIMARY_TINT);\r\n        pnlHeader.setBorder(new CompoundBorder(\r\n                BorderFactory.createMatteBorder(0, 0, 1, 0, ThemeColors.BORDER_LIGHT),\r\n                new EmptyBorder(14, 20, 14, 20)\r\n        ));\r\n\r\n        JLabel lblTitle = new JLabel(\"THIẾT LẬP ĐƠN VỊ QUY ĐỔI & BẢNG GIÁ ĐA QUY CÁCH\",\r\n                IconHelper.getPrimaryIcon(IconHelper.SETTINGS, 20), SwingConstants.LEFT);\r\n        lblTitle.setFont(new Font(\"Segoe UI\", Font.BOLD, 16));\r\n        lblTitle.setForeground(ThemeColors.TEXT_PRIMARY);\r\n\r\n        JLabel lblSub = new JLabel(\"Hỗ trợ bán hàng đa quy cách đóng gói (Khay, Thùng, Lốc, Bao) và tự động trừ kho theo ĐVT cơ sở\");\r\n        lblSub.setFont(new Font(\"Segoe UI\", Font.PLAIN, 12));\r\n        lblSub.setForeground(ThemeColors.TEXT_MUTED);\r\n\r\n        pnlHeader.add(lblTitle, BorderLayout.NORTH);\r\n        pnlHeader.add(lblSub, BorderLayout.SOUTH);\r\n        add(pnlHeader, BorderLayout.NORTH);\r\n\r\n        // 2. Body - Trái: Chọn SP & Thêm quy đổi mới, Phải: Bảng danh sách quy đổi\r\n        JPanel pnlBody = new JPanel(new BorderLayout(14, 0));\r\n        pnlBody.setBackground(ThemeColors.BACKGROUND);\r\n        pnlBody.setBorder(new EmptyBorder(14, 16, 14, 16));\r\n\r\n        pnlBody.add(taoPanelTrai(), BorderLayout.WEST);\r\n        pnlBody.add(taoPanelPhai(), BorderLayout.CENTER);\r\n\r\n        add(pnlBody, BorderLayout.CENTER);\r\n\r\n        // 3. Footer\r\n        JPanel pnlFooter = new JPanel(new FlowLayout(FlowLayout.RIGHT, 10, 12));\r\n        pnlFooter.setBackground(ThemeColors.SURFACE);\r\n        pnlFooter.setBorder(BorderFactory.createMatteBorder(1, 0, 0, 0, ThemeColors.BORDER_LIGHT));\r\n\r\n        JButton btnDong = ThemeColors.createSecondaryButton(\"Đóng lại\", null);\r\n        btnDong.addActionListener(e -> dispose());\r\n        pnlFooter.add(btnDong);\r\n        add(pnlFooter, BorderLayout.SOUTH);\r\n    }\r\n\r\n    private JPanel taoPanelTrai() {\r\n        JPanel pnl = new JPanel(new GridBagLayout());\r\n        pnl.setPreferredSize(new Dimension(340, 0));\r\n        pnl.setBackground(ThemeColors.SURFACE);\r\n        pnl.setBorder(ThemeColors.createCardBorder(12, 14, 12, 14));\r\n\r\n        GridBagConstraints gbc = new GridBagConstraints();\r\n        gbc.fill = GridBagConstraints.HORIZONTAL;\r\n        gbc.insets = new Insets(5, 4, 5, 4);\r\n\r\n        // Tiêu đề\r\n        gbc.gridx = 0; gbc.gridy = 0; gbc.gridwidth = 2;\r\n        JLabel lblSec = new JLabel(\"THÊM QUY CÁCH QUY ĐỔI MỚI\", IconHelper.getIcon(IconHelper.PLUS, 15, ThemeColors.PRIMARY), SwingConstants.LEFT);\r\n        lblSec.setFont(new Font(\"Segoe UI\", Font.BOLD, 13));\r\n        lblSec.setForeground(ThemeColors.PRIMARY_ACTIVE);\r\n        pnl.add(lblSec, gbc);\r\n\r\n        gbc.gridwidth = 1;\r\n\r\n        // Lấy danh sách sản phẩm động từ cơ sở dữ liệu\r\n        List<String> listSpCombo = new ArrayList<>();\r\n        for (QuyDoiItem item : dsQuyDoi) {\r\n            String str = item.maSP + \" - \" + item.tenSP;\r\n            if (!listSpCombo.contains(str)) {\r\n                listSpCombo.add(str);\r\n            }\r\n        }\r\n\r\n        // Chọn sản phẩm (CHƯA addActionListener vội để tránh lỗi NullPointerException)\r\n        gbc.gridx = 0; gbc.gridy = 1; gbc.weightx = 0.4;\r\n        pnl.add(new JLabel(\"Chọn sản phẩm:\"), gbc);\r\n        gbc.gridx = 1; gbc.weightx = 0.6;\r\n        cboSanPham = new JComboBox<>(listSpCombo.toArray(new String[0]));\r\n        cboSanPham.setPreferredSize(new Dimension(0, 32));\r\n        pnl.add(cboSanPham, gbc);\r\n\r\n        // ĐVT cơ sở\r\n        gbc.gridx = 0; gbc.gridy = 2;\r\n        pnl.add(new JLabel(\"ĐVT cơ sở:\"), gbc);\r\n        gbc.gridx = 1;\r\n        lblDvtGoc = new JLabel(\"Lon (1 cơ sở)\", SwingConstants.LEFT);\r\n        lblDvtGoc.setFont(new Font(\"Segoe UI\", Font.BOLD, 12));\r\n        lblDvtGoc.setForeground(ThemeColors.PRIMARY_ACTIVE);\r\n        pnl.add(lblDvtGoc, gbc);\r\n\r\n        // Giá cơ sở\r\n        gbc.gridx = 0; gbc.gridy = 3;\r\n        pnl.add(new JLabel(\"Giá niêm yết gốc:\"), gbc);\r\n        gbc.gridx = 1;\r\n        lblGiaGoc = new JLabel(\"20,000 đ\", SwingConstants.LEFT);\r\n        lblGiaGoc.setFont(new Font(\"Segoe UI\", Font.BOLD, 13));\r\n        lblGiaGoc.setForeground(ThemeColors.TEXT_PRIMARY);\r\n        pnl.add(lblGiaGoc, gbc);\r\n\r\n        // Đơn vị quy đổi mới\r\n        gbc.gridx = 0; gbc.gridy = 4;\r\n        pnl.add(new JLabel(\"Tên quy cách mới:\"), gbc);\r\n        gbc.gridx = 1;\r\n        txtDonViMoi = new JTextField();\r\n        txtDonViMoi.setPreferredSize(new Dimension(0, 32));\r\n        txtDonViMoi.setBorder(ThemeColors.createInputBorder());\r\n        txtDonViMoi.putClientProperty(\"JTextField.placeholderText\", \"Ví dụ: Khay 12 lon, Thùng...\");\r\n        pnl.add(txtDonViMoi, gbc);\r\n\r\n        // Tỷ lệ quy đổi\r\n        gbc.gridx = 0; gbc.gridy = 5;\r\n        pnl.add(new JLabel(\"Tỷ lệ quy đổi:\"), gbc);\r\n        gbc.gridx = 1;\r\n        spnTyLe = new JSpinner(new SpinnerNumberModel(12, 2, 500, 1));\r\n        spnTyLe.setPreferredSize(new Dimension(0, 32));\r\n        spnTyLe.addChangeListener(e -> tinhToanGiaTuDong()); // Tự tính giá khi thay đổi tỷ lệ\r\n        pnl.add(spnTyLe, gbc);\r\n\r\n        // Giá bán niêm yết (Tự động chiết khấu 5%)\r\n        gbc.gridx = 0; gbc.gridy = 6;\r\n        pnl.add(new JLabel(\"Giá bán quy cách (-5%):\"), gbc);\r\n        gbc.gridx = 1;\r\n        txtGiaBanMoi = new JTextField();\r\n        txtGiaBanMoi.setPreferredSize(new Dimension(0, 32));\r\n        txtGiaBanMoi.setEditable(false); // Khóa lại vì tự động tính theo công thức\r\n        txtGiaBanMoi.setBackground(new Color(241, 245, 249));\r\n        txtGiaBanMoi.setBorder(ThemeColors.createInputBorder());\r\n        pnl.add(txtGiaBanMoi, gbc);\r\n        cboSanPham.addActionListener(e -> {\r\n            capNhatBangTheoSanPham();\r\n            tinhToanGiaTuDong();\r\n        });\r\n\r\n        // Nút thêm\r\n        gbc.gridx = 0; gbc.gridy = 7; gbc.gridwidth = 2;\r\n        JButton btnThemQuyDoi = ThemeColors.createPrimaryButton(\"Thêm Quy đổi này\", IconHelper.getIcon(IconHelper.PLUS, 14, Color.WHITE));\r\n        btnThemQuyDoi.addActionListener(e -> xuLyThemQuyDoi());\r\n        pnl.add(btnThemQuyDoi, gbc);\r\n\r\n        // Hướng dẫn\r\n        gbc.gridx = 0; gbc.gridy = 8;\r\n        String guide = \"<html><div style='color:#64748B; font-size:11px; padding:8px; background:#F8FAFC; border-radius:6px;'>\"\r\n                + \"<b>Công thức trừ kho tự động:</b><br/>\"\r\n                + \"Khi khách mua <b>2 Khay</b> (tỷ lệ 12), hệ thống POS tự động trừ tồn kho <b>24 Lon</b> cơ sở từ lô hàng theo FEFO.\"\r\n                + \"</div></html>\";\r\n        JLabel lblGuide = new JLabel(guide);\r\n        pnl.add(lblGuide, gbc);\r\n\r\n        return pnl;\r\n    }\r\n\r\n    private JPanel taoPanelPhai() {\r\n        JPanel pnl = new JPanel(new BorderLayout(0, 10));\r\n        pnl.setBackground(ThemeColors.SURFACE);\r\n        pnl.setBorder(ThemeColors.createCardBorder(12, 14, 12, 14));\r\n\r\n        JLabel lblSec = new JLabel(\"BẢNG CÁC QUY CÁCH ĐANG ÁP DỤNG\",\r\n                IconHelper.getIcon(IconHelper.BOXES, 15, ThemeColors.PRIMARY), SwingConstants.LEFT);\r\n        lblSec.setFont(new Font(\"Segoe UI\", Font.BOLD, 13));\r\n        lblSec.setForeground(ThemeColors.PRIMARY_ACTIVE);\r\n\r\n        String[] cols = {\"Đơn vị quy đổi\", \"Tỷ lệ ĐVT gốc\", \"Là ĐVT cơ sở\", \"Giá bán niêm yết\", \"Tiết kiệm ước tính\"};\r\n        modelQuyDoi = new DefaultTableModel(cols, 0) {\r\n            @Override\r\n            public boolean isCellEditable(int row, int col) { return false; }\r\n        };\r\n\r\n        tblQuyDoi = new JTable(modelQuyDoi);\r\n        tblQuyDoi.setRowHeight(32);\r\n        tblQuyDoi.setFont(new Font(\"Segoe UI\", Font.PLAIN, 12));\r\n        tblQuyDoi.setSelectionBackground(ThemeColors.PRIMARY_SOFT);\r\n        tblQuyDoi.setSelectionForeground(ThemeColors.TEXT_PRIMARY);\r\n\r\n        DefaultTableCellRenderer center = new DefaultTableCellRenderer();\r\n        center.setHorizontalAlignment(JLabel.CENTER);\r\n        tblQuyDoi.getColumnModel().getColumn(1).setCellRenderer(center);\r\n        tblQuyDoi.getColumnModel().getColumn(2).setCellRenderer(center);\r\n\r\n        pnl.add(lblSec, BorderLayout.NORTH);\r\n        pnl.add(new JScrollPane(tblQuyDoi), BorderLayout.CENTER);\r\n\r\n        return pnl;\r\n    }\r\n\r\n    private void capNhatBangTheoSanPham() {\r\n        modelQuyDoi.setRowCount(0);\r\n        String sel = (String) cboSanPham.getSelectedItem();\r\n        if (sel == null) return;\r\n        String maSP = sel.substring(0, sel.indexOf(\" - \")).trim();\r\n\r\n        QuyDoiItem coSo = null;\r\n        for (QuyDoiItem item : dsQuyDoi) {\r\n            if (item.maSP.equals(maSP) && item.laCoSo) {\r\n                coSo = item;\r\n                break;\r\n            }\r\n        }\r\n\r\n        if (coSo != null) {\r\n            lblDvtGoc.setText(coSo.donVi + \" (Tỷ lệ: 1)\");\r\n            lblGiaGoc.setText(df.format(coSo.giaBan));\r\n        }\r\n\r\n        for (QuyDoiItem item : dsQuyDoi) {\r\n            if (item.maSP.equals(maSP)) {\r\n                String tietKiem = \"---\";\r\n                if (!item.laCoSo && coSo != null) {\r\n                    long giaGocNhanTyLe = coSo.giaBan * item.tyLe;\r\n                    long diff = giaGocNhanTyLe - item.giaBan;\r\n                    if (diff > 0) tietKiem = \"Tiết kiệm \" + df.format(diff);\r\n                }\r\n                modelQuyDoi.addRow(new Object[]{\r\n                        item.donVi,\r\n                        item.tyLe,\r\n                        item.laCoSo ? \"ĐƠN VỊ CƠ SỞ\" : \"Quy đổi\",\r\n                        df.format(item.giaBan),\r\n                        tietKiem\r\n                });\r\n            }\r\n        }\r\n    }\r\n    \r\n//    tính giá tự động chiếc khấu 5% khi mua số lượng lớn -- cập nhật thêm\r\n    private void tinhToanGiaTuDong() {\r\n        if (cboSanPham == null || txtGiaBanMoi == null || spnTyLe == null) return;\r\n        String sel = (String) cboSanPham.getSelectedItem();\r\n        if (sel == null) return;\r\n        String maSP = sel.substring(0, sel.indexOf(\" - \")).trim();\r\n\r\n        QuyDoiItem coSo = null;\r\n        for (QuyDoiItem item : dsQuyDoi) {\r\n            if (item.maSP.equals(maSP) && item.laCoSo) {\r\n                coSo = item;\r\n                break;\r\n            }\r\n        }\r\n\r\n        if (coSo != null) {\r\n            int tyLe = (int) spnTyLe.getValue();\r\n            // Công thức: (Giá gốc * Tỷ lệ) * 0.95 (giảm 5%)\r\n            long giaTinhToan = Math.round((double) coSo.giaBan * tyLe * 0.95);\r\n            txtGiaBanMoi.setText(String.valueOf(giaTinhToan));\r\n        }\r\n    }\r\n    \r\n//    ---------------\r\n\r\n    private void xuLyThemQuyDoi() {\r\n        String tenDvt = txtDonViMoi.getText().trim();\r\n        if (tenDvt.isEmpty()) {\r\n            JOptionPane.showMessageDialog(this, \"Vui lòng nhập tên quy cách quy đổi (ví dụ: Khay 12 lon, Thùng 24 lon)!\", \"Thiếu thông tin\", JOptionPane.WARNING_MESSAGE);\r\n            txtDonViMoi.requestFocus();\r\n            return;\r\n        }\r\n\r\n        try {\r\n            int tyLe = (int) spnTyLe.getValue();\r\n            long giaBan = Long.parseLong(txtGiaBanMoi.getText().replace(\",\", \"\").replace(\".\", \"\").trim());\r\n\r\n            String sel = (String) cboSanPham.getSelectedItem();\r\n            String maSP = sel.substring(0, sel.indexOf(\" - \")).trim();\r\n            String tenSP = sel.substring(sel.indexOf(\" - \") + 3).trim();\r\n\r\n            try {\r\n                bus.KhoLoHangBus khoBus = new bus.KhoLoHangBus();\r\n                String maDvt = utils.MaTuSinhHelper.sinhMaDonViTinh();\r\n                entity.DonViTinh dvt = new entity.DonViTinh(maDvt, tenDvt);\r\n                khoBus.themDonViTinh(dvt);\r\n                entity.SanPham sp = new entity.SanPham(maSP, null, tenSP, \"\");\r\n                entity.QuyDoiDonVi qd = new entity.QuyDoiDonVi(\r\n                        utils.MaTuSinhHelper.sinhMaQuyDoi(),\r\n                        sp, dvt, tyLe, false, java.math.BigDecimal.valueOf(giaBan)\r\n                );\r\n                khoBus.themQuyDoi(qd);\r\n            } catch (Exception ex) {\r\n                System.err.println(\"[ThietLapQuyDoiDialog] Lỗi lưu quy đổi CSDL: \" + ex.getMessage());\r\n                JOptionPane.showMessageDialog(this, \"Không thể lưu quy cách mới vào CSDL: \" + ex.getMessage(), \"Lỗi CSDL\", JOptionPane.ERROR_MESSAGE);\r\n                return;\r\n            }\r\n\r\n            QuyDoiItem newItem = new QuyDoiItem(maSP, tenSP, tenDvt, tyLe, false, giaBan);\r\n            dsQuyDoi.add(newItem);\r\n\r\n            capNhatBangTheoSanPham();\r\n\r\n            if (listener != null) {\r\n                listener.onQuyDoiAdded(maSP, tenSP, tenDvt, tyLe, giaBan);\r\n            }\r\n\r\n            JOptionPane.showMessageDialog(this,\r\n                    \"Đã thêm quy cách đóng gói [\" + tenDvt + \"] thành công!\\n\" +\r\n                            \"• Tỷ lệ quy đổi: 1 \" + tenDvt + \" = \" + tyLe + \" \" + lblDvtGoc.getText() + \"\\n\" +\r\n                            \"• Giá bán niêm yết: \" + df.format(giaBan),\r\n                    \"Thiết lập thành công\", JOptionPane.INFORMATION_MESSAGE);\r\n\r\n            txtDonViMoi.setText(\"\");\r\n        } catch (NumberFormatException e) {\r\n            JOptionPane.showMessageDialog(this, \"Giá bán quy cách phải là số nguyên dương hợp lệ!\", \"Lỗi nhập liệu\", JOptionPane.ERROR_MESSAGE);\r\n        }\r\n    }\r\n}\r\n"},{"path":"src/bus/KhoLoHangBus.java","sha256":"b29ec834fa9608d70f523a891c8e30c1307a83a3622f45e97e30a07a1d779393","content":"package bus;\r\n\r\nimport dao.LoHangDAO;\r\nimport dao.SanPhamDAO;\r\nimport entity.LoHang;\r\nimport entity.QuyDoiDonVi;\r\nimport entity.SanPham;\r\nimport entity.DanhMucHang;\r\nimport entity.DonViTinh;\r\nimport entity.NhaCungCap;\r\n\r\nimport java.math.BigDecimal;\r\nimport java.sql.SQLException;\r\nimport java.time.LocalDate;\r\nimport java.time.temporal.ChronoUnit;\r\nimport java.util.ArrayList;\r\nimport java.util.Collections;\r\nimport java.util.List;\r\n\r\n/**\r\n * Controller điều phối toàn bộ nghiệp vụ Quản lý Kho, Lô hàng FEFO, Điểm đặt hàng ROP và Quy đổi đơn vị.\r\n * Tách biệt hoàn toàn tầng GUI khỏi SanPhamDAO và LoHangDAO.\r\n */\r\npublic class KhoLoHangBus {\r\n\r\n    private final LoHangDAO loHangDAO;\r\n    private final SanPhamDAO sanPhamDAO;\r\n\r\n    public KhoLoHangBus() {\r\n        this.loHangDAO = new LoHangDAO();\r\n        this.sanPhamDAO = new SanPhamDAO();\r\n    }\r\n\r\n    /**\r\n     * Lấy toàn bộ danh sách sản phẩm trong hệ thống.\r\n     */\r\n    public List<SanPham> layDanhSachSanPham() {\r\n        try {\r\n            return sanPhamDAO.getAllSanPham();\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[KhoLoHangBus] Lỗi layDanhSachSanPham: \" + e.getMessage());\r\n            return Collections.emptyList();\r\n        }\r\n    }\r\n\r\n    public List<DanhMucHang> layDanhSachDanhMuc() {\r\n        try {\r\n            return sanPhamDAO.getAllDanhMuc();\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[KhoLoHangBus] Lỗi lấy danh mục: \" + e.getMessage());\r\n            return Collections.emptyList();\r\n        }\r\n    }\r\n\r\n    public List<DonViTinh> layDanhSachDonViTinh() {\r\n        try {\r\n            return sanPhamDAO.getAllDonViTinh();\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[KhoLoHangBus] Lỗi lấy đơn vị tính: \" + e.getMessage());\r\n            return Collections.emptyList();\r\n        }\r\n    }\r\n\r\n    public List<NhaCungCap> layDanhSachNhaCungCap() {\r\n        try {\r\n            return loHangDAO.getAllNhaCungCap();\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[KhoLoHangBus] Lỗi lấy nhà cung cấp: \" + e.getMessage());\r\n            return Collections.emptyList();\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Lấy danh sách quy đổi đơn vị theo mã sản phẩm.\r\n     */\r\n    public List<QuyDoiDonVi> layQuyDoiBySanPham(String maSP) {\r\n        try {\r\n            return sanPhamDAO.getQuyDoiBySanPham(maSP);\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[KhoLoHangBus] Lỗi layQuyDoiBySanPham: \" + e.getMessage());\r\n            return Collections.emptyList();\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Lấy sản phẩm theo mã.\r\n     */\r\n    public SanPham laySanPhamById(String maSP) {\r\n        try {\r\n            return sanPhamDAO.getSanPhamById(maSP);\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[KhoLoHangBus] Lỗi laySanPhamById: \" + e.getMessage());\r\n            return null;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Thêm sản phẩm mới kèm đơn vị quy đổi cơ sở.\r\n     */\r\n    public boolean themSanPham(SanPham sp) {\r\n        try {\r\n            return sanPhamDAO.insertSanPham(sp);\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[KhoLoHangBus] Lỗi themSanPham: \" + e.getMessage());\r\n            return false;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Thêm đơn vị tính mới vào CSDL.\r\n     */\r\n    public boolean themDonViTinh(entity.DonViTinh dvt) {\r\n        try {\r\n            return sanPhamDAO.insertDonViTinh(dvt);\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[KhoLoHangBus] Lỗi themDonViTinh: \" + e.getMessage());\r\n            return false;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Thêm đơn vị quy đổi mới cho sản phẩm.\r\n     */\r\n    public boolean themQuyDoi(QuyDoiDonVi qd) {\r\n        try {\r\n            return sanPhamDAO.insertQuyDoi(qd);\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[KhoLoHangBus] Lỗi themQuyDoi: \" + e.getMessage());\r\n            return false;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Xóa đơn vị quy đổi theo mã.\r\n     */\r\n    public boolean xoaQuyDoi(String maQuyDoi) {\r\n        try {\r\n            return sanPhamDAO.deleteQuyDoi(maQuyDoi);\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[KhoLoHangBus] Lỗi xoaQuyDoi: \" + e.getMessage());\r\n            return false;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Lấy toàn bộ danh sách lô hàng trong kho.\r\n     */\r\n    public List<LoHang> layDanhSachLoHang() {\r\n        try {\r\n            return loHangDAO.getAllLoHang();\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[KhoLoHangBus] Lỗi layDanhSachLoHang: \" + e.getMessage());\r\n            return Collections.emptyList();\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Trừ tồn kho lô hàng theo mã số lô (xuất kho bán lẻ FEFO).\r\n     */\r\n    public boolean truTonKho(String soLo, int soLuong) {\r\n        try {\r\n            return loHangDAO.truTonKho(soLo, soLuong);\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[KhoLoHangBus] Lỗi truTonKho: \" + e.getMessage());\r\n            return false;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Cộng trả tồn kho lô hàng theo mã số lô (đổi trả hoàn hàng vào kho).\r\n     */\r\n    public boolean congTonKho(String soLo, int soLuong) {\r\n        try {\r\n            return loHangDAO.congTonKho(soLo, soLuong);\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[KhoLoHangBus] Lỗi congTonKho: \" + e.getMessage());\r\n            return false;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Nhập lô hàng mới vào kho.\r\n     */\r\n    public boolean nhapLoHang(LoHang lh) {\r\n        try {\r\n            return loHangDAO.insertLoHang(lh);\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[KhoLoHangBus] Lỗi nhapLoHang: \" + e.getMessage());\r\n            return false;\r\n        }\r\n    }\r\n\r\n    public boolean nhapSanPhamVaLoHang(SanPham sp, QuyDoiDonVi qd, LoHang lo) {\r\n        try {\r\n            return new dao.NhapKhoDAO().nhapSanPhamVaLoHang(sp, qd, lo);\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[KhoLoHangBus] Transaction nhập kho thất bại: \" + e.getMessage());\r\n            return false;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Cập nhật số lượng tồn kho thực tế khi kiểm kê.\r\n     */\r\n    public boolean capNhatSoLuongTon(String soLo, int soLuongMoi) {\r\n        try {\r\n            return loHangDAO.capNhatSoLuongTon(soLo, soLuongMoi);\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[KhoLoHangBus] Lỗi capNhatSoLuongTon: \" + e.getMessage());\r\n            return false;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Lấy danh sách các lô hàng cảnh báo hạn dùng (hết hạn hoặc còn <= 60 ngày).\r\n     */\r\n    public List<LoHang> layDanhSachLoCanhBaoHanDung() {\r\n        List<LoHang> result = new ArrayList<>();\r\n        LocalDate today = LocalDate.now();\r\n        for (LoHang lh : layDanhSachLoHang()) {\r\n            if (lh.getHanSuDung() != null && lh.getSoLuongTon() > 0) {\r\n                long days = ChronoUnit.DAYS.between(today, lh.getHanSuDung());\r\n                if (days <= 60) {\r\n                    result.add(lh);\r\n                }\r\n            }\r\n        }\r\n        return result;\r\n    }\r\n\r\n    /**\r\n     * Đếm tổng số lượng lô hàng cảnh báo hạn sử dụng (hạn dùng <= 60 ngày).\r\n     */\r\n    public int demSoLoCanhBaoHanDung() {\r\n        return layDanhSachLoCanhBaoHanDung().size();\r\n    }\r\n}\r\n"},{"path":"src/utils/MaTuSinhHelper.java","sha256":"3d765ed6f706799a01304b4d7ef2cdd91924723597126d6bb395b61e0d30615a","content":"package utils;\r\n\r\nimport java.sql.Connection;\r\nimport java.sql.PreparedStatement;\r\nimport java.sql.ResultSet;\r\nimport java.time.LocalDate;\r\nimport java.time.format.DateTimeFormatter;\r\nimport java.util.Map;\r\nimport java.util.concurrent.ConcurrentHashMap;\r\n\r\n/**\r\n * Tiện ích khởi tạo mã tự sinh theo quy luật nghiệp vụ chuẩn cho hệ thống Mio Pet Shop.\r\n * Tất cả các mã đều tự động tăng dần từ CSDL, không cho phép chỉnh sửa thủ công:\r\n * - Mã Nhân Viên / Tài Khoản: NV{3 số tự tăng} (Ví dụ: NV001, NV002, ...)\r\n * - Mã Sản Phẩm: SP{3 số tự tăng} (Ví dụ: SP001, SP002, ...)\r\n * - Mã Dịch Vụ: DV{3 số tự tăng} (Ví dụ: DV001, DV002, ...)\r\n * - Mã Quy Đổi: QD{3 số tự tăng} (Ví dụ: QD001, QD002, ...)\r\n * - Mã Lô Hàng: LO-{yyMMdd}-{3 số tự tăng} (Ví dụ: LO-261107-001)\r\n * - Mã Giao Ca: GC{3 số tự tăng} (Ví dụ: GC001, GC002, ...)\r\n * - Mã Phân Công: PC{2 số tự tăng} (Ví dụ: PC01, PC02, ...)\r\n * - Mã Hóa Đơn: HD{yyMMdd}-{Mã NV 2 số}-{Số thứ tự 3 số} (Ví dụ: HD261107-01-001)\r\n * - Mã Chi Tiết HĐ: {Mã HĐ}_CT{seq} (Ví dụ: HD261107-01-001_CT1)\r\n * - Mã Phiếu Đổi Trả: DT{yyMMdd}-{Số thứ tự 3 số} (Ví dụ: DT261107-001)\r\n * - Mã Lịch Hẹn: LH{yyMMdd}-{Số thứ tự 3 số} (Ví dụ: LH261107-001)\r\n * - Mã Khách Hàng: KH{3 chữ số tự tăng} (Ví dụ: KH006)\r\n * - Mã Thú Cưng: TC{3 chữ số tự tăng} (Ví dụ: TC006)\r\n * - Mã Hồ Sơ Thú Cưng: HS{3 chữ số tự tăng} (Ví dụ: HS006)\r\n * - Mã Hồ Sơ Sức Khỏe: SK{3 chữ số tự tăng} (Ví dụ: SK006)\r\n * - Mã Đơn Vị Tính: DVT{2 chữ số tự tăng} (Ví dụ: DVT03)\r\n * - Mã Thẻ Spa Pass: PASS-{SĐT}-{Số thứ tự 2 số} (Ví dụ: PASS-0988111222-01)\r\n *\r\n * Tích hợp bộ đệm an toàn (ConcurrentHashMap) và log ngoại lệ minh bạch,\r\n * chống phát sinh mã trùng lặp (NV001, SP001,...) khi đường truyền CSDL bị gián đoạn.\r\n */\r\npublic final class MaTuSinhHelper {\r\n\r\n    private MaTuSinhHelper() {}\r\n\r\n    private static final DateTimeFormatter DATE_FMT = DateTimeFormatter.ofPattern(\"yyMMdd\");\r\n    private static final Map<String, Integer> MAX_CACHE = new ConcurrentHashMap<>();\r\n\r\n    private static synchronized int laySoThuTuTiepTheo(String keyPrefix, String tableName,\r\n                                                        String columnName, String codePrefix) {\r\n        int max = MAX_CACHE.getOrDefault(keyPrefix, 0);\r\n        String sql = \"SELECT MAX(TRY_CONVERT(INT, SUBSTRING(\" + columnName + \", ?, 20))) \"\r\n                + \"FROM \" + tableName + \" WHERE \" + columnName + \" LIKE ?\";\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setInt(1, codePrefix.length() + 1);\r\n            ps.setString(2, codePrefix + \"%\");\r\n            try (ResultSet rs = ps.executeQuery()) {\r\n                if (rs.next()) max = Math.max(max, rs.getInt(1));\r\n            }\r\n        } catch (Exception e) {\r\n            throw new IllegalStateException(\"Không thể sinh mã \" + keyPrefix + \" khi CSDL chưa sẵn sàng\", e);\r\n        }\r\n\r\n        int next = max + 1;\r\n        MAX_CACHE.put(keyPrefix, next);\r\n        return next;\r\n    }\r\n\r\n    private static synchronized int laySoThuTuTheoNgay(String fullPrefix, String tableName, String columnName) {\r\n        int max = MAX_CACHE.getOrDefault(fullPrefix, 0);\r\n        String sql = \"SELECT MAX(TRY_CONVERT(INT, SUBSTRING(\" + columnName + \", ?, 20))) \"\r\n                + \"FROM \" + tableName + \" WHERE \" + columnName + \" LIKE ?\";\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setInt(1, fullPrefix.length() + 1);\r\n            ps.setString(2, fullPrefix + \"%\");\r\n            try (ResultSet rs = ps.executeQuery()) {\r\n                if (rs.next()) max = Math.max(max, rs.getInt(1));\r\n            }\r\n        } catch (Exception e) {\r\n            throw new IllegalStateException(\"Không thể sinh mã \" + fullPrefix + \" khi CSDL chưa sẵn sàng\", e);\r\n        }\r\n\r\n        int next = max + 1;\r\n        MAX_CACHE.put(fullPrefix, next);\r\n        return next;\r\n    }\r\n\r\n    /**\r\n     * Sinh mã Nhân Viên & Tài Khoản tự tăng dạng NV001, NV002,...\r\n     */\r\n    public static synchronized String sinhMaNhanVien() {\r\n        return String.format(\"NV%03d\", laySoThuTuTiepTheo(\"NV\", \"NhanVien\", \"maNhanVien\", \"NV\"));\r\n    }\r\n\r\n    /**\r\n     * Sinh mã Sản Phẩm tự tăng dạng SP001, SP002,...\r\n     */\r\n    public static synchronized String sinhMaSanPham() {\r\n        return String.format(\"SP%03d\", laySoThuTuTiepTheo(\"SP\", \"SanPham\", \"maSanPham\", \"SP\"));\r\n    }\r\n\r\n    /**\r\n     * Sinh mã Dịch Vụ tự tăng dạng DV001, DV002,...\r\n     */\r\n    public static synchronized String sinhMaDichVu() {\r\n        return String.format(\"DV%03d\", laySoThuTuTiepTheo(\"DV\", \"DichVu\", \"maDichVu\", \"DV\"));\r\n    }\r\n\r\n    /**\r\n     * Sinh mã Quy Đổi Đơn Vị Tính tự tăng dạng QD001, QD002,...\r\n     */\r\n    public static synchronized String sinhMaQuyDoi() {\r\n        return String.format(\"QD%03d\", laySoThuTuTiepTheo(\"QD\", \"QuyDoiDonVi\", \"maQuyDoi\", \"QD\"));\r\n    }\r\n\r\n    /**\r\n     * Sinh số lô hàng tự tăng theo ngày dạng LO-yyMMdd-001,...\r\n     */\r\n    public static synchronized String sinhSoLo() {\r\n        return sinhSoLo(\"SP001\");\r\n    }\r\n\r\n    public static synchronized String sinhSoLo(String maSP) {\r\n        String today = LocalDate.now().format(DATE_FMT);\r\n        String prefix = \"LO-\" + today + \"-\";\r\n        return String.format(\"%s%03d\", prefix, laySoThuTuTheoNgay(prefix, \"LoHang\", \"soLo\"));\r\n    }\r\n\r\n    /**\r\n     * Sinh mã Bàn Giao Ca tự tăng dạng GC001, GC002,...\r\n     */\r\n    public static synchronized String sinhMaGiaoCa() {\r\n        return String.format(\"GC%03d\", laySoThuTuTiepTheo(\"GC\", \"BangGiaoCa\", \"maGiaoCa\", \"GC\"));\r\n    }\r\n\r\n    /**\r\n     * Sinh mã Phân Công Ca tự tăng dạng PC01, PC02,...\r\n     */\r\n    public static synchronized String sinhMaPhanCong() {\r\n        return String.format(\"PC%02d\", MAX_CACHE.merge(\"PC\", 1, Integer::sum));\r\n    }\r\n\r\n    /**\r\n     * Sinh mã Hóa Đơn theo quy luật: HD + yyMMdd + \"-\" + MãNV(2 số) + \"-\" + STT(3 số)\r\n     */\r\n    public static synchronized String sinhMaHoaDon(String maNhanVien) {\r\n        String today = LocalDate.now().format(DATE_FMT);\r\n        String nvPart = \"00\";\r\n        if (maNhanVien != null && !maNhanVien.trim().isEmpty()) {\r\n            String digits = maNhanVien.replaceAll(\"[^0-9]\", \"\");\r\n            if (digits.length() >= 2) {\r\n                nvPart = digits.substring(digits.length() - 2);\r\n            } else if (digits.length() == 1) {\r\n                nvPart = \"0\" + digits;\r\n            }\r\n        }\r\n        String prefix = \"HD\" + today + \"-\" + nvPart + \"-\";\r\n        return String.format(\"%s%03d\", prefix, laySoThuTuTheoNgay(prefix, \"HoaDon\", \"maHoaDon\"));\r\n    }\r\n\r\n    /**\r\n     * Sinh mã Phiếu Đổi Trả theo quy luật: DT + yyMMdd + \"-\" + STT(3 số)\r\n     */\r\n    public static synchronized String sinhMaPhieuDoiTra() {\r\n        String today = LocalDate.now().format(DATE_FMT);\r\n        String prefix = \"DT\" + today + \"-\";\r\n        return String.format(\"%s%03d\", prefix, laySoThuTuTheoNgay(prefix, \"PhieuDoiTra\", \"maPhieuDoiTra\"));\r\n    }\r\n\r\n    /**\r\n     * Sinh mã Lịch Hẹn theo quy luật: LH + yyMMdd + \"-\" + STT(3 số)\r\n     */\r\n    public static synchronized String sinhMaLichHen() {\r\n        String today = LocalDate.now().format(DATE_FMT);\r\n        String prefix = \"LH\" + today + \"-\";\r\n        return String.format(\"%s%03d\", prefix, laySoThuTuTheoNgay(prefix, \"LichHen\", \"maLichHen\"));\r\n    }\r\n\r\n    /**\r\n     * Sinh mã Khách Hàng mới theo quy luật tự tăng: KH + 3 chữ số (ví dụ KH006)\r\n     */\r\n    public static synchronized String sinhMaKhachHang() {\r\n        return String.format(\"KH%03d\", laySoThuTuTiepTheo(\"KH\", \"KhachHang\", \"maKhachHang\", \"KH\"));\r\n    }\r\n\r\n    /**\r\n     * Sinh mã Thú Cưng mới theo quy luật tự tăng: TC + 3 chữ số (ví dụ TC006)\r\n     */\r\n    public static synchronized String sinhMaThuCung() {\r\n        return String.format(\"TC%03d\", laySoThuTuTiepTheo(\"TC\", \"ThuCung\", \"maThuCung\", \"TC\"));\r\n    }\r\n\r\n    /**\r\n     * Sinh mã Hồ Sơ Thú Cưng tự tăng dạng HS001, HS002,...\r\n     */\r\n    public static synchronized String sinhMaHoSo() {\r\n        return String.format(\"HS%03d\", laySoThuTuTiepTheo(\"HS\", \"HoSoThuCung\", \"maHoSo\", \"HS\"));\r\n    }\r\n\r\n    /**\r\n     * Sinh mã Hồ Sơ Sức Khỏe tự tăng dạng SK001, SK002,...\r\n     */\r\n    public static synchronized String sinhMaSucKhoe() {\r\n        return String.format(\"SK%03d\", laySoThuTuTiepTheo(\"SK\", \"HoSoSucKhoe\", \"maSucKhoe\", \"SK\"));\r\n    }\r\n\r\n    /**\r\n     * Sinh mã Đơn Vị Tính tự tăng dạng DVT01, DVT02,...\r\n     */\r\n    public static synchronized String sinhMaDonViTinh() {\r\n        return String.format(\"DVT%02d\", laySoThuTuTiepTheo(\"DVT\", \"DonViTinh\", \"maDonVi\", \"DVT\"));\r\n    }\r\n\r\n    /**\r\n     * Sinh mã Thẻ Spa Pass: PASS-{SĐT}-{2 số thứ tự thẻ của khách}\r\n     */\r\n    public static synchronized String sinhMaTheSpaPass(String sdt) {\r\n        if (sdt == null || sdt.trim().isEmpty()) {\r\n            throw new IllegalArgumentException(\"Số điện thoại khách hàng là bắt buộc để sinh mã Spa Pass\");\r\n        }\r\n        String cleanSdt = sdt.trim();\r\n        String key = \"PASS_\" + cleanSdt;\r\n        int seq = MAX_CACHE.getOrDefault(key, 0);\r\n        String sql = \"SELECT COUNT(*) FROM TheSpaPass WHERE sdtKhachHang = ?\";\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setString(1, cleanSdt);\r\n            try (ResultSet rs = ps.executeQuery()) {\r\n                if (rs.next()) {\r\n                    seq = Math.max(seq, rs.getInt(1));\r\n                }\r\n            }\r\n        } catch (Exception e) {\r\n            System.err.println(\"[MaTuSinhHelper] Cảnh báo đọc mã Thẻ Spa Pass CSDL: \" + e.getMessage());\r\n        }\r\n        seq++;\r\n        MAX_CACHE.put(key, seq);\r\n        return String.format(\"PASS-%s-%02d\", cleanSdt, seq);\r\n    }\r\n}\r\n"},{"path":"src/dao/KhachHangDAO.java","sha256":"9594a90538f33e85b2544d84535c058e2e50005c67e730d7870933a03fb4a6dc","content":"package dao;\r\n\r\nimport entity.KhachHang;\r\nimport utils.DBConnection;\r\n\r\nimport java.sql.Connection;\r\nimport java.sql.PreparedStatement;\r\nimport java.sql.ResultSet;\r\nimport java.sql.SQLException;\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\n// DAO thao tác với bảng KhachHang trong SQL Server\r\n// đã bổ sung đọc thêm 2 cột email và diaChi để gửi thông báo lịch hẹn với pet hotel\r\npublic class KhachHangDAO {\r\n\r\n    // hàm phụ trợ để lấy chuỗi an toàn, lỡ database máy nào chưa chạy alter table thêm cột email\r\n    // thì nó không bị văng exception sập ứng dụng\r\n    private String layGiaTriAnToan(ResultSet rs, String colName) {\r\n        try {\r\n            String val = rs.getString(colName);\r\n            return val != null ? val : \"\";\r\n        } catch (Exception e) {\r\n            return \"\";\r\n        }\r\n    }\r\n\r\n    // Lấy toàn bộ danh sách khách hàng sắp xếp theo tên\r\n    public List<KhachHang> getAllKhachHang() throws SQLException {\r\n        List<KhachHang> list = new ArrayList<>();\r\n        String sql = \"SELECT * FROM KhachHang ORDER BY hoTen ASC\";\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql);\r\n             ResultSet rs = ps.executeQuery()) {\r\n            while (rs.next()) {\r\n                list.add(new KhachHang(\r\n                        rs.getString(\"maKhachHang\"),\r\n                        rs.getString(\"hoTen\"),\r\n                        rs.getString(\"soDienThoai\"),\r\n                        rs.getInt(\"diemTichLuy\"),\r\n                        layGiaTriAnToan(rs, \"email\"),\r\n                        layGiaTriAnToan(rs, \"diaChi\")\r\n                ));\r\n            }\r\n        }\r\n        return list;\r\n    }\r\n\r\n    // Tìm khách hàng bằng số điện thoại - cái này quầy POS hay gọi nhất để tích điểm\r\n    public KhachHang findBySoDienThoai(String soDienThoai) throws SQLException {\r\n        String sql = \"SELECT * FROM KhachHang WHERE soDienThoai = ?\";\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setString(1, soDienThoai);\r\n            try (ResultSet rs = ps.executeQuery()) {\r\n                if (rs.next()) {\r\n                    return new KhachHang(\r\n                            rs.getString(\"maKhachHang\"),\r\n                            rs.getString(\"hoTen\"),\r\n                            rs.getString(\"soDienThoai\"),\r\n                            rs.getInt(\"diemTichLuy\"),\r\n                            layGiaTriAnToan(rs, \"email\"),\r\n                            layGiaTriAnToan(rs, \"diaChi\")\r\n                    );\r\n                }\r\n            }\r\n        }\r\n        return null;\r\n    }\r\n\r\n    // Tìm khách hàng theo mã định danh KH001, KH002...\r\n    public KhachHang findByMaKhachHang(String maKhachHang) throws SQLException {\r\n        String sql = \"SELECT * FROM KhachHang WHERE maKhachHang = ?\";\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setString(1, maKhachHang);\r\n            try (ResultSet rs = ps.executeQuery()) {\r\n                if (rs.next()) {\r\n                    return new KhachHang(\r\n                            rs.getString(\"maKhachHang\"),\r\n                            rs.getString(\"hoTen\"),\r\n                            rs.getString(\"soDienThoai\"),\r\n                            rs.getInt(\"diemTichLuy\"),\r\n                            layGiaTriAnToan(rs, \"email\"),\r\n                            layGiaTriAnToan(rs, \"diaChi\")\r\n                    );\r\n                }\r\n            }\r\n        }\r\n        return null;\r\n    }\r\n\r\n    // Thêm khách hàng mới: ưu tiên insert kèm cả email và địa chỉ nếu db đã có cột\r\n    public boolean insert(KhachHang kh) throws SQLException {\r\n        String sqlCoEmail = \"INSERT INTO KhachHang (maKhachHang, hoTen, soDienThoai, diemTichLuy, email, diaChi) VALUES (?, ?, ?, ?, ?, ?)\";\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sqlCoEmail)) {\r\n            ps.setString(1, kh.getMaKhachHang());\r\n            ps.setString(2, kh.getHoTen());\r\n            ps.setString(3, kh.getSoDienThoai());\r\n            ps.setInt(4, kh.getDiemTichLuy());\r\n            ps.setString(5, kh.getEmail());\r\n            ps.setString(6, kh.getDiaChi());\r\n            return ps.executeUpdate() > 0;\r\n        } catch (SQLException e) {\r\n            // nếu lỗi do chưa có cột email hoặc diaChi thì fallback về câu lệnh insert cũ\r\n            String sqlCu = \"INSERT INTO KhachHang (maKhachHang, hoTen, soDienThoai, diemTichLuy) VALUES (?, ?, ?, ?)\";\r\n            try (Connection conn = DBConnection.getConnection();\r\n                 PreparedStatement psCu = conn.prepareStatement(sqlCu)) {\r\n                psCu.setString(1, kh.getMaKhachHang());\r\n                psCu.setString(2, kh.getHoTen());\r\n                psCu.setString(3, kh.getSoDienThoai());\r\n                psCu.setInt(4, kh.getDiemTichLuy());\r\n                return psCu.executeUpdate() > 0;\r\n            }\r\n        }\r\n    }\r\n\r\n    // Cập nhật thông tin khách hàng, có cập nhật cả email và địa chỉ mới\r\n    public boolean update(KhachHang kh) throws SQLException {\r\n        String sqlCoEmail = \"UPDATE KhachHang SET hoTen = ?, soDienThoai = ?, diemTichLuy = ?, email = ?, diaChi = ? WHERE maKhachHang = ?\";\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sqlCoEmail)) {\r\n            ps.setString(1, kh.getHoTen());\r\n            ps.setString(2, kh.getSoDienThoai());\r\n            ps.setInt(3, kh.getDiemTichLuy());\r\n            ps.setString(4, kh.getEmail());\r\n            ps.setString(5, kh.getDiaChi());\r\n            ps.setString(6, kh.getMaKhachHang());\r\n            return ps.executeUpdate() > 0;\r\n        } catch (SQLException e) {\r\n            // fallback nếu csdl máy bạn khác chưa kịp alter table\r\n            String sqlCu = \"UPDATE KhachHang SET hoTen = ?, soDienThoai = ?, diemTichLuy = ? WHERE maKhachHang = ?\";\r\n            try (Connection conn = DBConnection.getConnection();\r\n                 PreparedStatement psCu = conn.prepareStatement(sqlCu)) {\r\n                psCu.setString(1, kh.getHoTen());\r\n                psCu.setString(2, kh.getSoDienThoai());\r\n                psCu.setInt(3, kh.getDiemTichLuy());\r\n                psCu.setString(4, kh.getMaKhachHang());\r\n                return psCu.executeUpdate() > 0;\r\n            }\r\n        }\r\n    }\r\n\r\n    // Xóa khách hàng theo mã\r\n    public boolean delete(String maKhachHang) throws SQLException {\r\n        String sql = \"DELETE FROM KhachHang WHERE maKhachHang = ?\";\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setString(1, maKhachHang);\r\n            return ps.executeUpdate() > 0;\r\n        }\r\n    }\r\n\r\n    // Cộng hoặc trừ điểm tích lũy của khách hàng khi thanh toán hóa đơn\r\n    public boolean capNhatDiemTichLuy(String maKhachHang, int diemThayDoi) throws SQLException {\r\n        String sql = \"UPDATE KhachHang SET diemTichLuy = diemTichLuy + ? WHERE maKhachHang = ?\";\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setInt(1, diemThayDoi);\r\n            ps.setString(2, maKhachHang);\r\n            return ps.executeUpdate() > 0;\r\n        }\r\n    }\r\n}\r\n"},{"path":"src/bus/BanHangBus.java","sha256":"cbf8f64df574998c0c32b2d96e4f673d7fd1d87745fddf71385a298d9e10b1da","content":"package bus;\r\n\r\nimport dao.HoaDonDAO;\r\nimport dao.KhachHangDAO;\r\nimport dao.LoHangDAO;\r\nimport entity.*;\r\n\r\nimport java.math.BigDecimal;\r\nimport java.sql.SQLException;\r\nimport java.time.LocalDateTime;\r\nimport java.util.ArrayList;\r\nimport java.util.Collections;\r\nimport java.util.List;\r\n\r\n// controller xử lý bán hàng và khách hàng\r\npublic class BanHangBus {\r\n\r\n    // list tạm lưu khách trên ram để tìm cho nhanh đỡ lag\r\n    private static final List<KhachHang> DANH_SACH_KHACH_HANG = new ArrayList<>();\r\n    private static final KhachHangDAO STATIC_KH_DAO = new KhachHangDAO();\r\n\r\n    // kéo danh sách khách từ db lên\r\n    public static synchronized void dongBoKhachHangTuDatabase() {\r\n        try {\r\n            List<KhachHang> dbList = STATIC_KH_DAO.getAllKhachHang();\r\n            if (dbList != null) {\r\n                DANH_SACH_KHACH_HANG.clear();\r\n                DANH_SACH_KHACH_HANG.addAll(dbList);\r\n            }\r\n        } catch (SQLException e) {\r\n            System.err.println(\"Lỗi đọc khách hàng: \" + e.getMessage());\r\n        }\r\n    }\r\n\r\n    private final HoaDonDAO hoaDonDAO;\r\n    private final LoHangDAO loHangDAO;\r\n    private final KhachHangDAO khachHangDAO;\r\n    private HoaDon hoaDonHienTai;\r\n\r\n    public BanHangBus() {\r\n        this.hoaDonDAO = new HoaDonDAO();\r\n        this.loHangDAO = new LoHangDAO();\r\n        this.khachHangDAO = new KhachHangDAO();\r\n        // Mặc định khởi tạo ngay một phiên hóa đơn trắng khi mở màn hình POS\r\n        khoiTaoHoaDonMoi(null, null);\r\n    }\r\n\r\n    /**\r\n     * Khởi tạo một phiên hóa đơn mới tại quầy\r\n     */\r\n    // Khởi tạo phiên hóa đơn mới tại quầy: gán mã chuẩn, thời gian tạo và nhân viên thu ngân trực ca\r\n    public void khoiTaoHoaDonMoi(String maHoaDon, NhanVien nhanVien) {\r\n        NhanVien nhanVienLap = nhanVien != null ? nhanVien : utils.UserSession.getCurrentUser();\r\n        if (nhanVienLap == null || nhanVienLap.getMaNhanVien() == null) {\r\n            throw new IllegalStateException(\"Phải đăng nhập trước khi mở phiên bán hàng\");\r\n        }\r\n        // chưa có mã thì tự sinh mã theo ngày\r\n        if (maHoaDon == null || maHoaDon.trim().isEmpty()) {\r\n            maHoaDon = utils.MaTuSinhHelper.sinhMaHoaDon(nhanVienLap.getMaNhanVien());\r\n        }\r\n        // khởi tạo hóa đơn mới\r\n        this.hoaDonHienTai = new HoaDon(\r\n                maHoaDon,\r\n                null,\r\n                nhanVienLap,\r\n                LocalDateTime.now(),\r\n                BigDecimal.ZERO,\r\n                \"Tiền mặt\",\r\n                \"Chờ thanh toán\"\r\n        );\r\n    }\r\n\r\n    public HoaDon getHoaDonHienTai() {\r\n        return hoaDonHienTai;\r\n    }\r\n\r\n    /**\r\n     * DTO đại diện cho một mặt hàng hoặc dịch vụ trên danh mục POS.\r\n     */\r\n    public static class CatalogItem {\r\n        public String ma;\r\n        public String ten;\r\n        public String moTa;\r\n        public long gia;\r\n        public String dvt;\r\n        public int tyLe;\r\n        public int tonCoSo;\r\n        public int tonTheoQuyCach;\r\n        public String tenHienThi;\r\n        public boolean laDichVu;\r\n        public int thoiLuongPhut;\r\n        public String maVach;\r\n\r\n        public CatalogItem() {}\r\n    }\r\n\r\n    /**\r\n     * Lấy toàn bộ danh mục sản phẩm (kèm tỷ lệ quy đổi và tồn kho) cùng các dịch vụ Spa cho POS.\r\n     * Tuân thủ kiến trúc N-Tier: Gọi qua SanPhamDAO và DichVuDAO, không truy vấn SQL trực tiếp tại tầng BUS.\r\n     */\r\n    public List<CatalogItem> layDanhSachMatHangCatalog() {\r\n        List<CatalogItem> result = new ArrayList<>();\r\n        try {\r\n            dao.SanPhamDAO spDao = new dao.SanPhamDAO();\r\n            for (Object[] row : spDao.layDanhSachSanPhamCatalogPOS()) {\r\n                CatalogItem item = new CatalogItem();\r\n                item.ma = (String) row[0];\r\n                item.ten = (String) row[1];\r\n                item.moTa = (String) row[2];\r\n                item.maVach = (String) row[3];\r\n                item.gia = (Long) row[5];\r\n                item.dvt = (String) row[6];\r\n                item.tyLe = (Integer) row[7];\r\n                item.tonCoSo = (Integer) row[8];\r\n                item.tonTheoQuyCach = item.tyLe > 0 ? (item.tonCoSo / item.tyLe) : item.tonCoSo;\r\n                item.tenHienThi = item.tyLe > 1 ? (item.ten + \" (\" + item.dvt + \")\") : item.ten;\r\n                item.laDichVu = false;\r\n                result.add(item);\r\n            }\r\n\r\n            dao.DichVuDAO dvDao = new dao.DichVuDAO();\r\n            for (DichVu dv : dvDao.getAllDichVu()) {\r\n                CatalogItem item = new CatalogItem();\r\n                item.ma = dv.getMaDichVu();\r\n                item.ten = dv.getTenDichVu();\r\n                item.moTa = \"Dịch vụ Grooming / Spa / Khách sạn thú cưng\";\r\n                item.gia = dv.getGiaDichVu() != null ? dv.getGiaDichVu().longValue() : 0L;\r\n                item.dvt = \"Lượt\";\r\n                item.tyLe = 1;\r\n                item.tonCoSo = 999;\r\n                item.tonTheoQuyCach = 999;\r\n                item.tenHienThi = item.ten;\r\n                item.laDichVu = true;\r\n                item.thoiLuongPhut = dv.getThoiLuongPhut();\r\n                result.add(item);\r\n            }\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[BanHangBus] Lỗi đọc danh mục hàng hóa POS: \" + e.getMessage());\r\n        }\r\n        return result;\r\n    }\r\n\r\n    /**\r\n     * Lấy toàn bộ danh sách hóa đơn từ CSDL.\r\n     */\r\n    public List<HoaDon> layTatCaHoaDon() {\r\n        try {\r\n            return hoaDonDAO.getAllHoaDon();\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[BanHangBus] Lỗi layTatCaHoaDon: \" + e.getMessage());\r\n            return Collections.emptyList();\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Thực hiện thanh toán và lưu hóa đơn POS cùng chi tiết xuất lô, trừ kho FEFO.\r\n     */\r\n    public boolean luuHoaDonPOS(HoaDon hd) {\r\n        try {\r\n            return hoaDonDAO.thanhToanHoaDon(hd);\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[BanHangBus] Lỗi luuHoaDonPOS: \" + e.getMessage());\r\n            return false;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Lưu phiếu đổi trả liên kết với đơn POS.\r\n     */\r\n    public boolean luuPhieuDoiTra(PhieuDoiTra pdt) {\r\n        try {\r\n            return hoaDonDAO.luuPhieuDoiTra(pdt);\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[BanHangBus] Lỗi luuPhieuDoiTra: \" + e.getMessage());\r\n            return false;\r\n        }\r\n    }\r\n\r\n    /** Lưu phiếu đổi hàng và hóa đơn mới trong cùng một transaction CSDL. */\r\n    public boolean luuHoaDonKemDoiTra(HoaDon hd, PhieuDoiTra pdt) {\r\n        try {\r\n            return hoaDonDAO.thanhToanHoaDonKemDoiTra(hd, pdt);\r\n        } catch (SQLException | RuntimeException e) {\r\n            System.err.println(\"[BanHangBus] Lỗi luuHoaDonKemDoiTra: \" + e.getMessage());\r\n            return false;\r\n        }\r\n    }\r\n\r\n    public boolean luuGiaoDichPosDayDu(HoaDon hd, PhieuDoiTra pdt,\r\n                                      String maTheSuDung, entity.TheSpaPass theMoi,\r\n                                      List<String> dsMaPhongHotel, int diemSuDung,\r\n                                      int diemThuHoiDoTraHang) {\r\n        try {\r\n            return hoaDonDAO.thanhToanHoaDonDayDu(\r\n                    hd, pdt, maTheSuDung, theMoi, dsMaPhongHotel,\r\n                    diemSuDung, diemThuHoiDoTraHang);\r\n        } catch (SQLException | RuntimeException e) {\r\n            System.err.println(\"[BanHangBus] Lỗi luuGiaoDichPosDayDu: \" + e.getMessage());\r\n            return false;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Lấy danh sách lô hàng FEFO cho một sản phẩm.\r\n     */\r\n    public List<LoHang> layDanhSachLoHangFEFO(String maSP) {\r\n        try {\r\n            return loHangDAO.getAvailableLotsFEFO(maSP);\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[BanHangBus] Lỗi layDanhSachLoHangFEFO: \" + e.getMessage());\r\n            return Collections.emptyList();\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Lấy toàn bộ danh sách lô hàng trong hệ thống.\r\n     */\r\n    public List<LoHang> layTatCaLoHang() {\r\n        try {\r\n            return loHangDAO.getAllLoHang();\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[BanHangBus] Lỗi layTatCaLoHang: \" + e.getMessage());\r\n            return Collections.emptyList();\r\n        }\r\n    }\r\n\r\n\r\n    /**\r\n     * Tra cứu khách hàng thành viên theo số điện thoại, mã KH hoặc tên trực tiếp từ CSDL\r\n     */\r\n    // Tra cứu nhanh khách hàng khi thu ngân nhập thông tin vào ô tìm kiếm trên quầy POS\r\n    public KhachHang timKhachHang(String tuKhoa) {\r\n        if (tuKhoa == null || tuKhoa.trim().isEmpty()) {\r\n            return null;\r\n        }\r\n        // Luôn đảm bảo nạp dữ liệu khách hàng mới nhất\r\n        dongBoKhachHangTuDatabase();\r\n        String kw = tuKhoa.trim();\r\n        String kwLower = kw.toLowerCase();\r\n\r\n        // tìm theo sdt hoặc mã trước\r\n        for (KhachHang kh : DANH_SACH_KHACH_HANG) {\r\n            if (kh.getSoDienThoai().equals(kw) || kh.getMaKhachHang().equalsIgnoreCase(kw)) {\r\n                if (this.hoaDonHienTai != null) {\r\n                    this.hoaDonHienTai.setKhachHang(kh);\r\n                }\r\n                return kh;\r\n            }\r\n        }\r\n\r\n        // gõ trên 3 ký tự thì tìm mờ theo tên\r\n        if (kw.length() >= 3) {\r\n            for (KhachHang kh : DANH_SACH_KHACH_HANG) {\r\n                if (kh.getSoDienThoai().contains(kw) || kh.getHoTen().toLowerCase().contains(kwLower)) {\r\n                    if (this.hoaDonHienTai != null) {\r\n                        this.hoaDonHienTai.setKhachHang(kh);\r\n                    }\r\n                    return kh;\r\n                }\r\n            }\r\n        }\r\n        return null;\r\n    }\r\n\r\n    // Lọc danh sách khách hàng gợi ý (Autocomplete) theo từ khóa SĐT, Họ tên hoặc Mã KH\r\n    public static List<KhachHang> timKiemGoiYKhachHang(String tuKhoa) {\r\n        // Đảm bảo dữ liệu bộ nhớ đệm đã được tải\r\n        if (DANH_SACH_KHACH_HANG.isEmpty()) {\r\n            dongBoKhachHangTuDatabase();\r\n        }\r\n        List<KhachHang> kq = new ArrayList<>();\r\n        if (tuKhoa == null || tuKhoa.trim().isEmpty()) {\r\n            kq.addAll(DANH_SACH_KHACH_HANG);\r\n            return kq;\r\n        }\r\n        String kw = tuKhoa.trim().toLowerCase();\r\n        // Quét nhanh qua danh sách tạm trên RAM để không làm đơ giao diện Swing\r\n        for (KhachHang kh : DANH_SACH_KHACH_HANG) {\r\n            if (kh.getSoDienThoai().toLowerCase().contains(kw)\r\n                    || kh.getHoTen().toLowerCase().contains(kw)\r\n                    || kh.getMaKhachHang().toLowerCase().contains(kw)) {\r\n                kq.add(kh);\r\n            }\r\n        }\r\n        return kq;\r\n    }\r\n\r\n    // Lưu mới hoặc cập nhật thông tin khách hàng và điểm tích lũy xuống SQL Server\r\n    public static KhachHang luuHoacCapNhatKhachHang(String soDienThoai, String hoTen, int diemMoi) {\r\n        if (soDienThoai == null || soDienThoai.trim().isEmpty()) {\r\n            return null;\r\n        }\r\n        dongBoKhachHangTuDatabase();\r\n        String sdt = soDienThoai.trim();\r\n        // Cắt chuỗi an toàn nếu quá 15 ký tự để tránh lỗi tràn cột CSDL (Data Truncation)\r\n        if (sdt.length() > 15) {\r\n            sdt = sdt.substring(0, 15);\r\n        }\r\n\r\n        // Trường hợp 1: Nếu khách đã tồn tại trong hệ thống -> Cập nhật tên và điểm tích lũy\r\n        for (KhachHang kh : DANH_SACH_KHACH_HANG) {\r\n            if (kh.getSoDienThoai().equalsIgnoreCase(sdt)) {\r\n                if (hoTen != null && !hoTen.trim().isEmpty() && !hoTen.trim().equalsIgnoreCase(\"Khách vãng lai\")) {\r\n                    kh.setHoTen(hoTen.trim());\r\n                }\r\n                // Đảm bảo điểm tích lũy không bao giờ bị âm\r\n                kh.setDiemTichLuy(Math.max(0, diemMoi));\r\n                try {\r\n                    STATIC_KH_DAO.update(kh);\r\n                    return kh;\r\n                } catch (SQLException e) {\r\n                    System.err.println(\"[BanHangBus] Lỗi update KhachHang CSDL: \" + e.getMessage());\r\n                    return null;\r\n                }\r\n            }\r\n        }\r\n\r\n        // Trường hợp 2: Khách hàng mới toanh -> Tự động sinh mã KH mới và thêm vào CSDL\r\n        String tenMoi = (hoTen == null || hoTen.trim().isEmpty() || hoTen.trim().equalsIgnoreCase(\"Khách vãng lai\"))\r\n                ? \"Khách hàng mới\"\r\n                : hoTen.trim();\r\n        String maMoi = sinhMaKhachHangMoi();\r\n        KhachHang khMoi = new KhachHang(maMoi, tenMoi, sdt, Math.max(0, diemMoi));\r\n        try {\r\n            STATIC_KH_DAO.insert(khMoi);\r\n            DANH_SACH_KHACH_HANG.add(khMoi);\r\n            return khMoi;\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[BanHangBus] Lỗi insert KhachHang CSDL: \" + e.getMessage());\r\n            return null;\r\n        }\r\n    }\r\n\r\n    // Gọi MaTuSinhHelper để sinh mã khách hàng tự tăng dạng KH0001 dựa trên mã lớn nhất trong CSDL\r\n    public static String sinhMaKhachHangMoi() {\r\n        return utils.MaTuSinhHelper.sinhMaKhachHang();\r\n    }\r\n\r\n    // Cập nhật thông tin chi tiết khách hàng: chuẩn hóa dữ liệu đầu vào và lưu xuống CSDL\r\n    public static boolean capNhatThongTinKhachHang(String maKH, String hoTenMoi, String sdtMoi, int diemMoi) {\r\n        return capNhatThongTinKhachHang(maKH, hoTenMoi, sdtMoi, diemMoi, \"\", \"\");\r\n    }\r\n\r\n    // overload cập nhật thông tin khách hàng có cả email và địa chỉ để gửi mail thông báo\r\n    public static boolean capNhatThongTinKhachHang(String maKH, String hoTenMoi, String sdtMoi, int diemMoi, String emailMoi, String diaChiMoi) {\r\n        dongBoKhachHangTuDatabase();\r\n        for (KhachHang kh : DANH_SACH_KHACH_HANG) {\r\n            if (kh.getMaKhachHang().equalsIgnoreCase(maKH)) {\r\n                kh.setHoTen(hoTenMoi.trim());\r\n                kh.setSoDienThoai(sdtMoi.trim());\r\n                kh.setDiemTichLuy(Math.max(0, diemMoi));\r\n                kh.setEmail(emailMoi != null ? emailMoi.trim() : \"\");\r\n                kh.setDiaChi(diaChiMoi != null ? diaChiMoi.trim() : \"\");\r\n                try {\r\n                    STATIC_KH_DAO.update(kh);\r\n                    return true;\r\n                } catch (SQLException e) {\r\n                    System.err.println(\"[BanHangBus] Lỗi capNhatThongTinKhachHang CSDL: \" + e.getMessage());\r\n                    return false;\r\n                }\r\n            }\r\n        }\r\n        return false;\r\n    }\r\n\r\n    // thêm khách hàng mới hoặc cập nhật kèm cả email và địa chỉ nhà\r\n    public static KhachHang luuHoacCapNhatKhachHang(String soDienThoai, String hoTen, int diemMoi, String email, String diaChi) {\r\n        if (soDienThoai == null || soDienThoai.trim().isEmpty()) {\r\n            return null;\r\n        }\r\n        dongBoKhachHangTuDatabase();\r\n        String sdt = soDienThoai.trim();\r\n        if (sdt.length() > 15) {\r\n            sdt = sdt.substring(0, 15);\r\n        }\r\n\r\n        for (KhachHang kh : DANH_SACH_KHACH_HANG) {\r\n            if (kh.getSoDienThoai().equalsIgnoreCase(sdt)) {\r\n                if (hoTen != null && !hoTen.trim().isEmpty() && !hoTen.trim().equalsIgnoreCase(\"Khách vãng lai\")) {\r\n                    kh.setHoTen(hoTen.trim());\r\n                }\r\n                kh.setDiemTichLuy(Math.max(0, diemMoi));\r\n                if (email != null && !email.trim().isEmpty()) kh.setEmail(email.trim());\r\n                if (diaChi != null && !diaChi.trim().isEmpty()) kh.setDiaChi(diaChi.trim());\r\n                try {\r\n                    STATIC_KH_DAO.update(kh);\r\n                    return kh;\r\n                } catch (SQLException e) {\r\n                    System.err.println(\"[BanHangBus] Lỗi update KhachHang CSDL: \" + e.getMessage());\r\n                    return null;\r\n                }\r\n            }\r\n        }\r\n\r\n        String tenMoi = (hoTen == null || hoTen.trim().isEmpty() || hoTen.trim().equalsIgnoreCase(\"Khách vãng lai\"))\r\n                ? \"Khách hàng mới\"\r\n                : hoTen.trim();\r\n        String maMoi = sinhMaKhachHangMoi();\r\n        KhachHang khMoi = new KhachHang(maMoi, tenMoi, sdt, Math.max(0, diemMoi), email, diaChi);\r\n        try {\r\n            STATIC_KH_DAO.insert(khMoi);\r\n            DANH_SACH_KHACH_HANG.add(khMoi);\r\n            return khMoi;\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[BanHangBus] Lỗi insert KhachHang CSDL: \" + e.getMessage());\r\n            return null;\r\n        }\r\n    }\r\n\r\n    // Xóa khách hàng khỏi CSDL và loại bỏ luôn khỏi danh sách tạm trên RAM để tránh sai lệch dữ liệu\r\n    public static boolean xoaKhachHang(String maKH) {\r\n        try {\r\n            STATIC_KH_DAO.delete(maKH);\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[BanHangBus] Lỗi xoaKhachHang CSDL: \" + e.getMessage());\r\n            return false;\r\n        }\r\n        return DANH_SACH_KHACH_HANG.removeIf(kh -> kh.getMaKhachHang().equalsIgnoreCase(maKH));\r\n    }\r\n\r\n    // Xếp hạng thành viên tự động dựa trên tổng điểm tích lũy\r\n    public static String xepHangThanhVien(int diem) {\r\n        if (diem >= 100) return \"VIP Kim Cương\";\r\n        if (diem >= 50) return \"Hạng Vàng\";\r\n        if (diem >= 20) return \"Hạng Bạc\";\r\n        return \"Thành viên Mới\";\r\n    }\r\n\r\n    // Lấy toàn bộ danh sách khách hàng đang có để đổ lên bảng hiển thị trên giao diện\r\n    public static List<KhachHang> getDanhSachKhachHang() {\r\n        dongBoKhachHangTuDatabase();\r\n        return DANH_SACH_KHACH_HANG;\r\n    }\r\n\r\n    /**\r\n     * Thêm sản phẩm vào giỏ hàng: Tự động tìm Lô hàng có hạn sử dụng gần nhất (FEFO)\r\n     */\r\n    // Xuất kho theo chiến lược FEFO (First Expired, First Out): kiểm tra tồn kho và ưu tiên lô có hạn dùng gần nhất\r\n    public boolean themSanPhamXuatLo(SanPham sp, QuyDoiDonVi qd, int soLuong) throws Exception {\r\n        // kiểm tra dữ liệu truyền vào\r\n        if (sp == null || qd == null || soLuong <= 0) {\r\n            throw new IllegalArgumentException(\"Thông tin sản phẩm hoặc số lượng không hợp lệ!\");\r\n        }\r\n\r\n        // đổi ra số lượng cơ sở\r\n        int soLuongCoSoCanXuat = soLuong * qd.getTyLeQuyDoi();\r\n\r\n        // lấy mấy lô còn hạn theo thứ tự fefo\r\n        List<LoHang> dsLoHang = loHangDAO.getAvailableLotsFEFO(sp.getMaSanPham());\r\n        if (dsLoHang.isEmpty()) {\r\n            throw new IllegalStateException(\"Sản phẩm [\" + sp.getTenSanPham() + \"] hết hàng hoặc hết date rồi\");\r\n        }\r\n\r\n        // chọn lô cận date nhất mà còn đủ hàng\r\n        LoHang loChon = null;\r\n        for (LoHang lo : dsLoHang) {\r\n            if (lo.getSoLuongTon() >= soLuongCoSoCanXuat) {\r\n                loChon = lo;\r\n                break;\r\n            }\r\n        }\r\n\r\n        if (loChon == null) {\r\n            loChon = dsLoHang.get(0);\r\n            if (loChon.getSoLuongTon() < soLuongCoSoCanXuat) {\r\n                throw new IllegalStateException(\"Lô [\" + loChon.getSoLo() + \"] còn có \" + loChon.getSoLuongTon() + \", ko đủ xuất\");\r\n            }\r\n        }\r\n\r\n        // tạo dòng chi tiết xuất lô\r\n        String maCT = hoaDonHienTai.getMaHoaDon() + \"_SP\" + (hoaDonHienTai.getDsChiTiet().size() + 1);\r\n        ChiTietXuatLo ctXuatLo = new ChiTietXuatLo(\r\n                maCT,\r\n                hoaDonHienTai,\r\n                soLuong,\r\n                qd.getGiaBan(),\r\n                loChon,\r\n                qd\r\n        );\r\n\r\n        hoaDonHienTai.addChiTiet(ctXuatLo);\r\n        return true;\r\n    }\r\n\r\n    /**\r\n     * Thêm dịch vụ thú cưng vào hóa đơn\r\n     */\r\n    // Thêm dịch vụ chăm sóc thú cưng vào hóa đơn và tự động trích hoa hồng 10% cho kỹ thuật viên\r\n    public boolean themDichVu(DichVu dv, ThuCung tc, NhanVien ktv) {\r\n        if (dv == null || tc == null) {\r\n            throw new IllegalArgumentException(\"Vui lòng chọn dịch vụ và thú cưng hợp lệ!\");\r\n        }\r\n\r\n        String maCT = hoaDonHienTai.getMaHoaDon() + \"_DV\" + (hoaDonHienTai.getDsChiTiet().size() + 1);\r\n\r\n        // trích 10% hoa hồng cho bạn làm spa\r\n        BigDecimal hoaHong = dv.getGiaDichVu().multiply(BigDecimal.valueOf(0.10));\r\n\r\n        // thêm vào bill\r\n        ChiTietDichVu ctDv = new ChiTietDichVu(\r\n                maCT,\r\n                hoaDonHienTai,\r\n                1,\r\n                dv.getGiaDichVu(),\r\n                dv,\r\n                tc,\r\n                ktv,\r\n                hoaHong\r\n        );\r\n\r\n        hoaDonHienTai.addChiTiet(ctDv);\r\n        return true;\r\n    }\r\n\r\n    // Áp dụng số tiền giảm giá (từ Voucher khuyến mãi hoặc chiết khấu điểm tích lũy)\r\n    public void apDungGiamGia(BigDecimal giamGia) {\r\n        this.hoaDonHienTai.setGiamGia(giamGia);\r\n    }\r\n\r\n    /**\r\n     * Xác nhận thanh toán hóa đơn\r\n     */\r\n    // Xác nhận thanh toán: ghi nhận phương thức, cập nhật thời gian và kích hoạt ACID transaction lưu CSDL\r\n    public boolean thanhToan(String phuongThucThanhToan) throws SQLException {\r\n        // lưu phương thức thanh toán với giờ\r\n        this.hoaDonHienTai.setPhuongThucThanhToan(phuongThucThanhToan);\r\n        this.hoaDonHienTai.setThoiGianThanhToan(LocalDateTime.now());\r\n\r\n        // gọi dao lưu xuống db\r\n        boolean ok = hoaDonDAO.thanhToanHoaDon(this.hoaDonHienTai);\r\n\r\n        if (ok) {\r\n            dongBoKhachHangTuDatabase();\r\n        }\r\n        return ok;\r\n    }\r\n\r\n    /**\r\n     * Tra cứu nhanh sản phẩm bán lẻ theo Mã vạch (Barcode EAN-13) hoặc Mã sản phẩm (VD: SP001).\r\n     */\r\n    public CatalogItem timSanPhamTheoMaVachHoacMaSP(String maInput) {\r\n        if (maInput == null || maInput.trim().isEmpty()) {\r\n            return null;\r\n        }\r\n        String kw = maInput.trim();\r\n        List<CatalogItem> catalog = layDanhSachMatHangCatalog();\r\n        for (CatalogItem item : catalog) {\r\n            if (!item.laDichVu && item.tyLe == 1) {\r\n                if ((item.maVach != null && item.maVach.equalsIgnoreCase(kw))\r\n                        || (item.ma != null && item.ma.equalsIgnoreCase(kw))) {\r\n                    return item;\r\n                }\r\n            }\r\n        }\r\n        for (CatalogItem item : catalog) {\r\n            if (!item.laDichVu) {\r\n                if ((item.maVach != null && item.maVach.equalsIgnoreCase(kw))\r\n                        || (item.ma != null && item.ma.equalsIgnoreCase(kw))) {\r\n                    return item;\r\n                }\r\n            }\r\n        }\r\n        String kwLower = kw.toLowerCase();\r\n        for (CatalogItem item : catalog) {\r\n            if (!item.laDichVu) {\r\n                if ((item.maVach != null && item.maVach.toLowerCase().contains(kwLower))\r\n                        || (item.ma != null && item.ma.toLowerCase().contains(kwLower))\r\n                        || (item.ten != null && item.ten.toLowerCase().contains(kwLower))) {\r\n                    return item;\r\n                }\r\n            }\r\n        }\r\n        return null;\r\n    }\r\n\r\n    public KhachHang timKhachHangTheoSDT(String sdt) {\r\n        return timKhachHang(sdt);\r\n    }\r\n\r\n    public static long tinhThanhTienTungDong(int soLuong, long donGia) {\r\n        if (soLuong <= 0 || donGia < 0) return 0L;\r\n        return (long) soLuong * donGia;\r\n    }\r\n\r\n    public static long tinhGiamGiaVIP(long tongTienHang, boolean isVIP) {\r\n        if (!isVIP || tongTienHang <= 0) return 0L;\r\n        return Math.round(tongTienHang * 0.05);\r\n    }\r\n\r\n    public static long tinhTienGiamTuDiem(int soDiemMuonDung, int diemHienCo, long tongTienSauVIP) {\r\n        if (soDiemMuonDung <= 0 || diemHienCo <= 0 || tongTienSauVIP <= 0) return 0L;\r\n        int diemHopLe = Math.max(0, Math.min(soDiemMuonDung, diemHienCo));\r\n        return Math.min(tongTienSauVIP, diemHopLe * 1000L);\r\n    }\r\n\r\n    public static long tinhTongThanhToan(long tongTienHang, long tienGiamVIP, long tienDoiDiem, long tienKhauTruDoiTra) {\r\n        return Math.max(0L, tongTienHang - tienGiamVIP - tienDoiDiem - tienKhauTruDoiTra);\r\n    }\r\n\r\n    public static int tinhDiemThuongMoi(long tongThanhToan) {\r\n        if (tongThanhToan <= 0) return 0;\r\n        return (int) (tongThanhToan / 100000L);\r\n    }\r\n\r\n    private void unusedEndMarker() {\r\n    }\r\n}\r\n"},{"path":"src/entity/KhachHang.java","sha256":"ca8560b75d3be2a8727808b75be61c1e12beedd7a64f90635f1855da4edb278d","content":"package entity;\r\n\r\n// Entity khách hàng, mới bổ sung thêm trường email với địa chỉ\r\n// để phục vụ bên gửi email xác nhận đặt lịch hẹn với thông báo chăm sóc thú cưng ở pet hotel\r\npublic class KhachHang {\r\n    private String maKhachHang;\r\n    private String hoTen;\r\n    private String soDienThoai;\r\n    private int diemTichLuy;\r\n    private String email;   // thêm để gửi mail thông báo lịch hẹn và tiêm phòng\r\n    private String diaChi;  // lưu địa chỉ nhà khách khi cần đón thú cưng\r\n\r\n    public KhachHang() {\r\n        this.diemTichLuy = 0;\r\n        this.email = \"\";\r\n        this.diaChi = \"\";\r\n    }\r\n\r\n    // constructor cũ 4 tham số giữ nguyên để mấy chỗ bên POS với Hóa Đơn gọi không bị lỗi\r\n    public KhachHang(String maKhachHang, String hoTen, String soDienThoai, int diemTichLuy) {\r\n        this(maKhachHang, hoTen, soDienThoai, diemTichLuy, \"\", \"\");\r\n    }\r\n\r\n    // constructor đầy đủ 6 tham số dùng cho phần quản lý khách hàng và gửi mail\r\n    public KhachHang(String maKhachHang, String hoTen, String soDienThoai, int diemTichLuy, String email, String diaChi) {\r\n        this.maKhachHang = maKhachHang;\r\n        this.hoTen = hoTen;\r\n        this.soDienThoai = soDienThoai;\r\n        this.diemTichLuy = diemTichLuy;\r\n        this.email = email != null ? email : \"\";\r\n        this.diaChi = diaChi != null ? diaChi : \"\";\r\n    }\r\n\r\n    public String getMaKhachHang() {\r\n        return maKhachHang;\r\n    }\r\n\r\n    public void setMaKhachHang(String maKhachHang) {\r\n        this.maKhachHang = maKhachHang;\r\n    }\r\n\r\n    public String getHoTen() {\r\n        return hoTen;\r\n    }\r\n\r\n    public void setHoTen(String hoTen) {\r\n        this.hoTen = hoTen;\r\n    }\r\n\r\n    public String getSoDienThoai() {\r\n        return soDienThoai;\r\n    }\r\n\r\n    public void setSoDienThoai(String soDienThoai) {\r\n        this.soDienThoai = soDienThoai;\r\n    }\r\n\r\n    public int getDiemTichLuy() {\r\n        return diemTichLuy;\r\n    }\r\n\r\n    public void setDiemTichLuy(int diemTichLuy) {\r\n        this.diemTichLuy = diemTichLuy;\r\n    }\r\n\r\n    public String getEmail() {\r\n        return email;\r\n    }\r\n\r\n    public void setEmail(String email) {\r\n        this.email = email != null ? email : \"\";\r\n    }\r\n\r\n    public String getDiaChi() {\r\n        return diaChi;\r\n    }\r\n\r\n    public void setDiaChi(String diaChi) {\r\n        this.diaChi = diaChi != null ? diaChi : \"\";\r\n    }\r\n\r\n    @Override\r\n    public String toString() {\r\n        return \"KhachHang{\" +\r\n                \"maKhachHang='\" + maKhachHang + '\\'' +\r\n                \", hoTen='\" + hoTen + '\\'' +\r\n                \", soDienThoai='\" + soDienThoai + '\\'' +\r\n                \", diemTichLuy=\" + diemTichLuy +\r\n                \", email='\" + email + '\\'' +\r\n                \", diaChi='\" + diaChi + '\\'' +\r\n                '}';\r\n    }\r\n}\r\n"},{"path":"src/utils/UserSession.java","sha256":"fa17d88bb8a05b09bd5719f4fc491bd3c6077cb3f1fe98a616ba4b4f3427ee7c","content":"package utils;\r\n\r\nimport entity.NhanVien;\r\nimport entity.TaiKhoan;\r\n\r\n// lưu thông tin người đang đăng nhập và check quyền\r\npublic final class UserSession {\r\n\r\n    public enum Role {\r\n        NVQL(\"NVQL\", \"Quản lý hệ thống\"),\r\n        NVBH(\"NVBH\", \"Nhân viên Bán hàng\"),\r\n        NVCS(\"NVCS\", \"Nhân viên Chăm sóc Thú cưng\"),\r\n        NVTN(\"NVTN\", \"Nhân viên Thu ngân\");\r\n\r\n        private final String code;\r\n        private final String description;\r\n\r\n        Role(String code, String description) {\r\n            this.code = code;\r\n            this.description = description;\r\n        }\r\n\r\n        public String getCode() {\r\n            return code;\r\n        }\r\n\r\n        public String getDescription() {\r\n            return description;\r\n        }\r\n\r\n        // đổi từ chữ vai trò trong db sang enum\r\n        public static Role fromString(String roleStr) {\r\n            if (roleStr == null) return null;\r\n            String normalized = roleStr.trim().toUpperCase();\r\n\r\n            if (normalized.contains(\"QL\") || normalized.contains(\"ADMIN\") || normalized.contains(\"QUANLY\") || normalized.contains(\"KHO\")) {\r\n                return NVQL;\r\n            } else if (normalized.contains(\"BH\") || normalized.contains(\"BANHANG\")) {\r\n                return NVBH;\r\n            } else if (normalized.contains(\"CS\") || normalized.contains(\"KTV\") || normalized.contains(\"KYTHUAT\") || normalized.contains(\"CHAMSOC\")) {\r\n                return NVCS;\r\n            } else if (normalized.contains(\"TN\") || normalized.contains(\"THUNGAN\")) {\r\n                return NVTN;\r\n            }\r\n            return null;\r\n        }\r\n    }\r\n\r\n    private static NhanVien currentUser = null;\r\n    private static Role currentRole = null;\r\n\r\n    private UserSession() {}\r\n\r\n    /**\r\n     * Khởi tạo phiên làm việc khi đăng nhập thành công.\r\n     */\r\n    public static void initSession(NhanVien nhanVien) {\r\n        currentUser = nhanVien;\r\n        if (nhanVien != null && nhanVien.getTaiKhoan() != null) {\r\n            currentRole = Role.fromString(nhanVien.getTaiKhoan().getVaiTro());\r\n        } else if (nhanVien != null) {\r\n            currentRole = Role.fromString(nhanVien.getChucVu());\r\n        } else {\r\n            currentRole = null;\r\n        }\r\n    }\r\n\r\n    public static NhanVien getCurrentUser() {\r\n        return currentUser;\r\n    }\r\n\r\n    public static Role getCurrentRole() {\r\n        return currentRole;\r\n    }\r\n\r\n    public static String getUserId() {\r\n        return currentUser != null ? currentUser.getMaNhanVien() : null;\r\n    }\r\n\r\n    public static String getFullName() {\r\n        return currentUser != null ? currentUser.getHoTen() : \"Chưa đăng nhập\";\r\n    }\r\n\r\n    public static String getRoleCode() {\r\n        return currentRole != null ? currentRole.getCode() : \"GUEST\";\r\n    }\r\n\r\n    public static String getRoleDescription() {\r\n        return currentRole != null ? currentRole.getDescription() : \"Khách\";\r\n    }\r\n\r\n    public static boolean isQuanLy() {\r\n        return currentUser != null && currentRole == Role.NVQL;\r\n    }\r\n\r\n    public static boolean isBanHang() {\r\n        return currentUser != null && currentRole == Role.NVBH;\r\n    }\r\n\r\n    public static boolean isChamSoc() {\r\n        return currentUser != null && currentRole == Role.NVCS;\r\n    }\r\n\r\n    public static boolean isThuNgan() {\r\n        return currentUser != null && currentRole == Role.NVTN;\r\n    }\r\n\r\n    // hàm check xem tài khoản này có dc bấm vào card này ko\r\n    public static boolean canAccess(String cardName) {\r\n        if (isQuanLy()) {\r\n            return true; // Quản lý (NVQL) có toàn quyền truy cập tất cả phân hệ\r\n        }\r\n\r\n        switch (cardName) {\r\n            case \"CARD_POS\":\r\n                // Bán hàng (NVBH) và Thu ngân (NVTN) được phép vào POS\r\n                return isBanHang() || isThuNgan();\r\n\r\n            case \"CARD_THU_CUNG\":\r\n                // Chăm sóc (NVCS), Bán hàng (NVBH) và Thu ngân (NVTN) đều cần tra cứu thông tin thú cưng/khách hàng\r\n                return isChamSoc() || isBanHang() || isThuNgan();\r\n\r\n            case \"CARD_LICH_HEN\":\r\n                // Chăm sóc (NVCS), Thu ngân (NVTN) và Bán hàng (NVBH) được vào lịch hẹn\r\n                return isChamSoc() || isThuNgan() || isBanHang();\r\n\r\n            case \"CARD_PHAN_CA\":\r\n                // Màn hình phân ca làm việc chỉ dành riêng cho Quản lý hệ thống (NVQL)\r\n                return false;\r\n\r\n            case \"CARD_KHO\":\r\n                // Bán hàng và Thu ngân được xem tồn kho tra cứu giá bán\r\n                return isBanHang() || isThuNgan();\r\n\r\n            case \"CARD_GIAO_CA\":\r\n                // Thu ngân thực hiện kết két bàn giao ca và Quản lý duyệt ca\r\n                return isThuNgan() || isQuanLy();\r\n\r\n            case \"CARD_TONG_QUAN\":\r\n                // Dashboard điều hành chỉ dành riêng cho NVQL\r\n                return false;\r\n\r\n            case \"CARD_PET_HOTEL\":\r\n                // Quản lý (NVQL), Thu ngân (NVTN) và Chăm sóc (NVCS) đều có quyền vào Pet Hotel\r\n                return isQuanLy() || isThuNgan() || isChamSoc();\r\n\r\n            case \"CARD_DOI_TRA\":\r\n                // Quản lý (NVQL), Bán hàng (NVBH) và Thu ngân (NVTN) đều có quyền xử lý đổi trả hàng\r\n                return isQuanLy() || isBanHang() || isThuNgan();\r\n\r\n            case \"CARD_NHAN_VIEN\":\r\n                // Phân quyền nhân sự và tài khoản chỉ dành riêng cho NVQL\r\n                return false;\r\n\r\n            default:\r\n                return false;\r\n        }\r\n    }\r\n\r\n    public static boolean canAccessPetHotel() {\r\n        return canAccess(\"CARD_PET_HOTEL\");\r\n    }\r\n\r\n    public static boolean canAccessDoiTraHang() {\r\n        return canAccess(\"CARD_DOI_TRA\");\r\n    }\r\n\r\n    // ==========================================\r\n    // KIỂM TRA QUYỀN THEO 6 NHÓM CHỨC NĂNG SLIDE 17\r\n    // ==========================================\r\n    public static boolean canAccessNhom1HeThongPhanQuyen() {\r\n        return isQuanLy();\r\n    }\r\n\r\n    public static boolean canAccessNhom1GiaoCa() {\r\n        return isQuanLy() || isThuNgan();\r\n    }\r\n\r\n    public static boolean canAccessNhom2DanhMucHangHoa() {\r\n        return isQuanLy() || isBanHang() || isThuNgan();\r\n    }\r\n\r\n    public static boolean canAccessNhom2DanhMucNhaCungCap() {\r\n        return isQuanLy();\r\n    }\r\n\r\n    public static boolean canAccessNhom3CapNhatNhapKho() {\r\n        return isQuanLy();\r\n    }\r\n\r\n    public static boolean canAccessNhom3CapNhatTiepNhanLich() {\r\n        return isQuanLy() || isBanHang() || isThuNgan();\r\n    }\r\n\r\n    public static boolean canAccessNhom3CapNhatSucKhoeBe() {\r\n        return isQuanLy() || isChamSoc();\r\n    }\r\n\r\n    public static boolean canAccessNhom3CapNhatNhanSu() {\r\n        return isQuanLy();\r\n    }\r\n\r\n    public static boolean canAccessNhom4XuLyBanHangPOS() {\r\n        return isQuanLy() || isBanHang() || isThuNgan();\r\n    }\r\n\r\n    public static boolean canAccessNhom4XuLyPhanCaToanQuyen() {\r\n        return isQuanLy();\r\n    }\r\n\r\n    public static boolean canAccessNhom4XuLyTienDoDichVu() {\r\n        return isQuanLy() || isChamSoc();\r\n    }\r\n\r\n    public static boolean canAccessNhom4XuLyDoiTraHang() {\r\n        return isQuanLy() || isBanHang() || isThuNgan();\r\n    }\r\n\r\n    public static boolean canAccessNhom5TimKiemKhachVIP() {\r\n        return isQuanLy() || isBanHang() || isThuNgan();\r\n    }\r\n\r\n    public static boolean canAccessNhom5TimKiemLichHen() {\r\n        return isQuanLy() || isBanHang() || isThuNgan() || isChamSoc();\r\n    }\r\n\r\n    public static boolean canAccessNhom5TimKiemTonKhoFEFO() {\r\n        return isQuanLy() || isBanHang() || isThuNgan();\r\n    }\r\n\r\n    public static boolean canAccessNhom5TimKiemHoaDonCu() {\r\n        return isQuanLy() || isBanHang() || isThuNgan();\r\n    }\r\n\r\n    public static boolean canAccessNhom6BaoBieuDoanhThu() {\r\n        return isQuanLy() || isThuNgan();\r\n    }\r\n\r\n    public static boolean canAccessNhom6BaoBieuThongKeDichVu() {\r\n        return isQuanLy() || isChamSoc();\r\n    }\r\n\r\n    public static boolean canAccessNhom6BaoBieuCanhBaoFEFO() {\r\n        return isQuanLy();\r\n    }\r\n\r\n    public static boolean canAccessNhom6BaoBieuXuatNhapTon() {\r\n        return isQuanLy();\r\n    }\r\n\r\n    /**\r\n     * Hủy phiên làm việc khi đăng xuất.\r\n     */\r\n    public static void clearSession() {\r\n        currentUser = null;\r\n        currentRole = null;\r\n    }\r\n}\r\n"},{"path":"docs/ai-context/patches/agy-patch-simple-batch-20261108.json","sha256":null,"content":"[NEW FILE]"}]}