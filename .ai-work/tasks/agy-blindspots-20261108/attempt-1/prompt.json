r.getIcon(IconHelper.CLOCK, 12, ThemeColors.WARNING));\n        JButton btnInK80 = ThemeColors.createSecondaryButton(\"In K80\", IconHelper.getIcon(IconHelper.RECEIPT, 12, ThemeColors.PRIMARY_ACTIVE));\n\n        btnTaoDonMoi.setFont(new Font(\"Segoe UI\", Font.BOLD, 11));\n        btnLuuTam.setFont(new Font(\"Segoe UI\", Font.BOLD, 11));\n        btnInK80.setFont(new Font(\"Segoe UI\", Font.BOLD, 11));\n\n        btnTaoDonMoi.addActionListener(e -> taoDonMoi());\n        btnLuuTam.addActionListener(e -> luuTamDonHang());\n        btnInK80.addActionListener(e -> xemTruocInHoaDonK80());\n\n        pnlSubActions.add(btnTaoDonMoi);\n        pnlSubActions.add(btnLuuTam);\n        pnlSubActions.add(btnInK80);\n\n        JButton btnThanhToan = new JButton(\"THANH TOÁN (F9)\", IconHelper.getIcon(IconHelper.CREDIT_CARD, 15, Color.WHITE));\n        btnThanhToan.setFont(new Font(\"Segoe UI\", Font.BOLD, 13));\n        btnThanhToan.setBackground(ThemeColors.PRIMARY);\n        btnThanhToan.setForeground(Color.WHITE);\n        btnThanhToan.setFocusPainted(false);\n        btnThanhToan.setCursor(new Cursor(Cursor.HAND_CURSOR));\n        btnThanhToan.setPreferredSize(new Dimension(0, 36));\n        btnThanhToan.setBorder(new CompoundBorder(\n                new LineBorder(ThemeColors.PRIMARY_ACTIVE, 1, true),\n                new EmptyBorder(6, 12, 6, 12)\n        ));\n        btnThanhToan.putClientProperty(\"JButton.buttonType\", \"roundRect\");\n        btnThanhToan.addMouseListener(new MouseAdapter() {\n            @Override\n            public void mouseEntered(MouseEvent e) {\n                btnThanhToan.setBackground(ThemeColors.PRIMARY_HOVER);\n            }\n            @Override\n            public void mouseExited(MouseEvent e) {\n                btnThanhToan.setBackground(ThemeColors.PRIMARY);\n            }\n        });\n        btnThanhToan.addActionListener(e -> thucHienThanhToan());\n        registerKeyboardAction(e -> {\n            if (isShowing() && btnThanhToan.isEnabled()) btnThanhToan.doClick();\n        }, KeyStroke.getKeyStroke(java.awt.event.KeyEvent.VK_F9, 0), JComponent.WHEN_IN_FOCUSED_WINDOW);\n\n        pnlActionButtons.add(pnlSubActions, BorderLayout.WEST);\n        pnlActionButtons.add(btnThanhToan, BorderLayout.CENTER);\n\n        JPanel pnlCenter = new JPanel(new BorderLayout(0, 4));\n        pnlCenter.setOpaque(false);\n        pnlCenter.add(pnlKhachHang, BorderLayout.NORTH);\n\n        JPanel pnlTableWrapper = new JPanel(new BorderLayout(0, 3));\n        pnlTableWrapper.setOpaque(false);\n\n        // Thanh thông báo khấu trừ đổi trả hàng (Hiển thị khi tiếp nhận đổi trả từ DoiTraHangPanel)\n        pnlThongBaoDoiTra = new JPanel(new BorderLayout(8, 0));\n        pnlThongBaoDoiTra.setBackground(new Color(254, 243, 199));\n        pnlThongBaoDoiTra.setBorder(new CompoundBorder(\n                new LineBorder(new Color(245, 158, 11), 1, true),\n                new EmptyBorder(5, 8, 5, 8)\n        ));\n        pnlThongBaoDoiTra.setVisible(false);\n\n        lblThongBaoDoiTra = new JLabel(\"🔄 ĐỔI TRẢ TỪ HÓA ĐƠN | KHẤU TRỪ: -0 đ\");\n        lblThongBaoDoiTra.setFont(new Font(\"Segoe UI\", Font.BOLD, 11));\n        lblThongBaoDoiTra.setForeground(new Color(146, 64, 14));\n        lblThongBaoDoiTra.setIcon(IconHelper.getIcon(IconHelper.REFRESH, 13, new Color(180, 83, 9)));\n\n        btnHuyDoiTra = new JButton(\"Hủy đổi trả\", IconHelper.getIcon(IconHelper.TRASH, 11, ThemeColors.DANGER));\n        btnHuyDoiTra.setFont(new Font(\"Segoe UI\", Font.BOLD, 10));\n        btnHuyDoiTra.setBackground(new Color(254, 226, 226));\n        btnHuyDoiTra.setForeground(ThemeColors.DANGER);\n        btnHuyDoiTra.setFocusPainted(false);\n        btnHuyDoiTra.setCursor(new Cursor(Cursor.HAND_CURSOR));\n        btnHuyDoiTra.setBorder(new CompoundBorder(\n                new LineBorder(new Color(239, 68, 68), 1, true),\n                new EmptyBorder(2, 6, 2, 6)\n        ));\n        btnHuyDoiTra.addActionListener(e -> huyDoiTraHang());\n\n        pnlThongBaoDoiTra.add(lblThongBaoDoiTra, BorderLayout.CENTER);\n        pnlThongBaoDoiTra.add(btnHuyDoiTra, BorderLayout.EAST);\n\n        JPanel pnlCartTop = new JPanel(new BorderLayout(0, 3));\n        pnlCartTop.setOpaque(false);\n        pnlCartTop.add(pnlThongBaoDoiTra, BorderLayout.NORTH);\n        pnlCartTop.add(pnlCartActions, BorderLayout.SOUTH);\n\n        pnlTableWrapper.add(pnlCartTop, BorderLayout.NORTH);\n        pnlTableWrapper.add(scrollGioHang, BorderLayout.CENTER);\n\n        // Mô hình 3: Gợi ý bán kèm thông minh (Smart Cross-Sell banner)\n        pnlCrossSell = new JPanel(new BorderLayout(6, 0));\n        pnlCrossSell.setBackground(new Color(254, 243, 199));\n        pnlCrossSell.setBorder(new CompoundBorder(\n                new LineBorder(new Color(245, 158, 11), 1, true),\n                new EmptyBorder(4, 8, 4, 8)\n        ));\n        pnlCrossSell.setVisible(false);\n\n        lblCrossSellText = new JLabel(\"Gợi ý: Mua kèm xịt ve rận Bio-Care giảm 10%\");\n        lblCrossSellText.setFont(new Font(\"Segoe UI\", Font.BOLD, 11));\n        lblCrossSellText.setForeground(new Color(146, 64, 14));\n        lblCrossSellText.setIcon(IconHelper.getIcon(IconHelper.TAG, 13, new Color(180, 83, 9)));\n\n        btnThemCrossSell = new JButton(\"+ Thêm (-10%)\");\n        btnThemCrossSell.setFont(new Font(\"Segoe UI\", Font.BOLD, 10));\n        btnThemCrossSell.setBackground(new Color(245, 158, 11));\n        btnThemCrossSell.setForeground(Color.WHITE);\n        btnThemCrossSell.setFocusPainted(false);\n        btnThemCrossSell.setCursor(new Cursor(Cursor.HAND_CURSOR));\n        btnThemCrossSell.putClientProperty(\"JButton.buttonType\", \"roundRect\");\n        btnThemCrossSell.addActionListener(e -> themSanPhamCrossSellHienTai());\n\n        pnlCrossSell.add(lblCrossSellText, BorderLayout.CENTER);\n        pnlCrossSell.add(btnThemCrossSell, BorderLayout.EAST);\n        pnlTableWrapper.add(pnlCrossSell, BorderLayout.SOUTH);\n\n        pnlCenter.add(pnlTableWrapper, BorderLayout.CENTER);\n\n        pnlCenter.add(pnlTongKet, BorderLayout.SOUTH);\n\n        pnl.add(pnlHeader, BorderLayout.NORTH);\n        pnl.add(pnlCenter, BorderLayout.CENTER);\n        pnl.add(pnlActionButtons, BorderLayout.SOUTH);\n\n        return pnl;\n    }\n\n    private JButton taoNutGoiYTien(String label, long amount) {\n        JButton btn = new JButton(label);\n        btn.setFont(new Font(\"Segoe UI\", Font.BOLD, 10));\n        btn.setBackground(Color.WHITE);\n        btn.setForeground(ThemeColors.TEXT_PRIMARY);\n        btn.setFocusPainted(false);\n        btn.setCursor(new Cursor(Cursor.HAND_CURSOR));\n        btn.putClientProperty(\"JButton.buttonType\", \"roundRect\");\n        btn.setBorder(new CompoundBorder(\n                new LineBorder(ThemeColors.BORDER, 1, true),\n                new EmptyBorder(1, 5, 1, 5)\n        ));\n        btn.addActionListener(e -> {\n            if (cboPhuongThuc != null && !\"Tiền mặt\".equals(cboPhuongThuc.getSelectedItem())) {\n                cboPhuongThuc.setSelectedItem(\"Tiền mặt\");\n            }\n            if (txtTienKhachDua != null) {\n                txtTienKhachDua.setEnabled(true);\n                if (amount < 0) {\n                    long tienKhauTru = (thongTinDoiTraHienTai != null) ? thongTinDoiTraHienTai.getTongTienTra() : 0L;\n                    long canTra = Math.max(0, tongTienHang - tienGiamGia - tienKhauTru);\n                    txtTienKhachDua.setText(String.valueOf(canTra));\n                } else {\n                    txtTienKhachDua.setText(String.valueOf(amount));\n                }\n            }\n            tinhTienThoi();\n        });\n        return btn;\n    }\n\n//    private void xuLySuaSoLuongTuBanPhim(int row) {\n//        dangCapNhatSoLuongBang = true;\n//        try {\n//            Object rawVal = modelGioHang.getValueAt(row, 4);\n//            String valStr = rawVal != null ? rawVal.toString().replaceAll(\"[^0-9-]\", \"\").trim() : \"1\";\n    private void xuLySuaSoLuongTuBanPhim(int row) {\n        dangCapNhatSoLuongBang = true;\n        try {\n            Object rawVal = modelGioHang.getValueAt(row, 4);\n            String valStr = rawVal != null ? rawVal.toString().replaceAll(\"[^0-9-]\", \"\").trim() : \"1\";\n            int slMoi;\n            try {\n                slMoi = Integer.parseInt(valStr);\n            } catch (NumberFormatException ex) {\n                slMoi = 1;\n            }\n            if (slMoi <= 0) {\n                slMoi = 1;\n            }\n\n            // Kiểm tra tồn kho nghiêm ngặt nếu là sản phẩm hàng hóa\n            String maMon = (String) modelGioHang.getValueAt(row, 1);\n            String dvtMon = modelGioHang.getValueAt(row, 3) != null ? modelGioHang.getValueAt(row, 3).toString() : \"\";\n            if (maMon != null && maMon.startsWith(\"SP\")) {\n                for (CatalogItem item : allItems) {\n                    if (maMon.equalsIgnoreCase(item.ma) && (dvtMon.isEmpty() || dvtMon.equalsIgnoreCase(item.dvt))) {\n                        if (slMoi > item.tonKho) {\n                            JOptionPane.showMessageDialog(this,\n                                    \"Số lượng nhập (\" + slMoi + \") vượt quá tồn kho hiện tại của sản phẩm [\" + item.ten + \"] (\" + item.tonKho + \" \" + item.dvt + \")!\\n\" +\n                                    \"Hệ thống đã tự động điều chỉnh về mức tồn kho tối đa cho phép.\",\n                                    \"Cảnh báo tồn kho\", JOptionPane.WARNING_MESSAGE);\n                            slMoi = item.tonKho; // Giới hạn tối đa bằng số lượng tồn kho\n                        }\n                        break;\n                    }\n                }\n            }\n\n            modelGioHang.setValueAt(slMoi, row, 4);\n            String donGiaStr = ((String) modelGioHang.getValueAt(row, 5)).replaceAll(\"[^0-9]\", \"\").trim();\n            long donGia = donGiaStr.isEmpty() ? 0 : Long.parseLong(donGiaStr);\n            modelGioHang.setValueAt(df.format(slMoi * donGia), row, 6);\n            capNhatTongTien();\n        } finally {\n            dangCapNhatSoLuongBang = false;\n        }\n    }\n\n    private void hienThiPopupGoiYKhachHang(Component invoker) {\n        String kw = txtSdtKhachHang != null ? txtSdtKhachHang.getText().trim() : \"\";\n        List<KhachHang> dsGoiY = BanHangBus.timKiemGoiYKhachHang(kw);\n        if (dsGoiY.isEmpty()) {\n            dsGoiY = BanHangBus.getDanhSachKhachHang();\n        }\n\n        JPopupMenu popup = new JPopupMenu();\n        popup.setBorder(new LineBorder(ThemeColors.BORDER_ACCENT, 1, true));\n\n        JMenuItem headerItem = new JMenuItem(\"DANH SÁCH KHÁCH HÀNG THÀNH VIÊN (\" + dsGoiY.size() + \" KH)\");\n        headerItem.setFont(new Font(\"Segoe UI\", Font.BOLD, 11));\n        headerItem.setEnabled(false);\n        popup.add(headerItem);\n        popup.addSeparator();\n\n        for (KhachHang kh : dsGoiY) {\n            String hang = BanHangBus.xepHangThanhVien(kh.getDiemTichLuy());\n            String label = String.format(\"[%s] %s · %s (%d điểm - %s)\",\n                    kh.getMaKhachHang(), kh.getHoTen(), kh.getSoDienThoai(), kh.getDiemTichLuy(), hang);\n            JMenuItem item = new JMenuItem(label, IconHelper.getIcon(IconHelper.USER, 13, ThemeColors.PRIMARY_ACTIVE));\n            item.setFont(new Font(\"Segoe UI\", Font.PLAIN, 12));\n            item.addActionListener(e -> {\n                txtSdtKhachHang.setText(kh.getSoDienThoai());\n                traCuuKhachHang();\n            });\n            popup.add(item);\n        }\n\n        popup.addSeparator();\n        JMenuItem itemKhachLe = new JMenuItem(\"Đặt lại: Khách vãng lai (Xóa thông tin đang chọn)\",\n                IconHelper.getIcon(IconHelper.REFRESH, 13, ThemeColors.TEXT_SECONDARY));\n        itemKhachLe.setFont(new Font(\"Segoe UI\", Font.ITALIC, 11));\n        itemKhachLe.addActionListener(e -> {\n            dangCapNhatKhach = true;\n            try {\n                txtSdtKhachHang.setText(\"\");\n                txtTenKhachHang.setText(\"\");\n                tenKhachTuDongDien = false;\n                diemHienCo = 0;\n                lblDiemTichLuy.setText(\"Khách vãng lai · 0 điểm\");\n                lblDiemTichLuy.setForeground(ThemeColors.TEXT_SECONDARY);\n                capNhatDiemSpinner();\n            } finally {\n                dangCapNhatKhach = false;\n            }\n            capNhatTongTien();\n        });\n        popup.add(itemKhachLe);\n\n        popup.show(invoker, 0, invoker.getHeight() + 2);\n    }\n\n    private void moHopThoaiQuanLyKhachNhanh() {\n        String sdtDangNhap = txtSdtKhachHang.getText().trim();\n        String tenDangNhap = txtTenKhachHang.getText().trim();\n        KhachHang khHienTai = controller.timKhachHang(sdtDangNhap);\n\n        boolean isManager = utils.UserSession.isQuanLy();\n        JTextField txtSdt = new JTextField(khHienTai != null ? khHienTai.getSoDienThoai() : sdtDangNhap);\n        JTextField txtHoTen = new JTextField(khHienTai != null ? khHienTai.getHoTen() : tenDangNhap);\n        JTextField txtDiem = new JTextField(khHienTai != null ? String.valueOf(khHienTai.getDiemTichLuy()) : \"0\");\n        txtDiem.setEditable(isManager);\n        if (!isManager) {\n            txtDiem.setToolTipText(\"Chỉ Quản lý mới có quyền điều chỉnh điểm thủ công\");\n        }\n\n        String trangThaiKH = khHienTai != null\n                ? (\"KHÁCH CŨ [\" + khHienTai.getMaKhachHang() + \"] - Hạng: \" + BanHangBus.xepHangThanhVien(khHienTai.getDiemTichLuy()))\n                : \"KHÁCH HÀNG MỚI (Tự động cấp mã thành viên mới)\";\n\n        Object[] options = khHienTai != null\n                ? new Object[]{\"Lưu cập nhật\", \"Xóa khách hàng\", \"Đóng\"}\n                : new Object[]{\"+ Thêm Khách hàng mới\", \"Đóng\"};\n\n        Object[] msg = {\n                \"Phân loại: \" + trangThaiKH,\n                \"Số điện thoại (10 chữ số) (*):\", txtSdt,\n                \"Họ và tên khách hàng (*):\", txtHoTen,\n                \"Điểm tích lũy hiện có\" + (isManager ? \":\" : \" (Chỉ xem - Quyền Quản lý mới được sửa):\"), txtDiem\n        };\n\n        int choice = JOptionPane.showOptionDialog(this, msg,\n                \"QUẢN LÝ THÔNG TIN KHÁCH HÀNG TẠI QUẦY POS\",\n                JOptionPane.DEFAULT_OPTION, JOptionPane.PLAIN_MESSAGE,\n                null, options, options[0]);\n\n        if (choice == 0) {\n            String sdtMoi = txtSdt.getText().trim();\n            String tenMoi = txtHoTen.getText().trim();\n            if (sdtMoi.isEmpty() || tenMoi.isEmpty()) {\n                JOptionPane.showMessageDialog(this, \"Vui lòng nhập đầy đủ Số điện thoại và Họ tên khách hàng!\", \"Nhắc nhở\", JOptionPane.WARNING_MESSAGE);\n                return;\n            }\n            int diemMoi = khHienTai != null ? khHienTai.getDiemTichLuy() : 0;\n            if (isManager) {\n                try {\n                    diemMoi = Math.max(0, Integer.parseInt(txtDiem.getText().trim()));\n                } catch (NumberFormatException ignored) {}\n            }\n            boolean ok = false;\n            if (khHienTai != null) {\n                ok = BanHangBus.capNhatThongTinKhachHang(khHienTai.getMaKhachHang(), tenMoi, sdtMoi, diemMoi);\n            } else {\n                ok = (BanHangBus.luuHoacCapNhatKhachHang(sdtMoi, tenMoi, diemMoi) != null);\n            }\n            if (ok) {\n                txtSdtKhachHang.setText(sdtMoi);\n                traCuuKhachHang();\n                JOptionPane.showMessageDialog(this, \"Đã lưu hồ sơ khách hàng [\" + tenMoi + \" - \" + sdtMoi + \"] thành công!\", \"Thành công\", JOptionPane.INFORMATION_MESSAGE);\n            } else {\n                JOptionPane.showMessageDialog(this, \"Lỗi: Không thể lưu hồ sơ khách hàng xuống CSDL. Vui lòng kiểm tra lại thông tin hoặc kết nối CSDL!\", \"Lỗi lưu dữ liệu\", JOptionPane.ERROR_MESSAGE);\n            }\n        } else if (khHienTai != null && choice == 1) {\n            int cf = JOptionPane.showConfirmDialog(this,\n                    \"Bạn có chắc chắn muốn xóa khách hàng [\" + khHienTai.getHoTen() + \" - \" + khHienTai.getSoDienThoai() + \"]?\",\n                    \"Xác nhận xóa\", JOptionPane.YES_NO_OPTION, JOptionPane.WARNING_MESSAGE);\n            if (cf == JOptionPane.YES_OPTION) {\n                boolean xoaOk = BanHangBus.xoaKhachHang(khHienTai.getMaKhachHang());\n                if (xoaOk) {\n                    txtSdtKhachHang.setText(\"\");\n                    txtTenKhachHang.setText(\"\");\n                    traCuuKhachHang();\n                    JOptionPane.showMessageDialog(this, \"Đã xóa thông tin khách hàng khỏi hệ thống.\", \"Đã xóa\", JOptionPane.INFORMATION_MESSAGE);\n                } else {\n                    JOptionPane.showMessageDialog(this, \"Không thể xóa khách hàng này do đã phát sinh hóa đơn/giao dịch trong hệ thống (Ràng buộc toàn vẹn)!\", \"Không thể xóa\", JOptionPane.ERROR_MESSAGE);\n                }\n            }\n        }\n    }\n\n    private void traCuuKhachHang() {\n        if (dangCapNhatKhach) return;\n        dangCapNhatKhach = true;\n        try {\n            String sdt = txtSdtKhachHang != null ? txtSdtKhachHang.getText().trim() : \"\";\n            if (sdt.isEmpty()) {\n                if (tenKhachTuDongDien && txtTenKhachHang != null) {\n                    txtTenKhachHang.setText(\"\");\n                    tenKhachTuDongDien = false;\n                }\n                diemHienCo = 0;\n                if (lblDiemTichLuy != null) {\n                    lblDiemTichLuy.setText(\"Khách vãng lai · 0 điểm\");\n                    lblDiemTichLuy.setForeground(ThemeColors.TEXT_SECONDARY);\n                }\n                theSpaPassHienTai = null;\n                if (lblSpaPassStatus != null) {\n                    lblSpaPassStatus.setText(\"Chưa có thẻ Spa Pass\");\n                    lblSpaPassStatus.setForeground(ThemeColors.TEXT_MUTED);\n                }\n                if (btnDungSpaPass != null) {\n                    btnDungSpaPass.setEnabled(false);\n                }\n                if (lblThuCungDangChon != null) {\n                    lblThuCungDangChon.setText(\"Chưa chọn thú cưng (Khách vãng lai)\");\n                    lblThuCungDangChon.setForeground(ThemeColors.TEXT_MUTED);\n                }\n            } else {\n                KhachHang kh = controller.timKhachHang(sdt);\n                if (kh != null) {\n                    if (txtTenKhachHang != null) {\n                        txtTenKhachHang.setText(kh.getHoTen());\n                    }\n                    tenKhachTuDongDien = true;\n                    diemHienCo = kh.getDiemTichLuy();\n                    String hang = BanHangBus.xepHangThanhVien(diemHienCo);\n                    if (lblDiemTichLuy != null) {\n                        lblDiemTichLuy.setText(\"Khách cũ [\" + kh.getMaKhachHang() + \"]: \" + diemHienCo + \" điểm (\" + hang + \")\");\n                        lblDiemTichLuy.setForeground(diemHienCo >= 100 ? ThemeColors.PRIMARY_ACTIVE : ThemeColors.SUCCESS_TEXT);\n                    }\n                } else {\n                    if (tenKhachTuDongDien && txtTenKhachHang != null) {\n                        txtTenKhachHang.setText(\"\");\n                        tenKhachTuDongDien = false;\n                    }\n                    diemHienCo = 0;\n                    if (lblDiemTichLuy != null) {\n                        lblDiemTichLuy.setText(\"Khách mới (chưa có thẻ): Sẽ tự động lưu khi TT\");\n                        lblDiemTichLuy.setForeground(ThemeColors.WARNING_TEXT);\n                    }\n                }\n\n                // Cập nhật Thẻ Spa Pass (Mô hình 1: Punch Card)\n                theSpaPassHienTai = SpaPassBus.timTheKhaDung(sdt);\n                if (theSpaPassHienTai != null) {\n                    if (lblSpaPassStatus != null) {\n                        lblSpaPassStatus.setText(theSpaPassHienTai.getTenThe() + \": Còn \" + theSpaPassHienTai.getSoBuoiConLai() + \"/\" + theSpaPassHienTai.getTongSoBuoi() + \" buổi\");\n                        lblSpaPassStatus.setForeground(ThemeColors.PRIMARY_ACTIVE);\n                    }\n                    if (btnDungSpaPass != null) {\n                        btnDungSpaPass.setEnabled(theSpaPassHienTai.isKhaDung());\n                    }\n                } else {\n                    if (lblSpaPassStatus != null) {\n                        lblSpaPassStatus.setText(\"Chưa đăng ký Spa Pass\");\n                        lblSpaPassStatus.setForeground(ThemeColors.TEXT_MUTED);\n                    }\n                    if (btnDungSpaPass != null) {\n                        btnDungSpaPass.setEnabled(false);\n                    }\n                }\n\n                // Cập nhật Thú cưng & Dị ứng (Mô hình 3: Allergy Guard - truy vấn động từ CSDL)\n                if (lblThuCungDangChon != null) {\n                    dao.ThuCungDAO tcDao = new dao.ThuCungDAO();\n                    String thongTinDiUng = tcDao.getThongTinDiUngTheoSoDienThoai(sdt);\n                    if (thongTinDiUng != null) {\n                        lblThuCungDangChon.setText(thongTinDiUng);\n                        String upper = thongTinDiUng.toUpperCase();\n                        if (upper.contains(\"DỊ ỨNG\") || upper.contains(\"DI UNG\")) {\n                            lblThuCungDangChon.setForeground(ThemeColors.DANGER);\n                        } else {\n                            lblThuCungDangChon.setForeground(ThemeColors.SUCCESS_TEXT);\n                        }\n                    } else if (kh != null) {\n                        lblThuCungDangChon.setText(\"Bé cưng của \" + kh.getHoTen() + \" (Sức khỏe bình thường)\");\n                        lblThuCungDangChon.setForeground(ThemeColors.SUCCESS_TEXT);\n                    } else {\n                        lblThuCungDangChon.setText(\"Khách mới (Chưa có hồ sơ thú cưng)\");\n                        lblThuCungDangChon.setForeground(ThemeColors.TEXT_MUTED);\n                    }\n                }\n            }\n\n            capNhatDiemSpinner();\n            capNhatTongTien();\n        } finally {\n            dangCapNhatKhach = false;\n        }\n    }\n\n    private void thayDoiSoLuong(int delta) {\n        int row = tblGioHang.getSelectedRow();\n        if (row < 0) {\n            JOptionPane.showMessageDialog(this, \"Vui lòng chọn dòng sản phẩm cần điều chỉnh số lượng!\", \"Nhắc nhở\", JOptionPane.INFORMATION_MESSAGE);\n            return;\n        }\n\n        dangCapNhatSoLuongBang = true;\n        try {\n            int slHienTai = Integer.parseInt(modelGioHang.getValueAt(row, 4).toString().replaceAll(\"[^0-9]\", \"\"));\n            int slMoi = slHienTai + delta;\n            if (slMoi <= 0) {\n                modelGioHang.removeRow(row);\n                danhLaiSTT();\n            } else {\n                modelGioHang.setValueAt(slMoi, row, 4);\n                String donGiaStr = ((String) modelGioHang.getValueAt(row, 5)).replaceAll(\"[^0-9]\", \"\").trim();\n                long donGia = Long.parseLong(donGiaStr);\n                modelGioHang.setValueAt(df.format(slMoi * donGia), row, 6);\n            }\n            capNhatTongTien();\n        } finally {\n            dangCapNhatSoLuongBang = false;\n        }\n    }\n\n    private void xoaMonDangChon() {\n        int row = tblGioHang.getSelectedRow();\n        if (row >= 0) {\n            modelGioHang.removeRow(row);\n            danhLaiSTT();\n            capNhatTongTien();\n        } else {\n            JOptionPane.showMessageDialog(this, \"Vui lòng chọn món cần xóa khỏi giỏ hàng!\", \"Nhắc nhở\", JOptionPane.INFORMATION_MESSAGE);\n        }\n    }\n\n    private void danhLaiSTT() {\n        for (int i = 0; i < modelGioHang.getRowCount(); i++) {\n            modelGioHang.setValueAt(i + 1, i, 0);\n        }\n    }\n\n    private void capNhatTongTien() {\n        if (modelGioHang == null) return;\n        tongTienHang = 0;\n        for (int i = 0; i < modelGioHang.getRowCount(); i++) {\n            String thanhTienStr = ((String) modelGioHang.getValueAt(i, 6)).replaceAll(\"[^0-9]\", \"\").trim();\n            if (!thanhTienStr.isEmpty()) {\n                tongTienHang += Long.parseLong(thanhTienStr);\n            }\n        }\n\n        boolean isVIP = diemHienCo >= 100 || (lblDiemTichLuy != null && lblDiemTichLuy.getText().contains(\"VIP\"));\n        long tienGiamVip = (isVIP && tongTienHang > 0) ? (long) (tongTienHang * 0.05) : 0;\n        long tongSauVip = Math.max(0, tongTienHang - tienGiamVip);\n        int soDiemChon = (spnDiemDung != null && diemHienCo > 0) ? ((Number) spnDiemDung.getValue()).intValue() : 0;\n        tienDoiDiem = Math.min(tongSauVip, soDiemChon * 1000L);\n        tienGiamGia = tienGiamVip + tienDoiDiem;\n\n        long tienKhauTruDoiTra = (thongTinDoiTraHienTai != null) ? thongTinDoiTraHienTai.getTongTienTra() : 0L;\n        long tongGiamVaKhauTru = tienGiamGia + tienKhauTruDoiTra;\n        long canTra = Math.max(0, tongTienHang - tienGiamGia - tienKhauTruDoiTra);\n\n        if (lblTongTienHang != null) lblTongTienHang.setText(df.format(tongTienHang));\n        if (lblGiamGia != null) {\n            if (tongGiamVaKhauTru > 0) {\n                if (tienKhauTruDoiTra > 0) {\n                    lblGiamGia.setText(\"-\" + df.format(tongGiamVaKhauTru) + \" (Đổi: -\" + df.format(tienKhauTruDoiTra) + \")\");\n                } else {\n                    lblGiamGia.setText(\"-\" + df.format(tongGiamVaKhauTru));\n                }\n            } else {\n                lblGiamGia.setText(\"0 đ\");\n            }\n        }\n        if (lblKhachCanTra != null) lblKhachCanTra.setText(df.format(canTra));\n        if (txtTienKhachDua != null) {\n            String pttt = cboPhuongThuc != null ? (String) cboPhuongThuc.getSelectedItem() : \"Tiền mặt\";\n            if (\"Chuyển khoản\".equals(pttt)) {\n                txtTienKhachDua.setText(canTra == 0 ? \"0\" : String.valueOf(canTra));\n            } else {\n                String raw = txtTienKhachDua.getText().replaceAll(\"[^0-9]\", \"\").trim();\n                if (raw.isEmpty() || canTra == 0) {\n                    txtTienKhachDua.setText(\"0\");\n                }\n            }\n        }\n        tinhTienThoi();\n        capNhatThanhCrossSell();\n    }\n\n    private void tinhTienThoi() {\n        if (txtTienKhachDua == null || lblTienThoiLai == null) return;\n        try {\n            long tienKhauTruDoiTra = (thongTinDoiTraHienTai != null) ? thongTinDoiTraHienTai.getTongTienTra() : 0L;\n            long canTra = Math.max(0, tongTienHang - tienGiamGia - tienKhauTruDoiTra);\n            long tongPhaiTraTruocKhauTru = Math.max(0, tongTienHang - tienGiamGia);\n            long tienHoanThua = (tongPhaiTraTruocKhauTru < tienKhauTruDoiTra) ? (tienKhauTruDoiTra - tongPhaiTraTruocKhauTru) : 0L;\n\n            String text = txtTienKhachDua.getText().replaceAll(\"[^0-9]\", \"\").trim();\n            long tienDua = text.isEmpty() ? 0 : Long.parseLong(text);\n\n            if (tienHoanThua > 0) {\n                lblTienThoiLai.setText(\"Hoàn thừa: \" + df.format(tienHoanThua));\n                lblTienThoiLai.setForeground(ThemeColors.SUCCESS);\n            } else {\n                long tienThoi = tienDua - canTra;\n                if (canTra == 0 && tienDua == 0) {\n                    lblTienThoiLai.setText(\"0 đ\");\n                    lblTienThoiLai.setForeground(ThemeColors.SUCCESS);\n                } else if (tienThoi >= 0) {\n                    lblTienThoiLai.setText(df.format(tienThoi));\n                    lblTienThoiLai.setForeground(ThemeColors.SUCCESS);\n                } else {\n                    lblTienThoiLai.setText(\"Chưa đủ (thiếu \" + df.format(Math.abs(tienThoi)) + \")\");\n                    lblTienThoiLai.setForeground(ThemeColors.DANGER);\n                }\n            }\n        } catch (NumberFormatException e) {\n            lblTienThoiLai.setText(\"Số tiền không hợp lệ\");\n            lblTienThoiLai.setForeground(ThemeColors.DANGER);\n        }\n    }\n\n    private void lamSachKhungHoaDon() {\n        thongTinDoiTraHienTai = null;\n        if (pnlThongBaoDoiTra != null) {\n            pnlThongBaoDoiTra.setVisible(false);\n        }\n        modelGioHang.setRowCount(0);\n        lblMaHoaDon.setText(utils.MaTuSinhHelper.sinhMaHoaDon(utils.UserSession.getUserId()));\n        dangCapNhatKhach = true;\n        try {\n            txtSdtKhachHang.setText(\"\");\n            txtTenKhachHang.setText(\"\");\n            tenKhachTuDongDien = false;\n            diemHienCo = 0;\n            tienDoiDiem = 0;\n            capNhatDiemSpinner();\n            lblDiemTichLuy.setText(\"Khách vãng lai · 0 điểm\");\n            lblDiemTichLuy.setForeground(ThemeColors.TEXT_SECONDARY);\n            theSpaPassHienTai = null;\n            if (lblSpaPassStatus != null) {\n                lblSpaPassStatus.setText(\"Chưa có thẻ Spa Pass\");\n                lblSpaPassStatus.setForeground(ThemeColors.TEXT_MUTED);\n            }\n            if (btnDungSpaPass != null) {\n                btnDungSpaPass.setEnabled(false);\n            }\n            if (lblThuCungDangChon != null) {\n                lblThuCungDangChon.setText(\"Chưa chọn thú cưng (Khách vãng lai)\");\n                lblThuCungDangChon.setForeground(ThemeColors.TEXT_MUTED);\n            }\n            if (pnlCrossSell != null) {\n                pnlCrossSell.setVisible(false);\n            }\n            crossSellItemHienTai = null;\n            if (txtTienKhachDua != null) {\n                txtTienKhachDua.setText(\"0\");\n                txtTienKhachDua.setEnabled(true);\n            }\n            if (cboPhuongThuc != null) {\n                cboPhuongThuc.setSelectedItem(\"Tiền mặt\");\n            }\n        } finally {\n            dangCapNhatKhach = false;\n        }\n        capNhatTongTien();\n    }\n\n    private void xemTruocInHoaDonK80() {\n        if (modelGioHang == null || modelGioHang.getRowCount() == 0) {\n            JOptionPane.showMessageDialog(this, \"Giỏ hàng đang trống! Vui lòng thêm sản phẩm/dịch vụ để xem trước hóa đơn.\", \"Nhắc nhở\", JOptionPane.INFORMATION_MESSAGE);\n            return;\n        }\n        HoaDonDaThanhToan hd = new HoaDonDaThanhToan();\n        hd.maHoaDon = (lblMaHoaDon != null ? lblMaHoaDon.getText() : utils.MaTuSinhHelper.sinhMaHoaDon(utils.UserSession.getUserId())) + \" (Tạm)\";\n        hd.thoiGian = LocalDateTime.now().format(STATIC_DTF);\n        hd.tenKhach = (txtTenKhachHang != null && !txtTenKhachHang.getText().trim().isEmpty()) ? txtTenKhachHang.getText().trim() : \"Khách vãng lai\";\n        hd.sdt = (txtSdtKhachHang != null) ? txtSdtKhachHang.getText().trim() : \"\";\n        hd.thuNgan = UserSession.getFullName();\n        long tienKhauTru = (thongTinDoiTraHienTai != null) ? thongTinDoiTraHienTai.getTongTienTra() : 0L;\n        hd.tongTienHang = tongTienHang;\n        hd.giamGia = tienGiamGia + tienKhauTru;\n        hd.tongThanhToan = Math.max(0, tongTienHang - tienGiamGia - tienKhauTru);\n        hd.phuongThuc = cboPhuongThuc != null ? (String) cboPhuongThuc.getSelectedItem() : \"Tiền mặt\";\n        hd.trangThai = \"Phiếu tạm tính\";\n        for (int i = 0; i < modelGioHang.getRowCount(); i++) {\n            hd.dsMon.add(new Object[]{\n                    modelGioHang.getValueAt(i, 0),\n                    modelGioHang.getValueAt(i, 1),\n                    modelGioHang.getValueAt(i, 2),\n                    modelGioHang.getValueAt(i, 3),\n                    modelGioHang.getValueAt(i, 4),\n                    modelGioHang.getValueAt(i, 5),\n                    modelGioHang.getValueAt(i, 6)\n            });\n        }\n        long canTraVal = Math.max(0, tongTienHang - tienGiamGia - tienKhauTru);\n        HoaDonPreviewDialog.hienThiHoaDon(this, hd, canTraVal, 0, (int) (canTraVal / 100000), diemHienCo);\n    }\n\n    private void taoDonMoi() {\n        if (modelGioHang.getRowCount() > 0) {\n            int opt = JOptionPane.showConfirmDialog(this,\n                    \"Bạn có muốn xóa đơn hiện tại để tạo hóa đơn mới?\",\n                    \"Tạo đơn mới\",\n                    JOptionPane.YES_NO_OPTION);\n            if (opt != JOptionPane.YES_OPTION) return;\n        }\n        lamSachKhungHoaDon();\n    }\n\n    private void luuTamDonHang() {\n        if (modelGioHang.getRowCount() == 0) {\n            JOptionPane.showMessageDialog(this, \"Hóa đơn đang trống, không thể lưu tạm!\", \"Nhắc nhở\", JOptionPane.WARNING_MESSAGE);\n            return;\n        }\n\n        String tenNhap = txtTenKhachHang.getText().trim();\n        DonHangTam don = new DonHangTam();\n        don.maHoaDon = lblMaHoaDon.getText();\n        don.tenKhach = tenNhap.isEmpty() ? \"Khách vãng lai\" : tenNhap;\n        don.sdt = txtSdtKhachHang.getText().trim();\n        don.diemTichLuy = lblDiemTichLuy.getText();\n        don.thoiGianTao = LocalDateTime.now().format(DateTimeFormatter.ofPattern(\"HH:mm\"));\n        don.tongTien = tongTienHang;\n        don.giamGia = tienGiamGia;\n        don.khachCanTra = Math.max(0, tongTienHang - tienGiamGia);\n        don.phuongThuc = (String) cboPhuongThuc.getSelectedItem();\n\n        for (int i = 0; i < modelGioHang.getRowCount(); i++) {\n            don.dsMon.add(new Object[]{\n                    modelGioHang.getValueAt(i, 0),\n                    modelGioHang.getValueAt(i, 1),\n                    modelGioHang.getValueAt(i, 2),\n                    modelGioHang.getValueAt(i, 3),\n                    modelGioHang.getValueAt(i, 4),\n                    modelGioHang.getValueAt(i, 5),\n                    modelGioHang.getValueAt(i, 6),\n                    modelGioHang.getValueAt(i, 7)\n            });\n        }\n\n        dsDonTam.add(0, don);\n        boolean diskOk = luuDsDonTamXuongDisk();\n        capNhatGiaoDienDonCho();\n\n        if (diskOk) {\n            JOptionPane.showMessageDialog(this,\n                    \"ĐÃ LƯU TẠM ĐƠN HÀNG [\" + don.maHoaDon + \"] THÀNH CÔNG!\\n\" +\n                            \"• Khách: \" + don.tenKhach + \"\\n\" +\n                            \"• Món: \" + don.dsMon.size() + \" món · \" + df.format(don.khachCanTra) + \"\\n\\n\" +\n                            \"Đơn đã được chuyển vào Tab 'Hóa đơn chờ phục vụ' để bạn phục vụ khách tiếp theo.\",\n                    \"Lưu tạm thành công\", JOptionPane.INFORMATION_MESSAGE);\n        } else {\n            JOptionPane.showMessageDialog(this,\n                    \"Đơn hàng [\" + don.maHoaDon + \"] đã được lưu tạm trên RAM nhưng không thể ghi xuống file config/pos_don_tam.dat!\\n\" +\n                            \"Vui lòng lưu ý không tắt ứng dụng trước khi xử lý xong đơn này.\",\n                    \"Cảnh báo lưu tạm\", JOptionPane.WARNING_MESSAGE);\n        }\n\n        lamSachKhungHoaDon();\n    }\n\n    public void tiepNhanDichVuPetHotel(String maPhong, String loaiPhong, String tenBe, String tenChu, String sdt, int soNgay, long donGiaNgay, long tongTien) {\n        chonTabPOS();\n        dangCapNhatKhach = true;\n        try {\n            if (sdt != null && !sdt.trim().isEmpty()) {\n                txtSdtKhachHang.setText(sdt.trim());\n            }\n            if (tenChu != null && !tenChu.trim().isEmpty()) {\n                txtTenKhachHang.setText(tenChu.trim());\n            }\n            tenKhachTuDongDien = false;\n        } finally {\n            dangCapNhatKhach = false;\n        }\n        traCuuKhachHang();\n\n        int stt = modelGioHang.getRowCount() + 1;\n        String tenMon = \"Lưu trú Hotel [\" + maPhong + \"] - \" + loaiPhong + \" (\" + tenBe + \")\";\n        modelGioHang.addRow(new Object[]{\n                stt,\n                \"DV-HOTEL-\" + maPhong,\n                tenMon,\n                soNgay + \" ngày\",\n                1,\n                df.format(tongTien),\n                df.format(tongTien),\n                CAC_BUOC_TIEN_DO[3]\n        });\n        capNhatTongTien();\n\n        JOptionPane.showMessageDialog(this,\n                \"ĐÃ TIẾP NHẬN DỊCH VỤ PET HOTEL VÀO GIỎ HÀNG POS!\\n\" +\n                        \"• Phòng: \" + maPhong + \" (\" + loaiPhong + \")\\n\" +\n                        \"• Bé cưng: \" + tenBe + \" - Chủ: \" + tenChu + \"\\n\" +\n                        \"• Thời gian lưu trú: \" + soNgay + \" ngày\\n\" +\n                        \"• Tổng tiền: \" + df.format(tongTien) + \"\\n\\n\" +\n                        \"Vui lòng kiểm tra giảm giá VIP / đổi điểm và bấm 'THANH TOÁN NGAY'.\",\n                \"Tiếp nhận Pet Hotel thành công\", JOptionPane.INFORMATION_MESSAGE);\n    }\n\n    public void tiepNhanDichVuLichHen(String maLH, String khTen, String sdt, String thuCung, String tenDichVu, String ktv) {\n        chonTabPOS();\n        dangCapNhatKhach = true;\n        try {\n            if (sdt != null && !sdt.trim().isEmpty()) {\n                txtSdtKhachHang.setText(sdt.trim());\n            }\n            if (khTen != null && !khTen.trim().isEmpty()) {\n                txtTenKhachHang.setText(khTen.trim());\n            }\n            tenKhachTuDongDien = false;\n        } finally {\n            dangCapNhatKhach = false;\n        }\n        traCuuKhachHang();\n\n        String maDV = null;\n        long giaDV = 0L;\n        String dvt = \"45 phút\";\n        for (CatalogItem it : allItems) {\n            if (it.loai.toLowerCase().contains(\"dịch vụ\") || it.loai.toLowerCase().contains(\"spa\") || it.loai.toLowerCase().contains(\"grooming\")) {\n                if (it.ten.equalsIgnoreCase(tenDichVu) || tenDichVu.contains(it.ten) || it.ten.contains(tenDichVu) || (it.ma != null && it.ma.equalsIgnoreCase(tenDichVu))) {\n                    maDV = it.ma;\n                    giaDV = it.donGia;\n                    dvt = it.dvt;\n                    break;\n                }\n            }\n        }\n        if (maDV == null) {\n            try {\n                dao.DichVuDAO dvDao = new dao.DichVuDAO();\n                for (entity.DichVu dv : dvDao.getAllDichVu()) {\n                    if (dv.getTenDichVu().equalsIgnoreCase(tenDichVu) || dv.getMaDichVu().equalsIgnoreCase(tenDichVu)\n                            || tenDichVu.contains(dv.getTenDichVu()) || dv.getTenDichVu().contains(tenDichVu)) {\n                        maDV = dv.getMaDichVu();\n                        giaDV = dv.getGiaDichVu() != null ? dv.getGiaDichVu().longValue() : 0L;\n                        dvt = dv.getThoiLuongPhut() > 0 ? (dv.getThoiLuongPhut() + \" phút\") : \"45 phút\";\n                        break;\n                    }\n                }\n            } catch (Exception ignored) {}\n        }\n        if (maDV == null) {\n            maDV = \"DV001\";\n            giaDV = 300000L;\n            dvt = \"90 phút\";\n        }\n\n        int stt = modelGioHang.getRowCount() + 1;\n        String tenMon = tenDichVu + \" (\" + (thuCung != null && !thuCung.isEmpty() ? thuCung : \"Bé cưng\") + \") - KTV: \" + (ktv != null && !ktv.isEmpty() ? ktv : \"Mio Staff\");\n        modelGioHang.addRow(new Object[]{\n                stt,\n                maDV,\n                tenMon,\n                dvt,\n                1,\n                df.format(giaDV),\n                df.format(giaDV),\n                CAC_BUOC_TIEN_DO[0]\n        });\n        capNhatTongTien();\n\n        JOptionPane.showMessageDialog(this,\n                \"ĐÃ TIẾP NHẬN LỊCH HẸN [\" + maLH + \"] VÀO GIỎ HÀNG POS!\\n\" +\n                        \"• Khách hàng: \" + khTen + \" (\" + sdt + \")\\n\" +\n                        \"• Thú cưng: \" + thuCung + \"\\n\" +\n                        \"• Dịch vụ: \" + tenDichVu + \" - Đơn giá: \" + df.format(giaDV) + \"\\n\\n\" +\n                        \"Vui lòng kiểm tra giỏ hàng và tiến hành thanh toán.\",\n                \"Tiếp nhận Lịch hẹn thành công\", JOptionPane.INFORMATION_MESSAGE);\n    }\n\n    public void tiepNhanDoiTraHang(DoiTraTransferData data) {\n        if (data == null) return;\n        chonTabPOS();\n        this.thongTinDoiTraHienTai = data;\n\n        dangCapNhatKhach = true;\n        try {\n            if (data.getSdtKhach() != null && !data.getSdtKhach().trim().isEmpty()) {\n                txtSdtKhachHang.setText(data.getSdtKhach().trim());\n            } else {\n                txtSdtKhachHang.setText(\"\");\n            }\n            if (data.getTenKhach() != null && !data.getTenKhach().trim().isEmpty()) {\n                txtTenKhachHang.setText(data.getTenKhach().trim());\n            } else {\n                txtTenKhachHang.setText(\"\");\n            }\n            tenKhachTuDongDien = false;\n        } finally {\n            dangCapNhatKhach = false;\n        }\n        traCuuKhachHang();\n\n        // Xóa giỏ hàng hiện tại và đưa các món đổi mới vào giỏ\n        modelGioHang.setRowCount(0);\n        if (data.getDsMonMoi() != null) {\n            for (DoiTraTransferData.MonDoiMoi item : data.getDsMonMoi()) {\n                int stt = modelGioHang.getRowCount() + 1;\n                long thanhTien = item.donGia * item.soLuong;\n                modelGioHang.addRow(new Object[]{\n                        stt,\n                        item.maSP,\n                        item.tenSP,\n                        item.dvt,\n                        item.soLuong,\n                        df.format(item.donGia),\n                        df.format(thanhTien),\n                        CAC_BUOC_TIEN_DO[0]\n                });\n            }\n        }\n\n        // Hiển thị thanh thông báo khấu trừ đổi trả\n        if (pnlThongBaoDoiTra != null && lblThongBaoDoiTra != null) {\n            lblThongBaoDoiTra.setText(\"🔄 ĐỔI TRẢ TỪ HÓA ĐƠN [\" + data.getMaHoaDonGoc() + \"] | KHẤU TRỪ: -\" + df.format(data.getTongTienTra()));\n            pnlThongBaoDoiTra.setVisible(true);\n        }\n\n        capNhatTongTien();\n\n        JOptionPane.showMessageDialog(this,\n                \"ĐÃ TIẾP NHẬN YÊU CẦU ĐỔI TRẢ TỪ HÓA ĐƠN [\" + data.getMaHoaDonGoc() + \"]!\\n\" +\n                \"• Khách hàng: \" + (data.getTenKhach() != null ? data.getTenKhach() : \"Khách lẻ\") + \" (\" + (data.getSdtKhach() != null ? data.getSdtKhach() : \"\") + \")\\n\" +\n                \"• Giá trị khấu trừ hàng trả: -\" + df.format(data.getTongTienTra()) + \"\\n\" +\n                \"• Món đổi mới: \" + (data.getDsMonMoi() != null ? data.getDsMonMoi().size() : 0) + \" món đã thêm vào giỏ hàng.\\n\\n\" +\n                \"Thu ngân có thể chọn thêm sản phẩm từ Catalog nếu khách mua thêm hàng,\\n\" +\n                \"sau đó kiểm tra tổng chênh lệch và bấm 'THANH TOÁN'.\",\n                \"Tiếp nhận Đổi trả thành công\", JOptionPane.INFORMATION_MESSAGE);\n    }\n\n    public void huyDoiTraHang() {\n        int cf = JOptionPane.showConfirmDialog(this,\n                \"Bạn có chắc chắn muốn hủy giao dịch đổi trả này không?\\n\" +\n                \"Giỏ hàng sẽ được làm trống và hủy bỏ khấu trừ hàng trả.\",\n                \"Xác nhận hủy đổi trả\", JOptionPane.YES_NO_OPTION, JOptionPane.QUESTION_MESSAGE);\n        if (cf == JOptionPane.YES_OPTION) {\n            thongTinDoiTraHienTai = null;\n            if (pnlThongBaoDoiTra != null) {\n                pnlThongBaoDoiTra.setVisible(false);\n            }\n            modelGioHang.setRowCount(0);\n            capNhatTongTien();\n            JOptionPane.showMessageDialog(this, \"Đã hủy bỏ trạng thái đổi trả thành công.\", \"Thông báo\", JOptionPane.INFORMATION_MESSAGE);\n        }\n    }\n\n    // xử lý bấm nút thanh toán\n    private void thucHienThanhToan() {\n        if (modelGioHang.getRowCount() == 0) {\n            JOptionPane.showMessageDialog(this, \"Giỏ hàng đang trống! Vui lòng chọn sản phẩm hoặc dịch vụ trước khi thanh toán.\", \"Thông báo\", JOptionPane.WARNING_MESSAGE);\n            return;\n        }\n\n        // dừng gõ trên ô bảng nếu đang sửa số lượng\n        if (tblGioHang.isEditing()) {\n            tblGioHang.getCellEditor().stopCellEditing();\n        }\n\n        // coi thử có bé nào đang làm spa chưa xong ko\n        boolean conDichVuChuaXong = false;\n        StringBuilder sbChuaXong = new StringBuilder();\n        for (int i = 0; i < modelGioHang.getRowCount(); i++) {\n            String ma = (String) modelGioHang.getValueAt(i, 1);\n            if (ma != null && ma.startsWith(\"DV\")) {\n                String td = modelGioHang.getValueAt(i, 7) != null ? modelGioHang.getValueAt(i, 7).toString() : \"\";\n                if (!td.startsWith(\"4.\") && !td.contains(\"XONG\") && !td.contains(\"Hoàn tất\")) {\n                    conDichVuChuaXong = true;\n                    sbChuaXong.append(\" • \").append(modelGioHang.getValueAt(i, 2)).append(\" [\").append(td).append(\"]\\n\");\n                }\n            }\n        }\n        if (conDichVuChuaXong) {\n            int opt = JOptionPane.showConfirmDialog(this,\n                    \"CẢNH BÁO AN TOÀN TIẾN ĐỘ DỊCH VỤ:\\n\" +\n                    \"Đơn hàng vẫn còn dịch vụ thú cưng chưa hoàn tất:\\n\" +\n                    sbChuaXong.toString() + \"\\n\" +\n                    \"Bạn có chắc chắn muốn tiến hành thanh toán ngay bây giờ không?\",\n                    \"Cảnh báo thanh toán an toàn\",\n                    JOptionPane.YES_NO_OPTION, JOptionPane.WARNING_MESSAGE);\n            if (opt != JOptionPane.YES_OPTION) {\n                return;\n            }\n        }\n\n        // tính lại tiền cần trả sau khi trừ giảm giá với tiền đổi hàng cũ\n        long tienKhauTruDoiTra = (thongTinDoiTraHienTai != null) ? thongTinDoiTraHienTai.getTongTienTra() : 0L;\n        long canTra = Math.max(0, tongTienHang - tienGiamGia - tienKhauTruDoiTra);\n        long tongPhaiTraTruocKhauTru = Math.max(0, tongTienHang - tienGiamGia);\n        long tienHoanThua = (tongPhaiTraTruocKhauTru < tienKhauTruDoiTra) ? (tienKhauTruDoiTra - tongPhaiTraTruocKhauTru) : 0L;\n\n        String tienDuaRaw = txtTienKhachDua != null ? txtTienKhachDua.getText().replaceAll(\"[^0-9]\", \"\").trim() : \"\";\n        long tienKhachDuaVal;\n        try {\n            tienKhachDuaVal = tienDuaRaw.isEmpty() ? 0 : Long.parseLong(tienDuaRaw);\n        } catch (NumberFormatException ex) {\n            tienKhachDuaVal = 0;\n        }\n\n        String pttt = cboPhuongThuc != null ? (String) cboPhuongThuc.getSelectedItem() : \"Tiền mặt\";\n        if (pttt == null) pttt = \"Tiền mặt\";\n\n        String maHD = lblMaHoaDon.getText();\n        String sdt = txtSdtKhachHang.getText().trim();\n        String tenNhap = txtTenKhachHang.getText().trim();\n        String tenKhach = tenNhap.isEmpty() ? (sdt.isEmpty() ? \"Khách vãng lai\" : \"Khách hàng mới\") : tenNhap;\n\n        long tienThoiVal = 0;\n        if (tienHoanThua > 0) {\n            tienThoiVal = tienHoanThua;\n        // tiền mặt thì kiểm tra xem khách đưa đủ chưa\n        } else if (\"Tiền mặt\".equals(pttt)) {\n            if (canTra > 0 && tienKhachDuaVal < canTra) {\n                long thieu = canTra - tienKhachDuaVal;\n                JOptionPane.showMessageDialog(this,\n                        \"Tiền khách đưa chưa đủ để hoàn tất thanh toán!\\n\\n\"\n                        + \"• Tổng tiền cần thanh toán: \" + df.format(canTra) + \"\\n\"\n                        + \"• Số tiền khách đã đưa: \" + df.format(tienKhachDuaVal) + \"\\n\"\n                        + \"• Số tiền còn thiếu: \" + df.format(thieu) + \"\\n\\n\"\n                        + \"Vui lòng nhập đủ tiền trước khi hoàn tất hóa đơn.\",\n                        \"Chưa đủ tiền thanh toán\",\n                        JOptionPane.WARNING_MESSAGE);\n                if (txtTienKhachDua != null) {\n                    txtTienKhachDua.requestFocus();\n                    txtTienKhachDua.selectAll();\n                }\n                return;\n            }\n            tienThoiVal = Math.max(0, tienKhachDuaVal - canTra);\n        } else { // chuyển khoản thì hiện popup vietqr\n            if (canTra > 0) {\n                boolean daNhanTien = VietQRDialog.xacNhanThanhToanVietQR(this, maHD, canTra, tenKhach);\n                if (!daNhanTien) {\n                    return; // Thu ngân hoặc khách hủy giao dịch QR\n                }\n            }\n            tienKhachDuaVal = canTra;\n            tienThoiVal = 0;\n            if (txtTienKhachDua != null) {\n                txtTienKhachDua.setText(canTra == 0 ? \"0\" : String.valueOf(canTra));\n            }\n            if (lblTienThoiLai != null) {\n                lblTienThoiLai.setText(\"0 đ\");\n            }\n        }\n\n        String nowStr = LocalDateTime.now().format(dtf);\n\n        // Tính điểm đã dùng, điểm thưởng mới và khấu trừ điểm trả hàng (Chuẩn hệ thống: 100.000 đ = 1 điểm)\n        try {\n            if (spnDiemDung != null) spnDiemDung.commitEdit();\n        } catch (Exception ignored) {}\n        int diemDaDung = (spnDiemDung != null && diemHienCo > 0) ? ((Number) spnDiemDung.getValue()).intValue() : 0;\n        if (diemDaDung < 0) diemDaDung = 0;\n        if (diemDaDung > diemHienCo) diemDaDung = diemHienCo;\n        int diemThuongMoi = (sdt.isEmpty() && tenKhach.equalsIgnoreCase(\"Khách vãng lai\")) ? 0 : (int) (canTra / 100000L);\n        int diemKhauTruDT = (thongTinDoiTraHienTai != null) ? thongTinDoiTraHienTai.getDiemKhauTru() : 0;\n        int tongDiemMoi = Math.max(0, diemHienCo - diemDaDung - diemKhauTruDT) + diemThuongMoi;\n\n        // Đảm bảo khách hàng tồn tại trong CSDL trước khi tạo Hóa đơn\n        String sdtLuu = \"\";\n        if (!sdt.isEmpty() || (!tenNhap.isEmpty() && !tenNhap.equalsIgnoreCase(\"Khách vãng lai\"))) {\n            sdtLuu = sdt.isEmpty() ? (\"KH-\" + tenNhap) : sdt;\n            KhachHang khSaved = BanHangBus.luuHoacCapNhatKhachHang(sdtLuu, tenKhach, diemHienCo);\n            if (khSaved != null) {\n                tenKhach = khSaved.getHoTen();\n                sdt = khSaved.getSoDienThoai();\n            } else {\n                JOptionPane.showMessageDialog(this, \"Không lưu được hồ sơ khách hàng. Vui lòng kiểm tra kết nối và thử lại.\",\n                        \"Chưa thanh toán\", JOptionPane.ERROR_MESSAGE);\n                return;\n            }\n        }\n\n        // Lưu Hóa đơn & trừ tồn kho FEFO vào CSDL SQL Server qua BanHangBus\n        try {\n            bus.BanHangBus busThanhToan = new bus.BanHangBus();\n            bus.KhoLoHangBus busKho = new bus.KhoLoHangBus();\n            java.util.List<entity.LoHang> allLo = busThanhToan.layTatCaLoHang();\n\n            entity.HoaDon hdReal = new entity.HoaDon();\n            hdReal.setMaHoaDon(maHD);\n            hdReal.setNgayLap(LocalDateTime.now());\n            hdReal.setThoiGianThanhToan(LocalDateTime.now());\n            hdReal.setGiamGia(java.math.BigDecimal.valueOf(tienGiamGia + tienKhauTruDoiTra));\n            hdReal.setThanhTien(java.math.BigDecimal.valueOf(canTra));\n            hdReal.setPhuongThucThanhToan(pttt);\n            hdReal.setTrangThaiHoaDon(\"Đã thanh toán\");\n\n            entity.NhanVien nv = new entity.NhanVien();\n            String maNhanVienDangNhap = utils.UserSession.getUserId();\n            if (maNhanVienDangNhap == null || maNhanVienDangNhap.isBlank()) {\n                throw new IllegalStateException(\"Phiên đăng nhập đã hết hạn; vui lòng đăng nhập lại trước khi thanh toán\");\n            }\n            nv.setMaNhanVien(maNhanVienDangNhap);\n            hdReal.setNhanVien(nv);\n\n            if (!sdt.isEmpty()) {\n                entity.KhachHang kh = new bus.KhachHangBus().timKhachHangTheoSoDienThoai(sdt);\n                if (kh != null) {\n                    hdReal.setKhachHang(kh);\n                }\n            }\n\n            int ctSeq = 1;\n\n            // 1. KIỂM TRA TỒN KHO KHẢ DỤNG FEFO VÀ KHỞI TẠO CHI TIẾT HÓA ĐƠN TRƯỚC\n            for (int i = 0; i < modelGioHang.getRowCount(); i++) {\n                String ma = (String) modelGioHang.getValueAt(i, 1);\n                String dvt = modelGioHang.getValueAt(i, 3) != null ? modelGioHang.getValueAt(i, 3).toString() : \"\";\n                int sl = Integer.parseInt(modelGioHang.getValueAt(i, 4).toString().replaceAll(\"[^0-9]\", \"\"));\n                String dgStr = modelGioHang.getValueAt(i, 5).toString().replaceAll(\"[^0-9]\", \"\");\n                java.math.BigDecimal dg = dgStr.isEmpty() ? java.math.BigDecimal.ZERO : new java.math.BigDecimal(dgStr);\n\n                if (ma != null && ma.startsWith(\"SP\")) {\n                    entity.QuyDoiDonVi qd = null;\n                    try {\n                        java.util.List<entity.QuyDoiDonVi> listQd = busKho.layQuyDoiBySanPham(ma);\n                        if (listQd != null && !listQd.isEmpty()) {\n                            for (entity.QuyDoiDonVi q : listQd) {\n                                if (q.getDonViTinh() != null && q.getDonViTinh().getTenDonVi().equalsIgnoreCase(dvt)) {\n                                    qd = q;\n                                    break;\n                                }\n                            }\n                            if (qd == null) {\n                                qd = listQd.get(0);\n                            }\n                        }\n                    } catch (Exception ignored) {}\n\n                    int tyLe = (qd != null && qd.getTyLeQuyDoi() > 0) ? qd.getTyLeQuyDoi() : 1;\n                    int soLuongCoSoCanXuat = sl * tyLe;\n                    int remainingCoSo = soLuongCoSoCanXuat;\n                    java.math.BigDecimal remainingLineMoney = dg.multiply(java.math.BigDecimal.valueOf(sl));\n\n                    if (allLo != null) {\n                        for (entity.LoHang candidate : allLo) {\n                            if (remainingCoSo <= 0) break;\n                            if (candidate.getSanPham() != null\n                                    && candidate.getSanPham().getMaSanPham().equalsIgnoreCase(ma)\n                                    && candidate.getSoLuongTon() > 0) {\n                                if (candidate.getHanSuDung() != null && candidate.getHanSuDung().isBefore(java.time.LocalDate.now())) {\n                                    continue; // Bỏ qua lô đã hết hạn sử dụng theo chuẩn FEFO an toàn\n                                }\n                                int take = Math.min(remainingCoSo, candidate.getSoLuongTon());\n                                candidate.setSoLuongTon(candidate.getSoLuongTon() - take);\n\n                                java.math.BigDecimal itemTotal = dg.multiply(java.math.BigDecimal.valueOf(sl));\n                                java.math.BigDecimal ctTotal = (take == remainingCoSo) ? remainingLineMoney\n                                        : itemTotal.multiply(java.math.BigDecimal.valueOf(take)).divide(java.math.BigDecimal.valueOf(soLuongCoSoCanXuat), 0, java.math.RoundingMode.HALF_UP);\n                                remainingLineMoney = remainingLineMoney.subtract(ctTotal);\n\n                                int slXuat;\n                                java.math.BigDecimal donGiaXuat = dg;\n                                entity.QuyDoiDonVi qdXuat = qd;\n                                if (take == soLuongCoSoCanXuat) {\n                                    slXuat = sl;\n                                } else if (tyLe > 1 && take % tyLe == 0) {\n                                    slXuat = take / tyLe;\n                                } else if (tyLe > 1) {\n                                    // Bán lẻ theo đơn vị cơ sở vì lô chia không tròn quy cách hộp/thùng\n                                    slXuat = take;\n                                    donGiaXuat = ctTotal.divide(java.math.BigDecimal.valueOf(take), 2, java.math.RoundingMode.HALF_UP);\n                                    qdXuat = null;\n                                } else {\n                                    slXuat = take;\n                                }\n\n                                entity.ChiTietXuatLo ct = new entity.ChiTietXuatLo(\n                                        maHD + \"_CT\" + (ctSeq++), hdReal, slXuat, donGiaXuat, candidate, qdXuat\n                                );\n                                ct.setSoLuongXuatCoSo(take);\n                                ct.setThanhTien(ctTotal);\n                                hdReal.addChiTiet(ct);\n                                remainingCoSo -= take;\n                            }\n                        }\n                    }\n                    if (remainingCoSo > 0) {\n                        JOptionPane.showMessageDialog(this,\n                                \"Sản phẩm [\" + ma + \"] không đủ số lượng tồn khả dụng trong các lô hàng còn hạn (còn thiếu \" + remainingCoSo + \" đơn vị cơ sở)!\\n\"\n                                + \"Hệ thống dừng thanh toán và chưa ghi nhận phiếu đổi trả hay hóa đơn.\",\n                                \"Cảnh báo thiếu tồn kho FEFO\",\n                                JOptionPane.WARNING_MESSAGE);\n                        return;\n                    }\n                } else if (ma != null && (ma.startsWith(\"DV\") || ma.startsWith(\"GOI_SPA\"))) {\n                    String actualMaDv = ma;\n                    if (actualMaDv.startsWith(\"DV-HOTEL-\")) {\n                        actualMaDv = \"DV008\"; // Ánh xạ mã dịch vụ Pet Hotel vào mã chuẩn CSDL\n                    } else if (actualMaDv.equals(\"DV_SPAPASS\") || actualMaDv.startsWith(\"GOI_SPA\")) {\n                        actualMaDv = \"DV004\"; // Ánh xạ sang mã dịch vụ Tắm Sấy Chuẩn (DV004) thay vì DV001 Cắt tỉa\n                    }\n                    entity.DichVu dv = new entity.DichVu();\n                    dv.setMaDichVu(actualMaDv);\n\n                    // Trích xuất KTV thực hiện dịch vụ từ dòng giỏ hàng (chống ghi nhận thu ngân thành KTV)\n                    entity.NhanVien ktvThucHien = nv;\n                    String tenDong = String.valueOf(modelGioHang.getValueAt(i, 2));\n                    try {\n                        List<entity.NhanVien> dsAllNV = new bus.NhanVienBus().layDanhSachNhanVien();\n                        for (entity.NhanVien n : dsAllNV) {\n                            if (tenDong.contains(n.getHoTen()) || tenDong.contains(n.getMaNhanVien())) {\n                                ktvThucHien = n;\n                                break;\n                            }\n                        }\n                        if (ktvThucHien == nv) {\n                            // Nếu vẫn là thu ngân quầy, tìm nhân viên chuyên viên Spa (NVCS/KTV) để phân bổ\n                            for (entity.NhanVien n : dsAllNV) {\n                                if (n.getChucVu() != null && (n.getChucVu().contains(\"Spa\") || n.getChucVu().contains(\"KTV\") || n.getChucVu().contains(\"Chăm sóc\"))) {\n                                    ktvThucHien = n;\n                                    break;\n                                }\n                            }\n                        }\n                    } catch (Exception ignored) {}\n\n                    java.math.BigDecimal hoaHong = dg.multiply(java.math.BigDecimal.valueOf(sl))\n                            .multiply(new java.math.BigDecimal(\"0.10\")).setScale(0, java.math.RoundingMode.HALF_UP);\n\n                    entity.ChiTietDichVu ct = new entity.ChiTietDichVu(\n                            maHD + \"_CT\" + (ctSeq++), hdReal, sl, dg, dv, null, ktvThucHien, hoaHong\n                    );\n                    if (ma.startsWith(\"DV-HOTEL-\")) ct.setMaPhongHotel(ma.substring(\"DV-HOTEL-\".length()));\n                    ct.setSuDungSpaPass(\"DV_SPAPASS\".equals(ma));\n                    hdReal.addChiTiet(ct);\n                }\n            }\n\n            // 2. Chuẩn bị phiếu đổi trả; việc lưu sẽ được gộp cùng transaction hóa đơn.\n            entity.PhieuDoiTra pdt = null;\n            if (thongTinDoiTraHienTai != null) {\n                pdt = new entity.PhieuDoiTra();\n                pdt.setMaPhieuDoiTra(utils.MaTuSinhHelper.sinhMaPhieuDoiTra());\n                entity.HoaDon hdGoc = new entity.HoaDon();\n                hdGoc.setMaHoaDon(thongTinDoiTraHienTai.getMaHoaDonGoc());\n                pdt.setHoaDonGoc(hdGoc);\n                entity.NhanVien nvDT = new entity.NhanVien();\n                nvDT.setMaNhanVien(maNhanVienDangNhap);\n                pdt.setNhanVien(nvDT);\n                pdt.setNgayDoiTra(LocalDateTime.now());\n                pdt.setLyDoDoiTra(\"Đổi sang sản phẩm khác tại quầy POS\");\n                pdt.setTongTienHoan(java.math.BigDecimal.valueOf(tienHoanThua));\n                pdt.setTrangThaiDoiTra(\"Hoàn thành\");\n\n                int idx = 1;\n                if (thongTinDoiTraHienTai.getDsMonTra() != null) {\n                    for (DoiTraTransferData.MonTraLai mon : thongTinDoiTraHienTai.getDsMonTra()) {\n                        entity.ChiTietDoiTra ctDoiTra = new entity.ChiTietDoiTra(\n                                pdt.getMaPhieuDoiTra() + \"_\" + (idx++),\n                                pdt,\n                                new entity.SanPham(mon.maSP, null, \"\", \"\"),\n                                mon.soLuong,\n                                java.math.BigDecimal.valueOf(mon.thanhTien)\n                        );\n                        ctDoiTra.setSoLo(mon.soLo);\n                        ctDoiTra.setSoLuongCoSoHoan(mon.soLuongCoSoHoan);\n                        ctDoiTra.setSoLuongCoSoTra(mon.soLuongCoSoTra);\n                        pdt.addChiTietDoiTra(ctDoiTra);\n                    }\n                }\n            }\n\n            if (pdt != null) pdt.setTongTienHoan(java.math.BigDecimal.valueOf(tienHoanThua));\n\n            String maTheSuDung = null;\n            entity.TheSpaPass theMoi = null;\n            List<String> dsMaPhongHotel = new ArrayList<>();\n            for (int i = 0; i < modelGioHang.getRowCount(); i++) {\n                String ma = String.valueOf(modelGioHang.getValueAt(i, 1));\n                String ten = String.valueOf(modelGioHang.getValueAt(i, 2));\n                if (ma.startsWith(\"DV-HOTEL-\")) {\n                    dsMaPhongHotel.add(ma.substring(\"DV-HOTEL-\".length()));\n                }\n                if (\"DV_SPAPASS\".equals(ma)) {\n                    if (theSpaPassHienTai == null || !theSpaPassHienTai.isKhaDung()) {\n                        throw new IllegalStateException(\"Không tìm thấy Spa Pass còn hiệu lực để trừ lượt\");\n                    }\n                    maTheSuDung = theSpaPassHienTai.getMaThe();\n                }\n                if (ma.startsWith(\"GOI_SPA\") || ten.contains(\"Spa Pass\") || ten.contains(\"Gói Spa\")) {\n                    if (theMoi != null) {\n                        throw new IllegalStateException(\"Mỗi hóa đơn chỉ được kích hoạt một gói Spa Pass\");\n                    }\n                    if (sdt == null || sdt.isBlank()) {\n                        throw new IllegalStateException(\"Mua Spa Pass bắt buộc phải chọn khách hàng có số điện thoại\");\n                    }\n                    int soBuoi = (ma.contains(\"10\") || ten.contains(\"10\")) ? 10 : 5;\n                    String tienGoiText = String.valueOf(modelGioHang.getValueAt(i, 6)).replaceAll(\"[^0-9]\", \"\");\n                    long giaGoi = tienGoiText.isEmpty() ? 0L : Long.parseLong(tienGoiText);\n                    theMoi = new entity.TheSpaPass(\n                            utils.MaTuSinhHelper.sinhMaTheSpaPass(sdt),\n                            sdt.trim(), tenKhach, ten, soBuoi, 0, giaGoi,\n                            LocalDate.now(), LocalDate.now().plusDays(soBuoi > 5 ? 120 : 90)\n                    );\n                }\n            }\n            if (maTheSuDung != null && theMoi != null) {\n                throw new IllegalStateException(\"Không thể vừa dùng lượt vừa kích hoạt Spa Pass mới trong cùng hóa đơn\");\n            }\n\n            // 3. Hóa đơn, đổi trả, kho và Spa Pass cùng commit/rollback.\n            boolean okHD = busThanhToan.luuGiaoDichPosDayDu(\n                    hdReal, pdt, maTheSuDung, theMoi, dsMaPhongHotel,\n                    diemDaDung, diemKhauTruDT);\n            if (!okHD) {\n                throw new SQLException(\"Lưu hóa đơn và cập nhật kho không thành công trong CSDL SQL Server!\");\n            }\n\n            if (hdReal.getKhachHang() == null) {\n                diemThuongMoi = 0;\n                tongDiemMoi = 0;\n            } else {\n                entity.KhachHang persisted = new bus.KhachHangBus().timKhachHangTheoSoDienThoai(sdt);\n                if (persisted != null) tongDiemMoi = persisted.getDiemTichLuy();\n            }\n\n            // Đồng bộ lại từ DB; không cộng RAM thủ công để tránh hoàn kho hai lần/sai lô.\n            KhoLoHangPanel.dongBoLoHangTuDatabase();\n            BanHangPOSPanel.dongBoToanBoCatalogVaGiaoDien();\n            SpaPassBus.dongBoDuLieuTuDatabase();\n            if (!dsMaPhongHotel.isEmpty()) {\n                PetHotelPanel.dongBoVaLamMoiGiaoDien();\n            }\n        } catch (Exception ex) {\n            System.err.println(\"[BanHangPOSPanel] Lỗi ghi Hóa đơn CSDL: \" + ex.getMessage());\n            JOptionPane.showMessageDialog(this,\n                    \"KHÔNG THỂ LƯU HÓA ĐƠN VÀO CƠ SỞ DỮ LIỆU SQL SERVER!\\n\\nChi tiết lỗi: \" + ex.getMessage()\n                    + \"\\n\\n(Hệ thống đã dừng lại và không in hóa đơn ảo vì CSDL chưa ghi nhận thành công)\",\n                    \"Lỗi Giao Dịch CSDL\",\n                    JOptionPane.ERROR_MESSAGE);\n            return;\n        }\n\n        // Đồng bộ tức thời tồn kho Catalog và Lô hàng FEFO từ Database xuống giao diện\n        dongBoToanBoCatalogVaGiaoDien();\n        gui.KhoLoHangPanel.dongBoLoHangTuDatabase();\n\n        HoaDonDaThanhToan hd = new HoaDonDaThanhToan();\n        hd.maHoaDon = maHD;\n        hd.thoiGian = nowStr;\n        hd.tenKhach = tenKhach;\n        hd.sdt = sdt;\n        hd.thuNgan = utils.UserSession.getFullName();\n        hd.tongTienHang = tongTienHang;\n        hd.giamGia = tienGiamGia + tienKhauTruDoiTra;\n        hd.tongThanhToan = canTra;\n        hd.phuongThuc = pttt;\n        hd.trangThai = \"Đã thanh toán\";\n\n        for (int i = 0; i < modelGioHang.getRowCount(); i++) {\n            hd.dsMon.add(new Object[]{\n                    modelGioHang.getValueAt(i, 0),\n                    modelGioHang.getValueAt(i, 1),\n                    modelGioHang.getValueAt(i, 2),\n                    modelGioHang.getValueAt(i, 3),\n                    modelGioHang.getValueAt(i, 4),\n                    modelGioHang.getValueAt(i, 5),\n                    modelGioHang.getValueAt(i, 6),\n                    modelGioHang.getValueAt(i, 7)\n            });\n        }\n\n        dsLichSuHoaDon.add(0, hd);\n        for (BanHangPOSPanel inst : INSTANCES) {\n            inst.capNhatBangLichSu();\n        }\n        TongQuanPanel.lamMoiDuLieuDashboardAll();\n\n        // Hiển thị Biểu mẫu Hóa đơn bán hàng (Supermarket / Pet Shop Receipt) ngay sau khi thanh toán\n        HoaDonPreviewDialog.hienThiHoaDon(this, hd, tienKhachDuaVal, tienThoiVal, diemThuongMoi, tongDiemMoi);\n\n        thongTinDoiTraHienTai = null;\n        if (pnlThongBaoDoiTra != null) {\n            pnlThongBaoDoiTra.setVisible(false);\n        }\n\n        lamSachKhungHoaDon();\n    }\n\n    /**\n     * Mô hình 3: Cảnh báo Dị ứng Thực phẩm (Allergy Guard)\n     * Trả về true nếu an toàn hoặc khách xác nhận tự chọn mua.\n     * Trả về false nếu thu ngân chọn \"Đổi sang món khác\".\n     */\n    public boolean kiemTraVaCanhBaoDiUng(CatalogItem item) {\n        if (lblThuCungDangChon == null || item == null) return true;\n        String tcText = lblThuCungDangChon.getText();\n        if (tcText == null || tcText.contains(\"Chưa chọn\") || tcText.contains(\"Khách vãng lai\") || tcText.contains(\"bình thường\")) {\n            return true; // Khách vãng lai / chưa chọn thú cưng / sức khỏe bình thường -> Không cảnh báo\n        }\n\n        String itemNameLower = item.ten != null ? item.ten.toLowerCase() : \"\";\n        boolean canhBaoGa = tcText.contains(\"DỊ ỨNG ĐẠM GÀ\") && (itemNameLower.contains(\"gà\") || itemNameLower.contains(\"chicken\") || \"SP001\".equalsIgnoreCase(item.ma) || \"SP002\".equalsIgnoreCase(item.ma));\n        boolean canhBaoLactose = tcText.contains(\"DỊ ỨNG LACTOSE\") && (itemNameLower.contains(\"sữa\") || itemNameLower.contains(\"milk\") || itemNameLower.contains(\"bơ\") || itemNameLower.contains(\"cheese\") || itemNameLower.contains(\"lactose\"));\n\n        if (!canhBaoGa && !canhBaoLactose) {\n            return true;\n        }\n\n        if (GraphicsEnvironment.isHeadless()) {\n            return true;\n        }\n\n        String lyDoDiUng = canhBaoGa ? \"DỊ ỨNG ĐẠM GÀ\" : \"DỊ ỨNG LACTOSE (SỮA/BƠ)\";\n        String loiKhuyen = canhBaoGa ? \"Khuyên dùng: Đổi sang hạt/pate vị Cá hồi hoặc Cừu để tránh kích ứng da & đường ruột.\"\n                                     : \"Khuyên dùng: Đổi sang các dòng sữa hạt chuyên dụng hoặc pate không chứa lactose.\";\n\n        Object[] options = {\"Đổi sang món khác (Khuyên dùng)\", \"Khách xác nhận tự chọn mua\"};\n        int luaChon = JOptionPane.showOptionDialog(\n                this,\n                \"⚠️ CẢNH BÁO AN TOÀN SỨC KHỎE (ALLERGY GUARD):\\n\\n\"\n                        + \"Thú cưng đang chọn có tiền sử: [\" + lyDoDiUng + \"]\\n\"\n                        + \"Món đang thêm: \" + item.ten + \"\\n\\n\"\n                        + loiKhuyen + \"\\n\\n\"\n                        + \"Bạn muốn xử lý thế nào?\",\n                \"Cảnh báo dị ứng thú cưng\",\n                JOptionPane.YES_NO_OPTION,\n                JOptionPane.WARNING_MESSAGE,\n                null,\n                options,\n                options[0]\n        );\n\n        return luaChon == 1; // 1 = Khách xác nhận tự chọn mua -> Tiếp tục thêm vào giỏ; 0 hoặc đóng dialog = Hủy/Đổi món\n    }\n\n    /**\n     * Mô hình 3: Gợi ý bán kèm thông minh (Smart Cross-Sell)\n     */\n    private void capNhatThanhCrossSell() {\n        if (pnlCrossSell == null || modelGioHang == null) return;\n        if (modelGioHang.getRowCount() == 0) {\n            pnlCrossSell.setVisible(false);\n            crossSellItemHienTai = null;\n            return;\n        }\n\n        boolean coDichVu = false;\n        boolean coSanPham = false;\n        boolean daCoBioCare = false;\n        boolean daCoPate = false;\n\n        for (int i = 0; i < modelGioHang.getRowCount(); i++) {\n            String ma = (String) modelGioHang.getValueAt(i, 1);\n            String ten = (String) modelGioHang.getValueAt(i, 2);\n            if (ma != null && (ma.startsWith(\"DV\") || (ten != null && (ten.contains(\"Spa\") || ten.contains(\"Tắm\") || ten.contains(\"Khách sạn\"))))) {\n                coDichVu = true;\n            }\n            if (ma != null && (ma.startsWith(\"SP\") || (ten != null && (ten.contains(\"Hạt\") || ten.contains(\"Pate\") || ten.contains(\"Xịt\"))))) {\n                coSanPham = true;\n            }\n            if (\"SP004\".equalsIgnoreCase(ma) || (ten != null && ten.contains(\"Bio-Care\"))) {\n                daCoBioCare = true;\n            }\n            if (\"SP002\".equalsIgnoreCase(ma) || \"SP008\".equalsIgnoreCase(ma) || (ten != null && ten.contains(\"Pate\"))) {\n                daCoPate = true;\n            }\n        }\n\n        if (coDichVu && !daCoBioCare) {\n            crossSellItemHienTai = new CatalogItem(\n                    \"SP004\", \"Xịt trị ve rận Bio-Care 100ml (-10%)\", \"Hàng hóa\", \"Chai\", \"LÔ-BC2026\", 25, 67500, IconHelper.SHIELD, \"Bảo vệ ve rận sau tắm\"\n            );\n            lblCrossSellText.setText(\"💡 Khuyên dùng sau Spa: Xịt trị ve rận Bio-Care giảm 10% còn 67.500 đ\");\n            pnlCrossSell.setVisible(true);\n        } else if (coSanPham && !daCoPate) {\n            String tcText = lblThuCungDangChon != null ? lblThuCungDangChon.getText() : \"\";\n            if (tcText != null && tcText.contains(\"DỊ ỨNG ĐẠM GÀ\")) {\n                crossSellItemHienTai = new CatalogItem(\n                        \"SP008\", \"Pate Whiskas Vị Cá Thu 85g (-10%)\", \"Hàng hóa\", \"Gói\", \"LÔ-WH2026\", 50, 18000, IconHelper.SHOPPING_BAG, \"Đạm cá biển, an toàn dị ứng gà\"\n                );\n                lblCrossSellText.setText(\"💡 Bé dị ứng gà: Pate Cá Biển dinh dưỡng giảm 10% còn 18.000 đ\");\n            } else {\n                crossSellItemHienTai = new CatalogItem(\n                        \"SP002\", \"Pate Whiskas Vị Cá Thu 85g (-10%)\", \"Hàng hóa\", \"Lon\", \"LÔ-WS2026\", 45, 18000, IconHelper.SHOPPING_BAG, \"Bổ sung bữa ăn ngon miệng\"\n                );\n                lblCrossSellText.setText(\"💡 Mua kèm Thức ăn: Pate Whiskas dinh dưỡng giảm 10% còn 18.000 đ\");\n            }\n            pnlCrossSell.setVisible(true);\n        } else {\n            pnlCrossSell.setVisible(false);\n            crossSellItemHienTai = null;\n        }\n    }\n\n    private void themSanPhamCrossSellHienTai() {\n        if (crossSellItemHienTai != null) {\n            themSanPhamVaoGio(crossSellItemHienTai);\n            if (pnlCrossSell != null) {\n                pnlCrossSell.setVisible(false);\n            }\n        }\n    }\n\n    /**\n     * Mô hình 1: Thẻ Spa Pass Punch Card - Dùng 1 buổi\n     */\n    private void suDungLuotSpaPass() {\n        if (theSpaPassHienTai == null || !theSpaPassHienTai.isKhaDung()) {\n            JOptionPane.showMessageDialog(this, \"Khách hàng không có thẻ Spa Pass hoặc thẻ đã hết số buổi khả dụng!\", \"Spa Pass\", JOptionPane.WARNING_MESSAGE);\n            return;\n        }\n\n        for (int i = 0; i < modelGioHang.getRowCount(); i++) {\n            String ma = (String) modelGioHang.getValueAt(i, 1);\n            if (\"DV_SPAPASS\".equals(ma)) {\n                JOptionPane.showMessageDialog(this, \"Hóa đơn này đã có 1 lượt trừ buổi Spa Pass!\", \"Spa Pass\", JOptionPane.INFORMATION_MESSAGE);\n                return;\n            }\n        }\n\n        CatalogItem passItem = new CatalogItem(\n                \"DV_SPAPASS\",\n                \"Dịch vụ Spa Grooming (Trừ Thẻ Pass \" + theSpaPassHienTai.getMaThe() + \")\",\n                \"Spa & Trị liệu\",\n                \"Buổi\",\n                \"KTV Chuyên nghiệp\",\n                999,\n                0,\n                IconHelper.SPARKLES,\n                \"Buổi Spa Grooming trọn gói từ Thẻ Pass gia đình\"\n        );\n        themSanPhamVaoGio(passItem);\n        if (btnDungSpaPass != null) {\n            btnDungSpaPass.setEnabled(false);\n        }\n        JOptionPane.showMessageDialog(\n                this,\n                \"Đã áp dụng 1 buổi Spa Grooming (0 đ) từ thẻ \" + theSpaPassHienTai.getTenThe() + \"!\\n\"\n                        + \"Số buổi còn lại sau đơn này: \" + (theSpaPassHienTai.getSoBuoiConLai() - 1) + \"/\" + theSpaPassHienTai.getTongSoBuoi() + \" buổi.\",\n                \"Spa Pass Punch Card\",\n                JOptionPane.INFORMATION_MESSAGE\n        );\n    }\n\n    private void moDialogTraCuuSpaPass() {\n        JDialog dlg = new JDialog((Frame) SwingUtilities.getWindowAncestor(this), \"TRA CỨU & QUẢN LÝ THẺ SPA PASS TẠI QUẦY\", true);\n        dlg.setSize(820, 520);\n        dlg.setLocationRelativeTo(this);\n        dlg.setLayout(new BorderLayout(10, 10));\n        ((JPanel) dlg.getContentPane()).setBorder(new EmptyBorder(14, 16, 14, 16));\n        dlg.getContentPane().setBackground(ThemeColors.BACKGROUND);\n\n        JPanel pnlTop = new JPanel(new FlowLayout(FlowLayout.LEFT, 10, 0));\n        pnlTop.setOpaque(false);\n\n        JTextField txtSearch = new JTextField(18);\n        txtSearch.setPreferredSize(new Dimension(240, 36));\n        txtSearch.putClientProperty(\"JTextField.placeholderText\", \"Tìm theo SĐT, tên khách, mã thẻ...\");\n        txtSearch.putClientProperty(\"JTextField.leadingIcon\", IconHelper.getIcon(IconHelper.SEARCH, 15, ThemeColors.TEXT_MUTED));\n        txtSearch.setBorder(ThemeColors.createInputBorder());\n\n        String sdtHienTai = txtSdtKhachHang != null ? txtSdtKhachHang.getText().trim() : \"\";\n        if (!sdtHienTai.isEmpty()) {\n            txtSearch.setText(sdtHienTai);\n        }\n\n        JButton btnPhatHanh = ThemeColors.createPrimaryButton(\"+ Bán thẻ mới\", IconHelper.getIcon(IconHelper.PLUS, 13, Color.WHITE));\n        pnlTop.add(new JLabel(\"Tìm kiếm:\"));\n        pnlTop.add(txtSearch);\n        pnlTop.add(btnPhatHanh);\n\n        String[] cols = {\"Mã Thẻ\", \"Khách hàng\", \"Số điện thoại\", \"Tên gói\", \"Tổng\", \"Đã dùng\", \"Còn lại\", \"Hạn dùng\", \"Trạng thái\"};\n        DefaultTableModel model = new DefaultTableModel(cols, 0) {\n            @Override\n            public boolean isCellEditable(int row, int col) { return false; }\n        };\n        JTable tbl = new JTable(model);\n        tbl.setRowHeight(32);\n        tbl.setFont(new Font(\"Segoe UI\", Font.PLAIN, 12));\n        tbl.getTableHeader().setFont(new Font(\"Segoe UI\", Font.BOLD, 12));\n        tbl.getTableHeader().setBackground(ThemeColors.PRIMARY_TINT);\n\n        Runnable loadData = () -> {\n            model.setRowCount(0);\n            String kw = txtSearch.getText().trim().toLowerCase();\n            for (TheSpaPass the : SpaPassBus.layTatCaThe()) {\n                the.capNhatTrangThai();\n                if (!kw.isEmpty()) {\n                    boolean match = (the.getMaThe() != null && the.getMaThe().toLowerCase().contains(kw))\n                            || (the.getTenKhachHang() != null && the.getTenKhachHang().toLowerCase().contains(kw))\n                            || (the.getSdtKhachHang() != null && the.getSdtKhachHang().contains(kw));\n                    if (!match) continue;\n                }\n                model.addRow(new Object[]{\n                        the.getMaThe(),\n                        the.getTenKhachHang(),\n                        the.getSdtKhachHang(),\n                        the.getTenGoi(),\n                        the.getTongSoBuoi(),\n                        the.getSoBuoiDaDung(),\n                        the.getSoBuoiConLai(),\n                        the.getNgayHetHanStr(),\n                        the.getTrangThai()\n                });\n            }\n        };\n\n        txtSearch.getDocument().addDocumentListener(new javax.swing.event.DocumentListener() {\n            public void insertUpdate(javax.swing.event.DocumentEvent e) { loadData.run(); }\n            public void removeUpdate(javax.swing.event.DocumentEvent e) { loadData.run(); }\n            public void changedUpdate(javax.swing.event.DocumentEvent e) { loadData.run(); }\n        });\n\n        btnPhatHanh.addActionListener(e -> {\n            JOptionPane.showMessageDialog(dlg,\n                    \"Không phát hành thẻ miễn phí từ màn tra cứu. Hãy thêm Gói Spa Pass vào giỏ hàng\\n\"\n                    + \"và thanh toán; thẻ chỉ được kích hoạt sau khi hóa đơn lưu thành công.\",\n                    \"Bán gói qua POS\", JOptionPane.INFORMATION_MESSAGE);\n        });\n\n        JPanel pnlBottom = new JPanel(new FlowLayout(FlowLayout.RIGHT, 10, 0));\n        pnlBottom.setOpaque(false);\n\n        JButton btnChonThe = ThemeColors.createPrimaryButton(\"Áp dụng thẻ này cho đơn hàng\", IconHelper.getIcon(IconHelper.CHECK, 13, Color.WHITE));\n        JButton btnDong = ThemeColors.createSecondaryButton(\"Đóng\", null);\n\n        btnChonThe.addActionListener(e -> {\n            int r = tbl.getSelectedRow();\n            if (r < 0) {\n                JOptionPane.showMessageDialog(dlg, \"Vui lòng chọn 1 thẻ trên bảng để áp dụng!\", \"Chưa chọn\", JOptionPane.WARNING_MESSAGE);\n                return;\n            }\n            String maThe = model.getValueAt(r, 0).toString();\n            TheSpaPass the = SpaPassBus.timTheTheoMa(maThe);\n            if (the != null) {\n                theSpaPassHienTai = the;\n                if (txtSdtKhachHang != null) txtSdtKhachHang.setText(the.getSdtKhachHang());\n                if (txtTenKhachHang != null) txtTenKhachHang.setText(the.getTenKhachHang());\n                if (lblSpaPassStatus != null) {\n                    lblSpaPassStatus.setText(the.getTenThe() + \": Còn \" + the.getSoBuoiConLai() + \"/\" + the.getTongSoBuoi() + \" buổi\");\n                    lblSpaPassStatus.setForeground(ThemeColors.PRIMARY_ACTIVE);\n                }\n                if (btnDungSpaPass != null) {\n                    btnDungSpaPass.setEnabled(the.isKhaDung());\n                }\n                dlg.dispose();\n                JOptionPane.showMessageDialog(this, \"Đã liên kết Thẻ Spa Pass của [\" + the.getTenKhachHang() + \"] vào đơn hiện tại!\", \"Thành công\", JOptionPane.INFORMATION_MESSAGE);\n            }\n        });\n\n        btnDong.addActionListener(e -> dlg.dispose());\n        pnlBottom.add(btnChonThe);\n        pnlBottom.add(btnDong);\n\n        loadData.run();\n\n        dlg.add(pnlTop, BorderLayout.NORTH);\n        dlg.add(new JScrollPane(tbl), BorderLayout.CENTER);\n        dlg.add(pnlBottom, BorderLayout.SOUTH);\n        dlg.setVisible(true);\n    }\n\n    // ==========================================\n    // 2. TAB HÓA ĐƠN CHỜ PHỤC VỤ (GRID CARDS 1 CHẠM)\n    // ==========================================\n    private JPanel taoTabDonChoGrid() {\n        JPanel pnl = new JPanel(new BorderLayout(0, 12));\n        pnl.setBackground(ThemeColors.BACKGROUND);\n        pnl.setBorder(new EmptyBorder(14, 16, 14, 16));\n\n        JPanel pnlHeader = new JPanel(new BorderLayout(12, 0));\n        pnlHeader.setBackground(ThemeColors.SURFACE);\n        pnlHeader.setBorder(ThemeColors.createCardBorder(12, 16, 12, 16));\n\n        JButton btnBack = ThemeColors.createSecondaryButton(\"← Quay lại quầy POS\", IconHelper.getIcon(IconHelper.CART, 14, ThemeColors.TEXT_SECONDARY));\n        btnBack.setFocusPainted(false);\n        btnBack.addActionListener(e -> chonTabPOS());\n\n        lblSoDonChoHeader = new JLabel(\"DANH SÁCH ĐƠN HÀNG LƯU TẠM ĐANG CHỜ PHỤC VỤ (0 ĐƠN)\",\n                IconHelper.getIcon(IconHelper.CLOCK, 18, ThemeColors.WARNING), SwingConstants.LEFT);\n        lblSoDonChoHeader.setFont(new Font(\"Segoe UI\", Font.BOLD, 14));\n        lblSoDonChoHeader.setForeground(ThemeColors.TEXT_PRIMARY);\n\n        JPanel pnlLeft = new JPanel(new FlowLayout(FlowLayout.LEFT, 12, 0));\n        pnlLeft.setOpaque(false);\n        pnlLeft.add(btnBack);\n        pnlLeft.add(lblSoDonChoHeader);\n\n        JPanel pnlRight = new JPanel(new FlowLayout(FlowLayout.RIGHT, 10, 0));\n        pnlRight.setOpaque(false);\n\n        txtTimDonCho = new JTextField(18);\n        txtTimDonCho.setPreferredSize(new Dimension(240, 34));\n        txtTimDonCho.putClientProperty(\"JTextField.placeholderText\", \"Tìm theo SĐT, tên khách, mã đơn...\");\n        txtTimDonCho.putClientProperty(\"JTextField.leadingIcon\", IconHelper.getIcon(IconHelper.SEARCH, 15, ThemeColors.TEXT_MUTED));\n        txtTimDonCho.setBorder(ThemeColors.createInputBorder());\n        txtTimDonCho.getDocument().addDocumentListener(new DocumentListener() {\n            @Override\n            public void insertUpdate(DocumentEvent e) { capNhatGiaoDienDonCho(); }\n            @Override\n            public void removeUpdate(DocumentEvent e) { capNhatGiaoDienDonCho(); }\n            @Override\n            public void changedUpdate(DocumentEvent e) { capNhatGiaoDienDonCho(); }\n        });\n\n        JLabel lblHint = new JLabel(\"Click thẻ để khôi phục đơn\", SwingConstants.RIGHT);\n        lblHint.setFont(new Font(\"Segoe UI\", Font.PLAIN, 12));\n        lblHint.setForeground(ThemeColors.TEXT_MUTED);\n\n        pnlRight.add(txtTimDonCho);\n        pnlRight.add(lblHint);\n\n        pnlHeader.add(pnlLeft, BorderLayout.WEST);\n        pnlHeader.add(pnlRight, BorderLayout.EAST);\n\n        pnlCardsDonCho = new JPanel(new GridLayout(0, 3, 14, 14));\n        pnlCardsDonCho.setOpaque(false);\n\n        JPanel pnlWrapper = new JPanel(new BorderLayout());\n        pnlWrapper.setOpaque(false);\n        pnlWrapper.add(pnlCardsDonCho, BorderLayout.NORTH);\n\n        JScrollPane scroll = new JScrollPane(pnlWrapper);\n        scroll.setBorder(null);\n        scroll.setOpaque(false);\n        scroll.getViewport().setOpaque(false);\n\n        pnl.add(pnlHeader, BorderLayout.NORTH);\n        pnl.add(scroll, BorderLayout.CENTER);\n\n        capNhatGiaoDienDonCho();\n        return pnl;\n    }\n\n    private boolean luuDsDonTamXuongDisk() {\n        try {\n            java.io.File file = new java.io.File(\"config/pos_don_tam.dat\");\n            if (file.getParentFile() != null && !file.getParentFile().exists()) file.getParentFile().mkdirs();\n            try (java.io.ObjectOutputStream oos = new java.io.ObjectOutputStream(new java.io.FileOutputStream(file))) {\n                oos.writeObject(new ArrayList<>(dsDonTam));\n            }\n            return true;\n        } catch (Exception e) {\n            System.err.println(\"[BanHangPOSPanel] Lỗi lưu đơn tạm disk: \" + e.getMessage());\n            return false;\n        }\n    }\n\n    @SuppressWarnings(\"unchecked\")\n    private void taiDsDonTamTuDisk() {\n        try {\n            java.io.File file = new java.io.File(\"config/pos_don_tam.dat\");\n            if (file.exists()) {\n                try (java.io.ObjectInputStream ois = new java.io.ObjectInputStream(new java.io.FileInputStream(file))) {\n                    List<DonHangTam> loaded = (List<DonHangTam>) ois.readObject();\n                    if (loaded != null) {\n                        dsDonTam.clear();\n                        dsDonTam.addAll(loaded);\n                    }\n                }\n            }\n        } catch (Exception e) {\n            System.err.println(\"[BanHangPOSPanel] Lỗi đọc đơn tạm disk: \" + e.getMessage());\n        }\n    }\n\n    private void capNhatGiaoDienDonCho() {\n        try {\n            if (pnlCardsDonCho == null) return;\n            pnlCardsDonCho.removeAll();\n\n            if (lblSoDonChoHeader != null) {\n                lblSoDonChoHeader.setText(\"DANH SÁCH ĐƠN HÀNG LƯU TẠM ĐANG CHỜ PHỤC VỤ (\" + dsDonTam.size() + \" ĐƠN)\");\n            }\n            if (btnQuickDonCho != null) {\n                btnQuickDonCho.setText(\"Đơn chờ (\" + dsDonTam.size() + \")\");\n            }\n\n            if (dsDonTam.isEmpty()) {\n                JPanel pnlEmpty = new JPanel(new FlowLayout(FlowLayout.CENTER, 0, 50));\n                pnlEmpty.setOpaque(false);\n                JLabel lblEmpty = new JLabel(\"Hiện không có hóa đơn nào đang lưu tạm. Bấm 'Lưu tạm' tại quầy POS để chuyển đơn vào đây.\");\n                lblEmpty.setFont(new Font(\"Segoe UI\", Font.ITALIC, 13));\n                lblEmpty.setForeground(ThemeColors.TEXT_MUTED);\n                pnlEmpty.add(lblEmpty);\n                pnlCardsDonCho.setLayout(new BorderLayout());\n                pnlCardsDonCho.add(pnlEmpty, BorderLayout.CENTER);\n            } else {\n                pnlCardsDonCho.setLayout(new GridLayout(0, 3, 14, 14));\n                String kw = (txtTimDonCho != null) ? txtTimDonCho.getText().trim().toLowerCase() : \"\";\n                int countHienThi = 0;\n                for (DonHangTam don : dsDonTam) {\n                    boolean match = kw.isEmpty()\n                            || (don.maHoaDon != null && don.maHoaDon.toLowerCase().contains(kw))\n                            || (don.sdt != null && don.sdt.toLowerCase().contains(kw))\n                            || (don.tenKhach != null && don.tenKhach.toLowerCase().contains(kw));\n                    if (match) {\n                        pnlCardsDonCho.add(taoCardDonCho(don));\n                        countHienThi++;\n                    }\n                }\n                if (countHienThi == 0) {\n                    JPanel pnlKhongThay = new JPanel(new FlowLayout(FlowLayout.CENTER, 0, 40));\n                    pnlKhongThay.setOpaque(false);\n                    JLabel lblKt = new JLabel(\"Không tìm thấy đơn tạm nào khớp với từ khóa: '\" + kw + \"'\");\n                    lblKt.setFont(new Font(\"Segoe UI\", Font.ITALIC, 12));\n                    lblKt.setForeground(ThemeColors.TEXT_MUTED);\n                    pnlKhongThay.add(lblKt);\n                    pnlCardsDonCho.setLayout(new BorderLayout());\n                    pnlCardsDonCho.add(pnlKhongThay, BorderLayout.CENTER);\n                }\n            }\n\n            pnlCardsDonCho.revalidate();\n            pnlCardsDonCho.repaint();\n        } catch (Exception e) {\n            System.err.println(\"[BanHangPOSPanel] Lỗi cập nhật giao diện đơn chờ: \" + e.getMessage());\n        }\n    }\n\n    private JPanel taoCardDonCho(DonHangTam don) {\n        // Duyệt qua tất cả các dòng dịch vụ trong đơn tạm (Multi-Service Tracking)\n        List<Integer> listDvIdx = new ArrayList<>();\n        int daXongCount = 0;\n        for (int i = 0; i < don.dsMon.size(); i++) {\n            Object[] row = don.dsMon.get(i);\n            String ma = row.length > 1 && row[1] != null ? row[1].toString() : \"\";\n            if (ma.startsWith(\"DV\")) {\n                listDvIdx.add(i);\n                String td = row.length > 7 && row[7] != null ? row[7].toString() : \"\";\n                if (td.startsWith(\"4.\") || td.contains(\"XONG\") || td.contains(\"Hoàn tất\")) {\n                    daXongCount++;\n                }\n            }\n        }\n        int tongDv = listDvIdx.size();\n        boolean hasDv = tongDv > 0;\n        boolean allDvDone = hasDv && (daXongCount == tongDv);\n\n        JPanel card = new JPanel(new BorderLayout(8, 8));\n        int cardHeight = hasDv ? Math.min(270, 175 + tongDv * 28 + 25) : 165;\n        card.setPreferredSize(new Dimension(270, cardHeight));\n        card.setBackground(ThemeColors.SURFACE);\n        card.setBorder(ThemeColors.createCardBorder(12, 14, 12, 14));\n        card.setCursor(new Cursor(Cursor.HAND_CURSOR));\n\n        JPanel pnlTop = new JPanel(new BorderLayout());\n        pnlTop.setOpaque(false);\n\n        JLabel lblMa = new JLabel(don.maHoaDon);\n        lblMa.setFont(new Font(\"Segoe UI\", Font.BOLD, 13));\n        lblMa.setForeground(ThemeColors.PRIMARY_ACTIVE);\n\n        JLabel lblBadge;\n        if (hasDv && allDvDone) {\n            lblBadge = ThemeColors.createBadge(\"Dịch vụ xong (\" + daXongCount + \"/\" + tongDv + \")\", ThemeColors.SUCCESS_LIGHT, ThemeColors.SUCCESS_TEXT);\n        } else if (hasDv) {\n            lblBadge = ThemeColors.createBadge(\"Đang làm (\" + daXongCount + \"/\" + tongDv + \")\", ThemeColors.WARNING_LIGHT, ThemeColors.WARNING_TEXT);\n        } else {\n            lblBadge = ThemeColors.createBadge(\"Chờ thanh toán\", ThemeColors.WARNING_LIGHT, ThemeColors.WARNING_TEXT);\n        }\n\n        JButton btnHuyDon = new JButton(IconHelper.getIcon(IconHelper.TRASH, 12, ThemeColors.DANGER));\n        btnHuyDon.setPreferredSize(new Dimension(26, 26));\n        btnHuyDon.setFocusPainted(false);\n        btnHuyDon.setBorder(new LineBorder(ThemeColors.BORDER_LIGHT, 1, true));\n        btnHuyDon.setBackground(Color.WHITE);\n        btnHuyDon.setToolTipText(\"Hủy đơn tạm này\");\n        btnHuyDon.addActionListener(e -> {\n            int opt = JOptionPane.showConfirmDialog(this,\n                    \"Bạn có chắc muốn hủy đơn tạm [\" + don.maHoaDon + \"]?\",\n                    \"Hủy đơn tạm\", JOptionPane.YES_NO_OPTION);\n            if (opt == JOptionPane.YES_OPTION) {\n                dsDonTam.remove(don);\n                luuDsDonTamXuongDisk();\n                capNhatGiaoDienDonCho();\n            }\n        });\n\n        JPanel pnlRight = new JPanel(new FlowLayout(FlowLayout.RIGHT, 4, 0));\n        pnlRight.setOpaque(false);\n        pnlRight.add(lblBadge);\n        pnlRight.add(btnHuyDon);\n\n        pnlTop.add(lblMa, BorderLayout.WEST);\n        pnlTop.add(pnlRight, BorderLayout.EAST);\n\n        JPanel pnlCenter = new JPanel();\n        pnlCenter.setLayout(new BoxLayout(pnlCenter, BoxLayout.Y_AXIS));\n        pnlCenter.setOpaque(false);\n\n        JLabel lblKhach = new JLabel(\"Khách: \" + don.tenKhach + (don.sdt.isEmpty() ? \"\" : \" (\" + don.sdt + \")\"));\n        lblKhach.setFont(new Font(\"Segoe UI\", Font.BOLD, 12));\n        lblKhach.setForeground(ThemeColors.TEXT_PRIMARY);\n        lblKhach.setAlignmentX(Component.LEFT_ALIGNMENT);\n\n        JLabel lblTime = new JLabel(\"Lưu lúc: \" + don.thoiGianTao + \" · \" + don.dsMon.size() + \" món\");\n        lblTime.setFont(new Font(\"Segoe UI\", Font.PLAIN, 11));\n        lblTime.setForeground(ThemeColors.TEXT_MUTED);\n        lblTime.setAlignmentX(Component.LEFT_ALIGNMENT);\n\n        JLabel lblTongTien = new JLabel(\"Tổng tiền: \" + df.format(don.khachCanTra));\n        lblTongTien.setFont(new Font(\"Segoe UI\", Font.BOLD, 14));\n        lblTongTien.setForeground(ThemeColors.PRIMARY_ACTIVE);\n        lblTongTien.setAlignmentX(Component.LEFT_ALIGNMENT);\n\n        pnlCenter.add(lblKhach);\n        pnlCenter.add(Box.createVerticalStrut(2));\n        pnlCenter.add(lblTime);\n        pnlCenter.add(Box.createVerticalStrut(2));\n        pnlCenter.add(lblTongTien);\n\n        if (hasDv) {\n            pnlCenter.add(Box.createVerticalStrut(6));\n            // Thanh tiến độ tổng thể (Overall Progress Bar)\n            int pct = (daXongCount * 100) / tongDv;\n            JProgressBar pgbTienDo = new JProgressBar(0, 100);\n            pgbTienDo.setValue(pct);\n            pgbTienDo.setStringPainted(true);\n            pgbTienDo.setString(daXongCount + \"/\" + tongDv + \" dịch vụ (\" + pct + \"%)\");\n            pgbTienDo.setFont(new Font(\"Segoe UI\", Font.BOLD, 10));\n            pgbTienDo.setForeground(allDvDone ? ThemeColors.SUCCESS : ThemeColors.PRIMARY_ACTIVE);\n            pgbTienDo.setBackground(Color.decode(\"#FAEEE7\"));\n            pgbTienDo.setMaximumSize(new Dimension(Integer.MAX_VALUE, 16));\n            pgbTienDo.setAlignmentX(Component.LEFT_ALIGNMENT);\n            pnlCenter.add(pgbTienDo);\n            pnlCenter.add(Box.createVerticalStrut(4));\n\n            // Danh sách từng dòng dịch vụ kèm nút Badge 1-chạm cập nhật tiến độ độc lập\n            for (int sIdx : listDvIdx) {\n                Object[] row = don.dsMon.get(sIdx);\n                String tenMon = row.length > 2 && row[2] != null ? row[2].toString() : \"Dịch vụ\";\n                if (tenMon.length() > 22) {\n                    tenMon = tenMon.substring(0, 20) + \"..\";\n                }\n                String curTd = row.length > 7 && row[7] != null ? row[7].toString() : CAC_BUOC_TIEN_DO[0];\n\n                JPanel pnlServiceRow = new JPanel(new BorderLayout(4, 0));\n                pnlServiceRow.setOpaque(false);\n                pnlServiceRow.setMaximumSize(new Dimension(Integer.MAX_VALUE, 24));\n                pnlServiceRow.setAlignmentX(Component.LEFT_ALIGNMENT);\n\n                JLabel lblTenDv = new JLabel(\"• \" + tenMon);\n                lblTenDv.setFont(new Font(\"Segoe UI\", Font.PLAIN, 11));\n                lblTenDv.setForeground(ThemeColors.TEXT_PRIMARY);\n\n                JButton btnStep = taoButtonTienDo1Cham(don, sIdx, curTd);\n                pnlServiceRow.add(lblTenDv, BorderLayout.CENTER);\n                pnlServiceRow.add(btnStep, BorderLayout.EAST);\n\n                pnlCenter.add(pnlServiceRow);\n                pnlCenter.add(Box.createVerticalStrut(2));\n            }\n        }\n\n        JPanel pnlBottom = new JPanel(new BorderLayout());\n        pnlBottom.setOpaque(false);\n        JLabel lblRestoreHint = new JLabel(\"Nhấn để nạp lại vào POS >\");\n        lblRestoreHint.setFont(new Font(\"Segoe UI\", Font.BOLD, 11));\n        lblRestoreHint.setForeground(ThemeColors.PRIMARY);\n        pnlBottom.add(lblRestoreHint, BorderLayout.EAST);\n\n        card.add(pnlTop, BorderLayout.NORTH);\n        card.add(pnlCenter, BorderLayout.CENTER);\n        card.add(pnlBottom, BorderLayout.SOUTH);\n\n        card.addMouseListener(new MouseAdapter() {\n            @Override\n            public void mouseClicked(MouseEvent e) {\n                khoiPhucDonTamVaoPos(don);\n            }\n            @Override\n            public void mouseEntered(MouseEvent e) {\n                card.setBackground(ThemeColors.PRIMARY_TINT);\n                card.setBorder(new CompoundBorder(\n                        new LineBorder(ThemeColors.BORDER_ACCENT, 1, true),\n                        new EmptyBorder(12, 14, 12, 14)\n                ));\n            }\n            @Override\n            public void mouseExited(MouseEvent e) {\n                card.setBackground(ThemeColors.SURFACE);\n                card.setBorder(ThemeColors.createCardBorder(12, 14, 12, 14));\n            }\n        });\n\n        return card;\n    }\n\n    private void khoiPhucDonTamVaoPos(DonHangTam don) {\n        if (modelGioHang.getRowCount() > 0) {\n            int opt = JOptionPane.showConfirmDialog(this,\n                    \"Giỏ hàng POS đang có món chưa thanh toán!\\nBạn có muốn thay thế giỏ hàng hiện tại bằng đơn tạm [\" + don.maHoaDon + \"]?\",\n                    \"Xác nhận nạp đơn tạm\", JOptionPane.YES_NO_OPTION);\n            if (opt != JOptionPane.YES_OPTION) return;\n        }\n\n        lblMaHoaDon.setText(don.maHoaDon);\n        dangCapNhatKhach = true;\n        try {\n            txtSdtKhachHang.setText(don.sdt != null ? don.sdt : \"\");\n            txtTenKhachHang.setText(don.tenKhach != null && !don.tenKhach.equalsIgnoreCase(\"Khách vãng lai\") ? don.tenKhach : \"\");\n            tenKhachTuDongDien = false;\n        } finally {\n            dangCapNhatKhach = false;\n        }\n        traCuuKhachHang();\n        if (don.phuongThuc != null && don.phuongThuc.contains(\"Tiền mặt\")) {\n            cboPhuongThuc.setSelectedItem(\"Tiền mặt\");\n        } else {\n            cboPhuongThuc.setSelectedItem(\"Chuyển khoản\");\n        }\n\n        modelGioHang.setRowCount(0);\n        for (Object[] row : don.dsMon) {\n            if (row.length == 7) {\n                String ma = (String) row[1];\n                Object[] r8 = new Object[8];\n                System.arraycopy(row, 0, r8, 0, 7);\n                r8[7] = (ma != null && ma.startsWith(\"DV\")) ? CAC_BUOC_TIEN_DO[0] : \"—\";\n                modelGioHang.addRow(r8);\n            } else {\n                modelGioHang.addRow(row);\n            }\n        }\n        capNhatTongTien();\n\n        dsDonTam.remove(don);\n        luuDsDonTamXuongDisk();\n        capNhatGiaoDienDonCho();\n\n        chonTabPOS();\n\n        JOptionPane.showMessageDialog(this,\n                \"ĐÃ KHÔI PHỤC ĐƠN HÀNG [\" + don.maHoaDon + \"] THÀNH CÔNG!\\nBạn có thể quét thêm món hoặc bấm thanh toán ngay.\",\n                \"Khôi phục thành công\", JOptionPane.INFORMATION_MESSAGE);\n    }\n\n    private void chuyenTienDoDichVuTrongGio(int row) {\n        if (row < 0 || row >= modelGioHang.getRowCount()) return;\n        String ma = (String) modelGioHang.getValueAt(row, 1);\n        if (ma == null || !ma.startsWith(\"DV\")) return;\n\n        String currentTienDo = (String) modelGioHang.getValueAt(row, 7);\n        int nextIdx = 0;\n        for (int i = 0; i < CAC_BUOC_TIEN_DO.length; i++) {\n            if (CAC_BUOC_TIEN_DO[i].equalsIgnoreCase(currentTienDo)) {\n                nextIdx = (i + 1) % CAC_BUOC_TIEN_DO.length;\n                break;\n            }\n        }\n        String nextTienDo = CAC_BUOC_TIEN_DO[nextIdx];\n        modelGioHang.setValueAt(nextTienDo, row, 7);\n\n        String tenMon = (String) modelGioHang.getValueAt(row, 2);\n        if (nextIdx == 3) {\n            JOptionPane.showMessageDialog(this,\n                    \"Dịch vụ [\" + tenMon + \"] đã HOÀN TẤT & SẴN SÀNG THANH TOÁN!\",\n                    \"Tiến độ dịch vụ\", JOptionPane.INFORMATION_MESSAGE);\n        }\n    }\n\n    private JButton taoButtonTienDo1Cham(DonHangTam don, int serviceIdx, String curTienDo) {\n        String bg = \"#FEF3C7\";\n        String fg = \"#B45309\";\n        String nextStep = CAC_BUOC_TIEN_DO[1];\n\n        if (curTienDo.startsWith(\"2.\")) {\n            bg = \"#DBEAFE\";\n            fg = \"#1D4ED8\";\n            nextStep = CAC_BUOC_TIEN_DO[2];\n        } else if (curTienDo.startsWith(\"3.\")) {\n            bg = \"#F3E8FF\";\n            fg = \"#7E22CE\";\n            nextStep = CAC_BUOC_TIEN_DO[3];\n        } else if (curTienDo.startsWith(\"4.\")) {\n            bg = \"#D1FAE5\";\n            fg = \"#047857\";\n            nextStep = CAC_BUOC_TIEN_DO[0];\n        }\n\n        JButton btn = new JButton(\"<html><b style='color:\" + fg + \"; font-size:10px;'>\" + curTienDo + \" ></b></html>\");\n        btn.setFont(new Font(\"Segoe UI\", Font.BOLD, 10));\n        btn.setBackground(Color.decode(bg));\n        btn.setFocusPainted(false);\n        btn.setCursor(new Cursor(Cursor.HAND_CURSOR));\n        btn.setBorder(new CompoundBorder(\n                new LineBorder(Color.decode(fg), 1, true),\n                new EmptyBorder(1, 6, 1, 6)\n        ));\n        btn.setToolTipText(\"Nhấp 1 chạm để chuyển sang: \" + nextStep);\n\n        final String targetNext = nextStep;\n        btn.addActionListener(e -> {\n            don.dsMon.get(serviceIdx)[7] = targetNext;\n            luuDsDonTamXuongDisk();\n            capNhatGiaoDienDonCho();\n            if (targetNext.startsWith(\"4.\")) {\n                JOptionPane.showMessageDialog(this,\n                        \"Dịch vụ cho bé cưng của khách [\" + don.tenKhach + \"] (Đơn \" + don.maHoaDon + \")\\nđã HOÀN TẤT & SẴN SÀNG THANH TOÁN!\",\n                        \"Hoàn tất dịch vụ\", JOptionPane.INFORMATION_MESSAGE);\n            }\n        });\n\n        return btn;\n    }\n\n    private static class TienDoCellRenderer extends DefaultTableCellRenderer {\n        @Override\n        public Component getTableCellRendererComponent(JTable table, Object value, boolean isSelected, boolean hasFocus, int row, int column) {\n            JLabel lbl = (JLabel) super.getTableCellRendererComponent(table, value, isSelected, hasFocus, row, column);\n            lbl.setHorizontalAlignment(SwingConstants.CENTER);\n            String val = value != null ? value.toString() : \"—\";\n\n            if (val.startsWith(\"1.\")) {\n                lbl.setText(\"<html><span style='background:#FEF3C7; color:#B45309; font-weight:bold; font-size:10px; padding:2px 6px; border-radius:4px;'>\" + val + \"</span></html>\");\n                lbl.setToolTipText(\"1-Chạm: Nhấp để chuyển sang 'Đang thực hiện'\");\n            } else if (val.startsWith(\"2.\")) {\n                lbl.setText(\"<html><span style='background:#DBEAFE; color:#1D4ED8; font-weight:bold; font-size:10px; padding:2px 6px; border-radius:4px;'>\" + val + \"</span></html>\");\n                lbl.setToolTipText(\"1-Chạm: Nhấp để chuyển sang 'Đã xong - Chờ đón'\");\n            } else if (val.startsWith(\"3.\")) {\n                lbl.setText(\"<html><span style='background:#F3E8FF; color:#7E22CE; font-weight:bold; font-size:10px; padding:2px 6px; border-radius:4px;'>\" + val + \"</span></html>\");\n                lbl.setToolTipText(\"1-Chạm: Nhấp để chuyển sang 'Hoàn tất & TT'\");\n            } else if (val.startsWith(\"4.\")) {\n                lbl.setText(\"<html><span style='background:#D1FAE5; color:#047857; font-weight:bold; font-size:10px; padding:2px 6px; border-radius:4px;'>\" + val + \"</span></html>\");\n                lbl.setToolTipText(\"Dịch vụ đã hoàn tất và sẵn sàng thanh toán\");\n            } else {\n                lbl.setText(\"<html><span style='color:#94A3B8; font-size:11px;'>—</span></html>\");\n                lbl.setToolTipText(null);\n            }\n\n            if (isSelected) {\n                lbl.setBackground(ThemeColors.PRIMARY_SOFT);\n            } else {\n                lbl.setBackground(Color.WHITE);\n            }\n            return lbl;\n        }\n    }\n\n    // ==========================================\n    // 3. TAB LỊCH SỬ HÓA ĐƠN ĐÃ THANH TOÁN (JTABLE)\n    // ==========================================\n    private JPanel taoTabLichSuHoaDon() {\n        JPanel pnl = new JPanel(new BorderLayout(0, 12));\n        pnl.setBackground(ThemeColors.BACKGROUND);\n        pnl.setBorder(new EmptyBorder(14, 16, 14, 16));\n\n        JPanel pnlToolbar = new JPanel(new FlowLayout(FlowLayout.LEFT, 10, 0));\n        pnlToolbar.setBackground(ThemeColors.SURFACE);\n        pnlToolbar.setBorder(ThemeColors.createCardBorder(10, 14, 10, 14));\n\n        txtTimKiemLichSu = new JTextField(16);\n        txtTimKiemLichSu.setPreferredSize(new Dimension(200, 36));\n        txtTimKiemLichSu.putClientProperty(\"JTextField.placeholderText\", \"Tìm theo mã HĐ, khách, SĐT...\");\n        txtTimKiemLichSu.putClientProperty(\"JTextField.leadingIcon\", IconHelper.getIcon(IconHelper.SEARCH, 15, ThemeColors.TEXT_MUTED));\n        txtTimKiemLichSu.setBorder(ThemeColors.createInputBorder());\n\n        cboLocNgayLichSu = new JComboBox<>(new String[]{\"Tất cả lịch sử\", \"Hôm nay\", \"Hôm qua\", \"7 ngày qua\"});\n        cboLocNgayLichSu.setPreferredSize(new Dimension(140, 36));\n        cboLocNgayLichSu.addActionListener(e -> capNhatBangLichSu());\n\n        cboLocLoaiLichSu = new JComboBox<>(new String[]{\"Tất cả loại đơn\", \"Đơn bán lẻ (Hàng hóa)\", \"Đơn dịch vụ Spa\"});\n        cboLocLoaiLichSu.setPreferredSize(new Dimension(170, 36));\n        cboLocLoaiLichSu.addActionListener(e -> capNhatBangLichSu());\n\n        JButton btnXemChiTiet = ThemeColors.createSecondaryButton(\"Xem chi tiết đơn\", IconHelper.getIcon(IconHelper.RECEIPT, 14, ThemeColors.TEXT_SECONDARY));\n        JButton btnInLai = ThemeColors.createSecondaryButton(\"In lại hóa đơn\", IconHelper.getIcon(IconHelper.CLIPBOARD_CHECK, 14, ThemeColors.TEXT_SECONDARY));\n        JButton btnXuatExcel = ThemeColors.createPrimaryButton(\"Xuất Excel\", IconHelper.getIcon(IconHelper.CHECK, 14, Color.WHITE));\n\n        JButton btnBack = ThemeColors.createSecondaryButton(\"← Quay lại quầy POS\", IconHelper.getIcon(IconHelper.CART, 14, ThemeColors.TEXT_SECONDARY));\n        btnBack.setFocusPainted(false);\n        btnBack.addActionListener(e -> chonTabPOS());\n\n        btnXemChiTiet.addActionListener(e -> xuLyXemChiTietLichSu());\n        btnInLai.addActionListener(e -> xuLyInLaiHoaDon());\n        btnXuatExcel.addActionListener(e -> xuLyXuatExcel());\n\n        pnlToolbar.add(btnBack);\n        pnlToolbar.add(Box.createHorizontalStrut(6));\n        pnlToolbar.add(new JLabel(\"Tìm kiếm:\"));\n        pnlToolbar.add(txtTimKiemLichSu);\n        pnlToolbar.add(new JLabel(\"Khoảng ngày:\"));\n        pnlToolbar.add(cboLocNgayLichSu);\n        pnlToolbar.add(new JLabel(\"Loại đơn:\"));\n        pnlToolbar.add(cboLocLoaiLichSu);\n        pnlToolbar.add(btnXemChiTiet);\n        pnlToolbar.add(btnInLai);\n        pnlToolbar.add(btnXuatExcel);\n\n        String[] cols = {\"Mã HĐ\", \"Thời gian thanh toán\", \"Khách hàng\", \"Số điện thoại\", \"Thu ngân lập\", \"Tiền hàng\", \"Giảm VIP\", \"Tổng thanh toán\", \"Phương thức\", \"Trạng thái\"};\n        modelLichSu = new DefaultTableModel(cols, 0) {\n            @Override\n            public boolean isCellEditable(int row, int col) { return false; }\n        };\n\n        tblLichSu = new JTable(modelLichSu);\n        tblLichSu.setRowHeight(34);\n        tblLichSu.setFont(new Font(\"Segoe UI\", Font.PLAIN, 12));\n        tblLichSu.setShowHorizontalLines(true);\n        tblLichSu.setShowVerticalLines(false);\n        tblLichSu.setGridColor(ThemeColors.BORDER_LIGHT);\n        tblLichSu.setSelectionBackground(ThemeColors.PRIMARY_SOFT);\n        tblLichSu.setSelectionForeground(ThemeColors.TEXT_PRIMARY);\n\n        tblLichSu.getTableHeader().setFont(new Font(\"Segoe UI\", Font.BOLD, 12));\n        tblLichSu.getTableHeader().setBackground(ThemeColors.PRIMARY_TINT);\n        tblLichSu.getTableHeader().setForeground(ThemeColors.TEXT_PRIMARY);\n        tblLichSu.getTableHeader().setPreferredSize(new Dimension(0, 36));\n\n        DefaultTableCellRenderer center = new DefaultTableCellRenderer();\n        center.setHorizontalAlignment(JLabel.CENTER);\n        tblLichSu.getColumnModel().getColumn(0).setPreferredWidth(85);\n        tblLichSu.getColumnModel().getColumn(0).setCellRenderer(center);\n        tblLichSu.getColumnModel().getColumn(9).setCellRenderer(new DefaultTableCellRenderer() {\n            @Override\n            public Component getTableCellRendererComponent(JTable table, Object value, boolean isSelected, boolean hasFocus, int row, int column) {\n                JLabel c = (JLabel) super.getTableCellRendererComponent(table, value, isSelected, hasFocus, row, column);\n                c.setForeground(ThemeColors.SUCCESS);\n                c.setFont(c.getFont().deriveFont(Font.BOLD));\n                return c;\n            }\n        });\n\n        sorterLichSu = new TableRowSorter<>(modelLichSu);\n        tblLichSu.setRowSorter(sorterLichSu);\n\n        tblLichSu.addMouseListener(new MouseAdapter() {\n            @Override\n            public void mouseClicked(MouseEvent e) {\n                if (e.getClickCount() == 2 && tblLichSu.getSelectedRow() >= 0) {\n                    xuLyXemChiTietLichSu();\n                }\n            }\n        });\n\n        txtTimKiemLichSu.getDocument().addDocumentListener(new DocumentListener() {\n            @Override\n            public void insertUpdate(DocumentEvent e) { locLichSu(txtTimKiemLichSu.getText().trim()); }\n            @Override\n            public void removeUpdate(DocumentEvent e) { locLichSu(txtTimKiemLichSu.getText().trim()); }\n            @Override\n            public void changedUpdate(DocumentEvent e) { locLichSu(txtTimKiemLichSu.getText().trim()); }\n        });\n\n        capNhatBangLichSu();\n\n        pnl.add(pnlToolbar, BorderLayout.NORTH);\n        pnl.add(new JScrollPane(tblLichSu), BorderLayout.CENTER);\n        return pnl;\n    }\n\n    private void capNhatBangLichSu() {\n        if (modelLichSu == null) return;\n        modelLichSu.setRowCount(0);\n        dsLichSuHienThi.clear();\n\n        String locNgay = cboLocNgayLichSu != null && cboLocNgayLichSu.getSelectedItem() != null\n                ? cboLocNgayLichSu.getSelectedItem().toString() : \"Tất cả lịch sử\";\n        String locLoai = cboLocLoaiLichSu != null && cboLocLoaiLichSu.getSelectedItem() != null\n                ? cboLocLoaiLichSu.getSelectedItem().toString() : \"Tất cả loại đơn\";\n\n        java.time.LocalDate today = java.time.LocalDate.now();\n        DateTimeFormatter dFmt = DateTimeFormatter.ofPattern(\"dd/MM/yyyy\");\n\n        for (HoaDonDaThanhToan hd : dsLichSuHoaDon) {\n            boolean matchNgay = true;\n            if (!\"Tất cả lịch sử\".equals(locNgay)) {\n                java.time.LocalDate hdDate = null;\n                if (hd.thoiGian != null && hd.thoiGian.length() >= 10) {\n                    try {\n                        String s = hd.thoiGian.trim();\n                        String datePart = s.contains(\" - \") ? s.substring(s.lastIndexOf(\" - \") + 3).trim() : s;\n                        if (datePart.length() >= 10) {\n                            hdDate = java.time.LocalDate.parse(datePart.substring(0, 10), dFmt);\n                        }\n                    } catch (Exception ignored) {}\n                }\n                if (hdDate == null) {\n                    matchNgay = false;\n                } else if (\"Hôm nay\".equals(locNgay)) {\n                    matchNgay = hdDate.equals(today);\n                } else if (\"Hôm qua\".equals(locNgay)) {\n                    matchNgay = hdDate.equals(today.minusDays(1));\n                } else if (\"7 ngày qua\".equals(locNgay)) {\n                    matchNgay = !hdDate.isBefore(today.minusDays(6)) && !hdDate.isAfter(today);\n                }\n            }\n            if (!matchNgay) continue;\n\n            boolean matchLoai = true;\n            if (\"Đơn bán lẻ (Hàng hóa)\".equals(locLoai)) {\n                matchLoai = coSanPhamBanLe(hd);\n            } else if (\"Đơn dịch vụ Spa\".equals(locLoai)) {\n                matchLoai = coDichVuSpa(hd);\n            }\n            if (!matchLoai) continue;\n\n            dsLichSuHienThi.add(hd);\n            modelLichSu.addRow(new Object[]{\n                    hd.maHoaDon,\n                    hd.thoiGian,\n                    hd.tenKhach,\n                    hd.sdt,\n                    hd.thuNgan,\n                    df.format(hd.tongTienHang),\n                    df.format(hd.giamGia),\n                    df.format(hd.tongThanhToan),\n                    hd.phuongThuc,\n                    hd.trangThai\n            });\n        }\n    }\n\n    private void locLichSu(String kw) {\n        if (kw.isEmpty()) {\n            sorterLichSu.setRowFilter(null);\n        } else {\n            sorterLichSu.setRowFilter(RowFilter.regexFilter(\"(?i)\" + Pattern.quote(kw)));\n        }\n    }\n\n    private void xuLyXemChiTietLichSu() {\n        int row = tblLichSu.getSelectedRow();\n        if (row < 0) {\n            JOptionPane.showMessageDialog(this, \"Vui lòng chọn một hóa đơn từ bảng lịch sử để xem mẫu phiếu hóa đơn!\", \"Nhắc nhở\", JOptionPane.INFORMATION_MESSAGE);\n            return;\n        }\n\n        int modelRow = tblLichSu.convertRowIndexToModel(row);\n        if (modelRow < 0 || modelRow >= dsLichSuHienThi.size()) return;\n        HoaDonDaThanhToan hd = dsLichSuHienThi.get(modelRow);\n\n        int diemCong = (int) (hd.tongThanhToan / 100000L);\n        int tongDiem = diemCong;\n        if (hd.sdt != null && !hd.sdt.trim().isEmpty()) {\n            KhachHang kh = controller.timKhachHang(hd.sdt.trim());\n            if (kh != null) {\n                tongDiem = kh.getDiemTichLuy();\n            }\n        }\n\n        HoaDonPreviewDialog.hienThiHoaDon(this, hd, hd.tongThanhToan, 0, diemCong, tongDiem);\n    }\n\n    private void xuLyInLaiHoaDon() {\n        int row = tblLichSu.getSelectedRow();\n        if (row < 0) {\n            JOptionPane.showMessageDialog(this, \"Vui lòng chọn hóa đơn cần xem và in lại!\", \"Nhắc nhở\", JOptionPane.INFORMATION_MESSAGE);\n            return;\n        }\n        xuLyXemChiTietLichSu();\n    }\n\n    private void xuLyXuatExcel() {\n        if (dsLichSuHoaDon.isEmpty()) {\n            JOptionPane.showMessageDialog(this, \"Chưa có dữ liệu hóa đơn để xuất Excel!\", \"Thông báo\", JOptionPane.INFORMATION_MESSAGE);\n            return;\n        }\n\n        try {\n            java.util.List<java.util.List<String>> rows = new ArrayList<>();\n            rows.add(java.util.Arrays.asList(\n                    \"Mã hóa đơn\", \"Thời gian\", \"Tên khách hàng\", \"Số điện thoại\",\n                    \"Thu ngân\", \"Tổng tiền hàng\", \"Giảm giá\", \"Thực thu\", \"Phương thức\", \"Trạng thái\"\n            ));\n\n            for (HoaDonDaThanhToan hd : dsLichSuHoaDon) {\n                rows.add(java.util.Arrays.asList(\n                        hd.maHoaDon != null ? hd.maHoaDon : \"\",\n                        hd.thoiGian != null ? hd.thoiGian : \"\",\n                        hd.tenKhach != null ? hd.tenKhach : \"\",\n                        hd.sdt != null ? hd.sdt : \"\",\n                        hd.thuNgan != null ? hd.thuNgan : \"\",\n                        String.valueOf(hd.tongTienHang),\n                        String.valueOf(hd.giamGia),\n                        String.valueOf(hd.tongThanhToan),\n                        hd.phuongThuc != null ? hd.phuongThuc : \"\",\n                        hd.trangThai != null ? hd.trangThai : \"\"\n                ));\n            }\n\n            String fileName = \"BaoCaoDoanhThu_\" + LocalDate.now().format(DateTimeFormatter.ofPattern(\"yyyyMMdd\")) + \"_\" + System.currentTimeMillis() + \".xlsx\";\n            java.nio.file.Path outputPath = java.nio.file.Paths.get(\"export\", fileName);\n            utils.LichPhanCaExcelExporter.export(outputPath, \"Doanh Thu POS\", rows);\n\n            JOptionPane.showMessageDialog(this,\n                    \"XUẤT BÁO CÁO DOANH THU EXCEL THÀNH CÔNG!\\n\\n\" +\n                            \"• Tổng số hóa đơn: \" + dsLichSuHoaDon.size() + \" đơn\\n\" +\n                            \"• Tệp đã lưu tại: \" + outputPath.toAbsolutePath().toString(),\n                    \"Xuất Excel thành công\", JOptionPane.INFORMATION_MESSAGE);\n        } catch (Exception e) {\n            System.err.println(\"[BanHangPOSPanel] Lỗi xuất Excel: \" + e.getMessage());\n            JOptionPane.showMessageDialog(this, \"Không thể xuất file Excel: \" + e.getMessage(), \"Lỗi xuất file\", JOptionPane.ERROR_MESSAGE);\n        }\n    }\n}\n"},{"path":"src/gui/DoiTraHangPanel.java","sha256":"8d5104b519560d02b2bc6f71deeec3e3e52a2275a513be9d085fde2066bbdbc8","content":"package gui;\n\nimport bus.BanHangBus;\nimport bus.DoiTraBus;\nimport entity.DoiTraTransferData;\nimport entity.KhachHang;\nimport utils.IconHelper;\nimport utils.ThemeColors;\n\nimport javax.swing.*;\nimport javax.swing.border.CompoundBorder;\nimport javax.swing.border.EmptyBorder;\nimport javax.swing.border.LineBorder;\nimport javax.swing.table.DefaultTableCellRenderer;\nimport javax.swing.table.DefaultTableModel;\nimport java.awt.*;\nimport java.text.DecimalFormat;\nimport java.math.BigDecimal;\nimport java.math.RoundingMode;\nimport java.time.LocalDateTime;\nimport java.time.format.DateTimeFormatter;\nimport java.util.ArrayList;\nimport java.util.List;\n\n/**\n * Phân hệ Quản lý Đổi Trả Hàng Hóa & Hoàn Tiền (Return & Exchange Management)\n * Chuẩn Slide 17 IUH & Bảng màu Happy Hues Palette 15 (#faeee7, #ff8ba7, #33272a).\n * Hỗ trợ 2 Kịch bản Nghiệp vụ thực tế:\n * 1. Kịch bản A: Trả hàng - Hoàn tiền (Khấu trừ điểm VIP, Hoàn kho nếu nguyên tem).\n * 2. Kịch bản B: Đổi sang món khác (Bù/hoàn chênh lệch, Cập nhật kho cả món cũ và mới).\n */\npublic class DoiTraHangPanel extends JPanel {\n\n    private final DoiTraBus doiTraBus = new DoiTraBus();\n\n    private final DecimalFormat df = new DecimalFormat(\"#,### đ\");\n    private final DateTimeFormatter dtf = DateTimeFormatter.ofPattern(\"HH:mm - dd/MM/yyyy\");\n\n    // Khu vực 1: Tra cứu Hóa đơn\n    private JTextField txtTraCuu;\n    private JLabel lblInfoMaHD;\n    private JLabel lblInfoKhach;\n    private JLabel lblInfoThuNgan;\n    private JLabel lblInfoThoiGian;\n    private JLabel lblInfoTongTien;\n    private JPanel pnlInfoCard;\n\n    // Khu vực 2: Bảng sản phẩm\n    private DefaultTableModel modelSanPham;\n    private JTable tblSanPham;\n\n    // Khu vực 3: Kịch bản đổi trả\n    private JRadioButton radKichBanA;\n    private JRadioButton radKichBanB;\n    private JComboBox<BanHangPOSPanel.SanPhamDoiTra> cboSanPhamMoi;\n    private JSpinner spnSoLuongMoi;\n    private JLabel lblKetQuaHoanTien;\n    private JLabel lblKetQuaDiemVIP;\n    private JLabel lblKetQuaKho;\n    private JLabel lblKetQuaChenhLech;\n    private JPanel pnlKichBanBDetails;\n    private JButton btnXacNhanInPhieu;\n\n    // Data hóa đơn đang chọn\n    private BanHangPOSPanel.HoaDonDaThanhToan currentHoaDon = null;\n    private KhachHang currentKhachHang = null;\n    private boolean dangCapNhatBang = false;\n\n    public DoiTraHangPanel() {\n        setLayout(new BorderLayout(0, 14));\n        setBorder(new EmptyBorder(16, 20, 16, 20));\n        setBackground(ThemeColors.BACKGROUND);\n\n        // Header trên cùng\n        add(taoHeader(), BorderLayout.NORTH);\n\n        // Nội dung chính: Chia 2 nửa hoặc bố cục trên/dưới dạng thẻ\n        JPanel pnlCenter = new JPanel(new BorderLayout(0, 14));\n        pnlCenter.setOpaque(false);\n\n        // Nửa trên: Khu vực 1 (Tra cứu) & Khu vực 2 (Bảng sản phẩm)\n        JPanel pnlTopSection = new JPanel(new BorderLayout(0, 10));\n        pnlTopSection.setOpaque(false);\n        pnlTopSection.add(taoKhuVucTraCuu(), BorderLayout.NORTH);\n        pnlTopSection.add(taoKhuVucBangSanPham(), BorderLayout.CENTER);\n\n        // Nửa dưới: Khu vực 3 (2 Kịch bản) & Khu vực 4 (Nút In phiếu)\n        JPanel pnlBottomSection = new JPanel(new BorderLayout(0, 10));\n        pnlBottomSection.setOpaque(false);\n        pnlBottomSection.add(taoKhuVucKichBanNghiepVu(), BorderLayout.CENTER);\n        pnlBottomSection.add(taoKhuVucThaoTac(), BorderLayout.SOUTH);\n\n        pnlCenter.add(pnlTopSection, BorderLayout.CENTER);\n        pnlCenter.add(pnlBottomSection, BorderLayout.SOUTH);\n\n        add(pnlCenter, BorderLayout.CENTER);\n\n        // Tải sẵn hóa đơn mẫu đầu tiên nếu có để nhân viên thấy ngay dữ liệu\n        napHoaDonMacDinh();\n    }\n\n    private JPanel taoHeader() {\n        JPanel header = new JPanel(new BorderLayout());\n        header.setOpaque(false);\n\n        JPanel pnlTitles = new JPanel(new GridLayout(2, 1, 0, 2));\n        pnlTitles.setOpaque(false);\n\n        JLabel lblTitle = new JLabel(\"XỬ LÝ ĐỔI TRẢ HÀNG HÓA & HOÀN TIỀN\", IconHelper.getPrimaryIcon(IconHelper.REFRESH, 20), SwingConstants.LEFT);\n        lblTitle.setFont(new Font(\"Segoe UI\", Font.BOLD, 18));\n        lblTitle.setForeground(ThemeColors.TEXT_PRIMARY);\n\n        JLabel lblSub = new JLabel(\"Hỗ trợ tra cứu hóa đơn cũ, hoàn tiền, đổi sang sản phẩm khác, bù trừ chênh lệch và khấu trừ điểm VIP.\");\n        lblSub.setFont(new Font(\"Segoe UI\", Font.PLAIN, 13));\n        lblSub.setForeground(ThemeColors.TEXT_SECONDARY);\n\n        pnlTitles.add(lblTitle);\n        pnlTitles.add(lblSub);\n\n        JPanel pnlActions = new JPanel(new FlowLayout(FlowLayout.RIGHT, 8, 0));\n        pnlActions.setOpaque(false);\n\n        JButton btnLamMoi = ThemeColors.createSecondaryButton(\"Làm mới / Đơn khác\", IconHelper.getIcon(IconHelper.REFRESH, 14, ThemeColors.TEXT_SECONDARY));\n        btnLamMoi.setPreferredSize(new Dimension(160, 36));\n        btnLamMoi.addActionListener(e -> lamMoiGiaoDien());\n\n        pnlActions.add(btnLamMoi);\n\n        header.add(pnlTitles, BorderLayout.WEST);\n        header.add(pnlActions, BorderLayout.EAST);\n        return header;\n    }\n\n    // ==========================================\n    // KHU VỰC 1: TRA CỨU HÓA ĐƠN GỐC\n    // ==========================================\n    private JPanel taoKhuVucTraCuu() {\n        JPanel pnl = new JPanel(new BorderLayout(0, 8));\n        pnl.setBackground(ThemeColors.SURFACE);\n        pnl.setBorder(ThemeColors.createCardBorder(12, 14, 12, 14));\n\n        JPanel pnlSearchBar = new JPanel(new BorderLayout(8, 0));\n        pnlSearchBar.setOpaque(false);\n\n        JLabel lblSearchTitle = new JLabel(\"Tra cứu Hóa đơn:\", IconHelper.getIcon(IconHelper.SEARCH, 15, ThemeColors.PRIMARY_ACTIVE), SwingConstants.LEFT);\n        lblSearchTitle.setFont(new Font(\"Segoe UI\", Font.BOLD, 13));\n        lblSearchTitle.setPreferredSize(new Dimension(140, 34));\n\n        txtTraCuu = new JTextField();\n        txtTraCuu.setPreferredSize(new Dimension(0, 34));\n        txtTraCuu.setFont(new Font(\"Segoe UI\", Font.PLAIN, 13));\n        txtTraCuu.putClientProperty(\"JTextField.placeholderText\", \"Nhập Mã HĐ (vd: HD982104) hoặc Số điện thoại khách hàng (vd: 0988111222)...\");\n        txtTraCuu.setBorder(ThemeColors.createInputBorder());\n        txtTraCuu.addActionListener(e -> thucHienTraCuuHoaDon());\n\n        JButton btnTim = ThemeColors.createSecondaryButton(\"Tra cứu HĐ\", IconHelper.getIcon(IconHelper.SEARCH, 14, ThemeColors.TEXT_PRIMARY));\n        btnTim.setPreferredSize(new Dimension(110, 34));\n        btnTim.addActionListener(e -> thucHienTraCuuHoaDon());\n\n        JButton btnChonLichSu = ThemeColors.createSecondaryButton(\"Chọn từ Lịch sử\", IconHelper.getIcon(IconHelper.RECEIPT, 14, ThemeColors.TEXT_SECONDARY));\n        btnChonLichSu.setPreferredSize(new Dimension(140, 34));\n        btnChonLichSu.addActionListener(e -> hienThiDialogChonHoaDonLichSu());\n\n        JPanel pnlButtons = new JPanel(new FlowLayout(FlowLayout.RIGHT, 6, 0));\n        pnlButtons.setOpaque(false);\n        pnlButtons.add(btnTim);\n        pnlButtons.add(btnChonLichSu);\n\n        pnlSearchBar.add(lblSearchTitle, BorderLayout.WEST);\n        pnlSearchBar.add(txtTraCuu, BorderLayout.CENTER);\n        pnlSearchBar.add(pnlButtons, BorderLayout.EAST);\n\n        // Thông tin Hóa đơn hiển thị bên dưới\n        pnlInfoCard = new JPanel(new GridLayout(2, 3, 12, 6));\n        pnlInfoCard.setOpaque(false);\n        pnlInfoCard.setBorder(new CompoundBorder(\n                new LineBorder(ThemeColors.BORDER_LIGHT, 1, true),\n                new EmptyBorder(8, 12, 8, 12)\n        ));\n\n        lblInfoMaHD = new JLabel(\"• Mã HĐ: —\");\n        lblInfoMaHD.setFont(new Font(\"Segoe UI\", Font.BOLD, 13));\n        lblInfoMaHD.setForeground(ThemeColors.PRIMARY_ACTIVE);\n\n        lblInfoKhach = new JLabel(\"• Khách hàng: —\");\n        lblInfoKhach.setFont(new Font(\"Segoe UI\", Font.PLAIN, 13));\n\n        lblInfoThuNgan = new JLabel(\"• Thu ngân: —\");\n        lblInfoThuNgan.setFont(new Font(\"Segoe UI\", Font.PLAIN, 13));\n\n        lblInfoThoiGian = new JLabel(\"• Thời gian mua: —\");\n        lblInfoThoiGian.setFont(new Font(\"Segoe UI\", Font.PLAIN, 13));\n\n        lblInfoTongTien = new JLabel(\"• Tổng thanh toán: —\");\n        lblInfoTongTien.setFont(new Font(\"Segoe UI\", Font.BOLD, 13));\n        lblInfoTongTien.setForeground(ThemeColors.TEXT_PRIMARY);\n\n        JLabel lblChinhSach = new JLabel(\"• Chính sách: Đổi trả trong 07 ngày kể từ khi mua.\");\n        lblChinhSach.setFont(new Font(\"Segoe UI\", Font.ITALIC, 12));\n        lblChinhSach.setForeground(ThemeColors.TEXT_MUTED);\n\n        pnlInfoCard.add(lblInfoMaHD);\n        pnlInfoCard.add(lblInfoKhach);\n        pnlInfoCard.add(lblInfoThuNgan);\n        pnlInfoCard.add(lblInfoThoiGian);\n        pnlInfoCard.add(lblInfoTongTien);\n        pnlInfoCard.add(lblChinhSach);\n\n        pnl.add(pnlSearchBar, BorderLayout.NORTH);\n        pnl.add(pnlInfoCard, BorderLayout.CENTER);\n        return pnl;\n    }\n\n    // ==========================================\n    // KHU VỰC 2: BẢNG SẢN PHẨM CẦN ĐỔI / TRẢ\n    // ==========================================\n    private JPanel taoKhuVucBangSanPham() {\n        JPanel pnl = new JPanel(new BorderLayout(0, 8));\n        pnl.setBackground(ThemeColors.SURFACE);\n        pnl.setBorder(ThemeColors.createCardBorder(12, 14, 12, 14));\n\n        JPanel pnlHeader = new JPanel(new BorderLayout());\n        pnlHeader.setOpaque(false);\n\n        JLabel lblTitle = new JLabel(\"DANH SÁCH SẢN PHẨM TRONG HÓA ĐƠN CẦN ĐỔI / TRẢ\", IconHelper.getPrimaryIcon(IconHelper.BOXES, 16), SwingConstants.LEFT);\n        lblTitle.setFont(new Font(\"Segoe UI\", Font.BOLD, 14));\n        lblTitle.setForeground(ThemeColors.TEXT_PRIMARY);\n\n        JLabel lblGuide = new JLabel(\"Tích chọn sản phẩm muốn đổi/trả -> Nhập số lượng và chọn lý do / tình trạng hàng.\");\n        lblGuide.setFont(new Font(\"Segoe UI\", Font.ITALIC, 12));\n        lblGuide.setForeground(ThemeColors.TEXT_MUTED);\n\n        pnlHeader.add(lblTitle, BorderLayout.WEST);\n        pnlHeader.add(lblGuide, BorderLayout.EAST);\n\n        String[] cols = {\n                \"Chọn\", \"STT\", \"Mã SP\", \"Tên sản phẩm\", \"ĐVT\", \"Giá hoàn/ĐVT\", \"Đã mua\", \"SL Trả\", \"Lý do đổi trả\", \"Tình trạng hàng\", \"Số lô\", \"SL cơ sở/món\"\n        };\n\n        modelSanPham = new DefaultTableModel(cols, 0) {\n            @Override\n            public Class<?> getColumnClass(int columnIndex) {\n                if (columnIndex == 0) return Boolean.class;\n                if (columnIndex == 1 || columnIndex == 6 || columnIndex == 7) return Integer.class;\n                return String.class;\n            }\n\n            @Override\n            public boolean isCellEditable(int row, int column) {\n                // Cho phép sửa cột Chọn (0), SL Trả (7), Lý do (8), Tình trạng (9)\n                return column == 0 || column == 7 || column == 8 || column == 9;\n            }\n        };\n\n        tblSanPham = new JTable(modelSanPham);\n        tblSanPham.setRowHeight(36);\n        tblSanPham.setFont(new Font(\"Segoe UI\", Font.PLAIN, 13));\n        tblSanPham.setShowHorizontalLines(true);\n        tblSanPham.setShowVerticalLines(false);\n        tblSanPham.setGridColor(ThemeColors.BORDER_LIGHT);\n        tblSanPham.setSelectionBackground(ThemeColors.PRIMARY_SOFT);\n        tblSanPham.setSelectionForeground(ThemeColors.TEXT_PRIMARY);\n        tblSanPham.getTableHeader().setFont(new Font(\"Segoe UI\", Font.BOLD, 12));\n        tblSanPham.getTableHeader().setBackground(ThemeColors.PRIMARY_TINT);\n        tblSanPham.getTableHeader().setPreferredSize(new Dimension(0, 34));\n\n        DefaultTableCellRenderer center = new DefaultTableCellRenderer();\n        center.setHorizontalAlignment(JLabel.CENTER);\n\n        tblSanPham.getColumnModel().getColumn(0).setPreferredWidth(50);\n        tblSanPham.getColumnModel().getColumn(1).setPreferredWidth(45);\n        tblSanPham.getColumnModel().getColumn(1).setCellRenderer(center);\n        tblSanPham.getColumnModel().getColumn(2).setPreferredWidth(65);\n        tblSanPham.getColumnModel().getColumn(2).setCellRenderer(center);\n        tblSanPham.getColumnModel().getColumn(3).setPreferredWidth(180);\n        tblSanPham.getColumnModel().getColumn(4).setPreferredWidth(50);\n        tblSanPham.getColumnModel().getColumn(4).setCellRenderer(center);\n        tblSanPham.getColumnModel().getColumn(5).setPreferredWidth(85);\n        tblSanPham.getColumnModel().getColumn(6).setPreferredWidth(60);\n        tblSanPham.getColumnModel().getColumn(6).setCellRenderer(center);\n        tblSanPham.getColumnModel().getColumn(7).setPreferredWidth(65);\n        tblSanPham.getColumnModel().getColumn(7).setCellRenderer(center);\n        tblSanPham.getColumnModel().getColumn(8).setPreferredWidth(160);\n        tblSanPham.getColumnModel().getColumn(9).setPreferredWidth(180);\n        tblSanPham.getColumnModel().getColumn(10).setMinWidth(0);\n        tblSanPham.getColumnModel().getColumn(10).setMaxWidth(0);\n        tblSanPham.getColumnModel().getColumn(11).setMinWidth(0);\n        tblSanPham.getColumnModel().getColumn(11).setMaxWidth(0);\n\n        // Combobox cho Lý do đổi trả\n        JComboBox<String> cboLyDo = new JComboBox<>(new String[]{\n                \"Sản phẩm lỗi/hỏng\",\n                \"Thú cưng không hợp/dị ứng\",\n                \"Đổi size vòng cổ/chuồng\",\n                \"Khách đổi ý\"\n        });\n        tblSanPham.getColumnModel().getColumn(8).setCellEditor(new DefaultCellEditor(cboLyDo));\n\n        // Combobox cho Tình trạng hàng\n        JComboBox<String> cboTinhTrang = new JComboBox<>(new String[]{\n                \"Còn nguyên tem (nhập lại kho)\",\n                \"Hàng lỗi/rách (chờ hủy)\"\n        });\n        tblSanPham.getColumnModel().getColumn(9).setCellEditor(new DefaultCellEditor(cboTinhTrang));\n\n        // Lắng nghe sự kiện cập nhật bảng để tính lại số tiền\n        modelSanPham.addTableModelListener(e -> capNhatTinhToanKichBan());\n\n        JScrollPane scrollTable = new JScrollPane(tblSanPham);\n        scrollTable.setPreferredSize(new Dimension(0, 160));\n        scrollTable.setBorder(new LineBorder(ThemeColors.BORDER_LIGHT, 1, true));\n\n        pnl.add(pnlHeader, BorderLayout.NORTH);\n        pnl.add(scrollTable, BorderLayout.CENTER);\n        return pnl;\n    }\n\n    // ==========================================\n    // KHU VỰC 3: XỬ LÝ 2 KỊCH BẢN NGHIỆP VỤ\n    // ==========================================\n    private JPanel taoKhuVucKichBanNghiepVu() {\n        JPanel pnl = new JPanel(new BorderLayout(0, 10));\n        pnl.setBackground(ThemeColors.SURFACE);\n        pnl.setBorder(ThemeColors.createCardBorder(12, 14, 12, 14));\n\n        JPanel pnlHeader = new JPanel(new FlowLayout(FlowLayout.LEFT, 16, 0));\n        pnlHeader.setOpaque(false);\n\n        JLabel lblTitle = new JLabel(\"LỰA CHỌN KỊCH BẢN XỬ LÝ:\", IconHelper.getPrimaryIcon(IconHelper.CLIPBOARD_CHECK, 16), SwingConstants.LEFT);\n        lblTitle.setFont(new Font(\"Segoe UI\", Font.BOLD, 13));\n        lblTitle.setForeground(ThemeColors.TEXT_PRIMARY);\n\n        radKichBanA = new JRadioButton(\"Kịch bản A: Trả hàng - Hoàn tiền\", true);\n        radKichBanA.setFont(new Font(\"Segoe UI\", Font.BOLD, 13));\n        radKichBanA.setForeground(ThemeColors.TEXT_PRIMARY);\n        radKichBanA.setOpaque(false);\n        radKichBanA.setFocusPainted(false);\n        radKichBanA.addActionListener(e -> chuyenDoiKichBan(true));\n\n        radKichBanB = new JRadioButton(\"Kịch bản B: Đổi sang sản phẩm khác\", false);\n        radKichBanB.setFont(new Font(\"Segoe UI\", Font.BOLD, 13));\n        radKichBanB.setForeground(ThemeColors.TEXT_PRIMARY);\n        radKichBanB.setOpaque(false);\n        radKichBanB.setFocusPainted(false);\n        radKichBanB.addActionListener(e -> chuyenDoiKichBan(false));\n\n        ButtonGroup group = new ButtonGroup();\n        group.add(radKichBanA);\n        group.add(radKichBanB);\n\n        pnlHeader.add(lblTitle);\n        pnlHeader.add(radKichBanA);\n        pnlHeader.add(radKichBanB);\n\n        // Panel chi tiết kịch bản\n        JPanel pnlDetails = new JPanel(new GridLayout(1, 2, 14, 0));\n        pnlDetails.setOpaque(false);\n\n        // Khối trái: Kết quả hoàn tiền & Khấu trừ điểm VIP (Dùng cho cả A và B)\n        JPanel pnlSummary = new JPanel(new GridLayout(3, 1, 0, 6));\n        pnlSummary.setOpaque(false);\n        pnlSummary.setBorder(new CompoundBorder(\n                new LineBorder(ThemeColors.BORDER_LIGHT, 1, true),\n                new EmptyBorder(10, 14, 10, 14)\n        ));\n\n        lblKetQuaHoanTien = new JLabel(\"Tiền hàng đổi/trả: 0 đ\");\n        lblKetQuaHoanTien.setFont(new Font(\"Segoe UI\", Font.BOLD, 14));\n        lblKetQuaHoanTien.setForeground(ThemeColors.PRIMARY_ACTIVE);\n\n        lblKetQuaDiemVIP = new JLabel(\"Khấu trừ điểm VIP: -0 điểm\");\n        lblKetQuaDiemVIP.setFont(new Font(\"Segoe UI\", Font.PLAIN, 13));\n        lblKetQuaDiemVIP.setForeground(ThemeColors.DANGER);\n\n        lblKetQuaKho = new JLabel(\"Tồn kho hoàn lại: 0 món (Nếu nguyên tem)\");\n        lblKetQuaKho.setFont(new Font(\"Segoe UI\", Font.PLAIN, 13));\n        lblKetQuaKho.setForeground(ThemeColors.SUCCESS);\n\n        pnlSummary.add(lblKetQuaHoanTien);\n        pnlSummary.add(lblKetQuaDiemVIP);\n        pnlSummary.add(lblKetQuaKho);\n\n        // Khối phải: Cấu hình sản phẩm đổi mới (Dành cho Kịch bản B)\n        pnlKichBanBDetails = new JPanel(new GridBagLayout());\n        pnlKichBanBDetails.setOpaque(false);\n        pnlKichBanBDetails.setBorder(new CompoundBorder(\n                new LineBorder(ThemeColors.BORDER_LIGHT, 1, true),\n                new EmptyBorder(10, 14, 10, 14)\n        ));\n\n        GridBagConstraints gbc = new GridBagConstraints();\n        gbc.fill = GridBagConstraints.HORIZONTAL;\n        gbc.insets = new Insets(3, 4, 3, 4);\n\n        gbc.gridx = 0; gbc.gridy = 0; gbc.weightx = 0.3;\n        JLabel lblChonMonMoi = new JLabel(\"Chọn món mới:\");\n        lblChonMonMoi.setFont(new Font(\"Segoe UI\", Font.BOLD, 12));\n        pnlKichBanBDetails.add(lblChonMonMoi, gbc);\n\n        gbc.gridx = 1; gbc.weightx = 0.7;\n        List<BanHangPOSPanel.SanPhamDoiTra> dsSanPham = BanHangPOSPanel.layDanhSachSanPhamDoi();\n        cboSanPhamMoi = new JComboBox<>(dsSanPham.toArray(new BanHangPOSPanel.SanPhamDoiTra[0]));\n        cboSanPhamMoi.setPreferredSize(new Dimension(220, 30));\n        cboSanPhamMoi.addActionListener(e -> capNhatTinhToanKichBan());\n        pnlKichBanBDetails.add(cboSanPhamMoi, gbc);\n\n        gbc.gridx = 0; gbc.gridy = 1; gbc.weightx = 0.3;\n        JLabel lblSoLuongMoi = new JLabel(\"Số lượng mới:\");\n        lblSoLuongMoi.setFont(new Font(\"Segoe UI\", Font.BOLD, 12));\n        pnlKichBanBDetails.add(lblSoLuongMoi, gbc);\n\n        gbc.gridx = 1; gbc.weightx = 0.7;\n        spnSoLuongMoi = new JSpinner(new SpinnerNumberModel(1, 1, 999, 1));\n        spnSoLuongMoi.setPreferredSize(new Dimension(80, 30));\n        spnSoLuongMoi.addChangeListener(e -> capNhatTinhToanKichBan());\n        pnlKichBanBDetails.add(spnSoLuongMoi, gbc);\n\n        gbc.gridx = 0; gbc.gridy = 2; gbc.gridwidth = 2;\n        lblKetQuaChenhLech = new JLabel(\"Tiền chênh lệch bù/hoàn: 0 đ\");\n        lblKetQuaChenhLech.setFont(new Font(\"Segoe UI\", Font.BOLD, 14));\n        lblKetQuaChenhLech.setForeground(ThemeColors.TEXT_PRIMARY);\n        pnlKichBanBDetails.add(lblKetQuaChenhLech, gbc);\n\n        pnlDetails.add(pnlSummary);\n        pnlDetails.add(pnlKichBanBDetails);\n\n        pnl.add(pnlHeader, BorderLayout.NORTH);\n        pnl.add(pnlDetails, BorderLayout.CENTER);\n\n        chuyenDoiKichBan(true);\n        return pnl;\n    }\n\n    private void chuyenDoiKichBan(boolean laKichBanA) {\n        cboSanPhamMoi.setEnabled(!laKichBanA);\n        spnSoLuongMoi.setEnabled(!laKichBanA);\n        if (laKichBanA) {\n            pnlKichBanBDetails.setBackground(ThemeColors.BACKGROUND);\n            lblKetQuaChenhLech.setText(\"Kịch bản A: Hoàn 100% tiền hàng đã chọn.\");\n            lblKetQuaChenhLech.setForeground(ThemeColors.TEXT_MUTED);\n            if (btnXacNhanInPhieu != null) {\n                btnXacNhanInPhieu.setText(\"XÁC NHẬN & IN PHIẾU HOÀN TIỀN (80MM)\");\n                btnXacNhanInPhieu.setIcon(IconHelper.getIcon(IconHelper.RECEIPT, 16, Color.WHITE));\n                btnXacNhanInPhieu.setBackground(ThemeColors.PRIMARY);\n                btnXacNhanInPhieu.setPreferredSize(new Dimension(340, 44));\n            }\n        } else {\n            pnlKichBanBDetails.setBackground(ThemeColors.SURFACE);\n            if (btnXacNhanInPhieu != null) {\n                btnXacNhanInPhieu.setText(\"CHUYỂN SANG BÁN HÀNG POS ĐỂ THANH TOÁN (F9)\");\n                btnXacNhanInPhieu.setIcon(IconHelper.getIcon(IconHelper.SHOPPING_BAG, 16, Color.WHITE));\n                btnXacNhanInPhieu.setBackground(new Color(16, 185, 129));\n                btnXacNhanInPhieu.setPreferredSize(new Dimension(390, 44));\n            }\n        }\n        capNhatTinhToanKichBan();\n    }\n\n    // ==========================================\n    // KHU VỰC 4: THAO TÁC & IN PHIẾU ĐỔI TRẢ\n    // ==========================================\n    private JPanel taoKhuVucThaoTac() {\n        JPanel pnl = new JPanel(new FlowLayout(FlowLayout.RIGHT, 12, 4));\n        pnl.setOpaque(false);\n\n        btnXacNhanInPhieu = new JButton(\"XÁC NHẬN & IN PHIẾU HOÀN TIỀN (80MM)\", IconHelper.getIcon(IconHelper.RECEIPT, 16, Color.WHITE));\n        btnXacNhanInPhieu.setFont(new Font(\"Segoe UI\", Font.BOLD, 14));\n        btnXacNhanInPhieu.setBackground(ThemeColors.PRIMARY);\n        btnXacNhanInPhieu.setForeground(Color.WHITE);\n        btnXacNhanInPhieu.setPreferredSize(new Dimension(340, 44));\n        btnXacNhanInPhieu.setFocusPainted(false);\n        btnXacNhanInPhieu.setCursor(new Cursor(Cursor.HAND_CURSOR));\n        btnXacNhanInPhieu.setBorder(new CompoundBorder(\n                new LineBorder(ThemeColors.PRIMARY_HOVER, 1, true),\n                new EmptyBorder(8, 16, 8, 16)\n        ));\n        btnXacNhanInPhieu.addActionListener(e -> thucHienXacNhanDoiTra());\n\n        pnl.add(btnXacNhanInPhieu);\n        return pnl;\n    }\n\n    // ==========================================\n    // LOGIC NGHIỆP VỤ & TÍNH TOÁN\n    // ==========================================\n    private void napHoaDonMacDinh() {\n        List<BanHangPOSPanel.HoaDonDaThanhToan> ds = BanHangPOSPanel.layDanhSachHoaDonDaThanhToan();\n        if (!ds.isEmpty()) {\n            hienThiHoaDon(ds.get(0));\n        }\n    }\n\n    public void lamMoiGiaoDien() {\n        txtTraCuu.setText(\"\");\n        napHoaDonMacDinh();\n    }\n\n    private void hienThiDialogChonHoaDonLichSu() {\n        List<BanHangPOSPanel.HoaDonDaThanhToan> ds = BanHangPOSPanel.layDanhSachHoaDonDaThanhToan();\n        if (ds.isEmpty()) {\n            JOptionPane.showMessageDialog(this, \"Chưa có hóa đơn nào đã thanh toán trong hệ thống!\", \"Thông báo\", JOptionPane.INFORMATION_MESSAGE);\n            return;\n        }\n\n        String[] cols = {\"Mã HĐ\", \"Thời gian\", \"Khách hàng\", \"Số điện thoại\", \"Tổng tiền\", \"Thu ngân\"};\n        DefaultTableModel model = new DefaultTableModel(cols, 0) {\n            @Override\n            public boolean isCellEditable(int r, int c) { return false; }\n        };\n        for (BanHangPOSPanel.HoaDonDaThanhToan hd : ds) {\n            model.addRow(new Object[]{\n                    hd.maHoaDon, hd.thoiGian, hd.tenKhach, hd.sdt, df.format(hd.tongThanhToan), hd.thuNgan\n            });\n        }\n\n        JTable tbl = new JTable(model);\n        tbl.setRowHeight(32);\n        tbl.setFont(new Font(\"Segoe UI\", Font.PLAIN, 12));\n        tbl.setSelectionMode(ListSelectionModel.SINGLE_SELECTION);\n        if (tbl.getRowCount() > 0) tbl.setRowSelectionInterval(0, 0);\n\n        JScrollPane sp = new JScrollPane(tbl);\n        sp.setPreferredSize(new Dimension(600, 260));\n\n        int opt = JOptionPane.showConfirmDialog(this, sp, \"CHỌN HÓA ĐƠN ĐÃ THANH TOÁN ĐỂ ĐỔI TRẢ\", JOptionPane.OK_CANCEL_OPTION, JOptionPane.PLAIN_MESSAGE);\n        if (opt == JOptionPane.OK_OPTION) {\n            int selectedRow = tbl.getSelectedRow();\n            if (selectedRow >= 0 && selectedRow < ds.size()) {\n                hienThiHoaDon(ds.get(selectedRow));\n            }\n        }\n    }\n\n    private void thucHienTraCuuHoaDon() {\n        String keyword = txtTraCuu.getText().trim();\n        if (keyword.isEmpty()) {\n            JOptionPane.showMessageDialog(this, \"Vui lòng nhập Mã Hóa Đơn hoặc Số điện thoại cần tìm!\", \"Lỗi nhập liệu\", JOptionPane.WARNING_MESSAGE);\n            return;\n        }\n\n        List<BanHangPOSPanel.HoaDonDaThanhToan> ds = BanHangPOSPanel.layDanhSachHoaDonDaThanhToan();\n        BanHangPOSPanel.HoaDonDaThanhToan timThay = null;\n        for (BanHangPOSPanel.HoaDonDaThanhToan hd : ds) {\n            if (hd.maHoaDon.equalsIgnoreCase(keyword) || (hd.sdt != null && hd.sdt.equalsIgnoreCase(keyword))) {\n                timThay = hd;\n                break;\n            }\n        }\n\n        if (timThay != null) {\n            hienThiHoaDon(timThay);\n        } else {\n            JOptionPane.showMessageDialog(this, \"Không tìm thấy hóa đơn nào khớp với từ khóa: \" + keyword, \"Không tìm thấy\", JOptionPane.INFORMATION_MESSAGE);\n        }\n    }\n\n    private void hienThiHoaDon(BanHangPOSPanel.HoaDonDaThanhToan hd) {\n        this.currentHoaDon = hd;\n        this.currentKhachHang = new BanHangBus().timKhachHang(hd.sdt);\n\n        int diem = currentKhachHang != null ? currentKhachHang.getDiemTichLuy() : 0;\n        String vipBadge = diem >= 100 ? \" (VIP)\" : \"\";\n\n        lblInfoMaHD.setText(\"• Mã HĐ: \" + hd.maHoaDon);\n        lblInfoKhach.setText(\"• Khách hàng: \" + hd.tenKhach + \" (\" + (hd.sdt != null ? hd.sdt : \"Vãng lai\") + \" - \" + diem + \" điểm\" + vipBadge + \")\");\n        lblInfoThuNgan.setText(\"• Thu ngân: \" + hd.thuNgan);\n        lblInfoThoiGian.setText(\"• Thời gian mua: \" + hd.thoiGian);\n        lblInfoTongTien.setText(\"• Tổng thanh toán: \" + df.format(hd.tongThanhToan) + \" (\" + hd.phuongThuc + \")\");\n\n        // Tra cứu số lượng đã đổi trả ở các lần trước từ CSDL để chống trả lố / trả trùng\n        java.util.Map<String, Integer> mapDaTra;\n        try { mapDaTra = doiTraBus.layMapSoLuongDaTra(hd.maHoaDon); }\n        catch (RuntimeException ex) {\n            modelSanPham.setRowCount(0);\n            JOptionPane.showMessageDialog(this, ex.getMessage(), \"Không tải được lịch sử trả\", JOptionPane.ERROR_MESSAGE);\n            return;\n        }\n\n        // Đổ sản phẩm vào bảng\n        modelSanPham.setRowCount(0);\n        int stt = 1;\n        boolean coSanPhamDaTraHet = false;\n        for (Object[] mon : hd.dsMon) {\n            // [stt, maSP, tenSP, dvt, sl, donGia, thanhTien]\n            String ma = mon.length > 1 && mon[1] != null ? mon[1].toString() : \"SP000\";\n            String ten = mon.length > 2 && mon[2] != null ? mon[2].toString() : \"Sản phẩm\";\n            String dvt = mon.length > 3 && mon[3] != null ? mon[3].toString() : \"Gói\";\n            int slMua = mon.length > 4 && mon[4] instanceof Integer ? (Integer) mon[4] : 1;\n            String giaStr = mon.length > 5 && mon[5] != null ? mon[5].toString() : \"0 đ\";\n            long giaHoanSauGiam = tinhGiaHoanSauGiamGia(parseGia(giaStr));\n            String soLo = mon.length > 7 && mon[7] != null ? mon[7].toString() : null;\n            int tongSoLuongCoSo = mon.length > 8 && mon[8] instanceof Number\n                    ? ((Number) mon[8]).intValue() : slMua;\n            int soLuongCoSoMoiDonVi = slMua > 0 ? Math.max(1, tongSoLuongCoSo / slMua) : 1;\n\n            // Chỉ cho phép đổi trả hàng hóa vật lý (bắt đầu bằng SP), không đổi dịch vụ đã thực hiện\n            if (ma.startsWith(\"SP\")) {\n                String productKey = ma.trim().toUpperCase();\n                int daTraCoSo = mapDaTra.getOrDefault(productKey, 0);\n                int consumed = Math.min(tongSoLuongCoSo, daTraCoSo);\n                mapDaTra.put(productKey, Math.max(0, daTraCoSo - consumed));\n                int slConDuocTra = Math.max(0, (tongSoLuongCoSo - consumed) / soLuongCoSoMoiDonVi);\n                int slDaTra = slMua - slConDuocTra;\n                if (slConDuocTra > 0) {\n                    String tenHienThi = slDaTra > 0 ? (ten + \" (Đã trả \" + slDaTra + \"/\" + slMua + \")\") : ten;\n                    modelSanPham.addRow(new Object[]{\n                            false, stt++, ma, tenHienThi, dvt, df.format(giaHoanSauGiam), slConDuocTra, 1, \"Sản phẩm lỗi/hỏng\", \"Còn nguyên tem (nhập lại kho)\", soLo, soLuongCoSoMoiDonVi\n                    });\n                } else {\n                    coSanPhamDaTraHet = true;\n                }\n            }\n        }\n\n        if (modelSanPham.getRowCount() > 0) {\n            // Mặc định tích chọn món đầu tiên để tiện thao tác\n            modelSanPham.setValueAt(true, 0, 0);\n        } else if (coSanPhamDaTraHet) {\n            lblKetQuaHoanTien.setText(\"Hóa đơn [\" + hd.maHoaDon + \"] đã đổi/trả hết số lượng sản phẩm!\");\n        }\n\n        capNhatTinhToanKichBan();\n    }\n\n    private void capNhatTinhToanKichBan() {\n        if (dangCapNhatBang) return;\n        dangCapNhatBang = true;\n        try {\n            long tongTienTra = 0;\n            int tongSlTra = 0;\n            int tongSlNguyenTem = 0;\n\n            for (int i = 0; i < modelSanPham.getRowCount(); i++) {\n                Boolean chon = (Boolean) modelSanPham.getValueAt(i, 0);\n                if (Boolean.TRUE.equals(chon)) {\n                    int slMua = (int) modelSanPham.getValueAt(i, 6);\n                    int slTra = 1;\n                    Object valSlTra = modelSanPham.getValueAt(i, 7);\n                    if (valSlTra instanceof Integer) {\n                        slTra = (Integer) valSlTra;\n                    } else if (valSlTra != null) {\n                        try { slTra = Integer.parseInt(valSlTra.toString().trim()); } catch (Exception ignored) {}\n                    }\n\n                    // Giới hạn slTra không vượt quá slMua và >= 1\n                    if (slTra > slMua) slTra = slMua;\n                    if (slTra < 1) slTra = 1;\n                    if (!Integer.valueOf(slTra).equals(valSlTra)) {\n                        modelSanPham.setValueAt(slTra, i, 7);\n                    }\n\n                    long donGia = parseGia(modelSanPham.getValueAt(i, 5));\n                    tongTienTra += (donGia * slTra);\n                    tongSlTra += slTra;\n\n                    String tinhTrang = (String) modelSanPham.getValueAt(i, 9);\n                    if (tinhTrang != null && tinhTrang.contains(\"nguyên tem\")) {\n                        tongSlNguyenTem += slTra;\n                    }\n                }\n            }\n\n            // Chuẩn hệ thống tích điểm POS: 100.000 đ = 1 điểm VIP\n            int diemKhauTru = (int) (tongTienTra / 100000L);\n\n            lblKetQuaHoanTien.setText(\"Tiền hàng đổi/trả: \" + df.format(tongTienTra));\n            lblKetQuaDiemVIP.setText(\"Khấu trừ điểm VIP: -\" + diemKhauTru + \" điểm\");\n            lblKetQuaKho.setText(\"Tồn kho hoàn lại: +\" + tongSlNguyenTem + \" món nguyên tem\");\n\n            if (radKichBanB.isSelected()) {\n                BanHangPOSPanel.SanPhamDoiTra spMoi = (BanHangPOSPanel.SanPhamDoiTra) cboSanPhamMoi.getSelectedItem();\n                int slMoi = (Integer) spnSoLuongMoi.getValue();\n                long giaTriMonMoi = spMoi != null ? spMoi.donGia * slMoi : 0;\n                long chenhLech = giaTriMonMoi - tongTienTra;\n\n                if (chenhLech > 0) {\n                    lblKetQuaChenhLech.setText(\"<html>Khách cần thanh toán thêm: <b style='color:#33272A; font-size:14px;'>+\" + df.format(chenhLech) + \"</b></html>\");\n                } else if (chenhLech < 0) {\n                    lblKetQuaChenhLech.setText(\"<html>Cửa hàng hoàn lại cho khách: <b style='color:#E53E3E; font-size:14px;'>-\" + df.format(Math.abs(chenhLech)) + \"</b></html>\");\n                } else {\n                    lblKetQuaChenhLech.setText(\"Đổi ngang giá (Chênh lệch: 0 đ)\");\n                }\n            }\n        } finally {\n            dangCapNhatBang = false;\n        }\n    }\n\n    private long parseGia(Object obj) {\n        if (obj == null) return 0;\n        String s = obj.toString().replaceAll(\"[^0-9]\", \"\");\n        if (s.isEmpty()) return 0;\n        try {\n            return Long.parseLong(s);\n        } catch (Exception e) {\n            return 0;\n        }\n    }\n\n    /** Phân bổ giảm giá cấp hóa đơn theo tỷ lệ giá trị từng dòng hàng. */\n    private long tinhGiaHoanSauGiamGia(long donGiaGoc) {\n        if (currentHoaDon == null || donGiaGoc <= 0 || currentHoaDon.tongTienHang <= 0) return 0L;\n        long toiDaDuocHoan = Math.max(0L,\n                Math.min(currentHoaDon.tongThanhToan, currentHoaDon.tongTienHang));\n        return BigDecimal.valueOf(donGiaGoc)\n                .multiply(BigDecimal.valueOf(toiDaDuocHoan))\n                .divide(BigDecimal.valueOf(currentHoaDon.tongTienHang), 0, RoundingMode.HALF_UP)\n                .longValue();\n    }\n\n    // ==========================================\n    // XÁC NHẬN & IN PHIẾU ĐỔI TRẢ\n    // ==========================================\n    public void thucHienXacNhanDoiTra() {\n        if (currentHoaDon == null) {\n            JOptionPane.showMessageDialog(this, \"Chưa có hóa đơn nào được chọn để xử lý đổi trả!\", \"Lỗi\", JOptionPane.WARNING_MESSAGE);\n            return;\n        }\n\n        List<Object[]> dsMonTra = new ArrayList<>();\n        long tongTienTra = 0;\n        int tongSlNguyenTem = 0;\n\n        for (int i = 0; i < modelSanPham.getRowCount(); i++) {\n            Boolean chon = (Boolean) modelSanPham.getValueAt(i, 0);\n            if (Boolean.TRUE.equals(chon)) {\n                String maSP = (String) modelSanPham.getValueAt(i, 2);\n                String tenSP = (String) modelSanPham.getValueAt(i, 3);\n                String dvt = (String) modelSanPham.getValueAt(i, 4);\n                long donGia = parseGia(modelSanPham.getValueAt(i, 5));\n                int slTra = (Integer) modelSanPham.getValueAt(i, 7);\n                String lyDo = (String) modelSanPham.getValueAt(i, 8);\n                String tinhTrang = (String) modelSanPham.getValueAt(i, 9);\n                boolean nguyenTem = tinhTrang != null && tinhTrang.contains(\"nguyên tem\");\n                String soLo = modelSanPham.getValueAt(i, 10) != null ? modelSanPham.getValueAt(i, 10).toString() : null;\n                int slCoSoMoiDonVi = modelSanPham.getValueAt(i, 11) instanceof Number\n                        ? ((Number) modelSanPham.getValueAt(i, 11)).intValue() : 1;\n\n                long thanhTien = donGia * slTra;\n                tongTienTra += thanhTien;\n                if (nguyenTem) tongSlNguyenTem += slTra;\n\n                dsMonTra.add(new Object[]{maSP, tenSP, dvt, slTra, donGia, thanhTien, lyDo, nguyenTem,\n                        soLo, slTra * slCoSoMoiDonVi});\n            }\n        }\n\n        if (dsMonTra.isEmpty()) {\n            JOptionPane.showMessageDialog(this, \"Vui lòng tích chọn ít nhất 01 sản phẩm cần đổi/trả!\", \"Chưa chọn món\", JOptionPane.WARNING_MESSAGE);\n            return;\n        }\n\n        boolean laKichBanA = radKichBanA.isSelected();\n        BanHangPOSPanel.SanPhamDoiTra spMoi = (BanHangPOSPanel.SanPhamDoiTra) cboSanPhamMoi.getSelectedItem();\n        int slMoi = (Integer) spnSoLuongMoi.getValue();\n        long giaTriMonMoi = (!laKichBanA && spMoi != null) ? spMoi.donGia * slMoi : 0;\n        long chenhLech = giaTriMonMoi - tongTienTra;\n\n        // Kiểm tra quy định thời hạn 7 ngày đổi trả kể từ ngày mua hóa đơn\n        try {\n            if (currentHoaDon.thoiGian != null && !currentHoaDon.thoiGian.trim().isEmpty()) {\n                LocalDateTime ngayMua = LocalDateTime.parse(currentHoaDon.thoiGian.trim(), dtf);\n                long soNgayDaQua = java.time.temporal.ChronoUnit.DAYS.between(ngayMua.toLocalDate(), java.time.LocalDate.now());\n                if (soNgayDaQua > 7) {\n                    if (!utils.UserSession.isQuanLy()) {\n                        JOptionPane.showMessageDialog(this,\n                                \"Hóa đơn đã quá hạn đổi trả 07 ngày. Chỉ tài khoản Quản lý (NVQL)\\n\"\n                                + \"mới được duyệt ngoại lệ; nhân viên hiện tại không thể tiếp tục.\",\n                                \"Cần Quản lý duyệt\", JOptionPane.ERROR_MESSAGE);\n                        return;\n                    }\n                    int cfQuaHan = JOptionPane.showConfirmDialog(this,\n                            \"Bạn đang dùng quyền Quản lý để duyệt ngoại lệ cho hóa đơn đã qua \"\n                            + soNgayDaQua + \" ngày. Tiếp tục?\",\n                            \"Quản lý duyệt ngoại lệ quá hạn\", JOptionPane.YES_NO_OPTION,\n                            JOptionPane.WARNING_MESSAGE);\n                    if (cfQuaHan != JOptionPane.YES_OPTION) return;\n                }\n            }\n        } catch (Exception ignored) {}\n\n        // Nếu chọn Kịch bản B: Chuyển dữ liệu sang màn hình Bán hàng POS để thanh toán chênh lệch\n        if (!laKichBanA) {\n            if (spMoi == null) {\n                JOptionPane.showMessageDialog(this, \"Vui lòng chọn sản phẩm mới cần đổi sang ở Kịch bản B!\", \"Thiếu thông tin\", JOptionPane.WARNING_MESSAGE);\n                return;\n            }\n            if (slMoi > spMoi.tonKho) {\n                JOptionPane.showMessageDialog(this,\n                        \"Sản phẩm đổi mới [\" + spMoi.tenSP + \"] chỉ còn tồn kho \" + spMoi.tonKho + \" \" + spMoi.dvt + \" (Yêu cầu xuất: \" + slMoi + \")!\\n\" +\n                        \"Vui lòng giảm số lượng đổi hoặc chọn sản phẩm khác còn hàng.\",\n                        \"Không đủ tồn kho đổi hàng\",\n                        JOptionPane.ERROR_MESSAGE);\n                return;\n            }\n\n            DoiTraTransferData data = new DoiTraTransferData();\n            data.setMaHoaDonGoc(currentHoaDon.maHoaDon);\n            data.setThoiGianGoc(currentHoaDon.thoiGian);\n            data.setTenKhach(currentHoaDon.tenKhach);\n            data.setSdtKhach(currentHoaDon.sdt);\n            data.setTongTienTra(tongTienTra);\n            data.setDiemKhauTru((int) (tongTienTra / 100000L));\n\n            for (Object[] mon : dsMonTra) {\n                String maSP = (String) mon[0];\n                String tenSP = (String) mon[1];\n                String dvt = (String) mon[2];\n                int slTra = (Integer) mon[3];\n                long donGia = (Long) mon[4];\n                long thanhTien = (Long) mon[5];\n                String lyDo = (String) mon[6];\n                boolean nguyenTem = (Boolean) mon[7];\n                data.addMonTra(new DoiTraTransferData.MonTraLai(\n                        maSP, tenSP, dvt, slTra, donGia, thanhTien, lyDo, nguyenTem,\n                        (String) mon[8], (Integer) mon[9]\n                ));\n            }\n\n            data.addMonMoi(new DoiTraTransferData.MonDoiMoi(\n                    spMoi.maSP, spMoi.tenSP, spMoi.dvt, slMoi, spMoi.donGia\n            ));\n\n            Container top = getTopLevelAncestor();\n            if (top instanceof MainDashboard) {\n                MainDashboard md = (MainDashboard) top;\n                md.dieuHuongSangChucNang(MainDashboard.CARD_POS);\n                BanHangPOSPanel pos = md.getBanHangPOSPanel();\n                if (pos != null) {\n                    pos.tiepNhanDoiTraHang(data);\n                }\n            } else {\n                JOptionPane.showMessageDialog(this,\n                        \"Đã chuyển dữ liệu đổi trả sang POS thành công!\\n\" +\n                        \"• Khấu trừ hàng trả: \" + df.format(tongTienTra) + \"\\n\" +\n                        \"• Món mới: \" + spMoi.tenSP + \" x \" + slMoi,\n                        \"Chuyển sang POS\", JOptionPane.INFORMATION_MESSAGE);\n            }\n            return;\n        }\n\n        // Nếu Kịch bản B: trừ kho món mới\n        if (!laKichBanA && spMoi != null) {\n            KhoLoHangPanel.truTonKhoTheoFEFO(spMoi.maSP, slMoi);\n            BanHangPOSPanel.truTonKhoCatalog(spMoi.maSP, slMoi);\n        }\n\n        // Đồng bộ toàn diện tồn kho xuống database và giao diện\n        KhoLoHangPanel.dongBoLoHangTuDatabase();\n        BanHangPOSPanel.dongBoToanBoCatalogVaGiaoDien();\n\n        // 3. Khấu trừ / Cập nhật điểm VIP (Chuẩn hệ thống: 100.000 đ = 1 điểm)\n        int diemCu = currentKhachHang != null ? currentKhachHang.getDiemTichLuy() : 0;\n        int diemKhauTru = (int) (tongTienTra / 100000L);\n        int diemMoi = Math.max(0, diemCu - diemKhauTru);\n\n        if (!laKichBanA && chenhLech > 0) {\n            int diemCongThem = (int) (chenhLech / 100000L);\n            diemMoi += diemCongThem;\n        }\n\n        // Points are recovered by the DAO in the same transaction as the return.\n\n        // Lưu Phiếu Đổi Trả vào SQL Server\n        String maPhieu = utils.MaTuSinhHelper.sinhMaPhieuDoiTra();\n        try {\n            entity.PhieuDoiTra pdt = new entity.PhieuDoiTra();\n            pdt.setMaPhieuDoiTra(maPhieu);\n            entity.HoaDon hdGoc = new entity.HoaDon();\n            hdGoc.setMaHoaDon(currentHoaDon.maHoaDon);\n            pdt.setHoaDonGoc(hdGoc);\n            entity.NhanVien nv = new entity.NhanVien();\n            String maNhanVienDangNhap = utils.UserSession.getUserId();\n            if (maNhanVienDangNhap == null || maNhanVienDangNhap.isBlank()) {\n                throw new IllegalStateException(\"Phiên đăng nhập đã hết hạn\");\n            }\n            nv.setMaNhanVien(maNhanVienDangNhap);\n            pdt.setNhanVien(nv);\n            pdt.setNgayDoiTra(LocalDateTime.now());\n            pdt.setLyDoDoiTra(laKichBanA ? \"Trả hàng - Hoàn tiền\" : \"Đổi sang sản phẩm khác\");\n            pdt.setTongTienHoan(java.math.BigDecimal.valueOf(tongTienTra));\n\n            int idx = 1;\n            for (Object[] mon : dsMonTra) {\n                String ma = (String) mon[0];\n                int sl = (Integer) mon[3];\n                long thanhTien = (Long) mon[5];\n                entity.ChiTietDoiTra chiTiet = new entity.ChiTietDoiTra(\n                        pdt.getMaPhieuDoiTra() + \"_\" + (idx++),\n                        pdt, new entity.SanPham(ma, null, \"\", \"\"), sl,\n                        java.math.BigDecimal.valueOf(thanhTien)\n                );\n                chiTiet.setSoLuongCoSoTra((Integer) mon[9]);\n                if ((Boolean) mon[7]) {\n                    chiTiet.setSoLo((String) mon[8]);\n                    chiTiet.setSoLuongCoSoHoan((Integer) mon[9]);\n                }\n                pdt.addChiTietDoiTra(chiTiet);\n            }\n            if (!doiTraBus.luuPhieuDoiTra(pdt)) {\n                throw new IllegalStateException(\"Không lưu được phiếu đổi trả; tồn kho chưa được hoàn\");\n            }\n        } catch (Exception ex) {\n            System.err.println(\"[DoiTraHangPanel] Lỗi lưu phiếu đổi trả CSDL: \" + ex.getMessage());\n            JOptionPane.showMessageDialog(this,\n                    \"Đổi trả chưa hoàn tất vì không thể ghi nhận giao dịch: \" + ex.getMessage(),\n                    \"Lỗi lưu đổi trả\", JOptionPane.ERROR_MESSAGE);\n            return;\n        }\n\n        KhoLoHangPanel.dongBoLoHangTuDatabase();\n        BanHangPOSPanel.dongBoToanBoCatalogVaGiaoDien();\n\n        // 4. Đồng bộ Dashboard\n        TongQuanPanel.lamMoiDuLieuDashboardAll();\n\n        // 5. In Phiếu Đổi Trả nhiệt 80mm\n        hienThiPhieuDoiTraDialog(maPhieu, dsMonTra, laKichBanA, spMoi, slMoi, giaTriMonMoi, chenhLech, tongTienTra, diemKhauTru, diemMoi);\n    }\n\n    private void hienThiPhieuDoiTraDialog(String maPhieu, List<Object[]> dsMonTra, boolean laKichBanA,\n                                          BanHangPOSPanel.SanPhamDoiTra spMoi, int slMoi, long giaTriMonMoi,\n                                          long chenhLech, long tongTienTra, int diemKhauTru, int diemMoi) {\n        String thoiGian = LocalDateTime.now().format(dtf);\n\n        StringBuilder sb = new StringBuilder();\n        sb.append(\"====================================================\\n\");\n        sb.append(\"        PET SHOP MANAGEMENT - HỆ THỐNG CỬA HÀNG      \\n\");\n        sb.append(\"             PHIẾU XÁC NHẬN ĐỔI TRẢ HÀNG HÓA        \\n\");\n        sb.append(\"====================================================\\n\");\n        sb.append(\"Mã phiếu:       \").append(maPhieu).append(\"\\n\");\n        sb.append(\"Hóa đơn gốc:    \").append(currentHoaDon.maHoaDon).append(\" (Mua ngày: \").append(currentHoaDon.thoiGian).append(\")\\n\");\n        sb.append(\"Thời gian lập:  \").append(thoiGian).append(\"\\n\");\n        sb.append(\"Khách hàng:     \").append(currentHoaDon.tenKhach).append(\" (\").append(currentHoaDon.sdt != null ? currentHoaDon.sdt : \"Vãng lai\").append(\")\\n\");\n        sb.append(\"Thu ngân:       \").append(currentHoaDon.thuNgan).append(\"\\n\");\n        sb.append(\"Hình thức:      \").append(laKichBanA ? \"Trả hàng - Hoàn tiền\" : \"Đổi sang sản phẩm khác\").append(\"\\n\");\n        sb.append(\"----------------------------------------------------\\n\");\n        sb.append(\"CÁC MÓN TRẢ LẠI:\\n\");\n        for (Object[] mon : dsMonTra) {\n            sb.append(String.format(\" + [%s] %s x%d %s\\n\", mon[0], mon[1], mon[3], mon[2]));\n            sb.append(String.format(\"   Đơn giá: %s | Thành tiền: %s\\n\", df.format(mon[4]), df.format(mon[5])));\n            sb.append(String.format(\"   Lý do: %s | Tình trạng: %s\\n\", mon[6], (Boolean) mon[7] ? \"Nguyên tem (Nhập kho)\" : \"Hàng lỗi (Hủy)\"));\n        }\n        sb.append(\"----------------------------------------------------\\n\");\n        sb.append(String.format(\"TỔNG TIỀN HÀNG TRẢ:           %s\\n\", df.format(tongTienTra)));\n\n        if (!laKichBanA && spMoi != null) {\n            sb.append(\"----------------------------------------------------\\n\");\n            sb.append(\"MÓN ĐỔI MỚI:\\n\");\n            sb.append(String.format(\" + [%s] %s x%d %s\\n\", spMoi.maSP, spMoi.tenSP, slMoi, spMoi.dvt));\n            sb.append(String.format(\"   Giá trị món mới:           %s\\n\", df.format(giaTriMonMoi)));\n            sb.append(\"----------------------------------------------------\\n\");\n            if (chenhLech > 0) {\n                sb.append(String.format(\"KHÁCH ĐÓNG THÊM CHÊNH LỆCH:   +%s\\n\", df.format(chenhLech)));\n            } else if (chenhLech < 0) {\n                sb.append(String.format(\"CỬA HÀNG HOÀN LẠI TIỀN THỪA:  -%s\\n\", df.format(Math.abs(chenhLech))));\n            } else {\n                sb.append(\"ĐỔI NGANG GIÁ (CHÊNH LỆCH:    0 đ)\\n\");\n            }\n        } else {\n            sb.append(String.format(\"TIỀN HOÀN LẠI CHO KHÁCH:      %s\\n\", df.format(tongTienTra)));\n        }\n\n        sb.append(\"----------------------------------------------------\\n\");\n        sb.append(\"CẬP NHẬT ĐIỂM VIP:\\n\");\n        sb.append(String.format(\" - Khấu trừ điểm thưởng đơn cũ: -%d điểm\\n\", diemKhauTru));\n        sb.append(String.format(\" - Điểm tích lũy còn lại:       %d điểm\\n\", diemMoi));\n        sb.append(\"====================================================\\n\");\n        sb.append(\"   CẢM ƠN QUÝ KHÁCH ĐÃ TIN TƯỞNG DỊCH VỤ CỬA HÀNG!   \\n\");\n        sb.append(\"====================================================\\n\");\n\n        JTextArea txtReceipt = new JTextArea(sb.toString());\n        txtReceipt.setFont(new Font(\"Consolas\", Font.PLAIN, 12));\n        txtReceipt.setEditable(false);\n        txtReceipt.setBackground(new Color(254, 252, 248));\n        txtReceipt.setBorder(new EmptyBorder(12, 14, 12, 14));\n\n        JScrollPane scroll = new JScrollPane(txtReceipt);\n        scroll.setPreferredSize(new Dimension(480, 440));\n        scroll.setBorder(new LineBorder(ThemeColors.BORDER_LIGHT, 1, true));\n\n        JOptionPane.showMessageDialog(this, scroll, \"IN PHIẾU ĐỔI TRẢ NHIỆT 80MM THÀNH CÔNG\", JOptionPane.INFORMATION_MESSAGE,\n                IconHelper.getIcon(IconHelper.RECEIPT, 24, ThemeColors.SUCCESS));\n\n        // Sau khi hoàn tất thì làm mới lại bảng\n        lamMoiGiaoDien();\n    }\n\n    /**\n     * Phương thức nghiệp vụ tự động phục vụ Unit Test & Integration Test (VerifyModulesTest).\n     */\n    public boolean xuLyDoiTraTuDong(String maHD, String maSP, int soLuongTra, boolean nguyenTem,\n                                     boolean laDoiHang, String maSPMoi, int soLuongMoi) {\n        List<BanHangPOSPanel.HoaDonDaThanhToan> ds = BanHangPOSPanel.layDanhSachHoaDonDaThanhToan();\n        BanHangPOSPanel.HoaDonDaThanhToan target = null;\n        for (BanHangPOSPanel.HoaDonDaThanhToan hd : ds) {\n            if (hd.maHoaDon.equalsIgnoreCase(maHD) || (hd.sdt != null && hd.sdt.equalsIgnoreCase(maHD))) {\n                target = hd;\n                break;\n            }\n        }\n        if (target == null) return false;\n\n        // Tìm món trong HĐ\n        long donGia = 0;\n        for (Object[] mon : target.dsMon) {\n            String ma = mon.length > 1 && mon[1] != null ? mon[1].toString() : \"\";\n            if (ma.equalsIgnoreCase(maSP)) {\n                donGia = parseGia(mon.length > 5 ? mon[5] : \"0\");\n                break;\n            }\n        }\n        if (donGia <= 0) return false;\n\n        long tienHoan = donGia * soLuongTra;\n        if (nguyenTem) {\n            KhoLoHangPanel.congTonKho(maSP, soLuongTra);\n            BanHangPOSPanel.congTonKhoCatalog(maSP, soLuongTra);\n        }\n\n        if (laDoiHang && maSPMoi != null) {\n            KhoLoHangPanel.truTonKhoTheoFEFO(maSPMoi, soLuongMoi);\n            BanHangPOSPanel.truTonKhoCatalog(maSPMoi, soLuongMoi);\n        }\n\n        KhoLoHangPanel.dongBoLoHangTuDatabase();\n        BanHangPOSPanel.dongBoToanBoCatalogVaGiaoDien();\n\n        int diemKhauTru = (int) (tienHoan / 100000L);\n        KhachHang kh = new BanHangBus().timKhachHang(target.sdt);\n        int diemCu = kh != null ? kh.getDiemTichLuy() : 0;\n        int diemMoi = Math.max(0, diemCu - diemKhauTru);\n        if (target.sdt != null) {\n            BanHangBus.luuHoacCapNhatKhachHang(target.sdt, target.tenKhach, diemMoi);\n        }\n\n        return true;\n    }\n}\n"},{"path":"src/dao/HoaDonDAO.java","sha256":"b7f51d0df3fe4500191cce0a0faf8ac02ddf31b0bcd1f646dba3cfd4abb39a8c","content":"package dao;\n\nimport entity.*;\nimport utils.DBConnection;\n\nimport java.math.BigDecimal;\nimport java.math.RoundingMode;\nimport java.sql.*;\nimport java.time.LocalDateTime;\nimport java.util.ArrayList;\nimport java.util.List;\n\n/**\n * Data Access Object cho Hóa Đơn và các Chi Tiết Đa Hình.\n * Áp dụng nghiêm ngặt JDBC Transaction (ACID) đảm bảo an toàn tuyệt đối khi thanh toán và trừ kho.\n */\npublic class HoaDonDAO {\n\n    /**\n     * Lưu và thanh toán hóa đơn với giao dịch phân tán trên nhiều bảng:\n     * 1. Thêm bản ghi HoaDon\n     * 2. Duyệt từng dòng đa hình:\n     *    - Nếu là ChiTietXuatLo: thêm ChiTietHoaDon, ChiTietXuatLo, và TRỪ TỒN KHO LÔ HÀNG (FEFO).\n     *    - Nếu là ChiTietDichVu: thêm ChiTietHoaDon, ChiTietDichVu, ghi nhận hoa hồng KTV.\n     * 3. Tích điểm cho khách hàng (100.000đ = 1 điểm).\n     * Bắt buộc rollback nếu có bất kỳ lỗi nào hoặc kho không đủ tồn.\n     */\n    // Thực thi giao dịch thanh toán: lưu thông tin hóa đơn, chi tiết xuất lô, trừ tồn kho và tích lũy điểm thưởng\n    public boolean thanhToanHoaDon(HoaDon hoaDon) throws SQLException {\n        return thucThiThanhToan(hoaDon, null, null, null, null, 0, 0);\n    }\n\n    /** Lưu hóa đơn đổi hàng và phiếu trả trong cùng một transaction. */\n    public boolean thanhToanHoaDonKemDoiTra(HoaDon hoaDon, PhieuDoiTra phieuDoiTra) throws SQLException {\n        if (phieuDoiTra == null) {\n            throw new IllegalArgumentException(\"Phiếu đổi trả không được để trống\");\n        }\n        return thucThiThanhToan(hoaDon, phieuDoiTra, null, null, null, 0, 0);\n    }\n\n    /** Giao dịch POS đầy đủ, bao gồm đổi trả và/hoặc biến động Spa Pass. */\n    public boolean thanhToanHoaDonDayDu(HoaDon hoaDon, PhieuDoiTra phieuDoiTra,\n                                        String maTheSuDung, TheSpaPass theMoi,\n                                        List<String> dsMaPhongHotel, int diemSuDung,\n                                        int diemThuHoiDoTraHang) throws SQLException {\n        return thucThiThanhToan(hoaDon, phieuDoiTra, maTheSuDung, theMoi,\n                dsMaPhongHotel, diemSuDung, diemThuHoiDoTraHang);\n    }\n\n    private boolean thucThiThanhToan(HoaDon hoaDon, PhieuDoiTra phieuDoiTra,\n                                     String maTheSuDung, TheSpaPass theMoi,\n                                     List<String> dsMaPhongHotel, int diemSuDung,\n                                     int diemThuHoiDoTraHang) throws SQLException {\n        kiemTraHoaDonHopLe(hoaDon);\n        if (diemSuDung < 0 || diemThuHoiDoTraHang < 0) throw new IllegalArgumentException(\"Số điểm không được âm\");\n        try (Connection conn = DBConnection.getNewConnection()) {\n            conn.setAutoCommit(false);\n            try {\n                if (phieuDoiTra != null) {\n                    luuPhieuDoiTraTrongTransaction(conn, phieuDoiTra);\n                }\n                luuHoaDonTrongTransaction(conn, hoaDon);\n                // Return-point recovery is derived from the original customer inside the return transaction.\n                truDiemTrongTransaction(conn, hoaDon, diemSuDung, 0);\n                xuLySpaPassTrongTransaction(conn, hoaDon, maTheSuDung, theMoi);\n                hoanTatHotelTrongTransaction(conn, hoaDon, dsMaPhongHotel);\n                conn.commit();\n                hoaDon.setTrangThaiHoaDon(\"Đã thanh toán\");\n                return true;\n            } catch (SQLException | RuntimeException e) {\n                try {\n                    conn.rollback();\n                } catch (SQLException rollbackEx) {\n                    e.addSuppressed(rollbackEx);\n                }\n                throw e;\n            } finally {\n                try {\n                    conn.setAutoCommit(true);\n                } catch (SQLException ignored) {\n                }\n            }\n        }\n    }\n\n    private void truDiemTrongTransaction(Connection conn, HoaDon hoaDon,\n                                         int diemSuDung, int diemThuHoiDoTraHang) throws SQLException {\n        if (diemSuDung <= 0 && diemThuHoiDoTraHang <= 0) return;\n        if (hoaDon.getKhachHang() == null || hoaDon.getKhachHang().getMaKhachHang() == null) {\n            throw new SQLException(\"Không thể trừ điểm khi hóa đơn chưa liên kết khách hàng\");\n        }\n        int diemVuaCong = hoaDon.getThanhTien()\n                .divide(new BigDecimal(\"100000\"), 0, RoundingMode.DOWN).intValue();\n        String sql = \"UPDATE KhachHang SET diemTichLuy=\"\n                + \"CASE WHEN diemTichLuy-?-?-?<0 THEN ? ELSE diemTichLuy-?-? END \"\n                + \"WHERE maKhachHang=? AND diemTichLuy>=?\";\n        try (PreparedStatement ps = conn.prepareStatement(sql)) {\n            ps.setInt(1, diemVuaCong);\n            ps.setInt(2, Math.max(0, diemSuDung));\n            ps.setInt(3, Math.max(0, diemThuHoiDoTraHang));\n            ps.setInt(4, diemVuaCong);\n            ps.setInt(5, Math.max(0, diemSuDung));\n            ps.setInt(6, Math.max(0, diemThuHoiDoTraHang));\n            ps.setString(7, hoaDon.getKhachHang().getMaKhachHang());\n            ps.setInt(8, diemVuaCong + Math.max(0, diemSuDung));\n            if (ps.executeUpdate() != 1) {\n                throw new SQLException(\"Điểm dùng thanh toán không đủ hoặc vừa thay đổi ở giao dịch khác; vui lòng tải lại khách hàng\");\n            }\n        }\n    }\n\n    private void hoanTatHotelTrongTransaction(Connection conn, HoaDon hoaDon, List<String> rooms) throws SQLException {\n        HoaDonDichVu.completeHotel(conn, hoaDon, rooms);\n    }\n\n    private void xuLySpaPassTrongTransaction(Connection conn, HoaDon hoaDon, String card, TheSpaPass newCard) throws SQLException {\n        HoaDonDichVu.processSpa(conn, hoaDon, card, newCard);\n    }\n\n    private void kiemTraHoaDonHopLe(HoaDon hoaDon) {\n        HoaDonIntegrity.validateSale(hoaDon);\n    }\n\n    private void luuHoaDonTrongTransaction(Connection conn, HoaDon hoaDon) throws SQLException {\n        String sqlHoaDon = \"INSERT INTO HoaDon (maHoaDon, maKhachHang, maNhanVien, ngayLap, thoiGianThanhToan, giamGia, thanhTien, phuongThucThanhToan, trangThaiHoaDon) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\";\n        String sqlCTHoaDon = \"INSERT INTO ChiTietHoaDon (maChiTiet, maHoaDon, loaiChiTiet, maSanPham, maDichVu, soLuong, donGiaLucBan, thanhTien) VALUES (?, ?, ?, ?, ?, ?, ?, ?)\";\n        String sqlCTXuatLo = \"INSERT INTO ChiTietXuatLo (maChiTiet, soLo, maQuyDoi, soLuongXuatCoSo) VALUES (?, ?, ?, ?)\";\n        String sqlTruKho = \"UPDATE LoHang SET soLuongTon = soLuongTon - ? WHERE soLo = ? AND soLuongTon >= ? AND hanSuDung >= CAST(GETDATE() AS DATE)\";\n        String sqlCTDichVu = \"INSERT INTO ChiTietDichVu (maChiTiet, maDichVu, maThuCung, maKtvThucHien, tienHoaHong) VALUES (?, ?, ?, ?, ?)\";\n        String sqlTichDiem = \"UPDATE KhachHang SET diemTichLuy = diemTichLuy + ? WHERE maKhachHang = ?\";\n\n        try (PreparedStatement ps = conn.prepareStatement(sqlHoaDon)) {\n            ps.setString(1, hoaDon.getMaHoaDon());\n            if (hoaDon.getKhachHang() != null && hoaDon.getKhachHang().getMaKhachHang() != null) {\n                ps.setString(2, hoaDon.getKhachHang().getMaKhachHang());\n            } else {\n                ps.setNull(2, Types.NVARCHAR);\n            }\n            ps.setString(3, hoaDon.getNhanVien().getMaNhanVien());\n            ps.setTimestamp(4, Timestamp.valueOf(hoaDon.getNgayLap() != null ? hoaDon.getNgayLap() : LocalDateTime.now()));\n            ps.setTimestamp(5, Timestamp.valueOf(LocalDateTime.now()));\n            ps.setBigDecimal(6, hoaDon.getGiamGia() != null ? hoaDon.getGiamGia() : BigDecimal.ZERO);\n            ps.setBigDecimal(7, hoaDon.getThanhTien());\n            ps.setString(8, hoaDon.getPhuongThucThanhToan() != null ? hoaDon.getPhuongThucThanhToan() : \"Tiền mặt\");\n            ps.setString(9, \"Đã thanh toán\");\n            ps.executeUpdate();\n        }\n\n        try (PreparedStatement psCT = conn.prepareStatement(sqlCTHoaDon);\n             PreparedStatement psXuat = conn.prepareStatement(sqlCTXuatLo);\n             PreparedStatement psTruKho = conn.prepareStatement(sqlTruKho);\n             PreparedStatement psDV = conn.prepareStatement(sqlCTDichVu)) {\n            int index = 1;\n            for (ChiTietHoaDon ct : hoaDon.getDsChiTiet()) {\n                String maChiTiet = hoaDon.getMaHoaDon() + \"_CT\" + (index++);\n                ct.setMaChiTiet(maChiTiet);\n                String maSP = ct.getSanPham() != null ? ct.getSanPham().getMaSanPham() : null;\n                if (maSP == null && ct instanceof ChiTietXuatLo) {\n                    ChiTietXuatLo xl = (ChiTietXuatLo) ct;\n                    if (xl.getLoHang() != null && xl.getLoHang().getSanPham() != null) {\n                        maSP = xl.getLoHang().getSanPham().getMaSanPham();\n                    }\n                }\n                String maDV = ct.getDichVu() != null ? ct.getDichVu().getMaDichVu() : null;\n\n                psCT.setString(1, maChiTiet);\n                psCT.setString(2, hoaDon.getMaHoaDon());\n                psCT.setString(3, ct.getLoaiChiTiet());\n                if (maSP != null) psCT.setString(4, maSP); else psCT.setNull(4, Types.NVARCHAR);\n                if (maDV != null) psCT.setString(5, maDV); else psCT.setNull(5, Types.NVARCHAR);\n                psCT.setInt(6, ct.getSoLuong());\n                psCT.setBigDecimal(7, ct.getDonGiaLucBan());\n                psCT.setBigDecimal(8, ct.getThanhTien());\n                psCT.executeUpdate();\n\n                if (ct instanceof ChiTietXuatLo) {\n                    ChiTietXuatLo xuatLo = (ChiTietXuatLo) ct;\n                    if (xuatLo.getLoHang() == null || xuatLo.getLoHang().getSoLo() == null) {\n                        throw new SQLException(\"Chi tiết xuất kho chưa xác định số lô\");\n                    }\n                    psXuat.setString(1, maChiTiet);\n                    psXuat.setString(2, xuatLo.getLoHang().getSoLo());\n                    psXuat.setString(3, HoaDonIntegrity.resolveUnit(conn, xuatLo));\n                    psXuat.setInt(4, xuatLo.getSoLuongXuatCoSo());\n                    psXuat.executeUpdate();\n\n                    psTruKho.setInt(1, xuatLo.getSoLuongXuatCoSo());\n                    psTruKho.setString(2, xuatLo.getLoHang().getSoLo());\n                    psTruKho.setInt(3, xuatLo.getSoLuongXuatCoSo());\n                    if (psTruKho.executeUpdate() != 1) {\n                        throw new SQLException(\"Lô hàng \" + xuatLo.getLoHang().getSoLo() + \" không đủ số lượng tồn khả dụng để xuất kho!\");\n                    }\n                } else if (ct instanceof ChiTietDichVu) {\n                    ChiTietDichVu dv = (ChiTietDichVu) ct;\n                    if (dv.getDichVu() == null || dv.getDichVu().getMaDichVu() == null) {\n                        throw new SQLException(\"Chi tiết dịch vụ chưa xác định mã dịch vụ\");\n                    }\n                    psDV.setString(1, maChiTiet);\n                    psDV.setString(2, dv.getDichVu().getMaDichVu());\n                    psDV.setString(3, dv.getThuCung() != null ? dv.getThuCung().getMaThuCung() : null);\n                    psDV.setString(4, dv.getKtvThucHien() != null ? dv.getKtvThucHien().getMaNhanVien() : null);\n                    psDV.setBigDecimal(5, dv.getTienHoaHong() != null ? dv.getTienHoaHong() : BigDecimal.ZERO);\n                    psDV.executeUpdate();\n                }\n            }\n        }\n\n        if (hoaDon.getKhachHang() != null && hoaDon.getKhachHang().getMaKhachHang() != null) {\n            int diemCong = hoaDon.getThanhTien().divide(new BigDecimal(\"100000\"), 0, RoundingMode.DOWN).intValue();\n            if (diemCong > 0) {\n                try (PreparedStatement ps = conn.prepareStatement(sqlTichDiem)) {\n                    ps.setInt(1, diemCong);\n                    ps.setString(2, hoaDon.getKhachHang().getMaKhachHang());\n                    ps.executeUpdate();\n                }\n            }\n        }\n    }\n\n    /**\n     * Lấy toàn bộ danh sách hóa đơn trong hệ thống kèm chi tiết (Tối ưu hóa: Chỉ 2 câu lệnh SQL, xóa bỏ hoàn toàn N+1 queries)\n     */\n    public List<HoaDon> getAllHoaDon() throws SQLException {\n        List<HoaDon> list = new ArrayList<>();\n        java.util.Map<String, HoaDon> map = new java.util.LinkedHashMap<>();\n        String sql = \"SELECT h.*, kh.hoTen AS tenKhachHang, kh.soDienThoai, nv.hoTen AS tenNhanVien \" +\n                \"FROM HoaDon h \" +\n                \"LEFT JOIN KhachHang kh ON h.maKhachHang = kh.maKhachHang \" +\n                \"LEFT JOIN NhanVien nv ON h.maNhanVien = nv.maNhanVien \" +\n                \"ORDER BY h.ngayLap DESC\";\n\n        try (Connection conn = DBConnection.getConnection();\n             PreparedStatement ps = conn.prepareStatement(sql);\n             ResultSet rs = ps.executeQuery()) {\n            while (rs.next()) {\n                HoaDon hd = mapResultSetToHoaDon(rs);\n                map.put(hd.getMaHoaDon(), hd);\n                list.add(hd);\n            }\n        }\n\n        if (map.isEmpty()) return list;\n\n        String sqlAllCT = \"SELECT ct.maChiTiet, ct.maHoaDon, ct.loaiChiTiet, ct.soLuong, ct.donGiaLucBan, ct.thanhTien, \" +\n                \"xl.soLo, xl.maQuyDoi, xl.soLuongXuatCoSo, COALESCE(ct.maSanPham, l.maSanPham) AS maSanPham, s.tenSanPham, dvt.tenDonVi, \" +\n                \"COALESCE(ct.maDichVu, dv.maDichVu) AS maDichVu, d.tenDichVu, d.thoiLuongPhut, dv.maThuCung, tc.tenThuCung, dv.maKtvThucHien, dv.tienHoaHong \" +\n                \"FROM ChiTietHoaDon ct \" +\n                \"LEFT JOIN ChiTietXuatLo xl ON ct.maChiTiet = xl.maChiTiet \" +\n                \"LEFT JOIN LoHang l ON xl.soLo = l.soLo \" +\n                \"LEFT JOIN SanPham s ON COALESCE(ct.maSanPham, l.maSanPham) = s.maSanPham \" +\n                \"LEFT JOIN QuyDoiDonVi qd ON xl.maQuyDoi = qd.maQuyDoi \" +\n                \"LEFT JOIN DonViTinh dvt ON qd.maDonVi = dvt.maDonVi \" +\n                \"LEFT JOIN ChiTietDichVu dv ON ct.maChiTiet = dv.maChiTiet \" +\n                \"LEFT JOIN DichVu d ON COALESCE(ct.maDichVu, dv.maDichVu) = d.maDichVu \" +\n                \"LEFT JOIN ThuCung tc ON dv.maThuCung = tc.maThuCung \" +\n                \"ORDER BY ct.maChiTiet ASC\";\n\n        try (Connection conn = DBConnection.getConnection();\n             PreparedStatement ps = conn.prepareStatement(sqlAllCT);\n             ResultSet rs = ps.executeQuery()) {\n            while (rs.next()) {\n                String maHD = rs.getString(\"maHoaDon\");\n                HoaDon hd = map.get(maHD);\n                if (hd != null) {\n                    ChiTietHoaDon ct = mapResultSetToChiTiet(rs);\n                    if (ct != null) {\n                        ct.setHoaDon(hd);\n                        hd.getDsChiTiet().add(ct); // Preserve the persisted invoice total.\n                    }\n                }\n            }\n        }\n        return list;\n    }\n\n    /**\n     * Tìm kiếm hóa đơn theo mã và nạp đầy đủ danh sách chi tiết đa hình\n     */\n    public HoaDon findById(String maHoaDon) throws SQLException {\n        String sql = \"SELECT h.*, kh.hoTen AS tenKhachHang, kh.soDienThoai, nv.hoTen AS tenNhanVien \" +\n                \"FROM HoaDon h \" +\n                \"LEFT JOIN KhachHang kh ON h.maKhachHang = kh.maKhachHang \" +\n                \"LEFT JOIN NhanVien nv ON h.maNhanVien = nv.maNhanVien \" +\n                \"WHERE h.maHoaDon = ?\";\n\n        try (Connection conn = DBConnection.getConnection();\n             PreparedStatement ps = conn.prepareStatement(sql)) {\n            ps.setString(1, maHoaDon);\n            try (ResultSet rs = ps.executeQuery()) {\n                if (rs.next()) {\n                    HoaDon hd = mapResultSetToHoaDon(rs);\n                    hd.getDsChiTiet().addAll(getChiTietByHoaDon(hd.getMaHoaDon()));\n                    return hd;\n                }\n            }\n        }\n        return null;\n    }\n\n    /**\n     * Lấy danh sách chi tiết đa hình của một hóa đơn\n     */\n    public List<ChiTietHoaDon> getChiTietByHoaDon(String maHoaDon) throws SQLException {\n        List<ChiTietHoaDon> list = new ArrayList<>();\n        String sql = \"SELECT ct.maChiTiet, ct.maHoaDon, ct.loaiChiTiet, ct.soLuong, ct.donGiaLucBan, ct.thanhTien, \" +\n                \"xl.soLo, xl.maQuyDoi, xl.soLuongXuatCoSo, COALESCE(ct.maSanPham, l.maSanPham) AS maSanPham, s.tenSanPham, dvt.tenDonVi, \" +\n                \"COALESCE(ct.maDichVu, dv.maDichVu) AS maDichVu, d.tenDichVu, d.thoiLuongPhut, dv.maThuCung, tc.tenThuCung, dv.maKtvThucHien, dv.tienHoaHong \" +\n                \"FROM ChiTietHoaDon ct \" +\n                \"LEFT JOIN ChiTietXuatLo xl ON ct.maChiTiet = xl.maChiTiet \" +\n                \"LEFT JOIN LoHang l ON xl.soLo = l.soLo \" +\n                \"LEFT JOIN SanPham s ON COALESCE(ct.maSanPham, l.maSanPham) = s.maSanPham \" +\n                \"LEFT JOIN QuyDoiDonVi qd ON xl.maQuyDoi = qd.maQuyDoi \" +\n                \"LEFT JOIN DonViTinh dvt ON qd.maDonVi = dvt.maDonVi \" +\n                \"LEFT JOIN ChiTietDichVu dv ON ct.maChiTiet = dv.maChiTiet \" +\n                \"LEFT JOIN DichVu d ON COALESCE(ct.maDichVu, dv.maDichVu) = d.maDichVu \" +\n                \"LEFT JOIN ThuCung tc ON dv.maThuCung = tc.maThuCung \" +\n                \"WHERE ct.maHoaDon = ?\";\n\n        try (Connection conn = DBConnection.getConnection();\n             PreparedStatement ps = conn.prepareStatement(sql)) {\n            ps.setString(1, maHoaDon);\n            try (ResultSet rs = ps.executeQuery()) {\n                while (rs.next()) {\n                    ChiTietHoaDon ct = mapResultSetToChiTiet(rs);\n                    if (ct != null) {\n                        list.add(ct);\n                    }\n                }\n            }\n        }\n        return list;\n    }\n\n    private ChiTietHoaDon mapResultSetToChiTiet(ResultSet rs) throws SQLException {\n        String loai = rs.getString(\"loaiChiTiet\");\n        if (\"SAN_PHAM\".equalsIgnoreCase(loai) || \"ChiTietXuatLo\".equalsIgnoreCase(loai) || \"XUAT_LO\".equalsIgnoreCase(loai)) {\n            SanPham sp = new SanPham();\n            sp.setMaSanPham(rs.getString(\"maSanPham\") != null ? rs.getString(\"maSanPham\") : \"SP001\");\n            sp.setTenSanPham(rs.getString(\"tenSanPham\") != null ? rs.getString(\"tenSanPham\") : \"Sản phẩm\");\n\n            LoHang lo = new LoHang();\n            lo.setSoLo(rs.getString(\"soLo\"));\n            lo.setSanPham(sp);\n\n            QuyDoiDonVi qd = null;\n            if (rs.getString(\"tenDonVi\") != null) {\n                DonViTinh dvt = new DonViTinh(\"\", rs.getString(\"tenDonVi\"));\n                qd = new QuyDoiDonVi();\n                qd.setMaQuyDoi(rs.getString(\"maQuyDoi\"));\n                qd.setDonViTinh(dvt);\n            }\n\n            ChiTietXuatLo c = new ChiTietXuatLo(\n                    rs.getString(\"maChiTiet\"),\n                    null,\n                    rs.getInt(\"soLuong\"),\n                    rs.getBigDecimal(\"donGiaLucBan\"),\n                    lo,\n                    qd\n            );\n            c.setSanPham(sp);\n            c.setSoLuongXuatCoSo(rs.getInt(\"soLuongXuatCoSo\"));\n            c.setThanhTien(rs.getBigDecimal(\"thanhTien\"));\n            return c;\n        } else if (\"DICH_VU\".equalsIgnoreCase(loai) || \"ChiTietDichVu\".equalsIgnoreCase(loai)) {\n            DichVu d = new DichVu();\n            d.setMaDichVu(rs.getString(\"maDichVu\") != null ? rs.getString(\"maDichVu\") : \"DV001\");\n            d.setTenDichVu(rs.getString(\"tenDichVu\") != null ? rs.getString(\"tenDichVu\") : \"Dịch vụ\");\n            d.setThoiLuongPhut(rs.getInt(\"thoiLuongPhut\") > 0 ? rs.getInt(\"thoiLuongPhut\") : 60);\n\n            ThuCung tc = null;\n            if (rs.getString(\"maThuCung\") != null) {\n                tc = new ThuCung();\n                tc.setMaThuCung(rs.getString(\"maThuCung\"));\n                tc.setTenThuCung(rs.getString(\"tenThuCung\"));\n            }\n\n            NhanVien ktv = new NhanVien();\n            ktv.setMaNhanVien(rs.getString(\"maKtvThucHien\"));\n\n            ChiTietDichVu c = new ChiTietDichVu(\n                    rs.getString(\"maChiTiet\"),\n                    null,\n                    rs.getInt(\"soLuong\"),\n                    rs.getBigDecimal(\"donGiaLucBan\"),\n                    d,\n                    tc,\n                    ktv,\n                    rs.getBigDecimal(\"tienHoaHong\")\n            );\n            c.setThanhTien(rs.getBigDecimal(\"thanhTien\"));\n            return c;\n        }\n        return null;\n    }\n\n    /**\n     * Lấy tổng số lượng đã đổi/trả trước đó của từng mã sản phẩm thuộc một Hóa đơn gốc\n     * giúp chặn triệt để việc trả lố hoặc trả trùng nhiều lần trên cùng 1 hóa đơn.\n     */\n    public java.util.Map<String, Integer> layMapSoLuongDaTra(String maHoaDonGoc) {\n        java.util.Map<String, Integer> map = new java.util.HashMap<>();\n        if (maHoaDonGoc == null || maHoaDonGoc.trim().isEmpty()) return map;\n        String sql = \"SELECT ct.maSanPham, SUM(ct.soLuongCoSoTra) AS tongDaTra \" +\n                     \"FROM ChiTietDoiTra ct \" +\n                     \"JOIN PhieuDoiTra p ON ct.maPhieuDoiTra = p.maPhieuDoiTra \" +\n                     \"WHERE p.maHoaDonGoc = ? \" +\n                     \"GROUP BY ct.maSanPham\";\n        try (Connection conn = DBConnection.getConnection();\n             PreparedStatement ps = conn.prepareStatement(sql)) {\n            ps.setString(1, maHoaDonGoc.trim());\n            try (ResultSet rs = ps.executeQuery()) {\n                while (rs.next()) {\n                    String maSP = rs.getString(\"maSanPham\");\n                    int daTra = rs.getInt(\"tongDaTra\");\n                    if (maSP != null) {\n                        map.put(maSP.trim().toUpperCase(), daTra);\n                    }\n                }\n            }\n        } catch (Exception e) {\n            throw new IllegalStateException(\"Không tải được lịch sử trả hàng; hãy kiểm tra migration và thử lại\", e);\n        }\n        return map;\n    }\n\n    /**\n     * Lưu phiếu đổi trả hàng hóa vào CSDL (Transaction JDBC an toàn)\n     */\n    public boolean luuPhieuDoiTra(PhieuDoiTra pdt) throws SQLException {\n        try (Connection conn = DBConnection.getNewConnection()) {\n            conn.setAutoCommit(false);\n            try {\n                luuPhieuDoiTraTrongTransaction(conn, pdt);\n                conn.commit();\n                return true;\n            } catch (SQLException | RuntimeException e) {\n                try { conn.rollback(); } catch (SQLException rollbackEx) { e.addSuppressed(rollbackEx); }\n                throw e;\n            } finally {\n                try { conn.setAutoCommit(true); } catch (SQLException ignored) {}\n            }\n        }\n    }\n\n    private void luuPhieuDoiTraTrongTransaction(Connection conn, PhieuDoiTra pdt) throws SQLException {\n        if (pdt == null || pdt.getHoaDonGoc() == null || pdt.getHoaDonGoc().getMaHoaDon() == null) {\n            throw new IllegalArgumentException(\"Phiếu đổi trả phải liên kết hóa đơn gốc\");\n        }\n        if (pdt.getNhanVien() == null || pdt.getNhanVien().getMaNhanVien() == null\n                || pdt.getNhanVien().getMaNhanVien().isBlank()) {\n            throw new IllegalArgumentException(\"Phiếu đổi trả phải xác định nhân viên tiếp nhận\");\n        }\n        HoaDonIntegrity.ReturnPoints returnPoints = HoaDonIntegrity.validateReturn(conn, pdt);\n        String sqlPhieu = \"INSERT INTO PhieuDoiTra (maPhieuDoiTra, maHoaDonGoc, maNhanVienTiepNhan, ngayDoiTra, lyDoDoiTra, tongTienHoan, trangThaiDoiTra) VALUES (?, ?, ?, ?, ?, ?, ?)\";\n        String sqlCT = \"INSERT INTO ChiTietDoiTra (maChiTietDoiTra, maPhieuDoiTra, maSanPham, soLuongDoiTra, tienHoanLai, soLo, soLuongCoSoHoan, soLuongCoSoTra) VALUES (?, ?, ?, ?, ?, ?, ?, ?)\";\n        String sqlHoanLo = \"UPDATE LoHang SET soLuongTon = soLuongTon + ? WHERE soLo = ? AND maSanPham = ?\";\n\n        try (PreparedStatement ps = conn.prepareStatement(sqlPhieu)) {\n            ps.setString(1, pdt.getMaPhieuDoiTra());\n            ps.setString(2, pdt.getHoaDonGoc().getMaHoaDon());\n            ps.setString(3, pdt.getNhanVien().getMaNhanVien());\n            ps.setTimestamp(4, Timestamp.valueOf(pdt.getNgayDoiTra() != null ? pdt.getNgayDoiTra() : LocalDateTime.now()));\n            ps.setString(5, pdt.getLyDoDoiTra());\n            ps.setBigDecimal(6, pdt.getTongTienHoan());\n            ps.setString(7, pdt.getTrangThaiDoiTra() != null ? pdt.getTrangThaiDoiTra() : \"Hoàn thành\");\n            ps.executeUpdate();\n        }\n\n        if (pdt.getDsChiTietDoiTra() == null || pdt.getDsChiTietDoiTra().isEmpty()) {\n            throw new IllegalArgumentException(\"Phiếu đổi trả phải có ít nhất một mặt hàng\");\n        }\n        try (PreparedStatement psCT = conn.prepareStatement(sqlCT);\n             PreparedStatement psKho = conn.prepareStatement(sqlHoanLo)) {\n            for (ChiTietDoiTra ct : pdt.getDsChiTietDoiTra()) {\n                if (ct.getSanPham() == null || ct.getSanPham().getMaSanPham() == null) {\n                    throw new IllegalArgumentException(\"Chi tiết đổi trả chưa xác định sản phẩm\");\n                }\n                boolean canHoanKho = (ct.getSoLo() != null && !ct.getSoLo().isBlank() && ct.getSoLuongCoSoHoan() > 0);\n                psCT.setString(1, ct.getMaChiTietDoiTra());\n                psCT.setString(2, pdt.getMaPhieuDoiTra());\n                psCT.setString(3, ct.getSanPham().getMaSanPham());\n                psCT.setInt(4, ct.getSoLuongDoiTra());\n                psCT.setBigDecimal(5, ct.getTienHoanLai());\n                if (canHoanKho) {\n                    psCT.setString(6, ct.getSoLo());\n                    psCT.setInt(7, ct.getSoLuongCoSoHoan());\n                } else {\n                    psCT.setNull(6, Types.NVARCHAR);\n                    psCT.setInt(7, 0);\n                }\n                psCT.setInt(8, ct.getSoLuongCoSoTra());\n                psCT.executeUpdate();\n\n                if (canHoanKho) {\n                    psKho.setInt(1, ct.getSoLuongCoSoHoan());\n                    psKho.setString(2, ct.getSoLo());\n                    psKho.setString(3, ct.getSanPham().getMaSanPham());\n                    if (psKho.executeUpdate() != 1) {\n                        throw new SQLException(\"Không tìm thấy đúng lô gốc \" + ct.getSoLo() + \" để hoàn kho\");\n                    }\n                }\n            }\n        }\n        returnPoints.apply(conn);\n    }\n\n    /**\n     * Hủy hóa đơn\n     */\n    public boolean huyHoaDon(String maHoaDon) throws SQLException {\n        String sql = \"UPDATE HoaDon SET trangThaiHoaDon = N'Đã hủy' WHERE maHoaDon = ?\";\n        try (Connection conn = DBConnection.getConnection();\n             PreparedStatement ps = conn.prepareStatement(sql)) {\n            ps.setString(1, maHoaDon);\n            return ps.executeUpdate() > 0;\n        }\n    }\n\n    private HoaDon mapResultSetToHoaDon(ResultSet rs) throws SQLException {\n        KhachHang kh = null;\n        if (rs.getString(\"maKhachHang\") != null) {\n            kh = new KhachHang(\n                    rs.getString(\"maKhachHang\"),\n                    rs.getString(\"tenKhachHang\"),\n                    rs.getString(\"soDienThoai\"),\n                    0\n            );\n        }\n\n        NhanVien nv = null;\n        if (rs.getString(\"maNhanVien\") != null) {\n            nv = new NhanVien();\n            nv.setMaNhanVien(rs.getString(\"maNhanVien\"));\n            nv.setHoTen(rs.getString(\"tenNhanVien\"));\n        }\n\n        Timestamp nl = rs.getTimestamp(\"ngayLap\");\n        LocalDateTime ngayLap = (nl != null) ? nl.toLocalDateTime() : LocalDateTime.now();\n\n        Timestamp tt = rs.getTimestamp(\"thoiGianThanhToan\");\n        LocalDateTime thoiGianTT = (tt != null) ? tt.toLocalDateTime() : null;\n\n        HoaDon hd = new HoaDon();\n        hd.setMaHoaDon(rs.getString(\"maHoaDon\"));\n        hd.setKhachHang(kh);\n        hd.setNhanVien(nv);\n        hd.setNgayLap(ngayLap);\n        hd.setThoiGianThanhToan(thoiGianTT);\n        hd.setGiamGia(rs.getBigDecimal(\"giamGia\"));\n        hd.setThanhTien(rs.getBigDecimal(\"thanhTien\"));\n        hd.setPhuongThucThanhToan(rs.getString(\"phuongThucThanhToan\"));\n        hd.setTrangThaiHoaDon(rs.getString(\"trangThaiHoaDon\"));\n\n        return hd;\n    }\n}\n"},{"path":"src/dao/HoaDonIntegrity.java","sha256":"a6ccec1c5505f999b88f069c3e11f78cd38708ae553974d7461ffdc294e0eece","content":"package dao;\n\nimport entity.*;\nimport java.math.BigDecimal;\nimport java.math.RoundingMode;\nimport java.sql.*;\nimport java.util.*;\n\n/** Validation on the same connection as HoaDonDAO's transaction. */\nfinal class HoaDonIntegrity {\n    private HoaDonIntegrity() {}\n    private static final BigDecimal POINT_UNIT = BigDecimal.valueOf(100000);\n\n    static void validateSale(HoaDon h) {\n        if (h == null || h.getMaHoaDon() == null || h.getMaHoaDon().isBlank()\n                || h.getDsChiTiet() == null || h.getDsChiTiet().isEmpty()\n                || h.getNhanVien() == null || h.getNhanVien().getMaNhanVien() == null\n                || h.getNhanVien().getMaNhanVien().isBlank()) {\n            throw new IllegalArgumentException(\"Hóa đơn phải có mã, nhân viên và chi tiết\");\n        }\n        nonnegative(h.getGiamGia(), \"Giảm giá\");\n        nonnegative(h.getThanhTien(), \"Tổng thanh toán\");\n        BigDecimal sum = BigDecimal.ZERO;\n        for (ChiTietHoaDon ct : h.getDsChiTiet()) {\n            if (ct == null || ct.getSoLuong() <= 0) throw new IllegalArgumentException(\"Số lượng bán phải dương\");\n            nonnegative(ct.getDonGiaLucBan(), \"Đơn giá\");\n            nonnegative(ct.getThanhTien(), \"Thành tiền dòng\");\n            BigDecimal roundingTolerance = BigDecimal.valueOf(ct.getSoLuong())\n                    .multiply(new BigDecimal(\"0.005\")).max(BigDecimal.ONE);\n            if (ct.getDonGiaLucBan().multiply(BigDecimal.valueOf(ct.getSoLuong()))\n                    .subtract(ct.getThanhTien()).abs().compareTo(roundingTolerance) > 0) {\n                throw new IllegalArgumentException(\"Thành tiền dòng không khớp số lượng và đơn giá\");\n            }\n            if (ct instanceof ChiTietXuatLo x && x.getSoLuongXuatCoSo() <= 0) {\n                throw new IllegalArgumentException(\"Số lượng xuất cơ sở phải dương\");\n            }\n            sum = sum.add(ct.getThanhTien());\n        }\n        if (sum.subtract(h.getGiamGia()).max(BigDecimal.ZERO).subtract(h.getThanhTien())\n                .abs().compareTo(new BigDecimal(\"0.01\")) > 0) {\n            throw new IllegalArgumentException(\"Tổng thanh toán không khớp chi tiết và giảm giá\");\n        }\n    }\n\n    static String resolveUnit(Connection c, ChiTietXuatLo x) throws SQLException {\n        if (x.getLoHang() == null || x.getLoHang().getSoLo() == null) throw new SQLException(\"Chưa chọn lô xuất\");\n        String qd = x.getQuyDoiDonVi() == null ? null : x.getQuyDoiDonVi().getMaQuyDoi();\n        if (qd != null && qd.isBlank()) throw new SQLException(\"Mã quy đổi không hợp lệ\");\n        String sql = \"SELECT TOP 1 q.maQuyDoi,q.tyLeQuyDoi,l.maSanPham FROM LoHang l \"\n                + \"JOIN QuyDoiDonVi q ON q.maSanPham=l.maSanPham WHERE l.soLo=? \"\n                + (qd == null ? \"AND q.tyLeQuyDoi=1 \" : \"AND q.maQuyDoi=? \")\n                + \"ORDER BY q.laDonViCoSo DESC,q.maQuyDoi\";\n        try (PreparedStatement ps = c.prepareStatement(sql)) {\n            ps.setString(1, x.getLoHang().getSoLo());\n            if (qd != null) ps.setString(2, qd);\n            try (ResultSet r = ps.executeQuery()) {\n                if (!r.next()) throw new SQLException(\"Không có quy đổi hợp lệ của sản phẩm trong lô; bổ sung đơn vị cơ sở trước khi bán\");\n                String product = r.getString(\"maSanPham\");\n                int ratio = r.getInt(\"tyLeQuyDoi\");\n                if (x.getSanPham() == null || !product.equals(x.getSanPham().getMaSanPham()) || ratio <= 0\n                        || (long)x.getSoLuong() * ratio != x.getSoLuongXuatCoSo()) {\n                    throw new SQLException(\"Sản phẩm, đơn vị quy đổi và số lượng xuất cơ sở không khớp\");\n                }\n                return r.getString(\"maQuyDoi\");\n            }\n        }\n    }\n\n    record ReturnPoints(String customer, int reclaim) {\n        void apply(Connection c) throws SQLException {\n            if (customer == null || reclaim <= 0) return;\n            try (PreparedStatement ps = c.prepareStatement(\"UPDATE KhachHang SET diemTichLuy=CASE WHEN diemTichLuy>=? THEN diemTichLuy-? ELSE 0 END WHERE maKhachHang=?\")) {\n                ps.setInt(1, reclaim);ps.setInt(2, reclaim);ps.setString(3, customer);\n                if (ps.executeUpdate() != 1) throw new SQLException(\"Không tìm thấy khách hàng gốc để thu hồi điểm\");\n            }\n        }\n    }\n    private static final class Sold {\n        long base;\n        int ratio;\n        BigDecimal gross;\n        Sold(long base, int ratio, BigDecimal gross) { this.base=base;this.ratio=ratio;this.gross=gross; }\n    }\n    private static final class Returned {\n        long base;\n        BigDecimal money=BigDecimal.ZERO;\n        boolean unresolved;\n    }\n\n    static ReturnPoints validateReturn(Connection c, PhieuDoiTra p) throws SQLException {\n        if (p == null || p.getHoaDonGoc() == null || p.getHoaDonGoc().getMaHoaDon() == null\n                || p.getDsChiTietDoiTra() == null || p.getDsChiTietDoiTra().isEmpty()) {\n            throw new IllegalArgumentException(\"Phiếu trả phải có hóa đơn gốc và chi tiết\");\n        }\n        String invoice = p.getHoaDonGoc().getMaHoaDon(), customer;\n        BigDecimal discount, sourceTotal;\n        // Every return path takes this lock before reading earlier returns.\n        try (PreparedStatement ps=c.prepareStatement(\"SELECT maKhachHang,giamGia,thanhTien,trangThaiHoaDon FROM HoaDon WITH(UPDLOCK,HOLDLOCK) WHERE maHoaDon=?\")) {\n            ps.setString(1, invoice);\n            try(ResultSet r=ps.executeQuery()) {\n                if(!r.next() || !\"Đã thanh toán\".equals(r.getString(\"trangThaiHoaDon\"))) throw new SQLException(\"Chỉ được trả hàng của hóa đơn đã thanh toán\");\n                customer=r.getString(\"maKhachHang\");discount=r.getBigDecimal(\"giamGia\");sourceTotal=r.getBigDecimal(\"thanhTien\");\n            }\n        }\n        Map<String,Sold> sold=new HashMap<>();BigDecimal gross=BigDecimal.ZERO;\n        try(PreparedStatement ps=c.prepareStatement(\"SELECT ct.maSanPham,SUM(CAST(x.soLuongXuatCoSo AS BIGINT)) base,SUM(ct.thanhTien) gross,MIN(CASE WHEN ct.soLuong>0 AND x.soLuongXuatCoSo%ct.soLuong=0 THEN x.soLuongXuatCoSo/ct.soLuong ELSE 0 END) minRatio,MAX(CASE WHEN ct.soLuong>0 AND x.soLuongXuatCoSo%ct.soLuong=0 THEN x.soLuongXuatCoSo/ct.soLuong ELSE 0 END) maxRatio FROM ChiTietHoaDon ct JOIN ChiTietXuatLo x ON x.maChiTiet=ct.maChiTiet WHERE ct.maHoaDon=? GROUP BY ct.maSanPham\")) {\n            ps.setString(1,invoice);try(ResultSet r=ps.executeQuery()){while(r.next()){\n                int ratio=r.getInt(\"minRatio\")==r.getInt(\"maxRatio\")?r.getInt(\"minRatio\"):0;\n                sold.put(r.getString(\"maSanPham\"),new Sold(r.getLong(\"base\"),ratio,r.getBigDecimal(\"gross\")));\n            }}\n        }\n        try(PreparedStatement ps=c.prepareStatement(\"SELECT COALESCE(SUM(thanhTien),0) FROM ChiTietHoaDon WHERE maHoaDon=?\")){\n            ps.setString(1,invoice);try(ResultSet r=ps.executeQuery()){r.next();gross=r.getBigDecimal(1);}\n        }\n        Map<String,Returned> previous=new HashMap<>();BigDecimal oldMoney=BigDecimal.ZERO;\n        try(PreparedStatement ps=c.prepareStatement(\"SELECT ct.maSanPham,ct.soLuongCoSoTra,ct.tienHoanLai FROM ChiTietDoiTra ct JOIN PhieuDoiTra p ON p.maPhieuDoiTra=ct.maPhieuDoiTra WHERE p.maHoaDonGoc=?\")){\n            ps.setString(1,invoice);try(ResultSet r=ps.executeQuery()){while(r.next()){\n                Returned a=previous.computeIfAbsent(r.getString(1),k->new Returned());\n                long base=r.getLong(2);a.unresolved|=r.wasNull()||base<=0;a.base+=base;\n                BigDecimal money=r.getBigDecimal(3);a.money=a.money.add(money);oldMoney=oldMoney.add(money);\n            }}\n        }\n        Map<String,Returned> proposed=new HashMap<>();Map<String,Long> lotRestock=new HashMap<>();BigDecimal newMoney=BigDecimal.ZERO;\n        for(ChiTietDoiTra ct:p.getDsChiTietDoiTra()){\n            if(ct==null || ct.getSanPham()==null || ct.getSoLuongDoiTra()<=0) throw new IllegalArgumentException(\"Chi tiết trả phải có sản phẩm và số lượng dương\");\n            nonnegative(ct.getTienHoanLai(),\"Tiền trả dòng\");String product=ct.getSanPham().getMaSanPham();Sold original=sold.get(product);\n            if(original==null || original.base<=0) throw new SQLException(\"Sản phẩm trả không có trên hóa đơn gốc\");\n            long base=ct.getSoLuongCoSoTra();\n            if(base<=0){\n                // Conversion ambiguity cannot be guessed from a product's current pack settings.\n                if(original.ratio<=0) throw new SQLException(\"Hóa đơn bán nhiều quy cách; cần chỉ rõ số lượng trả cơ sở\");\n                base=(long)ct.getSoLuongDoiTra()*original.ratio;\n                if(base>Integer.MAX_VALUE)throw new SQLException(\"Số lượng trả quá lớn\");ct.setSoLuongCoSoTra((int)base);\n            }\n            if(ct.getSoLuongCoSoHoan()<0 || ct.getSoLuongCoSoHoan()>base) throw new SQLException(\"Lượng nhập lại kho vượt lượng hàng trả\");\n            if(ct.getSoLuongCoSoHoan()>0){\n                if(ct.getSoLo()==null || ct.getSoLo().isBlank())throw new SQLException(\"Nhập lại kho phải chỉ rõ lô gốc\");\n                lotRestock.merge(product+\"\\u0001\"+ct.getSoLo(),(long)ct.getSoLuongCoSoHoan(),Long::sum);\n            }\n            Returned a=proposed.computeIfAbsent(product,k->new Returned());a.base+=base;a.money=a.money.add(ct.getTienHoanLai());newMoney=newMoney.add(ct.getTienHoanLai());\n        }\n        for(var entry:proposed.entrySet()){\n            Sold original=sold.get(entry.getKey());Returned prior=previous.getOrDefault(entry.getKey(),new Returned()), now=entry.getValue();\n            if(prior.unresolved)throw new SQLException(\"Lịch sử trả cũ chưa đối soát được đơn vị cơ sở; cần quản lý kiểm tra\");\n            if(prior.base+now.base>original.base)throw new SQLException(\"Tổng hàng trả vượt số lượng đã mua hoặc vừa được trả tại quầy khác\");\n            BigDecimal netFactor=gross.signum()>0?gross.subtract(discount).max(BigDecimal.ZERO).divide(gross,16,RoundingMode.DOWN):BigDecimal.ZERO;\n            BigDecimal cap=original.gross.multiply(netFactor).multiply(BigDecimal.valueOf(prior.base+now.base)).divide(BigDecimal.valueOf(original.base),2,RoundingMode.HALF_UP);\n            if(prior.money.add(now.money).subtract(cap).compareTo(BigDecimal.ONE)>0)throw new SQLException(\"Tiền hoàn vượt giá trị hàng gốc sau giảm giá\");\n        }\n        for(var entry:lotRestock.entrySet()){\n            String[] key=entry.getKey().split(\"\\u0001\",2);long soldInLot=0, returnedToLot=0;\n            try(PreparedStatement ps=c.prepareStatement(\"SELECT COALESCE(SUM(CAST(x.soLuongXuatCoSo AS BIGINT)),0) FROM ChiTietXuatLo x JOIN ChiTietHoaDon ct ON ct.maChiTiet=x.maChiTiet WHERE ct.maHoaDon=? AND ct.maSanPham=? AND x.soLo=?\")){\n                ps.setString(1,invoice);ps.setString(2,key[0]);ps.setString(3,key[1]);try(ResultSet r=ps.executeQuery()){r.next();soldInLot=r.getLong(1);}\n            }\n            try(PreparedStatement ps=c.prepareStatement(\"SELECT COALESCE(SUM(CAST(ct.soLuongCoSoHoan AS BIGINT)),0) FROM ChiTietDoiTra ct JOIN PhieuDoiTra p ON p.maPhieuDoiTra=ct.maPhieuDoiTra WHERE p.maHoaDonGoc=? AND ct.maSanPham=? AND ct.soLo=?\")){\n                ps.setString(1,invoice);ps.setString(2,key[0]);ps.setString(3,key[1]);try(ResultSet r=ps.executeQuery()){r.next();returnedToLot=r.getLong(1);}\n            }\n            if(soldInLot<=0 || returnedToLot+entry.getValue()>soldInLot)throw new SQLException(\"Lô nhập lại không thuộc hóa đơn hoặc vượt lượng xuất gốc\");\n        }\n        nonnegative(p.getTongTienHoan(),\"Tiền thực hoàn\");\n        if(p.getTongTienHoan().compareTo(newMoney)>0)throw new SQLException(\"Tiền thực hoàn vượt giá trị hàng trả\");\n        int earned=sourceTotal.divide(POINT_UNIT,0,RoundingMode.DOWN).intValue();\n        int before=Math.min(earned,oldMoney.divide(POINT_UNIT,0,RoundingMode.DOWN).intValue());\n        int after=Math.min(earned,oldMoney.add(newMoney).divide(POINT_UNIT,0,RoundingMode.DOWN).intValue());\n        return new ReturnPoints(customer,Math.max(0,after-before));\n    }\n    private static void nonnegative(BigDecimal value,String name){\n        if(value==null || value.signum()<0)throw new IllegalArgumentException(name+\" phải không âm\");\n    }\n}\n"},{"path":"src/dao/HoaDonDichVu.java","sha256":"1f0a4aa1852705cd8d50e28fcf7d3aa24194471ebde6ac907c1adc62433d944c","content":"package dao;\n\nimport entity.*;\nimport java.math.BigDecimal;\nimport java.sql.*;\nimport java.util.*;\n\n/** Hotel and Spa writes share the invoice transaction and its rollback. */\nfinal class HoaDonDichVu {\n    private HoaDonDichVu() {}\n\n    static void completeHotel(Connection c,HoaDon h,List<String> rooms)throws SQLException {\n        if(rooms==null || rooms.isEmpty())return;\n        SortedSet<String> sorted=new TreeSet<>();\n        for(String room:rooms){if(room==null || room.isBlank())throw new SQLException(\"Chưa xác định phòng Hotel\");sorted.add(room);}\n        List<ChiTietDichVu> hotelLines=new ArrayList<>();\n        for(ChiTietHoaDon ct:h.getDsChiTiet())if(ct instanceof ChiTietDichVu d && d.getDichVu()!=null && \"DV008\".equals(d.getDichVu().getMaDichVu()))hotelLines.add(d);\n        for(String room:sorted){\n            int days;BigDecimal charge;\n            try(PreparedStatement ps=c.prepareStatement(\"SELECT CASE WHEN DATEDIFF(DAY,CAST(thoiGianCheckIn AS DATE),CAST(GETDATE() AS DATE))<1 THEN 1 ELSE DATEDIFF(DAY,CAST(thoiGianCheckIn AS DATE),CAST(GETDATE() AS DATE)) END days,donGiaNgay,COALESCE(phiDichVuPhatSinh,0) extra FROM PhongLuuTru WITH(UPDLOCK,HOLDLOCK) WHERE maPhong=? AND trangThai=N'ĐANG CÓ KHÁCH' AND thoiGianCheckIn IS NOT NULL AND thoiGianCheckIn<=SYSDATETIME()\")){\n                ps.setString(1,room);try(ResultSet r=ps.executeQuery()){\n                    if(!r.next())throw new SQLException(\"Phòng \"+room+\" không còn khách hoặc ngày nhận phòng không hợp lệ\");\n                    days=r.getInt(\"days\");charge=r.getBigDecimal(\"donGiaNgay\").multiply(BigDecimal.valueOf(days)).add(r.getBigDecimal(\"extra\"));\n                }\n            }\n            List<ChiTietDichVu> matches=new ArrayList<>();\n            for(var line:hotelLines)if(room.equals(line.getMaPhongHotel()))matches.add(line);\n            if(matches.isEmpty() && sorted.size()==1 && hotelLines.size()==1 && hotelLines.get(0).getMaPhongHotel()==null)matches.add(hotelLines.get(0));\n            if(matches.size()!=1 || matches.get(0).getThanhTien().subtract(charge).abs().compareTo(BigDecimal.ONE)>0)throw new SQLException(\"Dòng tính tiền phòng \"+room+\" không khớp số ngày và phụ phí; vui lòng tải lại\");\n            String insert=\"INSERT INTO LichSuLuuTru(maPhong,tenThuCung,tenChu,sdtChu,thoiGianCheckIn,thoiGianCheckOut,soNgayLuuTru,donGiaNgay,phiPhatSinh,tongTien,ghiChu,maHoaDon,trangThaiThanhToan) SELECT maPhong,tenThuCung,tenChu,sdtChu,thoiGianCheckIn,SYSDATETIME(),?,donGiaNgay,COALESCE(phiDichVuPhatSinh,0),?,ghiChuChamSoc,?,N'DA_THANH_TOAN' FROM PhongLuuTru WHERE maPhong=? AND trangThai=N'ĐANG CÓ KHÁCH'\";\n            try(PreparedStatement ps=c.prepareStatement(insert)){\n                ps.setInt(1,days);ps.setBigDecimal(2,charge);ps.setString(3,h.getMaHoaDon());ps.setString(4,room);\n                if(ps.executeUpdate()!=1)throw new SQLException(\"Không lưu được lịch sử phòng \"+room);\n            }\n            try(PreparedStatement ps=c.prepareStatement(\"UPDATE PhongLuuTru SET trangThai=N'ĐANG DỌN DẸP' WHERE maPhong=? AND trangThai=N'ĐANG CÓ KHÁCH'\")){\n                ps.setString(1,room);if(ps.executeUpdate()!=1)throw new SQLException(\"Không cập nhật được trạng thái phòng \"+room);\n            }\n        }\n        for(var line:hotelLines)if(line.getMaPhongHotel()!=null && !sorted.contains(line.getMaPhongHotel()))throw new SQLException(\"Phòng trên dòng bán chưa được chọn checkout\");\n    }\n\n    static void processSpa(Connection c,HoaDon h,String card,TheSpaPass newCard)throws SQLException {\n        if(card!=null && !card.isBlank()){\n            if(newCard!=null)throw new SQLException(\"Tách riêng giao dịch mua thẻ và sử dụng thẻ\");\n            long sessions=0;boolean marked=false;\n            for(ChiTietHoaDon ct:h.getDsChiTiet())if(ct instanceof ChiTietDichVu d && d.isSuDungSpaPass()){marked=true;sessions+=d.getSoLuong();}\n            if(!marked)for(ChiTietHoaDon ct:h.getDsChiTiet())if(ct instanceof ChiTietDichVu d && d.getDichVu()!=null && \"DV004\".equals(d.getDichVu().getMaDichVu()))sessions+=d.getSoLuong();\n            if(sessions<=0 || sessions>Integer.MAX_VALUE)throw new SQLException(\"Phải có số lượt dịch vụ Spa hợp lệ\");\n            if(h.getKhachHang()==null || h.getKhachHang().getMaKhachHang()==null)throw new SQLException(\"Sử dụng Spa Pass phải liên kết đúng khách hàng\");\n            String update=\"UPDATE TheSpaPass SET soBuoiDaDung=soBuoiDaDung+? WHERE maThe=? AND trangThai=N'ĐANG HOẠT ĐỘNG' AND ngayKichHoat<=CAST(GETDATE() AS DATE) AND ngayHetHan>=CAST(GETDATE() AS DATE) AND soBuoiDaDung>=0 AND tongSoBuoi-soBuoiDaDung>=? AND EXISTS(SELECT 1 FROM KhachHang k WHERE k.maKhachHang=? AND k.soDienThoai=TheSpaPass.sdtKhachHang)\";\n            try(PreparedStatement ps=c.prepareStatement(update)){\n                ps.setInt(1,(int)sessions);ps.setString(2,card);ps.setInt(3,(int)sessions);ps.setString(4,h.getKhachHang().getMaKhachHang());\n                if(ps.executeUpdate()!=1)throw new SQLException(\"Thẻ không đúng chủ, hết hạn hoặc không đủ lượt; vui lòng tải lại\");\n            }\n            try(PreparedStatement ps=c.prepareStatement(\"INSERT INTO LichSuSuDungSpaPass(maThe,maHoaDon,maNhanVien,thoiGianSuDung,ghiChu,soLuot) VALUES(?,?,?,SYSDATETIME(),?,?)\")){\n                ps.setString(1,card);ps.setString(2,h.getMaHoaDon());ps.setString(3,h.getNhanVien().getMaNhanVien());ps.setString(4,\"Thanh toán tại POS\");ps.setInt(5,(int)sessions);ps.executeUpdate();\n            }\n        }\n        if(newCard!=null){\n            if(h.getKhachHang()==null || newCard.getTongSoBuoi()<=0 || newCard.getSoBuoiDaDung()!=0\n                    || newCard.getDonGiaGoi()<0 || newCard.getNgayKichHoat()==null || newCard.getNgayHetHan()==null\n                    || newCard.getNgayHetHan().isBefore(newCard.getNgayKichHoat()))throw new SQLException(\"Dữ liệu mua Spa Pass không hợp lệ\");\n            try(PreparedStatement ps=c.prepareStatement(\"SELECT 1 FROM KhachHang WHERE maKhachHang=? AND soDienThoai=?\")){\n                ps.setString(1,h.getKhachHang().getMaKhachHang());ps.setString(2,newCard.getSdtKhachHang());try(ResultSet r=ps.executeQuery()){if(!r.next())throw new SQLException(\"Chủ thẻ không khớp khách hàng trên hóa đơn\");}\n            }\n            try(PreparedStatement ps=c.prepareStatement(\"INSERT INTO TheSpaPass(maThe,sdtKhachHang,tenKhachHang,tenGoi,tongSoBuoi,soBuoiDaDung,donGiaGoi,ngayKichHoat,ngayHetHan,trangThai,maHoaDonKichHoat) VALUES(?,?,?,?,?,0,?,?,?,?,?)\")){\n                ps.setString(1,newCard.getMaThe());ps.setString(2,newCard.getSdtKhachHang());ps.setString(3,newCard.getTenKhachHang());ps.setString(4,newCard.getTenGoi());ps.setInt(5,newCard.getTongSoBuoi());ps.setBigDecimal(6,BigDecimal.valueOf(newCard.getDonGiaGoi()));ps.setDate(7,java.sql.Date.valueOf(newCard.getNgayKichHoat()));ps.setDate(8,java.sql.Date.valueOf(newCard.getNgayHetHan()));ps.setString(9,\"ĐANG HOẠT ĐỘNG\");ps.setString(10,h.getMaHoaDon());ps.executeUpdate();\n            }\n        }\n    }\n}\n"},{"path":"src/dao/LichHenDAO.java","sha256":"074e37f93d87e7752b2c7372f7fc150399726489d411eb10094927c8245d9355","content":"package dao;\r\n\r\nimport entity.*;\r\nimport utils.DBConnection;\r\n\r\nimport java.sql.*;\r\nimport java.time.LocalDateTime;\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\n/**\r\n * Data Access Object cho Lịch hẹn và Chi tiết Lịch hẹn dịch vụ.\r\n */\r\npublic class LichHenDAO {\r\n\r\n    /**\r\n     * Lấy toàn bộ danh sách lịch hẹn kèm khách hàng và chi tiết dịch vụ\r\n     */\r\n    public List<LichHen> getAllLichHen() throws SQLException {\r\n        List<LichHen> list = new ArrayList<>();\r\n        String sql = \"SELECT lh.maLichHen, lh.ngayHen, lh.trangThaiLichHen, lh.ghiChu, \" +\r\n                \"kh.maKhachHang, kh.hoTen AS tenKhachHang, kh.soDienThoai, kh.diemTichLuy, \" +\r\n                \"nv.maNhanVien AS maNvTiepNhan, nv.hoTen AS tenNvTiepNhan \" +\r\n                \"FROM LichHen lh \" +\r\n                \"JOIN KhachHang kh ON lh.maKhachHang = kh.maKhachHang \" +\r\n                \"LEFT JOIN NhanVien nv ON lh.maNhanVienTiepNhan = nv.maNhanVien \" +\r\n                \"ORDER BY lh.ngayHen DESC\";\r\n\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql);\r\n             ResultSet rs = ps.executeQuery()) {\r\n            while (rs.next()) {\r\n                KhachHang kh = new KhachHang(\r\n                        rs.getString(\"maKhachHang\"),\r\n                        rs.getString(\"tenKhachHang\"),\r\n                        rs.getString(\"soDienThoai\"),\r\n                        rs.getInt(\"diemTichLuy\")\r\n                );\r\n\r\n                NhanVien nv = null;\r\n                if (rs.getString(\"maNvTiepNhan\") != null) {\r\n                    nv = new NhanVien();\r\n                    nv.setMaNhanVien(rs.getString(\"maNvTiepNhan\"));\r\n                    nv.setHoTen(rs.getString(\"tenNvTiepNhan\"));\r\n                }\r\n\r\n                Timestamp ts = rs.getTimestamp(\"ngayHen\");\r\n                LocalDateTime ngayHen = (ts != null) ? ts.toLocalDateTime() : LocalDateTime.now();\r\n\r\n                LichHen lh = new LichHen(\r\n                        rs.getString(\"maLichHen\"),\r\n                        kh,\r\n                        nv,\r\n                        ngayHen,\r\n                        rs.getString(\"trangThaiLichHen\"),\r\n                        rs.getString(\"ghiChu\")\r\n                );\r\n\r\n                // Nạp danh sách chi tiết\r\n                lh.setDsChiTiet(getChiTietByLichHen(conn, lh.getMaLichHen(), lh));\r\n                list.add(lh);\r\n            }\r\n        }\r\n        return list;\r\n    }\r\n\r\n    /**\r\n     * Lấy danh sách chi tiết lịch hẹn của 1 mã lịch hẹn\r\n     */\r\n    private List<ChiTietLichHen> getChiTietByLichHen(Connection conn, String maLichHen, LichHen lh) throws SQLException {\r\n        List<ChiTietLichHen> ds = new ArrayList<>();\r\n        String sql = \"SELECT ctlh.maChiTietLichHen, \" +\r\n                \"tc.maThuCung, tc.tenThuCung, tc.giongLoai, \" +\r\n                \"dv.maDichVu, dv.tenDichVu, dv.giaDichVu, dv.thoiLuongPhut, \" +\r\n                \"ktv.maNhanVien AS maKtv, ktv.hoTen AS tenKtv \" +\r\n                \"FROM ChiTietLichHen ctlh \" +\r\n                \"JOIN ThuCung tc ON ctlh.maThuCung = tc.maThuCung \" +\r\n                \"JOIN DichVu dv ON ctlh.maDichVu = dv.maDichVu \" +\r\n                \"LEFT JOIN NhanVien ktv ON ctlh.maKtvChiDinh = ktv.maNhanVien \" +\r\n                \"WHERE ctlh.maLichHen = ?\";\r\n\r\n        try (PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setString(1, maLichHen);\r\n            try (ResultSet rs = ps.executeQuery()) {\r\n                while (rs.next()) {\r\n                    ThuCung tc = new ThuCung();\r\n                    tc.setMaThuCung(rs.getString(\"maThuCung\"));\r\n                    tc.setTenThuCung(rs.getString(\"tenThuCung\"));\r\n                    tc.setGiongLoai(rs.getString(\"giongLoai\"));\r\n\r\n                    DichVu dv = new DichVu(\r\n                            rs.getString(\"maDichVu\"),\r\n                            rs.getString(\"tenDichVu\"),\r\n                            rs.getBigDecimal(\"giaDichVu\"),\r\n                            rs.getInt(\"thoiLuongPhut\")\r\n                    );\r\n\r\n                    NhanVien ktv = null;\r\n                    if (rs.getString(\"maKtv\") != null) {\r\n                        ktv = new NhanVien();\r\n                        ktv.setMaNhanVien(rs.getString(\"maKtv\"));\r\n                        ktv.setHoTen(rs.getString(\"tenKtv\"));\r\n                    }\r\n\r\n                    ChiTietLichHen ct = new ChiTietLichHen(\r\n                            rs.getString(\"maChiTietLichHen\"),\r\n                            lh,\r\n                            tc,\r\n                            dv,\r\n                            ktv\r\n                    );\r\n                    ds.add(ct);\r\n                }\r\n            }\r\n        }\r\n        return ds;\r\n    }\r\n\r\n    /**\r\n     * Thêm lịch hẹn mới kèm chi tiết (Transaction JDBC an toàn)\r\n     */\r\n    public boolean insertLichHen(LichHen lh) throws SQLException {\r\n        String sqlLH = \"INSERT INTO LichHen (maLichHen, maKhachHang, maNhanVienTiepNhan, ngayHen, trangThaiLichHen, ghiChu) VALUES (?, ?, ?, ?, ?, ?)\";\r\n        String sqlCT = \"INSERT INTO ChiTietLichHen (maChiTietLichHen, maLichHen, maThuCung, maDichVu, maKtvChiDinh) VALUES (?, ?, ?, ?, ?)\";\r\n\r\n        Connection conn = null;\r\n        try {\r\n            conn = DBConnection.getConnection();\r\n            conn.setAutoCommit(false);\r\n\r\n            try (PreparedStatement psLH = conn.prepareStatement(sqlLH)) {\r\n                psLH.setString(1, lh.getMaLichHen());\r\n                psLH.setString(2, lh.getKhachHang().getMaKhachHang());\r\n                psLH.setString(3, lh.getNhanVienTiepNhan() != null ? lh.getNhanVienTiepNhan().getMaNhanVien() : null);\r\n                psLH.setTimestamp(4, Timestamp.valueOf(lh.getNgayHen() != null ? lh.getNgayHen() : LocalDateTime.now()));\r\n                psLH.setString(5, lh.getTrangThaiLichHen() != null ? lh.getTrangThaiLichHen() : \"Đã đặt\");\r\n                psLH.setString(6, lh.getGhiChu());\r\n                psLH.executeUpdate();\r\n            }\r\n\r\n            for (ChiTietLichHen ct : lh.getDsChiTiet()) {\r\n                try (PreparedStatement psCT = conn.prepareStatement(sqlCT)) {\r\n                    psCT.setString(1, ct.getMaChiTietLichHen());\r\n                    psCT.setString(2, lh.getMaLichHen());\r\n                    psCT.setString(3, ct.getThuCung().getMaThuCung());\r\n                    psCT.setString(4, ct.getDichVu().getMaDichVu());\r\n                    psCT.setString(5, ct.getKtvChiDinh() != null ? ct.getKtvChiDinh().getMaNhanVien() : null);\r\n                    psCT.executeUpdate();\r\n                }\r\n            }\r\n\r\n            conn.commit();\r\n            return true;\r\n        } catch (SQLException e) {\r\n            if (conn != null) {\r\n                try { conn.rollback(); } catch (SQLException ignored) {}\r\n            }\r\n            throw e;\r\n        } finally {\r\n            if (conn != null) {\r\n                try { conn.setAutoCommit(true); } catch (SQLException ignored) {}\r\n                try { conn.close(); } catch (SQLException ignored) {}\r\n            }\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Cập nhật trạng thái lịch hẹn (Đã đặt, Đang phục vụ, Hoàn thành, Hủy)\r\n     */\r\n    public boolean capNhatTrangThai(String maLichHen, String trangThaiMoi) throws SQLException {\r\n        String sql = \"UPDATE LichHen SET trangThaiLichHen = ? WHERE maLichHen = ?\";\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setString(1, trangThaiMoi);\r\n            ps.setString(2, maLichHen);\r\n            return ps.executeUpdate() > 0;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Phân công KTV chỉ định cho chi tiết lịch hẹn\r\n     */\r\n    public boolean capNhatKtvChiDinh(String maChiTietLichHen, String maKtv) throws SQLException {\r\n        String sql = \"UPDATE ChiTietLichHen SET maKtvChiDinh = ? WHERE maChiTietLichHen = ?\";\r\n        try (Connection conn = DBConnection.getConnection();\r\n             PreparedStatement ps = conn.prepareStatement(sql)) {\r\n            ps.setString(1, maKtv);\r\n            ps.setString(2, maChiTietLichHen);\r\n            return ps.executeUpdate() > 0;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Xóa lịch hẹn kèm toàn bộ chi tiết (Transaction)\r\n     */\r\n    public boolean deleteLichHen(String maLichHen) throws SQLException {\r\n        String sqlCT = \"DELETE FROM ChiTietLichHen WHERE maLichHen = ?\";\r\n        String sqlLH = \"DELETE FROM LichHen WHERE maLichHen = ?\";\r\n\r\n        Connection conn = null;\r\n        try {\r\n            conn = DBConnection.getConnection();\r\n            conn.setAutoCommit(false);\r\n\r\n            try (PreparedStatement ps1 = conn.prepareStatement(sqlCT)) {\r\n                ps1.setString(1, maLichHen);\r\n                ps1.executeUpdate();\r\n            }\r\n\r\n            int rows;\r\n            try (PreparedStatement ps2 = conn.prepareStatement(sqlLH)) {\r\n                ps2.setString(1, maLichHen);\r\n                rows = ps2.executeUpdate();\r\n            }\r\n\r\n            conn.commit();\r\n            return rows > 0;\r\n        } catch (SQLException e) {\r\n            if (conn != null) {\r\n                try { conn.rollback(); } catch (SQLException ignored) {}\r\n            }\r\n            throw e;\r\n        } finally {\r\n            if (conn != null) {\r\n                try { conn.setAutoCommit(true); } catch (SQLException ignored) {}\r\n                try { conn.close(); } catch (SQLException ignored) {}\r\n            }\r\n        }\r\n    }\r\n}\r\n"},{"path":"src/dao/BaoCaoThongKeDAO.java","sha256":"380e46d68de82ff2b4994691bce0a0c2d3bfcdba21aa484a7563dbee865aaa94","content":"package dao;\r\n\r\nimport utils.DBConnection;\r\n\r\nimport java.sql.Connection;\r\nimport java.sql.PreparedStatement;\r\nimport java.sql.ResultSet;\r\nimport java.sql.SQLException;\r\nimport java.sql.Timestamp;\r\nimport java.time.LocalDate;\r\nimport java.time.LocalDateTime;\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\n/**\r\n * Nguồn dữ liệu tập trung cho Trung tâm Báo biểu.\r\n * Mọi báo cáo đều đọc trực tiếp từ SQL Server và dùng cùng một khoảng thời gian [từ, đến).\r\n */\r\npublic class BaoCaoThongKeDAO {\r\n\r\n    public static final class DoanhThuRow {\r\n        public String maHoaDon;\r\n        public LocalDateTime thoiGian;\r\n        public String khachHang;\r\n        public String thuNgan;\r\n        public long tienHang;\r\n        public long giamGia;\r\n        public long doanhThuThuan;\r\n        public long doanhThuHangHoa;\r\n        public long doanhThuDichVu;\r\n        public long giaVon;\r\n        public String phuongThuc;\r\n    }\r\n\r\n    public static final class TopBanChayRow {\r\n        public String ma;\r\n        public String ten;\r\n        public String phanNhom;\r\n        public String donViTinh;\r\n        public int soLuong;\r\n        public long doanhThu;\r\n    }\r\n\r\n    public static final class HieuSuatNhanSuRow {\r\n        public String maNhanVien;\r\n        public String hoTen;\r\n        public String chucVu;\r\n        public boolean dangHoatDong;\r\n        public int soCa;\r\n        public int soHoaDon;\r\n        public int soDichVu;\r\n        public long doanhThuPhuTrach;\r\n        public long hoaHong;\r\n    }\r\n\r\n    public static final class KhachHangRow {\r\n        public String maKhachHang;\r\n        public String hoTen;\r\n        public String soDienThoai;\r\n        public int diemTichLuy;\r\n    }\r\n\r\n    public static final class HotelSummaryRow {\r\n        public String loaiPhong;\r\n        public int tongPhong;\r\n        public int dangCoKhach;\r\n        public int dangDon;\r\n        public int phongTrong;\r\n        public long doanhThuNgayTamTinh;\r\n    }\r\n\r\n    public static final class DoiTraSummary {\r\n        public int soPhieu;\r\n        public int soLuongSanPham;\r\n        public long tongTienHoan;\r\n    }\r\n\r\n    public static final class LoHangFefoRow {\r\n        public String soLo;\r\n        public String maSanPham;\r\n        public String tenSanPham;\r\n        public LocalDate ngaySanXuat;\r\n        public LocalDate hanSuDung;\r\n        public long soNgayConLai;\r\n        public int soLuongTon;\r\n        public String donViTinh;\r\n    }\r\n\r\n    public static final class XuatNhapTonRow {\r\n        public String maSanPham;\r\n        public String tenSanPham;\r\n        public String donViTinh;\r\n        public int tonDauKy;\r\n        public int nhapTrongKy;\r\n        public int xuatBanTrongKy;\r\n        public int hoanTraTrongKy;\r\n        public int tonCuoiKy;\r\n        public long donGiaBan;\r\n        public long giaTriTonTheoGiaNhap;\r\n    }\r\n\r\n    public List<DoanhThuRow> getDoanhThu(LocalDateTime tu, LocalDateTime den) throws SQLException {\r\n        String sql =\r\n                \"WITH CT_Rev AS (\" +\r\n                \" SELECT ct.maHoaDon,\" +\r\n                \" SUM(CASE WHEN ct.loaiChiTiet IN ('SAN_PHAM','XUAT_LO','ChiTietXuatLo') THEN CAST(ct.thanhTien AS BIGINT) ELSE 0 END) doanhThuHang,\" +\r\n                \" SUM(CASE WHEN ct.loaiChiTiet IN ('DICH_VU','ChiTietDichVu') THEN CAST(ct.thanhTien AS BIGINT) ELSE 0 END) doanhThuDV\" +\r\n                \" FROM ChiTietHoaDon ct\" +\r\n                \" GROUP BY ct.maHoaDon\" +\r\n                \"),\" +\r\n                \"CT_Cost AS (\" +\r\n                \" SELECT ct.maHoaDon,\" +\r\n                \" SUM(CASE WHEN ct.loaiChiTiet IN ('SAN_PHAM','XUAT_LO','ChiTietXuatLo') THEN CAST(COALESCE(xl.soLuongXuatCoSo, ct.soLuong) AS BIGINT) * CAST(COALESCE(l.donGiaNhapCoSo,0) AS BIGINT) ELSE 0 END) giaVonHang,\" +\r\n                \" SUM(CASE WHEN ct.loaiChiTiet IN ('DICH_VU','ChiTietDichVu') THEN CAST(COALESCE(dv.tienHoaHong,0) AS BIGINT) ELSE 0 END) giaVonDV\" +\r\n                \" FROM ChiTietHoaDon ct\" +\r\n                \" LEFT JOIN ChiTietXuatLo xl ON xl.maChiTiet=ct.maChiTiet\" +\r\n                \" LEFT JOIN LoHang l ON l.soLo=xl.soLo\" +\r\n                \" LEFT JOIN ChiTietDichVu dv ON dv.maChiTiet=ct.maChiTiet\" +\r\n                \" GROUP BY ct.maHoaDon\" +\r\n                \")\" +\r\n                \" SELECT h.maHoaDon, COALESCE(h.thoiGianThanhToan,h.ngayLap) thoiGian,\" +\r\n                \" COALESCE(kh.hoTen,N'Khách vãng lai') khachHang, COALESCE(nv.hoTen,N'Không xác định') thuNgan,\" +\r\n                \" CAST(COALESCE(h.thanhTien,0)+COALESCE(h.giamGia,0) AS BIGINT) tienHang,\" +\r\n                \" CAST(COALESCE(h.giamGia,0) AS BIGINT) giamGia, CAST(COALESCE(h.thanhTien,0) AS BIGINT) doanhThuThuan,\" +\r\n                \" CAST(COALESCE(rev.doanhThuHang,0) AS BIGINT) doanhThuHang,\" +\r\n                \" CAST(COALESCE(rev.doanhThuDV,0) AS BIGINT) doanhThuDV,\" +\r\n                \" CAST(COALESCE(cost.giaVonHang,0) + COALESCE(cost.giaVonDV,0) AS BIGINT) giaVon,\" +\r\n                \" COALESCE(h.phuongThucThanhToan,N'Không xác định') phuongThuc\" +\r\n                \" FROM HoaDon h\" +\r\n                \" LEFT JOIN KhachHang kh ON kh.maKhachHang=h.maKhachHang\" +\r\n                \" LEFT JOIN NhanVien nv ON nv.maNhanVien=h.maNhanVien\" +\r\n                \" LEFT JOIN CT_Rev rev ON rev.maHoaDon=h.maHoaDon\" +\r\n                \" LEFT JOIN CT_Cost cost ON cost.maHoaDon=h.maHoaDon\" +\r\n                \" WHERE h.trangThaiHoaDon=N'Đã thanh toán'\" +\r\n                \" AND COALESCE(h.thoiGianThanhToan,h.ngayLap)>=? AND COALESCE(h.thoiGianThanhToan,h.ngayLap)<?\" +\r\n                \" ORDER BY thoiGian DESC\";\r\n        List<DoanhThuRow> rows = new ArrayList<>();\r\n        try (Connection c = DBConnection.getConnection(); PreparedStatement ps = c.prepareStatement(sql)) {\r\n            setRange(ps, tu, den);\r\n            try (ResultSet rs = ps.executeQuery()) {\r\n                while (rs.next()) {\r\n                    DoanhThuRow r = new DoanhThuRow();\r\n                    r.maHoaDon = rs.getString(\"maHoaDon\");\r\n                    r.thoiGian = rs.getTimestamp(\"thoiGian\").toLocalDateTime();\r\n                    r.khachHang = rs.getString(\"khachHang\");\r\n                    r.thuNgan = rs.getString(\"thuNgan\");\r\n                    r.tienHang = rs.getLong(\"tienHang\");\r\n                    r.giamGia = rs.getLong(\"giamGia\");\r\n                    r.doanhThuThuan = rs.getLong(\"doanhThuThuan\");\r\n                    long hangGross = rs.getLong(\"doanhThuHang\");\r\n                    long dvGross = rs.getLong(\"doanhThuDV\");\r\n                    long gross = hangGross + dvGross;\r\n                    r.doanhThuHangHoa = gross > 0 ? Math.round(r.doanhThuThuan * (hangGross * 1.0 / gross)) : r.doanhThuThuan;\r\n                    r.doanhThuDichVu = r.doanhThuThuan - r.doanhThuHangHoa;\r\n                    r.giaVon = rs.getLong(\"giaVon\");\r\n                    r.phuongThuc = rs.getString(\"phuongThuc\");\r\n                    rows.add(r);\r\n                }\r\n            }\r\n        }\r\n        return rows;\r\n    }\r\n\r\n    public List<TopBanChayRow> getTopBanChay(LocalDateTime tu, LocalDateTime den) throws SQLException {\r\n        String sql =\r\n                \"WITH XL AS (\" +\r\n                \" SELECT maChiTiet, SUM(soLuongXuatCoSo) tongXuatCoSo FROM ChiTietXuatLo GROUP BY maChiTiet\" +\r\n                \")\" +\r\n                \" SELECT COALESCE(ct.maDichVu, ct.maSanPham) ma,\" +\r\n                \" COALESCE(d.tenDichVu, sp.tenSanPham, N'Sản phẩm') ten,\" +\r\n                \" CASE WHEN ct.loaiChiTiet IN ('DICH_VU','ChiTietDichVu') THEN N'Dịch vụ' ELSE N'Hàng hóa' END phanNhom,\" +\r\n                \" CASE WHEN ct.loaiChiTiet IN ('DICH_VU','ChiTietDichVu') THEN N'Lượt' ELSE COALESCE(sp.donViCoSo, N'Đơn vị') END donViTinh,\" +\r\n                \" SUM(CASE WHEN ct.loaiChiTiet IN ('DICH_VU','ChiTietDichVu') THEN ct.soLuong ELSE COALESCE(xl.tongXuatCoSo, ct.soLuong) END) soLuong,\" +\r\n                \" SUM(CAST(ct.thanhTien AS BIGINT)) doanhThu\" +\r\n                \" FROM ChiTietHoaDon ct\" +\r\n                \" JOIN HoaDon h ON h.maHoaDon=ct.maHoaDon\" +\r\n                \" LEFT JOIN XL xl ON xl.maChiTiet=ct.maChiTiet\" +\r\n                \" LEFT JOIN SanPham sp ON sp.maSanPham=ct.maSanPham\" +\r\n                \" LEFT JOIN DichVu d ON d.maDichVu=ct.maDichVu\" +\r\n                \" WHERE h.trangThaiHoaDon=N'Đã thanh toán'\" +\r\n                \" AND COALESCE(h.thoiGianThanhToan,h.ngayLap)>=? AND COALESCE(h.thoiGianThanhToan,h.ngayLap)<?\" +\r\n                \" GROUP BY COALESCE(ct.maDichVu, ct.maSanPham),\" +\r\n                \" COALESCE(d.tenDichVu, sp.tenSanPham, N'Sản phẩm'),\" +\r\n                \" CASE WHEN ct.loaiChiTiet IN ('DICH_VU','ChiTietDichVu') THEN N'Dịch vụ' ELSE N'Hàng hóa' END,\" +\r\n                \" CASE WHEN ct.loaiChiTiet IN ('DICH_VU','ChiTietDichVu') THEN N'Lượt' ELSE COALESCE(sp.donViCoSo, N'Đơn vị') END\" +\r\n                \" ORDER BY doanhThu DESC, soLuong DESC\";\r\n        List<TopBanChayRow> rows = new ArrayList<>();\r\n        try (Connection c = DBConnection.getConnection(); PreparedStatement ps = c.prepareStatement(sql)) {\r\n            setRange(ps, tu, den);\r\n            try (ResultSet rs = ps.executeQuery()) {\r\n                while (rs.next()) {\r\n                    TopBanChayRow r = new TopBanChayRow();\r\n                    r.ma = rs.getString(\"ma\");\r\n                    r.ten = rs.getString(\"ten\");\r\n                    r.phanNhom = rs.getString(\"phanNhom\");\r\n                    r.donViTinh = rs.getString(\"donViTinh\");\r\n                    r.soLuong = rs.getInt(\"soLuong\");\r\n                    r.doanhThu = rs.getLong(\"doanhThu\");\r\n                    rows.add(r);\r\n                }\r\n            }\r\n        }\r\n        return rows;\r\n    }\r\n\r\n    public List<HieuSuatNhanSuRow> getHieuSuatNhanSu(LocalDateTime tu, LocalDateTime den) throws SQLException {\r\n        String sql =\r\n                \"WITH PC AS (SELECT maNhanVien,COUNT(*) soCa FROM BangPhanCong WHERE ngayLamViec>=CAST(? AS date) AND ngayLamViec<CAST(? AS date) GROUP BY maNhanVien),\" +\r\n                \" HD AS (SELECT maNhanVien,COUNT(*) soHD,SUM(CAST(thanhTien AS BIGINT)) doanhThu FROM HoaDon\" +\r\n                \" WHERE trangThaiHoaDon=N'Đã thanh toán' AND COALESCE(thoiGianThanhToan,ngayLap)>=? AND COALESCE(thoiGianThanhToan,ngayLap)<? GROUP BY maNhanVien),\" +\r\n                \" DV AS (SELECT dv.maKtvThucHien,COUNT(*) soDV,SUM(CAST(ct.thanhTien AS BIGINT)) doanhThuDV,SUM(CAST(COALESCE(dv.tienHoaHong,0) AS BIGINT)) hoaHong\" +\r\n                \" FROM ChiTietDichVu dv JOIN ChiTietHoaDon ct ON ct.maChiTiet=dv.maChiTiet JOIN HoaDon h ON h.maHoaDon=ct.maHoaDon\" +\r\n                \" WHERE h.trangThaiHoaDon=N'Đã thanh toán' AND COALESCE(h.thoiGianThanhToan,h.ngayLap)>=? AND COALESCE(h.thoiGianThanhToan,h.ngayLap)<? GROUP BY dv.maKtvThucHien)\" +\r\n                \" SELECT nv.maNhanVien,nv.hoTen,nv.chucVu,COALESCE(tk.trangThaiHoatDong,1) hoatDong,\" +\r\n                \" COALESCE(pc.soCa,0) soCa,COALESCE(hd.soHD,0) soHD,COALESCE(dv.soDV,0) soDV,\" +\r\n                \" COALESCE(hd.doanhThu,0)+COALESCE(dv.doanhThuDV,0) doanhThu,COALESCE(dv.hoaHong,0) hoaHong\" +\r\n                \" FROM NhanVien nv LEFT JOIN TaiKhoan tk ON tk.maTaiKhoan=nv.maTaiKhoan\" +\r\n                \" LEFT JOIN PC pc ON pc.maNhanVien=nv.maNhanVien LEFT JOIN HD hd ON hd.maNhanVien=nv.maNhanVien LEFT JOIN DV dv ON dv.maKtvThucHien=nv.maNhanVien\" +\r\n                \" ORDER BY doanhThu DESC,nv.maNhanVien\";\r\n        List<HieuSuatNhanSuRow> rows = new ArrayList<>();\r\n        try (Connection c = DBConnection.getConnection(); PreparedStatement ps = c.prepareStatement(sql)) {\r\n            ps.setTimestamp(1, Timestamp.valueOf(tu));\r\n            ps.setTimestamp(2, Timestamp.valueOf(den));\r\n            ps.setTimestamp(3, Timestamp.valueOf(tu));\r\n            ps.setTimestamp(4, Timestamp.valueOf(den));\r\n            ps.setTimestamp(5, Timestamp.valueOf(tu));\r\n            ps.setTimestamp(6, Timestamp.valueOf(den));\r\n            try (ResultSet rs = ps.executeQuery()) {\r\n                while (rs.next()) {\r\n                    HieuSuatNhanSuRow r = new HieuSuatNhanSuRow();\r\n                    r.maNhanVien = rs.getString(\"maNhanVien\");\r\n                    r.hoTen = rs.getString(\"hoTen\");\r\n                    r.chucVu = rs.getString(\"chucVu\");\r\n                    r.dangHoatDong = rs.getBoolean(\"hoatDong\");\r\n                    r.soCa = rs.getInt(\"soCa\");\r\n                    r.soHoaDon = rs.getInt(\"soHD\");\r\n                    r.soDichVu = rs.getInt(\"soDV\");\r\n                    r.doanhThuPhuTrach = rs.getLong(\"doanhThu\");\r\n                    r.hoaHong = rs.getLong(\"hoaHong\");\r\n                    rows.add(r);\r\n                }\r\n            }\r\n        }\r\n        return rows;\r\n    }\r\n\r\n    public List<KhachHangRow> getKhachHang() throws SQLException {\r\n        List<KhachHangRow> rows = new ArrayList<>();\r\n        String sql = \"SELECT maKhachHang,hoTen,soDienThoai,diemTichLuy FROM KhachHang ORDER BY diemTichLuy DESC,maKhachHang\";\r\n        try (Connection c = DBConnection.getConnection(); PreparedStatement ps = c.prepareStatement(sql); ResultSet rs = ps.executeQuery()) {\r\n            while (rs.next()) {\r\n                KhachHangRow r = new KhachHangRow();\r\n                r.maKhachHang = rs.getString(\"maKhachHang\");\r\n                r.hoTen = rs.getString(\"hoTen\");\r\n                r.soDienThoai = rs.getString(\"soDienThoai\");\r\n                r.diemTichLuy = rs.getInt(\"diemTichLuy\");\r\n                rows.add(r);\r\n            }\r\n        }\r\n        return rows;\r\n    }\r\n\r\n    public List<HotelSummaryRow> getHotelSummary() throws SQLException {\r\n        String sql = \"SELECT loaiPhong,COUNT(*) tongPhong,\" +\r\n                \" SUM(CASE WHEN trangThai=N'ĐANG CÓ KHÁCH' THEN 1 ELSE 0 END) dangCoKhach,\" +\r\n                \" SUM(CASE WHEN trangThai=N'ĐANG DỌN DẸP' THEN 1 ELSE 0 END) dangDon,\" +\r\n                \" SUM(CASE WHEN trangThai=N'TRỐNG' THEN 1 ELSE 0 END) phongTrong,\" +\r\n                \" SUM(CASE WHEN trangThai=N'ĐANG CÓ KHÁCH' THEN donGiaNgay+COALESCE(phiDichVuPhatSinh,0) ELSE 0 END) doanhThuNgay\" +\r\n                \" FROM PhongLuuTru GROUP BY loaiPhong ORDER BY loaiPhong\";\r\n        List<HotelSummaryRow> rows = new ArrayList<>();\r\n        try (Connection c = DBConnection.getConnection(); PreparedStatement ps = c.prepareStatement(sql); ResultSet rs = ps.executeQuery()) {\r\n            while (rs.next()) {\r\n                HotelSummaryRow r = new HotelSummaryRow();\r\n                r.loaiPhong = rs.getString(\"loaiPhong\");\r\n                r.tongPhong = rs.getInt(\"tongPhong\");\r\n                r.dangCoKhach = rs.getInt(\"dangCoKhach\");\r\n                r.dangDon = rs.getInt(\"dangDon\");\r\n                r.phongTrong = rs.getInt(\"phongTrong\");\r\n                r.doanhThuNgayTamTinh = rs.getLong(\"doanhThuNgay\");\r\n                rows.add(r);\r\n            }\r\n        }\r\n        return rows;\r\n    }\r\n\r\n    public DoiTraSummary getDoiTraSummary(LocalDateTime tu, LocalDateTime den) throws SQLException {\r\n        String sql =\r\n                \"WITH P AS (\" +\r\n                \" SELECT p.maPhieuDoiTra, p.tongTienHoan\" +\r\n                \" FROM PhieuDoiTra p\" +\r\n                \" WHERE p.ngayDoiTra>=? AND p.ngayDoiTra<?\" +\r\n                \"),\" +\r\n                \"CT AS (\" +\r\n                \" SELECT ct.maPhieuDoiTra, SUM(ct.soLuongDoiTra) soLuong\" +\r\n                \" FROM ChiTietDoiTra ct\" +\r\n                \" WHERE ct.maPhieuDoiTra IN (SELECT maPhieuDoiTra FROM P)\" +\r\n                \" GROUP BY ct.maPhieuDoiTra\" +\r\n                \")\" +\r\n                \" SELECT COUNT(p.maPhieuDoiTra) soPhieu,\" +\r\n                \" COALESCE(SUM(ct.soLuong),0) soLuong,\" +\r\n                \" COALESCE(SUM(CAST(p.tongTienHoan AS BIGINT)),0) tongHoan\" +\r\n                \" FROM P p\" +\r\n                \" LEFT JOIN CT ct ON ct.maPhieuDoiTra=p.maPhieuDoiTra\";\r\n        DoiTraSummary r = new DoiTraSummary();\r\n        try (Connection c = DBConnection.getConnection(); PreparedStatement ps = c.prepareStatement(sql)) {\r\n            setRange(ps, tu, den);\r\n            try (ResultSet rs = ps.executeQuery()) {\r\n                if (rs.next()) {\r\n                    r.soPhieu = rs.getInt(\"soPhieu\");\r\n                    r.soLuongSanPham = rs.getInt(\"soLuong\");\r\n                    r.tongTienHoan = rs.getLong(\"tongHoan\");\r\n                }\r\n            }\r\n        }\r\n        return r;\r\n    }\r\n\r\n    public List<LoHangFefoRow> getLoHangFefo() throws SQLException {\r\n        String sql = \"SELECT l.soLo,l.maSanPham,sp.tenSanPham,l.ngaySanXuat,l.hanSuDung,\" +\r\n                \" DATEDIFF(day,CAST(GETDATE() AS date),l.hanSuDung) soNgayConLai,l.soLuongTon,COALESCE(dvt.tenDonVi,N'Đơn vị') donViTinh\" +\r\n                \" FROM LoHang l JOIN SanPham sp ON sp.maSanPham=l.maSanPham\" +\r\n                \" OUTER APPLY (SELECT TOP 1 dv.tenDonVi FROM QuyDoiDonVi q JOIN DonViTinh dv ON dv.maDonVi=q.maDonVi\" +\r\n                \" WHERE q.maSanPham=l.maSanPham AND q.tyLeQuyDoi=1 ORDER BY q.maQuyDoi) dvt\" +\r\n                \" WHERE l.soLuongTon>0 ORDER BY l.hanSuDung,l.soLo\";\r\n        List<LoHangFefoRow> rows = new ArrayList<>();\r\n        try (Connection c = DBConnection.getConnection(); PreparedStatement ps = c.prepareStatement(sql); ResultSet rs = ps.executeQuery()) {\r\n            while (rs.next()) {\r\n                LoHangFefoRow r = new LoHangFefoRow();\r\n                r.soLo = rs.getString(\"soLo\");\r\n                r.maSanPham = rs.getString(\"maSanPham\");\r\n                r.tenSanPham = rs.getString(\"tenSanPham\");\r\n                r.ngaySanXuat = rs.getDate(\"ngaySanXuat\").toLocalDate();\r\n                r.hanSuDung = rs.getDate(\"hanSuDung\").toLocalDate();\r\n                r.soNgayConLai = rs.getLong(\"soNgayConLai\");\r\n                r.soLuongTon = rs.getInt(\"soLuongTon\");\r\n                r.donViTinh = rs.getString(\"donViTinh\");\r\n                rows.add(r);\r\n            }\r\n        }\r\n        return rows;\r\n    }\r\n\r\n    public List<XuatNhapTonRow> getXuatNhapTon(LocalDateTime tu, LocalDateTime den) throws SQLException {\r\n        String sql =\r\n                \"WITH L AS (SELECT maSanPham,SUM(CAST(soLuongTon AS BIGINT)) tonHienTai,\" +\r\n                \" SUM(CAST(soLuongTon AS BIGINT)*CAST(donGiaNhapCoSo AS BIGINT)) giaTriHienTai FROM LoHang GROUP BY maSanPham),\" +\r\n                \" N AS (SELECT maSanPham,\" +\r\n                \" SUM(CASE WHEN ngayNhap>=? AND ngayNhap<? THEN soLuongNhap ELSE 0 END) nhapKy,\" +\r\n                \" SUM(CASE WHEN ngayNhap>=? THEN soLuongNhap ELSE 0 END) nhapSau,\" +\r\n                \" SUM(CASE WHEN ngayNhap>=? THEN CAST(soLuongNhap AS BIGINT)*CAST(donGiaNhapCoSo AS BIGINT) ELSE 0 END) giaTriNhapSau\" +\r\n                \" FROM LoHang GROUP BY maSanPham),\" +\r\n                \" X AS (SELECT l.maSanPham,\" +\r\n                \" SUM(CASE WHEN COALESCE(h.thoiGianThanhToan,h.ngayLap)>=? AND COALESCE(h.thoiGianThanhToan,h.ngayLap)<? THEN x.soLuongXuatCoSo ELSE 0 END) xuatKy,\" +\r\n                \" SUM(CASE WHEN COALESCE(h.thoiGianThanhToan,h.ngayLap)>=? THEN x.soLuongXuatCoSo ELSE 0 END) xuatSau,\" +\r\n                \" SUM(CASE WHEN COALESCE(h.thoiGianThanhToan,h.ngayLap)>=? THEN CAST(x.soLuongXuatCoSo AS BIGINT)*CAST(l.donGiaNhapCoSo AS BIGINT) ELSE 0 END) giaTriXuatSau\" +\r\n                \" FROM ChiTietXuatLo x JOIN LoHang l ON l.soLo=x.soLo JOIN ChiTietHoaDon cthd ON cthd.maChiTiet=x.maChiTiet\" +\r\n                \" JOIN HoaDon h ON h.maHoaDon=cthd.maHoaDon WHERE h.trangThaiHoaDon=N'Đã thanh toán' GROUP BY l.maSanPham),\" +\r\n                \" R AS (SELECT ct.maSanPham,\" +\r\n                \" SUM(CASE WHEN p.ngayDoiTra>=? AND p.ngayDoiTra<? THEN COALESCE(ct.soLuongCoSoHoan,0) ELSE 0 END) traKy,\" +\r\n                \" SUM(CASE WHEN p.ngayDoiTra>=? THEN COALESCE(ct.soLuongCoSoHoan,0) ELSE 0 END) traSau,\" +\r\n                \" SUM(CASE WHEN p.ngayDoiTra>=? THEN CAST(COALESCE(ct.soLuongCoSoHoan,0) AS BIGINT)*CAST(COALESCE(l.donGiaNhapCoSo,0) AS BIGINT) ELSE 0 END) giaTriTraSau\" +\r\n                \" FROM ChiTietDoiTra ct JOIN PhieuDoiTra p ON p.maPhieuDoiTra=ct.maPhieuDoiTra LEFT JOIN LoHang l ON l.soLo=ct.soLo GROUP BY ct.maSanPham)\" +\r\n                \" SELECT sp.maSanPham,sp.tenSanPham,COALESCE(dvt.tenDonVi,N'Đơn vị') donViTinh,\" +\r\n                \" (COALESCE(l.tonHienTai,0)-COALESCE(n.nhapSau,0)+COALESCE(x.xuatSau,0)-COALESCE(r.traSau,0)) tonCuoi,\" +\r\n                \" COALESCE(n.nhapKy,0) nhapKy,COALESCE(x.xuatKy,0) xuatKy,COALESCE(r.traKy,0) traKy,\" +\r\n                \" COALESCE(qd.giaBan,0) giaBan,\" +\r\n                \" (COALESCE(l.giaTriHienTai,0)-COALESCE(n.giaTriNhapSau,0)+COALESCE(x.giaTriXuatSau,0)-COALESCE(r.giaTriTraSau,0)) giaTriTon\" +\r\n                \" FROM SanPham sp LEFT JOIN L l ON l.maSanPham=sp.maSanPham LEFT JOIN N n ON n.maSanPham=sp.maSanPham\" +\r\n                \" LEFT JOIN X x ON x.maSanPham=sp.maSanPham LEFT JOIN R r ON r.maSanPham=sp.maSanPham\" +\r\n                \" OUTER APPLY (SELECT TOP 1 q.giaBan,q.maDonVi FROM QuyDoiDonVi q WHERE q.maSanPham=sp.maSanPham AND q.tyLeQuyDoi=1 ORDER BY q.maQuyDoi) qd\" +\r\n                \" LEFT JOIN DonViTinh dvt ON dvt.maDonVi=qd.maDonVi ORDER BY sp.maSanPham\";\r\n        List<XuatNhapTonRow> rows = new ArrayList<>();\r\n        try (Connection c = DBConnection.getConnection(); PreparedStatement ps = c.prepareStatement(sql)) {\r\n            int i = 1;\r\n            ps.setTimestamp(i++, Timestamp.valueOf(tu)); ps.setTimestamp(i++, Timestamp.valueOf(den));\r\n            ps.setTimestamp(i++, Timestamp.valueOf(den)); ps.setTimestamp(i++, Timestamp.valueOf(den));\r\n            ps.setTimestamp(i++, Timestamp.valueOf(tu)); ps.setTimestamp(i++, Timestamp.valueOf(den));\r\n            ps.setTimestamp(i++, Timestamp.valueOf(den)); ps.setTimestamp(i++, Timestamp.valueOf(den));\r\n            ps.setTimestamp(i++, Timestamp.valueOf(tu)); ps.setTimestamp(i++, Timestamp.valueOf(den));\r\n            ps.setTimestamp(i++, Timestamp.valueOf(den)); ps.setTimestamp(i++, Timestamp.valueOf(den));\r\n            try (ResultSet rs = ps.executeQuery()) {\r\n                while (rs.next()) {\r\n                    XuatNhapTonRow r = new XuatNhapTonRow();\r\n                    r.maSanPham = rs.getString(\"maSanPham\");\r\n                    r.tenSanPham = rs.getString(\"tenSanPham\");\r\n                    r.donViTinh = rs.getString(\"donViTinh\");\r\n                    r.tonCuoiKy = Math.max(0, rs.getInt(\"tonCuoi\"));\r\n                    r.nhapTrongKy = rs.getInt(\"nhapKy\");\r\n                    r.xuatBanTrongKy = rs.getInt(\"xuatKy\");\r\n                    r.hoanTraTrongKy = rs.getInt(\"traKy\");\r\n                    r.tonDauKy = Math.max(0, r.tonCuoiKy - r.nhapTrongKy + r.xuatBanTrongKy - r.hoanTraTrongKy);\r\n                    r.donGiaBan = rs.getLong(\"giaBan\");\r\n                    r.giaTriTonTheoGiaNhap = rs.getLong(\"giaTriTon\");\r\n                    rows.add(r);\r\n                }\r\n            }\r\n        }\r\n        return rows;\r\n    }\r\n\r\n    private static void setRange(PreparedStatement ps, LocalDateTime tu, LocalDateTime den) throws SQLException {\r\n        ps.setTimestamp(1, Timestamp.valueOf(tu));\r\n        ps.setTimestamp(2, Timestamp.valueOf(den));\r\n    }\r\n}\r\n"},{"path":"src/bus/ThongKeBus.java","sha256":"1efd438c543a485f1cccd86367480ba07b7465f219c3fd1c8514d2896c8b6e44","content":"package bus;\r\n\r\nimport dao.BaoCaoThongKeDAO;\r\nimport dao.BaoCaoThongKeDAO.*;\r\nimport dao.HoaDonDAO;\r\n\r\nimport java.sql.SQLException;\r\nimport java.time.LocalDate;\r\nimport java.time.LocalDateTime;\r\nimport java.util.*;\r\n\r\n/**\r\n * Controller điều phối toàn bộ nghiệp vụ Thống kê, Báo cáo Doanh thu, Hiệu suất và Dữ liệu Dashboard.\r\n * Tách biệt hoàn toàn tầng GUI khỏi BaoCaoThongKeDAO.\r\n */\r\npublic class ThongKeBus {\r\n\r\n    private final BaoCaoThongKeDAO baoCaoDAO;\r\n    private final HoaDonDAO hoaDonDAO;\r\n\r\n    public ThongKeBus() {\r\n        this.baoCaoDAO = new BaoCaoThongKeDAO();\r\n        this.hoaDonDAO = new HoaDonDAO();\r\n    }\r\n\r\n    public List<DoanhThuRow> layBaoCaoDoanhThu(LocalDateTime tuNgay, LocalDateTime denNgay) {\r\n        try {\r\n            return baoCaoDAO.getDoanhThu(tuNgay, denNgay);\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[ThongKeBus] Lỗi layBaoCaoDoanhThu: \" + e.getMessage());\r\n            return Collections.emptyList();\r\n        }\r\n    }\r\n\r\n    public List<DoanhThuRow> layBaoCaoDoanhThu(LocalDate tuNgay, LocalDate denNgay) {\r\n        return layBaoCaoDoanhThu(tuNgay.atStartOfDay(), denNgay.plusDays(1).atStartOfDay());\r\n    }\r\n\r\n    public List<TopBanChayRow> layTopBanChay(LocalDateTime tuNgay, LocalDateTime denNgay) {\r\n        try {\r\n            return baoCaoDAO.getTopBanChay(tuNgay, denNgay);\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[ThongKeBus] Lỗi layTopBanChay: \" + e.getMessage());\r\n            return Collections.emptyList();\r\n        }\r\n    }\r\n\r\n    public List<TopBanChayRow> layTopBanChay(LocalDate tuNgay, LocalDate denNgay) {\r\n        return layTopBanChay(tuNgay.atStartOfDay(), denNgay.plusDays(1).atStartOfDay());\r\n    }\r\n\r\n    public List<HieuSuatNhanSuRow> layHieuSuatNhanSu(LocalDateTime tuNgay, LocalDateTime denNgay) {\r\n        try {\r\n            return baoCaoDAO.getHieuSuatNhanSu(tuNgay, denNgay);\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[ThongKeBus] Lỗi layHieuSuatNhanSu: \" + e.getMessage());\r\n            return Collections.emptyList();\r\n        }\r\n    }\r\n\r\n    public List<HieuSuatNhanSuRow> layHieuSuatNhanSu(LocalDate tuNgay, LocalDate denNgay) {\r\n        return layHieuSuatNhanSu(tuNgay.atStartOfDay(), denNgay.plusDays(1).atStartOfDay());\r\n    }\r\n\r\n    public List<KhachHangRow> layThongKeKhachHang() {\r\n        try {\r\n            return baoCaoDAO.getKhachHang();\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[ThongKeBus] Lỗi layThongKeKhachHang: \" + e.getMessage());\r\n            return Collections.emptyList();\r\n        }\r\n    }\r\n\r\n    public List<HotelSummaryRow> layHotelSummary() {\r\n        try {\r\n            return baoCaoDAO.getHotelSummary();\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[ThongKeBus] Lỗi layHotelSummary: \" + e.getMessage());\r\n            return Collections.emptyList();\r\n        }\r\n    }\r\n\r\n    public DoiTraSummary layDoiTraSummary(LocalDateTime tuNgay, LocalDateTime denNgay) {\r\n        try {\r\n            return baoCaoDAO.getDoiTraSummary(tuNgay, denNgay);\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[ThongKeBus] Lỗi layDoiTraSummary: \" + e.getMessage());\r\n            return new DoiTraSummary();\r\n        }\r\n    }\r\n\r\n    public DoiTraSummary layDoiTraSummary(LocalDate tuNgay, LocalDate denNgay) {\r\n        return layDoiTraSummary(tuNgay.atStartOfDay(), denNgay.plusDays(1).atStartOfDay());\r\n    }\r\n\r\n    public List<LoHangFefoRow> layLoHangFefo() {\r\n        try {\r\n            return baoCaoDAO.getLoHangFefo();\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[ThongKeBus] Lỗi layLoHangFefo: \" + e.getMessage());\r\n            return Collections.emptyList();\r\n        }\r\n    }\r\n\r\n    public List<XuatNhapTonRow> layXuatNhapTon(LocalDateTime tuNgay, LocalDateTime denNgay) {\r\n        try {\r\n            return baoCaoDAO.getXuatNhapTon(tuNgay, denNgay);\r\n        } catch (SQLException e) {\r\n            System.err.println(\"[ThongKeBus] Lỗi layXuatNhapTon: \" + e.getMessage());\r\n            return Collections.emptyList();\r\n        }\r\n    }\r\n\r\n    public List<XuatNhapTonRow> layXuatNhapTon(LocalDate tuNgay, LocalDate denNgay) {\r\n        return layXuatNhapTon(tuNgay.atStartOfDay(), denNgay.plusDays(1).atStartOfDay());\r\n    }\r\n\r\n    /**\r\n     * Lấy doanh thu thực tế 7 ngày gần nhất từ CSDL SQL Server (phục vụ BarChart và Dashboard).\r\n     */\r\n    public long[] layDoanhThu7NgayGanNhat() {\r\n        long[] result = new long[7];\r\n        LocalDate today = LocalDate.now();\r\n        LocalDateTime tuNgay = today.minusDays(6).atStartOfDay();\r\n        LocalDateTime denNgay = today.plusDays(1).atStartOfDay();\r\n        List<DoanhThuRow> rows = layBaoCaoDoanhThu(tuNgay, denNgay);\r\n\r\n        Map<LocalDate, Long> mapNgayDoanhThu = new HashMap<>();\r\n        for (DoanhThuRow r : rows) {\r\n            if (r.thoiGian != null) {\r\n                LocalDate d = r.thoiGian.toLocalDate();\r\n                mapNgayDoanhThu.put(d, mapNgayDoanhThu.getOrDefault(d, 0L) + r.doanhThuThuan);\r\n            }\r\n        }\r\n\r\n        for (int i = 0; i < 7; i++) {\r\n            LocalDate d = today.minusDays(6 - i);\r\n            result[i] = mapNgayDoanhThu.getOrDefault(d, 0L);\r\n        }\r\n        return result;\r\n    }\r\n\r\n    /**\r\n     * Lấy số lượng đơn hàng thực tế 7 ngày gần nhất từ CSDL SQL Server.\r\n     */\r\n    public int[] laySoDon7NgayGanNhat() {\r\n        int[] result = new int[7];\r\n        LocalDate today = LocalDate.now();\r\n        LocalDateTime tuNgay = today.minusDays(6).atStartOfDay();\r\n        LocalDateTime denNgay = today.plusDays(1).atStartOfDay();\r\n        List<DoanhThuRow> rows = layBaoCaoDoanhThu(tuNgay, denNgay);\r\n\r\n        Map<LocalDate, Integer> mapNgayDon = new HashMap<>();\r\n        for (DoanhThuRow r : rows) {\r\n            if (r.thoiGian != null) {\r\n                LocalDate d = r.thoiGian.toLocalDate();\r\n                mapNgayDon.put(d, mapNgayDon.getOrDefault(d, 0) + 1);\r\n            }\r\n        }\r\n\r\n        for (int i = 0; i < 7; i++) {\r\n            LocalDate d = today.minusDays(6 - i);\r\n            result[i] = mapNgayDon.getOrDefault(d, 0);\r\n        }\r\n        return result;\r\n    }\r\n\r\n    /**\r\n     * Lấy danh sách nhãn thứ/ngày của 7 ngày gần nhất.\r\n     */\r\n    public String[] layNhan7NgayGanNhat() {\r\n        String[] labels = new String[7];\r\n        LocalDate today = LocalDate.now();\r\n        for (int i = 0; i < 7; i++) {\r\n            LocalDate d = today.minusDays(6 - i);\r\n            int dayOfWeek = d.getDayOfWeek().getValue();\r\n            String thu = (dayOfWeek == 7) ? \"CN\" : (\"T\" + (dayOfWeek + 1));\r\n            labels[i] = thu + \" (\" + String.format(\"%02d/%02d\", d.getDayOfMonth(), d.getMonthValue()) + \")\";\r\n        }\r\n        return labels;\r\n    }\r\n\r\n    /**\r\n     * Lấy tổng doanh thu thuần trong ngày hôm nay.\r\n     */\r\n    public long layDoanhThuHomNay() {\r\n        LocalDate today = LocalDate.now();\r\n        List<DoanhThuRow> rows = layBaoCaoDoanhThu(today, today);\r\n        long sum = 0;\r\n        for (DoanhThuRow r : rows) {\r\n            sum += r.doanhThuThuan;\r\n        }\r\n        return sum;\r\n    }\r\n\r\n    /**\r\n     * Lấy tổng số hóa đơn thanh toán trong ngày hôm nay.\r\n     */\r\n    public int laySoDonHangHomNay() {\r\n        LocalDate today = LocalDate.now();\r\n        List<DoanhThuRow> rows = layBaoCaoDoanhThu(today, today);\r\n        return rows.size();\r\n    }\r\n}\r\n"},{"path":"sql/HeThongQuanLyCuaHangThuCung.sql","sha256":"4409e4005b2368dd9a9f2ba0d1a84f87594f24a7d2704dcbf0b2f97a2ced6c8e","content":"﻿-- ======================================================================================\r\n-- ĐỒ ÁN: HỆ THỐNG QUẢN LÝ CỬA HÀNG THÚ CƯNG MIO (PET SHOP MANAGEMENT SYSTEM)\r\n-- MÔN HỌC: PHÁT TRIỂN PHẦN MỀM / CÔNG NGHỆ JAVA\r\n-- ĐƠN VỊ: KHOA CÔNG NGHỆ THÔNG TIN - ĐẠI HỌC CÔNG NGHIỆP TP.HCM (IUH) - NHÓM 07\r\n-- GVHD: ThS. PHẠM THANH HÙNG\r\n-- TẬP TIN DUY NHẤT: KHỞI TẠO CSDL TOÀN DIỆN VÀ NẠP DỮ LIỆU MẪU MỌI TRƯỜNG HỢP KIỂM THỬ\r\n-- ======================================================================================\r\nUSE master;\r\nGO\r\n\r\n-- 1. XÓA SẠCH CƠ SỞ DỮ LIỆU CŨ NẾU ĐÃ TỒN TẠI ĐỂ TÁI LẬP MỚI 100%\r\nIF EXISTS (SELECT 1 FROM sys.databases WHERE name = 'QuanLyCuaHangThuCung')\r\nBEGIN\r\n    ALTER DATABASE QuanLyCuaHangThuCung SET SINGLE_USER WITH ROLLBACK IMMEDIATE;\r\n    DROP DATABASE QuanLyCuaHangThuCung;\r\n    PRINT N'-> Đã xóa cơ sở dữ liệu cũ QuanLyCuaHangThuCung thành công!';\r\nEND\r\nGO\r\n\r\nCREATE DATABASE QuanLyCuaHangThuCung;\r\nGO\r\n\r\nUSE QuanLyCuaHangThuCung;\r\nGO\r\n\r\nPRINT N'-> Đã khởi tạo cơ sở dữ liệu mới QuanLyCuaHangThuCung thành công!';\r\nGO\r\n\r\n-- ======================================================================================\r\n-- PHẦN I: KHỞI TẠO CẤU TRÚC BẢNG (SCHEMA DEFINITION TOÀN BỘ CÁC PHÂN HỆ)\r\n-- ======================================================================================\r\n-- 1. Bảng Tài khoản người dùng (Phân quyền RBAC 4 vai trò chuẩn: NVQL, NVTN, NVBH, NVCS)\r\nCREATE TABLE TaiKhoan (\r\n    maTaiKhoan NVARCHAR(20) PRIMARY KEY,       -- Tự động tăng: NV001, NV002, ... (khớp maNhanVien)\r\n    soDienThoai NVARCHAR(15) NOT NULL UNIQUE,  -- Dùng để nhân viên đăng nhập\r\n    email NVARCHAR(100) NOT NULL UNIQUE,       -- Dùng để xác thực quên mật khẩu\r\n    matKhau NVARCHAR(64) NOT NULL,             -- Chuỗi băm SHA-256 (64 ký tự hex)\r\n    vaiTro NVARCHAR(20) NOT NULL CHECK (vaiTro IN ('NVQL', 'NVTN', 'NVBH', 'NVCS')), -- 4 vai trò cốt lõi\r\n    trangThaiHoatDong BIT NOT NULL DEFAULT 1   -- 1: Đang làm việc, 0: Khóa/Đã nghỉ\r\n);\r\nGO\r\n\r\n-- 2. Bảng Nhân viên\r\nCREATE TABLE NhanVien (\r\n    maNhanVien NVARCHAR(20) PRIMARY KEY,       -- Tự động tăng: NV001, NV002, ...\r\n    hoTen NVARCHAR(100) NOT NULL,\r\n    chucVu NVARCHAR(50) NOT NULL,\r\n    soDienThoai NVARCHAR(15) NOT NULL UNIQUE,\r\n    email NVARCHAR(100) NOT NULL,\r\n    maTaiKhoan NVARCHAR(20) NOT NULL UNIQUE,\r\n    CONSTRAINT FK_NhanVien_TaiKhoan FOREIGN KEY (maTaiKhoan) REFERENCES TaiKhoan(maTaiKhoan) ON DELETE CASCADE\r\n);\r\nGO\r\n\r\n-- 3. Bảng Ca làm việc\r\nCREATE TABLE CaLamViec (\r\n    maCa NVARCHAR(20) PRIMARY KEY,\r\n    tenCa NVARCHAR(50) NOT NULL,\r\n    gioBatDau TIME NOT NULL,\r\n    gioKetThuc TIME NOT NULL\r\n);\r\nGO\r\n\r\n-- 4. Bảng Phân công ca trực\r\nCREATE TABLE BangPhanCong (\r\n    maPhanCong INT IDENTITY(1,1) PRIMARY KEY,\r\n    maNhanVien NVARCHAR(20) NOT NULL,\r\n    maCa NVARCHAR(20) NOT NULL,\r\n    ngayLamViec DATE NOT NULL,\r\n    trangThaiCa NVARCHAR(50) DEFAULT N'Đã phân công',\r\n    ghiChu NVARCHAR(255) NULL,\r\n    CONSTRAINT FK_PhanCong_NhanVien FOREIGN KEY (maNhanVien) REFERENCES NhanVien(maNhanVien),\r\n    CONSTRAINT FK_PhanCong_CaLamViec FOREIGN KEY (maCa) REFERENCES CaLamViec(maCa),\r\n    CONSTRAINT UQ_BangPhanCong_NhanVien_Ngay_Ca UNIQUE (maNhanVien, ngayLamViec, maCa)\r\n);\r\nGO\r\n\r\n-- 5. Bảng Bàn giao ca thu ngân & Két tiền (Có kiểm soát tiền mặt, chuyển khoản, hoàn trả và duyệt ca)\r\nCREATE TABLE BangGiaoCa (\r\n    maGiaoCa NVARCHAR(20) PRIMARY KEY,\r\n    maNhanVien NVARCHAR(20) NOT NULL,\r\n    maCa NVARCHAR(20) NOT NULL,\r\n    tienDauCa DECIMAL(18,2) NOT NULL,\r\n    tienCuoiCaHeThong DECIMAL(18,2) NOT NULL,\r\n    tienCuoiCaThucTe DECIMAL(18,2) NOT NULL,\r\n    tienChenhLech DECIMAL(18,2) NOT NULL,\r\n    tienThuTienMat DECIMAL(18,2) NOT NULL DEFAULT 0,\r\n    tienChuyenKhoan DECIMAL(18,2) NOT NULL DEFAULT 0,\r\n    tienHoanTra DECIMAL(18,2) NOT NULL DEFAULT 0,\r\n    lyDoChenhLech NVARCHAR(255),\r\n    gioBatDauCa DATETIME2 NULL,\r\n    gioKetThucThucTe DATETIME2,\r\n    ngayGiaoCa AS CONVERT(DATE, gioKetThucThucTe) PERSISTED,\r\n    trangThai NVARCHAR(20) NOT NULL DEFAULT 'CHO_DUYET', -- DANG_MO, CHO_DUYET, DA_DUYET\r\n    maQuanLyDuyet NVARCHAR(20) NULL,\r\n    thoiGianDuyet DATETIME2 NULL,\r\n    CONSTRAINT FK_GiaoCa_NhanVien FOREIGN KEY (maNhanVien) REFERENCES NhanVien(maNhanVien),\r\n    CONSTRAINT FK_GiaoCa_CaLamViec FOREIGN KEY (maCa) REFERENCES CaLamViec(maCa),\r\n    CONSTRAINT FK_GiaoCa_QuanLyDuyet FOREIGN KEY (maQuanLyDuyet) REFERENCES NhanVien(maNhanVien),\r\n    CONSTRAINT CK_BangGiaoCa_TrangThai CHECK (trangThai IN ('DANG_MO', 'CHO_DUYET', 'DA_DUYET')),\r\n    CONSTRAINT CK_BangGiaoCa_SoTienKhongAm CHECK (\r\n        tienDauCa >= 0 AND tienCuoiCaHeThong >= 0 AND tienCuoiCaThucTe >= 0\r\n        AND tienThuTienMat >= 0 AND tienChuyenKhoan >= 0 AND tienHoanTra >= 0\r\n    ),\r\n    CONSTRAINT CK_BangGiaoCa_ThongTinDuyet CHECK (\r\n        (trangThai = 'DA_DUYET' AND maQuanLyDuyet IS NOT NULL AND thoiGianDuyet IS NOT NULL)\r\n        OR (trangThai <> 'DA_DUYET' AND maQuanLyDuyet IS NULL AND thoiGianDuyet IS NULL)\r\n    )\r\n);\r\nGO\r\n\r\nCREATE UNIQUE INDEX UQ_BangGiaoCa_NhanVien_Ngay_Ca\r\nON BangGiaoCa(maNhanVien, ngayGiaoCa, maCa)\r\nWHERE ngayGiaoCa IS NOT NULL;\r\nGO\r\n\r\n-- 6. Bảng Khách hàng thành viên (Đã tích hợp email nhận thông báo và địa chỉ)\r\nCREATE TABLE KhachHang (\r\n    maKhachHang NVARCHAR(20) PRIMARY KEY,\r\n    hoTen NVARCHAR(100) NOT NULL,\r\n    soDienThoai NVARCHAR(15) NOT NULL UNIQUE,\r\n    diemTichLuy INT NOT NULL DEFAULT 0 CHECK (diemTichLuy >= 0),\r\n    email NVARCHAR(100) NULL,\r\n    diaChi NVARCHAR(255) NULL\r\n);\r\nGO\r\n\r\n-- 7. Bảng Thú cưng\r\nCREATE TABLE ThuCung (\r\n    maThuCung NVARCHAR(20) PRIMARY KEY,\r\n    tenThuCung NVARCHAR(100) NOT NULL,\r\n    giongLoai NVARCHAR(50),\r\n    ngaySinh DATE,\r\n    gioiTinh NVARCHAR(10) -- Đực, Cái\r\n);\r\nGO\r\n\r\n-- 8. Bảng Hồ sơ thú cưng & Định danh Microchip\r\nCREATE TABLE HoSoThuCung (\r\n    maHoSo NVARCHAR(20) PRIMARY KEY,\r\n    maKhachHang NVARCHAR(20) NOT NULL,\r\n    maThuCung NVARCHAR(20) NOT NULL,\r\n    soMicrochip NVARCHAR(50),\r\n    ngayDangKy DATE NOT NULL,\r\n    trangThaiNuoi NVARCHAR(50) DEFAULT N'Đang nuôi',\r\n    CONSTRAINT FK_HoSo_KhachHang FOREIGN KEY (maKhachHang) REFERENCES KhachHang(maKhachHang),\r\n    CONSTRAINT FK_HoSo_ThuCung FOREIGN KEY (maThuCung) REFERENCES ThuCung(maThuCung)\r\n);\r\nGO\r\n\r\n-- 9. Bảng Sổ theo dõi sức khỏe & Thể trạng y tế thú cưng\r\nCREATE TABLE HoSoSucKhoe (\r\n    maSucKhoe NVARCHAR(20) PRIMARY KEY,\r\n    maThuCung NVARCHAR(20) NOT NULL,\r\n    maNhanVienKiemTra NVARCHAR(20) NOT NULL,\r\n    canNang DECIMAL(6,2),\r\n    nhietDo DECIMAL(4,2),\r\n    tinhTrangVeRan NVARCHAR(100),\r\n    tiemPhongDai BIT NOT NULL DEFAULT 0,\r\n    ghiChuTheTrang NVARCHAR(255),\r\n    ngayKiemTra DATETIME2 NOT NULL,\r\n    CONSTRAINT FK_SucKhoe_ThuCung FOREIGN KEY (maThuCung) REFERENCES ThuCung(maThuCung),\r\n    CONSTRAINT FK_SucKhoe_NhanVien FOREIGN KEY (maNhanVienKiemTra) REFERENCES NhanVien(maNhanVien)\r\n);\r\nGO\r\n\r\n-- 10. Bảng Danh mục Dịch vụ Spa & Grooming\r\nCREATE TABLE DichVu (\r\n    maDichVu NVARCHAR(20) PRIMARY KEY,\r\n    tenDichVu NVARCHAR(100) NOT NULL,\r\n    giaDichVu DECIMAL(18,2) NOT NULL,\r\n    thoiLuongPhut INT NOT NULL\r\n);\r\nGO\r\n\r\n-- 11. Bảng Lịch hẹn dịch vụ\r\nCREATE TABLE LichHen (\r\n    maLichHen NVARCHAR(20) PRIMARY KEY,\r\n    maKhachHang NVARCHAR(20) NOT NULL,\r\n    maNhanVienTiepNhan NVARCHAR(20),\r\n    ngayHen DATETIME2 NOT NULL,\r\n    trangThaiLichHen NVARCHAR(50) DEFAULT N'Đã đặt', -- Đã đặt, Đang phục vụ, Hoàn thành, Hủy\r\n    ghiChu NVARCHAR(255),\r\n    CONSTRAINT FK_LichHen_KhachHang FOREIGN KEY (maKhachHang) REFERENCES KhachHang(maKhachHang),\r\n    CONSTRAINT FK_LichHen_NhanVien FOREIGN KEY (maNhanVienTiepNhan) REFERENCES NhanVien(maNhanVien)\r\n);\r\nGO\r\n\r\n-- 12. Bảng Chi tiết lịch hẹn (Phân công Kỹ thuật viên)\r\nCREATE TABLE ChiTietLichHen (\r\n    maChiTietLichHen NVARCHAR(20) PRIMARY KEY,\r\n    maLichHen NVARCHAR(20) NOT NULL,\r\n    maThuCung NVARCHAR(20) NOT NULL,\r\n    maDichVu NVARCHAR(20) NOT NULL,\r\n    maKtvChiDinh NVARCHAR(20),\r\n    CONSTRAINT FK_CTLichHen_LichHen FOREIGN KEY (maLichHen) REFERENCES LichHen(maLichHen),\r\n    CONSTRAINT FK_CTLichHen_ThuCung FOREIGN KEY (maThuCung) REFERENCES ThuCung(maThuCung),\r\n    CONSTRAINT FK_CTLichHen_DichVu FOREIGN KEY (maDichVu) REFERENCES DichVu(maDichVu),\r\n    CONSTRAINT FK_CTLichHen_Ktv FOREIGN KEY (maKtvChiDinh) REFERENCES NhanVien(maNhanVien)\r\n);\r\nGO\r\n\r\n-- 13. Bảng Danh mục hàng hóa\r\nCREATE TABLE DanhMucHang (\r\n    maDanhMuc NVARCHAR(20) PRIMARY KEY,\r\n    tenDanhMuc NVARCHAR(100) NOT NULL,\r\n    moTa NVARCHAR(255)\r\n);\r\nGO\r\n\r\n-- 14. Bảng Sản phẩm\r\nCREATE TABLE SanPham (\r\n    maSanPham NVARCHAR(20) PRIMARY KEY,\r\n    maDanhMuc NVARCHAR(20) NOT NULL,\r\n    tenSanPham NVARCHAR(100) NOT NULL,\r\n    maVach NVARCHAR(30) NULL UNIQUE,\r\n    donViCoSo NVARCHAR(30) NOT NULL DEFAULT N'Đơn vị',\r\n    giaBanCoSo DECIMAL(18,2) NOT NULL DEFAULT 0 CHECK (giaBanCoSo >= 0),\r\n    moTa NVARCHAR(255),\r\n    CONSTRAINT FK_SanPham_DanhMuc FOREIGN KEY (maDanhMuc) REFERENCES DanhMucHang(maDanhMuc)\r\n);\r\nGO\r\n\r\n-- 15. Bảng Đơn vị tính\r\nCREATE TABLE DonViTinh (\r\n    maDonVi NVARCHAR(20) PRIMARY KEY,\r\n    tenDonVi NVARCHAR(50) NOT NULL\r\n);\r\nGO\r\n\r\n-- 16. Bảng Quy đổi đơn vị tính đa cấp\r\nCREATE TABLE QuyDoiDonVi (\r\n    maQuyDoi NVARCHAR(20) PRIMARY KEY,\r\n    maSanPham NVARCHAR(20) NOT NULL,\r\n    maDonVi NVARCHAR(20) NOT NULL,\r\n    tyLeQuyDoi INT NOT NULL CHECK (tyLeQuyDoi > 0),\r\n    laDonViCoSo BIT NOT NULL DEFAULT 0,\r\n    giaBan DECIMAL(18,2) NOT NULL CHECK (giaBan >= 0),\r\n    CONSTRAINT FK_QuyDoi_SanPham FOREIGN KEY (maSanPham) REFERENCES SanPham(maSanPham),\r\n    CONSTRAINT FK_QuyDoi_DonVi FOREIGN KEY (maDonVi) REFERENCES DonViTinh(maDonVi)\r\n);\r\nGO\r\n\r\n-- 17. Bảng Nhà cung cấp\r\nCREATE TABLE NhaCungCap (\r\n    maNhaCungCap NVARCHAR(20) PRIMARY KEY,\r\n    tenNhaCungCap NVARCHAR(100) NOT NULL,\r\n    diaChi NVARCHAR(255),\r\n    soDienThoai NVARCHAR(20)\r\n);\r\nGO\r\n\r\n-- 18. Bảng Lô hàng (Quản lý hạn sử dụng theo thuật toán FEFO)\r\nCREATE TABLE LoHang (\r\n    soLo NVARCHAR(50) PRIMARY KEY,\r\n    maSanPham NVARCHAR(20) NOT NULL,\r\n    maNhaCungCap NVARCHAR(20) NOT NULL,\r\n    ngaySanXuat DATE NOT NULL,\r\n    hanSuDung DATE NOT NULL,\r\n    ngayNhap DATETIME2 NOT NULL DEFAULT SYSDATETIME(),\r\n    donGiaNhapCoSo DECIMAL(18,2) NOT NULL CHECK (donGiaNhapCoSo >= 0),\r\n    soLuongNhap INT NOT NULL CHECK (soLuongNhap >= 0),\r\n    soLuongTon INT NOT NULL CHECK (soLuongTon >= 0),\r\n    CONSTRAINT FK_LoHang_SanPham FOREIGN KEY (maSanPham) REFERENCES SanPham(maSanPham),\r\n    CONSTRAINT FK_LoHang_NhaCungCap FOREIGN KEY (maNhaCungCap) REFERENCES NhaCungCap(maNhaCungCap)\r\n);\r\nGO\r\n\r\n-- 19. Bảng Hóa đơn bán hàng POS\r\nCREATE TABLE HoaDon (\r\n    maHoaDon NVARCHAR(20) PRIMARY KEY,\r\n    maKhachHang NVARCHAR(20) NULL,\r\n    maNhanVien NVARCHAR(20) NOT NULL,\r\n    ngayLap DATETIME2 NOT NULL,\r\n    thoiGianThanhToan DATETIME2,\r\n    giamGia DECIMAL(18,2) DEFAULT 0,\r\n    thanhTien DECIMAL(18,2) NOT NULL,\r\n    phuongThucThanhToan NVARCHAR(50), -- Tiền mặt, Chuyển khoản QR, Thẻ\r\n    trangThaiHoaDon NVARCHAR(50) DEFAULT N'Đã thanh toán',\r\n    CONSTRAINT FK_HoaDon_KhachHang FOREIGN KEY (maKhachHang) REFERENCES KhachHang(maKhachHang),\r\n    CONSTRAINT FK_HoaDon_NhanVien FOREIGN KEY (maNhanVien) REFERENCES NhanVien(maNhanVien)\r\n);\r\nGO\r\n\r\n-- 20. Bảng Chi tiết hóa đơn\r\nCREATE TABLE ChiTietHoaDon (\r\n    maChiTiet NVARCHAR(50) PRIMARY KEY,\r\n    maHoaDon NVARCHAR(20) NOT NULL,\r\n    loaiChiTiet NVARCHAR(20) NOT NULL, -- SAN_PHAM, DICH_VU\r\n    maSanPham NVARCHAR(20) NULL,\r\n    maDichVu NVARCHAR(20) NULL,\r\n    soLuong INT NOT NULL,\r\n    donGiaLucBan DECIMAL(18,2) NOT NULL,\r\n    thanhTien DECIMAL(18,2) NOT NULL,\r\n    CONSTRAINT FK_CTHD_HoaDon FOREIGN KEY (maHoaDon) REFERENCES HoaDon(maHoaDon) ON DELETE CASCADE,\r\n    CONSTRAINT FK_CTHD_SanPham FOREIGN KEY (maSanPham) REFERENCES SanPham(maSanPham),\r\n    CONSTRAINT FK_CTHD_DichVu FOREIGN KEY (maDichVu) REFERENCES DichVu(maDichVu)\r\n);\r\nGO\r\n\r\n-- 21. Bảng Chi tiết xuất kho theo lô hàng (FEFO Tracking)\r\nCREATE TABLE ChiTietXuatLo (\r\n    maChiTietXuatLo INT IDENTITY(1,1) PRIMARY KEY,\r\n    maChiTiet NVARCHAR(50) NOT NULL,\r\n    soLo NVARCHAR(50) NOT NULL,\r\n    maQuyDoi NVARCHAR(20) NOT NULL,\r\n    soLuongXuatCoSo INT NOT NULL,\r\n    CONSTRAINT FK_CTXuatLo_CTHD FOREIGN KEY (maChiTiet) REFERENCES ChiTietHoaDon(maChiTiet) ON DELETE CASCADE,\r\n    CONSTRAINT FK_CTXuatLo_LoHang FOREIGN KEY (soLo) REFERENCES LoHang(soLo),\r\n    CONSTRAINT FK_CTXuatLo_QuyDoi FOREIGN KEY (maQuyDoi) REFERENCES QuyDoiDonVi(maQuyDoi)\r\n);\r\nGO\r\n\r\n-- 22. Bảng Chi tiết dịch vụ thực hiện & Hoa hồng kỹ thuật viên (10%)\r\nCREATE TABLE ChiTietDichVu (\r\n    maChiTietDichVu INT IDENTITY(1,1) PRIMARY KEY,\r\n    maChiTiet NVARCHAR(50) NOT NULL,\r\n    maDichVu NVARCHAR(20) NOT NULL,\r\n    maThuCung NVARCHAR(20),\r\n    maKtvThucHien NVARCHAR(20),\r\n    tienHoaHong DECIMAL(18,2) DEFAULT 0,\r\n    CONSTRAINT FK_CTDV_CTHD FOREIGN KEY (maChiTiet) REFERENCES ChiTietHoaDon(maChiTiet) ON DELETE CASCADE,\r\n    CONSTRAINT FK_CTDV_DichVu FOREIGN KEY (maDichVu) REFERENCES DichVu(maDichVu),\r\n    CONSTRAINT FK_CTDV_ThuCung FOREIGN KEY (maThuCung) REFERENCES ThuCung(maThuCung),\r\n    CONSTRAINT FK_CTDV_Ktv FOREIGN KEY (maKtvThucHien) REFERENCES NhanVien(maNhanVien)\r\n);\r\nGO\r\n\r\n-- 23. Bảng Phiếu đổi trả hàng hóa\r\nCREATE TABLE PhieuDoiTra (\r\n    maPhieuDoiTra NVARCHAR(20) PRIMARY KEY,\r\n    maHoaDonGoc NVARCHAR(20) NOT NULL,\r\n    maNhanVienTiepNhan NVARCHAR(20) NOT NULL,\r\n    ngayDoiTra DATETIME2 NOT NULL,\r\n    tongTienHoan DECIMAL(18,2) NOT NULL,\r\n    lyDoDoiTra NVARCHAR(255),\r\n    trangThaiDoiTra NVARCHAR(50) DEFAULT N'Hoàn thành',\r\n    CONSTRAINT FK_DoiTra_HoaDon FOREIGN KEY (maHoaDonGoc) REFERENCES HoaDon(maHoaDon),\r\n    CONSTRAINT FK_DoiTra_NhanVien FOREIGN KEY (maNhanVienTiepNhan) REFERENCES NhanVien(maNhanVien)\r\n);\r\nGO\r\n\r\n-- 24. Bảng Chi tiết đổi trả\r\nCREATE TABLE ChiTietDoiTra (\r\n    maChiTietDoiTra NVARCHAR(50) PRIMARY KEY,\r\n    maPhieuDoiTra NVARCHAR(20) NOT NULL,\r\n    maSanPham NVARCHAR(20) NOT NULL,\r\n    soLuongDoiTra INT NOT NULL DEFAULT 1,\r\n    tienHoanLai DECIMAL(18,2) NOT NULL DEFAULT 0,\r\n    soLo NVARCHAR(50) NULL,\r\n    soLuongCoSoHoan INT NOT NULL DEFAULT 0,\r\n    soLuong INT NULL,\r\n    donGiaHoan DECIMAL(18,2) NULL,\r\n    lyDoChiTiet NVARCHAR(255),\r\n    CONSTRAINT FK_CTDoiTra_Phieu FOREIGN KEY (maPhieuDoiTra) REFERENCES PhieuDoiTra(maPhieuDoiTra) ON DELETE CASCADE,\r\n    CONSTRAINT FK_CTDoiTra_SanPham FOREIGN KEY (maSanPham) REFERENCES SanPham(maSanPham),\r\n    CONSTRAINT FK_CTDoiTra_LoHang FOREIGN KEY (soLo) REFERENCES LoHang(soLo),\r\n    CONSTRAINT CK_CTDoiTra_SoLuongCoSoHoan CHECK (soLuongCoSoHoan >= 0)\r\n);\r\nGO\r\n\r\n-- 25. Bảng Quản lý Khách sạn lưu trú thú cưng (Pet Hotel & Boarding Matrix)\r\nCREATE TABLE PhongLuuTru (\r\n    maPhong NVARCHAR(20) PRIMARY KEY,\r\n    loaiPhong NVARCHAR(50) NOT NULL,       -- Phòng Tiêu chuẩn, Phòng VIP Suite, Condo cho Mèo\r\n    donGiaNgay BIGINT NOT NULL,\r\n    trangThai NVARCHAR(50) NOT NULL,       -- TRỐNG, ĐANG CÓ KHÁCH, ĐANG DỌN DẸP\r\n    tenThuCung NVARCHAR(100),\r\n    giongLoai NVARCHAR(100),\r\n    tenChu NVARCHAR(100),\r\n    sdtChu NVARCHAR(20),\r\n    thoiGianCheckIn DATETIME2,\r\n    duKienCheckOut DATETIME2,\r\n    ghiChuChamSoc NVARCHAR(255),\r\n    daChoAnSang BIT NOT NULL DEFAULT 0,\r\n    daChoAnToi BIT NOT NULL DEFAULT 0,\r\n    daDiDaoVeSinh BIT NOT NULL DEFAULT 0,\r\n    phiDichVuPhatSinh BIGINT NOT NULL DEFAULT 0\r\n);\r\nGO\r\n\r\n-- 26. Bảng Thẻ Gói Spa Pass (Punch Card định kỳ tích hợp POS)\r\nCREATE TABLE TheSpaPass (\r\n    maThe NVARCHAR(50) PRIMARY KEY,\r\n    sdtKhachHang NVARCHAR(15) NOT NULL,\r\n    tenKhachHang NVARCHAR(100) NOT NULL,\r\n    tenGoi NVARCHAR(100) NOT NULL,\r\n    tongSoBuoi INT NOT NULL CHECK (tongSoBuoi > 0),\r\n    soBuoiDaDung INT NOT NULL DEFAULT 0 CHECK (soBuoiDaDung >= 0),\r\n    donGiaGoi DECIMAL(18,2) NOT NULL DEFAULT 0 CHECK (donGiaGoi >= 0),\r\n    ngayKichHoat DATE NOT NULL,\r\n    ngayHetHan DATE NOT NULL,\r\n    trangThai NVARCHAR(50) NOT NULL DEFAULT N'ĐANG HOẠT ĐỘNG',\r\n    maHoaDonKichHoat NVARCHAR(20) NULL,\r\n    CONSTRAINT FK_TheSpaPass_HoaDonKichHoat FOREIGN KEY (maHoaDonKichHoat) REFERENCES HoaDon(maHoaDon)\r\n);\r\nGO\r\n\r\nCREATE UNIQUE INDEX UQ_TheSpaPass_HoaDonKichHoat\r\nON TheSpaPass(maHoaDonKichHoat) WHERE maHoaDonKichHoat IS NOT NULL;\r\nGO\r\n\r\nCREATE TABLE LichSuSuDungSpaPass (\r\n    maSuDung BIGINT IDENTITY(1,1) PRIMARY KEY,\r\n    maThe NVARCHAR(50) NOT NULL,\r\n    maHoaDon NVARCHAR(20) NOT NULL,\r\n    maNhanVien NVARCHAR(20) NOT NULL,\r\n    thoiGianSuDung DATETIME2 NOT NULL DEFAULT SYSDATETIME(),\r\n    ghiChu NVARCHAR(255),\r\n    CONSTRAINT FK_LSSpaPass_The FOREIGN KEY (maThe) REFERENCES TheSpaPass(maThe),\r\n    CONSTRAINT FK_LSSpaPass_HoaDon FOREIGN KEY (maHoaDon) REFERENCES HoaDon(maHoaDon),\r\n    CONSTRAINT FK_LSSpaPass_NhanVien FOREIGN KEY (maNhanVien) REFERENCES NhanVien(maNhanVien),\r\n    CONSTRAINT UQ_LSSpaPass_HoaDon UNIQUE (maHoaDon)\r\n);\r\nGO\r\n\r\n-- 27. Bảng Lịch sử lưu trú Khách sạn thú cưng (Pet Hotel Checkout History)\r\nCREATE TABLE LichSuLuuTru (\r\n    maLuuTru INT IDENTITY(1,1) PRIMARY KEY,\r\n    maPhong NVARCHAR(20) NOT NULL,\r\n    tenThuCung NVARCHAR(100),\r\n    tenChu NVARCHAR(100),\r\n    sdtChu NVARCHAR(20),\r\n    thoiGianCheckIn DATETIME2,\r\n    thoiGianCheckOut DATETIME2,\r\n    soNgayLuuTru INT CHECK (soNgayLuuTru >= 0),\r\n    donGiaNgay DECIMAL(18,2) CHECK (donGiaNgay >= 0),\r\n    phiPhatSinh DECIMAL(18,2) CHECK (phiPhatSinh >= 0),\r\n    tongTien DECIMAL(18,2) CHECK (tongTien >= 0),\r\n    ghiChu NVARCHAR(500),\r\n    maHoaDon NVARCHAR(20) NULL,\r\n    trangThaiThanhToan NVARCHAR(30) NOT NULL DEFAULT 'CHO_THANH_TOAN',\r\n    CONSTRAINT FK_LichSuLuuTru_HoaDon FOREIGN KEY (maHoaDon) REFERENCES HoaDon(maHoaDon),\r\n    CONSTRAINT CK_LichSuLuuTru_ThanhToan CHECK (trangThaiThanhToan IN ('CHO_THANH_TOAN','DA_THANH_TOAN','DA_HUY'))\r\n);\r\nGO\r\n\r\nCREATE UNIQUE INDEX UQ_LichSuLuuTru_HoaDon\r\nON LichSuLuuTru(maHoaDon) WHERE maHoaDon IS NOT NULL;\r\nGO\r\n\r\nPRINT N'-> Hoàn thành tạo cấu trúc bảng (Schema) thành công!';\r\nGO\r\n\r\n-- ======================================================================================\r\n-- PHẦN II: NẠP DỮ LIỆU MẪU KIỂM THỬ MỌI KỊCH BẢN VÀ TRƯỜNG HỢP NGHIỆP VỤ (SEED DATA)\r\n-- ======================================================================================\r\n-- 1. Tài khoản & Nhân viên (4 thành viên phụ trách 4 phân hệ cốt lõi + KTV + NV nghỉ việc)\r\nINSERT INTO TaiKhoan (maTaiKhoan, soDienThoai, email, matKhau, vaiTro, trangThaiHoatDong) VALUES\r\n('NV001', '0901234567', 'minh.quanly@miopet.vn', '8d969eef6ecad3c29a3a629280e686cf0c3f5d5a86aff3ca12020c923adc6c92', 'NVQL',  1),\r\n('NV002', '0923456789', 'dat.kho@miopet.vn',      '8d969eef6ecad3c29a3a629280e686cf0c3f5d5a86aff3ca12020c923adc6c92', 'NVQL',  1),\r\n('NV003', '0912345678', 'minh.thungan@miopet.vn',  '8d969eef6ecad3c29a3a629280e686cf0c3f5d5a86aff3ca12020c923adc6c92', 'NVTN',  1),\r\n('NV004', '0945678901', 'ngoc.spa@miopet.vn',      '8d969eef6ecad3c29a3a629280e686cf0c3f5d5a86aff3ca12020c923adc6c92', 'NVCS',  1),\r\n('NV005', '0934567890', 'ha.ktv@miopet.vn',        '8d969eef6ecad3c29a3a629280e686cf0c3f5d5a86aff3ca12020c923adc6c92', 'NVCS',  1),\r\n('NV006', '0956789012', 'hung.banhang@miopet.vn',  '8d969eef6ecad3c29a3a629280e686cf0c3f5d5a86aff3ca12020c923adc6c92', 'NVBH',  1);\r\nINSERT INTO NhanVien (maNhanVien, hoTen, chucVu, soDienThoai, email, maTaiKhoan) VALUES\r\n('NV001', N'Lê Khãi Minh',    N'Quản lý hệ thống',        '0901234567', 'minh.quanly@miopet.vn', 'NV001'),\r\n('NV002', N'Tô Thành Đạt',     N'Quản lý kho & Lô hàng',   '0923456789', 'dat.kho@miopet.vn',      'NV002'),\r\n('NV003', N'Lê Anh Minh',      N'Thu ngân trưởng ca',      '0912345678', 'minh.thungan@miopet.vn',  'NV003'),\r\n('NV004', N'Võ Thị Hồng Ngọc', N'Chuyên viên Spa & Hotel', '0945678901', 'ngoc.spa@miopet.vn',      'NV004'),\r\n('NV005', N'Trần Thị Thu Hà',  N'Kỹ thuật viên chăm sóc',  '0934567890', 'ha.ktv@miopet.vn',        'NV005'),\r\n('NV006', N'Nguyễn Văn Hùng',  N'Nhân viên bán hàng (Cũ)', '0956789012', 'hung.banhang@miopet.vn',  'NV006');\r\nGO\r\n\r\n-- 2. Ca làm việc cố định\r\nINSERT INTO CaLamViec (maCa, tenCa, gioBatDau, gioKetThuc) VALUES\r\n('CA01', N'Ca Sáng (07:00 - 11:30)', '07:00:00', '11:30:00'),\r\n('CA02', N'Ca Trưa (11:30 - 15:30)', '11:30:00', '15:30:00'),\r\n('CA03', N'Ca Chiều (15:30 - 19:30)', '15:30:00', '19:30:00'),\r\n('CA04', N'Ca Tối (19:30 - 22:00)',  '19:30:00', '22:00:00');\r\nGO\r\n\r\n-- 3. Phân công ca trực (Phủ kín các ngày trong tuần hiện tại để hiển thị ma trận và xuất Excel)\r\nINSERT INTO BangPhanCong (maNhanVien, maCa, ngayLamViec, ghiChu) VALUES\r\n-- Ngày hôm qua (-1)\r\n('NV002', 'CA01', DATEADD(day, -1, CAST(GETDATE() AS DATE)), N'Kiểm kê lô hàng nhập sáng'),\r\n('NV003', 'CA02', DATEADD(day, -1, CAST(GETDATE() AS DATE)), N'Trực quầy POS thu ngân'),\r\n('NV004', 'CA03', DATEADD(day, -1, CAST(GETDATE() AS DATE)), N'Nhận tắm sấy chó mèo'),\r\n-- Ngày hôm nay (0)\r\n('NV001', 'CA01', CAST(GETDATE() AS DATE), N'Mở cửa cửa hàng & Họp giao ban đầu ngày'),\r\n('NV003', 'CA01', CAST(GETDATE() AS DATE), N'Trực ca thu ngân sáng'),\r\n('NV002', 'CA02', CAST(GETDATE() AS DATE), N'Soát đơn vị tính quy đổi và xếp kho'),\r\n('NV004', 'CA02', CAST(GETDATE() AS DATE), N'Theo dõi dinh dưỡng chuồng Pet Hotel'),\r\n('NV005', 'CA03', CAST(GETDATE() AS DATE), N'Cắt tỉa tạo kiểu thú cưng'),\r\n('NV003', 'CA04', CAST(GETDATE() AS DATE), N'Chốt ca thu ngân tối & Khóa két tiền'),\r\n-- Ngày mai (+1)\r\n('NV002', 'CA01', DATEADD(day, 1, CAST(GETDATE() AS DATE)), N'Nhập hàng nhà cung cấp NCC01'),\r\n('NV004', 'CA01', DATEADD(day, 1, CAST(GETDATE() AS DATE)), N'Đón thú cưng khách sạn check-in'),\r\n('NV003', 'CA02', DATEADD(day, 1, CAST(GETDATE() AS DATE)), N'Trực quầy bán lẻ'),\r\n('NV005', 'CA03', DATEADD(day, 1, CAST(GETDATE() AS DATE)), N'Ca chăm sóc Spa chiều');\r\nGO\r\n\r\n-- 4. Bàn giao ca thu ngân & Đối soát tiền két (Đủ các kịch bản: Khớp két, Thiếu tiền chờ duyệt, Ca đang mở)\r\nINSERT INTO BangGiaoCa (maGiaoCa, maNhanVien, maCa, tienDauCa, tienCuoiCaHeThong, tienCuoiCaThucTe, tienChenhLech, tienThuTienMat, tienChuyenKhoan, tienHoanTra, lyDoChenhLech, gioKetThucThucTe, trangThai, maQuanLyDuyet, thoiGianDuyet) VALUES\r\n-- Ca 1: Khớp két 100%, Quản lý đã duyệt ký nhận K80\r\n('GC001', 'NV003', 'CA01', 1000000, 3500000, 3500000, 0, 2500000, 850000, 0, \r\n N'Khớp két 100%, không phát sinh sai lệch', \r\n DATEADD(day, -2, DATEADD(hour, 11, DATEADD(minute, 30, CAST(CAST(GETDATE() AS DATE) AS DATETIME2)))), \r\n 'DA_DUYET', 'NV001', DATEADD(day, -2, DATEADD(hour, 11, DATEADD(minute, 45, CAST(CAST(GETDATE() AS DATE) AS DATETIME2))))),\r\n-- Ca 2: ĐANG CHỜ DUYỆT (CHO_DUYET), bị THIẾU 50.000đ do thu ngân thối nhầm tiền -> Dùng để demo chức năng Duyệt ca & in K80\r\n('GC002', 'NV005', 'CA02', 3500000, 5200000, 5150000, -50000, 1700000, 450000, 20000, \r\n N'Thối nhầm tiền thừa 50.000đ cho khách mua hạt Royal Canin', \r\n DATEADD(day, -1, DATEADD(hour, 15, DATEADD(minute, 35, CAST(CAST(GETDATE() AS DATE) AS DATETIME2)))), \r\n 'CHO_DUYET', NULL, NULL),\r\n-- Ca 3: ĐÃ DUYỆT, có phát sinh giao dịch hoàn tiền trả hàng\r\n('GC003', 'NV003', 'CA03', 2000000, 4800000, 4800000, 0, 2800000, 1200000, 65000, \r\n N'Đã hoàn tiền đổi trả 1 túi cát vệ sinh cho khách Mai', \r\n DATEADD(day, -1, DATEADD(hour, 19, DATEADD(minute, 30, CAST(CAST(GETDATE() AS DATE) AS DATETIME2)))), \r\n 'DA_DUYET', 'NV001', DATEADD(day, -1, DATEADD(hour, 19, DATEADD(minute, 40, CAST(CAST(GETDATE() AS DATE) AS DATETIME2))))),\r\n-- Ca 4: ĐANG MỞ (DANG_MO) của ca trực hiện tại -> Để thu ngân thao tác Bàn giao ca trực tiếp trên giao diện\r\n('GC004', 'NV003', 'CA01', 1500000, 1500000, 1500000, 0, 0, 0, 0, \r\n N'Ca trực hiện tại đang phục vụ khách hàng', \r\n NULL, 'DANG_MO', NULL, NULL);\r\nGO\r\n\r\n-- 5. Khách hàng thành viên (Đầy đủ các hạng thẻ: Kim Cương, Vàng, Bạc, Mới, có Email & Địa chỉ)\r\nINSERT INTO KhachHang (maKhachHang, hoTen, soDienThoai, diemTichLuy, email, diaChi) VALUES\r\n('KH001', N'Nguyễn Văn An',  '0988111222', 125, 'khachhang.an@gmail.com',  N'12 Nguyễn Văn Bảo, P.4, Q. Gò Vấp, TP.HCM'), -- VIP Kim Cương (>= 100 điểm)\r\n('KH002', N'Trần Thị Mai',   '0977333444', 68,  'mai.tran@gmail.com',       N'45 Lê Lợi, P.3, Q. Gò Vấp, TP.HCM'),        -- Hạng Vàng (50 - 99 điểm)\r\n('KH003', N'Lê Hoàng Yến',   '0912345678', 35,  'hoangyen.pet@gmail.com',   N'78 Quang Trung, P.10, Q. Gò Vấp, TP.HCM'),  -- Hạng Bạc (20 - 49 điểm)\r\n('KH004', N'Đặng Quốc Bảo',  '0933555777', 10,  'quocbao.dang@gmail.com',   N'15 Phan Văn Trị, P.7, Q. Gò Vấp, TP.HCM'),  -- Khách hàng Mới (< 20 điểm)\r\n('KH005', N'Khách vãng lai', '0900000000', 0,   'hotro.miopet@gmail.com',   N'Khách mua trực tiếp tại quầy');             -- Khách vãng lai\r\nGO\r\n\r\n-- 6. Danh mục Thú cưng & Hồ sơ Microchip\r\nINSERT INTO ThuCung (maThuCung, tenThuCung, giongLoai, ngaySinh, gioiTinh) VALUES\r\n('TC001', N'Miu Miu',    N'